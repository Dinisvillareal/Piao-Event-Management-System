    {
        Schema::table('users', function (Blueprint $table) {
            $table->unsignedBigInteger('household_head_of')
                ->nullable()
                ->storedAs('CASE WHEN is_household_head = 1 THEN household_id ELSE NULL END')
                ->after('is_household_head');
        });

