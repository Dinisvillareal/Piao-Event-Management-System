            ->select('id', 'household_id')
            ->whereNotNull('household_id')
            ->where('is_household_head', true)
            ->orderByDesc('id')
            ->get()
            ->groupBy('household_id')
            ->flatMap(fn ($rows) => $rows->slice(1)->pluck('id'));

