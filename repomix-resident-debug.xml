<file path="app/Support/Mutex.php">
<?php

namespace App\Support;

use App\Exceptions\MutexBusyException;
use Illuminate\Support\Facades\DB;

/**
 * A short "one at a time" lock for check-then-write jobs that a database row lock cannot cover, such as
 * "is this venue free?" followed by an insert (there is no row yet to lock) or "next code after the last one".
 *
 * On MySQL / MariaDB it is a named lock held by the database connection (GET_LOCK / RELEASE_LOCK): it works
 * across every PHP process and every server talking to the same database, needs no table, and is released
 * by the database itself if the process dies. Take it BEFORE opening the transaction so that what the
 * second caller reads is what the first one committed. On SQLite (the automated tests; one process at a
 * time anyway) it just runs the callback.
 */
final class Mutex
{
    /** Seconds a request waits for its turn before telling the person to try again. */
    public const DEFAULT_WAIT = 10;

    /**
     * @template T
     * @param  callable():T  $callback
     * @return T
     */
    public static function run(string $key, callable $callback, int $wait = self::DEFAULT_WAIT)
    {
        if (!in_array(DB::getDriverName(), ['mysql', 'mariadb'], true)) {
            return $callback();
        }

        // Lock names are limited to 64 characters; hash so any text (a venue name) is safe.
        $name = 'piao:' . substr(hash('sha256', mb_strtolower($key)), 0, 40);

        $got = DB::selectOne('SELECT GET_LOCK(?, ?) AS got', [$name, $wait]);
        if ((int) ($got->got ?? 0) !== 1) {
            throw new MutexBusyException();
        }

        try {
            return $callback();
        } finally {
            DB::selectOne('SELECT RELEASE_LOCK(?) AS released', [$name]);
        }
    }
}
</file>

<file path="app/Support/Paged.php">
<?php

namespace App\Support;

use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Illuminate\Http\Request;

/**
 * Small helpers shared by every list screen that filters, sorts and pages in
 * the database (instead of downloading everything and filtering in the
 * browser): page size, forgiving word-by-word search, and one response shape
 * -- { data, meta: { total, page, per_page, last_page }, ...extra }.
 */
class Paged
{
    public static function perPage(Request $request, int $default = 10, int $max = 100): int
    {
        return max(1, min($max, (int) $request->input('per_page', $default)));
    }

    public static function page(Request $request): int
    {
        return max(1, (int) $request->input('page', 1));
    }

    /** Search words (lower-cased, whitespace-split), like the browser's matchesSearch(). */
    public static function tokens(?string $query): array
    {
        $q = trim(preg_replace('/\s+/u', ' ', mb_strtolower((string) $query)));

        return $q === '' ? [] : explode(' ', $q);
    }

    /** "%word%" with LIKE wildcards in the word escaped. */
    public static function like(string $word): string
    {
        return '%' . addcslashes($word, '\\%_') . '%';
    }

    /** Standard JSON body for a paginated list. */
    public static function body(LengthAwarePaginator $paginator, $rows, array $extra = []): array
    {
        return array_merge([
            'data' => $rows,
            'meta' => [
                'total' => $paginator->total(),
                'page' => $paginator->currentPage(),
                'per_page' => $paginator->perPage(),
                'last_page' => $paginator->lastPage(),
            ],
        ], $extra);
    }
}
