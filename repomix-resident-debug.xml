<file path="app/Http/Controllers/Controller.php">
<?php

namespace App\Http\Controllers;

use App\Exceptions\MutexBusyException;
use App\Exceptions\UserFacingException;
use App\Support\Mutex;
use App\Models\ActivityLog;
use Illuminate\Support\Carbon;
use Illuminate\Support\Facades\Log;

abstract class Controller
{
    /**
     * True when the authenticated user is Staff.
     *
     * Centralized here so every controller shares ONE definition of
     * "staff" instead of each controller redefining its own private
     * copy. Previously this same one-line check was copy-pasted into
     * ~14 controllers separately -- meaning there was no single place
     * to audit or change who counts as staff, and a new controller
     * could easily forget the check entirely. Now it's defined once
     * and inherited by every controller in the app.
     */
    protected function isStaff(): bool
    {
        return auth()->user()?->role === 'Staff';
    }

    /**
     * Write one activity-log row.
     *
     * Supports both calling styles that existed across the codebase
     * before this was centralized, so no call site needs to change:
     *
     *   $this->createLog($action, $module, $description)   // explicit module
     *   $this->createLog($action, $description)             // module comes
     *                                                         // from $this->logModule
     *
     * A controller that always logs to the same module (e.g.
     * InventoryController -> "Inventory") declares:
     *
     *   protected $logModule = 'Inventory';
     *
     * and can then call the 2-arg form. $at lets a caller backdate/
     * order entries deliberately (see EventController, which staggers
     * a "Create event" row and its paired "Sent notification" row by
     * a few hundred milliseconds so they display in the right order
     * in the activity feed) -- ActivityLog has auto timestamps, so
     * $at only needs to be passed when that default isn't good enough.
     */
    protected function createLog(string $action, string $moduleOrDescription, ?string $description = null, ?Carbon $at = null): void
    {
        if ($description === null) {
            $module = $this->logModule ?? 'System';
            $description = $moduleOrDescription;
        } else {
            $module = $moduleOrDescription;
        }

        $row = [
            'user_code'   => auth()->user()?->user_code ?? 'SYSTEM',
            'action'      => $action,
            'module'      => $module,
            'description' => $description,
        ];

        if ($at !== null) {
            $row['created_at'] = $at;
            $row['updated_at'] = $at;
        }

        ActivityLog::create($row);
    }

    /**
     * The text that may be shown to the user for a caught exception.
     *
     * A UserFacingException carries a message written for staff, so it is shown as is.
     * Anything else (database error, bug) is internal: the full detail goes to the server
     * log only, and the screen gets a generic line. Never put $e->getMessage() into a
     * response directly -- it can contain table names, SQL and file paths.
     */
    protected function safeError(\Throwable $e): string
    {
        if ($e instanceof UserFacingException) {
            return $e->getMessage();
        }

        Log::error($e->getMessage(), [
            'exception' => $e,
            'user_code' => auth()->user()?->user_code,
            'url' => request()->fullUrl(),
        ]);

        return 'Something went wrong. Please try again.';
    }

    /**
     * Runs a check-then-write job one at a time per $key (see App\Support\Mutex). If another request holds
     * the same lock for too long the person gets a "try again" answer instead of a half-done save.
     */
    protected function exclusively(string $key, callable $callback)
    {
        try {
            return Mutex::run($key, $callback);
        } catch (MutexBusyException) {
            return response()->json([
                'message' => 'The system is busy saving another change to the same record. Please try again in a moment.',
            ], 503);
        }
    }
}
</file>

<file path="app/Models/Concerns/HasConditionUnits.php">
<?php

namespace App\Models\Concerns;

use App\Models\InventoryItem;

/**
 * For rows that move a number of inventory units around (an event's borrow
 * row, a release of it): remembers how many of those units are New / Good /
 * Fair / Poor, so they go back into the same conditions they came out of.
 *
 * `quantity` stays the total. Rows made before units were split have all four
 * counts at 0 -- the "unsplit" remainder (quantity minus the split units) is
 * treated as belonging to the item's main condition.
 */
trait HasConditionUnits
{
    public static function unitColumns(): array
    {
        return InventoryItem::CONDITION_COLUMNS;
    }

    public function initializeHasConditionUnits(): void
    {
        $this->mergeFillable(array_values(InventoryItem::CONDITION_COLUMNS));
        foreach (InventoryItem::CONDITION_COLUMNS as $col) {
            $this->casts[$col] = 'integer';
        }
    }

    /** Units per condition; unsplit units are counted under $main. Always adds up to `quantity`. */
    public function resolvedUnits(string $main = 'Good'): array
    {
        $units = [];
        foreach (InventoryItem::CONDITION_COLUMNS as $label => $col) {
            $units[$label] = (int) $this->getAttribute($col);
        }
        $rest = (int) $this->quantity - array_sum($units);
        if ($rest > 0) {
            $units[isset($units[$main]) ? $main : 'Good'] += $rest;
        }

        return $units;
    }

    /** Replaces the split and the total quantity with $units. Does not save. */
    public function setUnits(array $units): void
    {
        foreach (InventoryItem::CONDITION_COLUMNS as $label => $col) {
            $this->setAttribute($col, max(0, (int) ($units[$label] ?? 0)));
        }
        $this->quantity = array_sum(array_map(fn ($n) => max(0, (int) $n), $units));
    }

    /** Adds $units to this row. Does not save. */
    public function addUnits(array $units, string $main = 'Good'): void
    {
        $now = $this->resolvedUnits($main);
        foreach ($units as $label => $n) {
            $now[$label] = ($now[$label] ?? 0) + (int) $n;
        }
        $this->setUnits($now);
    }

    /**
     * Takes out as many units as were returned, preferring the same
     * conditions they were borrowed in; whatever is left over (a unit came
     * back in a different condition than it left in) comes from the largest
     * remaining condition. Does not save.
     */
    public function takeOutMatching(array $returned, string $main = 'Good'): void
    {
        $now = $this->resolvedUnits($main);
        $left = 0;
        foreach ($returned as $label => $n) {
            $n = max(0, (int) $n);
            $cut = min($n, $now[$label] ?? 0);
            if ($cut > 0) {
                $now[$label] -= $cut;
            }
            $left += $n - $cut;
        }

        arsort($now);
        foreach (array_keys($now) as $label) {
            if ($left <= 0) {
                break;
            }
            $cut = min($left, $now[$label]);
            $now[$label] -= $cut;
            $left -= $cut;
        }

        $this->setUnits($now);
    }

    /**
     * Takes $n units out of this row (largest condition first) and returns
     * what was taken, per condition. Does not save.
     */
    public function takeOutUnits(int $n, string $main = 'Good'): array
    {
        $now = $this->resolvedUnits($main);
        $taken = array_fill_keys(array_keys($now), 0);

        $order = array_keys($now);
        usort($order, fn ($a, $b) => $now[$b] <=> $now[$a]);
        foreach ($order as $label) {
            if ($n <= 0) {
                break;
            }
            $cut = min($n, $now[$label]);
            $taken[$label] = $cut;
            $now[$label] -= $cut;
            $n -= $cut;
        }

        $this->setUnits($now);

        return $taken;
    }
}
</file>

<file path="app/Models/Concerns/JoinsHashChain.php">
<?php

namespace App\Models\Concerns;

use App\Support\AuditChain;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;

/**
 * A new row joins its table's hash chain (App\Support\AuditChain): it stores the fingerprint of the row
 * before it and its own. The read of the previous row and the insert happen in one transaction with the
 * previous row locked, so two requests at the same moment cannot both follow the same row.
 *
 * The model can define beforeChain() to fill in system values (such as an IP address) before the
 * fingerprint is calculated.
 */
trait JoinsHashChain
{
    private static array $chainColumnsPresent = [];

    protected function performInsert(Builder $query)
    {
        $table = $this->getTable();
        self::$chainColumnsPresent[$table] ??= Schema::hasColumn($table, 'row_hash');
        if (!self::$chainColumnsPresent[$table]) {
            return parent::performInsert($query);   // the chain columns have not been added yet (migration not run)
        }

        return DB::transaction(function () use ($query, $table) {
            if (method_exists($this, 'beforeChain')) {
                $this->beforeChain();
            }
            $this->updateTimestamps();   // the time is part of the fingerprint, so it is fixed before it is calculated

            $last = DB::table($table)->orderByDesc('id')->lockForUpdate()->first(['row_hash']);
            $previous = $last->row_hash ?? null;

            $this->setAttribute('prev_hash', $previous ?? '');
            $this->setAttribute('row_hash', AuditChain::fingerprint($previous, $this->getAttributes(), $table));

            return parent::performInsert($query);
        });
    }
}
</file>

<file path="app/Models/Concerns/KeepsActivityLog.php">
<?php

namespace App\Models\Concerns;

use Illuminate\Support\Facades\Storage;

/**
 * An edit trail for records that are corrected after the fact (a return, an
 * expense). Every edit is appended to the record's `activity_log` -- what
 * changed (field, from, to), who did it and when -- so the original values are
 * never lost, the same way the Found entries in Inventory keep their history.
 *
 * Evidence is never thrown away either: photos / receipts that an edit
 * replaced or removed stay on disk and are listed on that edit's entry.
 *
 * Needs an `activity_log` JSON column cast to array on the model.
 */
trait KeepsActivityLog
{
    /**
     * Appends one edit to the trail. $changes is a list of
     * ['field' => string, 'from' => scalar|null, 'to' => scalar|null];
     * $photos are the storage paths the edit replaced or removed (kept on
     * disk, never deleted) and $added the ones it attached.
     * Does nothing when there is nothing to record. Call save() afterwards.
     */
    public function logEdit(array $changes, array $photos = [], array $added = []): void
    {
        $photos = array_values(array_filter($photos));
        $added = array_values(array_filter($added));
        if (!$changes && !$photos && !$added) {
            return;
        }

        $log = $this->activity_log ?? [];
        $log[] = [
            'by' => auth()->user()?->user_code,
            'at' => now()->toIso8601String(),
            'changes' => array_values($changes),
            'photos' => $photos,
            'added' => $added,
        ];
        $this->activity_log = $log;
    }

    /** The trail as the screens need it: public URLs, who and when, newest first. */
    public function getActivityLogUrlsAttribute(): array
    {
        $entries = collect($this->activity_log ?? []);
        $people = [];
        $codes = $entries->pluck('by')->filter()->unique()->values();
        if ($codes->isNotEmpty()) {
            $people = \App\Models\User::whereIn('user_code', $codes)->get(['user_code', 'first_name', 'last_name'])->keyBy('user_code')->all();
        }

        return $entries
            ->map(fn ($h) => [
                'changes' => $h['changes'] ?? [],
                'photo_urls' => array_map(fn ($p) => Storage::disk('public')->url($p), $h['photos'] ?? []),
                'added_urls' => array_map(fn ($p) => Storage::disk('public')->url($p), $h['added'] ?? []),
                'by' => isset($people[$h['by'] ?? null]) ? trim($people[$h['by']]->first_name . ' ' . $people[$h['by']]->last_name) : ($h['by'] ?? null),
                'at' => $h['at'] ?? null,
            ])
            ->reverse()
            ->values()
            ->all();
    }
}
</file>

<file path="app/Services/ActivationSlipService.php">
<?php

namespace App\Services;

use App\Models\User;
use Illuminate\Support\Facades\Hash;

/**
 * One-time activation slips. Nobody types or sees an account's password: the
 * system makes a random code, keeps only its hash, and returns the code once
 * so it can be printed. The person uses it (with their user code) to choose
 * their own password. Used for residents (UserController) and for staff
 * accounts that the Head Staff resets (StaffAccountController).
 */
class ActivationSlipService
{
    public const HOURS = 48;

    /** Makes a new one-time code for the account and returns what the slip shows (once). */
    public function issue(User $user, ?User $issuer = null): array
    {
        $issuer ??= auth()->user();
        $alphabet = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';   // no 0/O, 1/I/L: easy to read from paper
        $code = '';
        for ($i = 0; $i < 12; $i++) {
            $code .= $alphabet[random_int(0, strlen($alphabet) - 1)];
        }
        $expires = now()->addHours(self::HOURS);

        $user->forceFill([
            'password' => null,
            'must_change_password' => false,
            'password_changed_at' => null,
            'activation_code_hash' => Hash::make($code),
            'activation_expires_at' => $expires,
            'activation_failed_attempts' => 0,
            'activation_issued_by' => $issuer?->user_code,
        ])->save();

        // Any session the account still had ends: the old password no longer exists.
        app(SecurityService::class)->revokeSessions($user);

        return [
            'user_code' => $user->user_code,
            'name' => $this->displayName($user),
            'code' => implode('-', str_split($code, 4)),
            'expires_at' => $expires->toIso8601String(),
            // The person who prints the slip (shown on the slip as "Issued by").
            'issued_by' => $issuer ? $this->displayName($issuer) : '',
        ];
    }

    /** "FIRST M. LAST JR." -- capitalised, with the middle initial, as printed on the slip. */
    public function displayName(User $u): string
    {
        $mi = trim((string) $u->middle_name) !== '' ? mb_substr(trim($u->middle_name), 0, 1) . '.' : '';
        $parts = array_filter([trim($u->first_name), $mi, trim($u->last_name), trim((string) $u->suffix)]);
        return mb_strtoupper(implode(' ', $parts));
    }
}
</file>

<file path="app/Support/ActivityLogReport.php">
<?php

namespace App\Support;

use App\Models\ActivityLog;
use App\Models\User;
use Carbon\Carbon;
use Illuminate\Http\Request;

/**
 * The Activity Log Report: the same entries the screen shows for the same filters, with the columns
 * the staff member picked, as one table that both the Excel workbook (drawn in the browser) and the
 * PDF (drawn here) print. One builder, so the two files and the screen can never disagree.
 *
 * Column keys and order are mirrored in resources/js/lib/activityLogExport.ts -- keep them in sync.
 */
final class ActivityLogReport
{
    /** key => [header, relative PDF width, centered]. Printed in this order, whatever order they were ticked. */
    public const COLUMNS = [
        'no'          => ['No.', 5, true],
        'when'        => ['Date and time', 14, false],
        'code'        => ['Staff code', 9, false],
        'staff'       => ['Staff name', 15, false],
        'action'      => ['Action', 9, false],
        'module'      => ['Module', 11, false],
        'description' => ['Description', 34, false],
        'ip'          => ['IP address', 10, false],
    ];

    /** Fewest columns a report may have (the letterhead needs room for the seal and the address block). */
    public const MIN_COLUMNS = 3;

    /** The Excel workbook is drawn in the browser, the PDF by dompdf: both are capped, so narrow the filters beyond this. */
    public const EXCEL_MAX_ROWS = 10000;
    /** Rows per drawn table in the PDF: the report reads as one table, but is laid out in flush pieces of this many to save memory. */
    public const PDF_CHUNK_ROWS = 100;

    /**
     * The PDF is one file, laid out in flush pieces of PDF_CHUNK_ROWS rows. dompdf keeps the whole document in
     * memory (about 300 MB for 2,000 rows of 8 columns), so it is limited by cells (rows x columns): fewer
     * columns means more rows. Anything bigger belongs in the Excel file.
     * Mirrored in lib/activityLogExport.ts (PDF_MAX_CELLS) so the window can warn before downloading.
     */
    public const PDF_MAX_CELLS = 16000;

    public const PERIODS = ['all', 'today', '7d', '30d'];

    /** Validation rules shared by the screen, the Excel and the PDF requests; the report requests also need their columns. */
    public static function rules(bool $withColumns = true): array
    {
        $rules = [
            'search'    => 'nullable|string|max:200',
            'type'      => 'nullable|string|max:30',
            'date'      => 'nullable|date',
            'date_from' => 'nullable|date',
            'date_to'   => 'nullable|date|after_or_equal:date_from',
            'period'    => 'nullable|in:' . implode(',', self::PERIODS),
            'sort'      => 'nullable|in:asc,desc',
            'message'   => 'nullable|boolean',
        ];

        if ($withColumns) {
            $rules['columns'] = ['required', 'array', 'min:' . self::MIN_COLUMNS, 'max:' . count(self::COLUMNS)];
            $rules['columns.*'] = ['string', 'in:' . implode(',', array_keys(self::COLUMNS))];
        }

        return $rules;
    }

    /** Most entries one PDF can hold with this many columns. */
    public static function pdfMaxRows(int $columns): int
    {
        return intdiv(self::PDF_MAX_CELLS, max(1, $columns));
    }

    /** The 422 text when a report is too long for its file type. */
    public static function tooManyMessage(string $format, int $count, int $columns = 0): string
    {
        $max = $format === 'PDF' ? self::pdfMaxRows($columns) : self::EXCEL_MAX_ROWS;

        return 'Too many entries for one ' . $format . ' file (' . number_format($count) . '). Narrow the filters to ' . number_format($max) . ' entries or fewer.';
    }

    /** The filters the screen and the reports share (see ActivityLog::scopeFiltered), with a quick "period" turned into dates. */
    public static function filtersFrom(Request $request): array
    {
        $f = [
            'search'    => $request->input('search'),
            'type'      => $request->input('type'),
            'date'      => $request->input('date'),
            'date_from' => $request->input('date_from'),
            'date_to'   => $request->input('date_to'),
        ];

        // A quick period only fills in a date range when no day or range was chosen -- an explicit date wins.
        if (!$f['date'] && !$f['date_from'] && !$f['date_to']) {
            $today = Carbon::now('Asia/Manila')->startOfDay();
            switch ($request->input('period')) {
                case 'today':
                    $f['date'] = $today->toDateString();
                    break;
                case '7d':
                    [$f['date_from'], $f['date_to']] = [$today->copy()->subDays(6)->toDateString(), $today->toDateString()];
                    break;
                case '30d':
                    [$f['date_from'], $f['date_to']] = [$today->copy()->subDays(29)->toDateString(), $today->toDateString()];
                    break;
            }
        }

        return $f;
    }

    /** Oldest-first only when asked; whitelisted because the value comes from the query string. */
    public static function direction(Request $request): string
    {
        return $request->input('sort') === 'asc' ? 'asc' : 'desc';
    }

    /** "Module: Events · Date: November 13, 2026 · Search: "scan" · Newest first · 128 entries" */
    public static function describe(array $f, string $dir, int $count): string
    {
        $parts = [];

        $type = $f['type'] ?? null;
        if ($type && $type !== 'all' && isset(ActivityLog::MODULE_FILTERS[$type])) {
            $parts[] = 'Module: ' . ActivityLog::MODULE_FILTERS[$type];
        }

        $day = fn (?string $v) => $v ? Carbon::parse($v, 'Asia/Manila')->format('F j, Y') : null;
        if (!empty($f['date'])) {
            $parts[] = 'Date: ' . $day($f['date']);
        } elseif (!empty($f['date_from']) || !empty($f['date_to'])) {
            $parts[] = 'Dates: ' . ($day($f['date_from'] ?? null) ?? 'start') . ' to ' . ($day($f['date_to'] ?? null) ?? 'today');
        }

        $search = trim((string) ($f['search'] ?? ''));
        if ($search !== '') {
            $parts[] = 'Search: "' . mb_substr($search, 0, 100) . '"';
        }

        if (!$parts) {
            array_unshift($parts, 'All activity');
        }
        $parts[] = $dir === 'asc' ? 'Oldest first' : 'Newest first';
        $parts[] = $count . ($count === 1 ? ' entry' : ' entries');

        return implode(' · ', $parts);
    }

    private int $lastId;

    /**
     * @param string[] $columns keys of COLUMNS, any order
     */
    public function __construct(
        private array $filters,
        private string $dir,
        array $columns,
        private bool $withMessage = true,
    ) {
        // Fixed print order, no duplicates, nothing unknown.
        $this->columns = array_values(array_filter(array_keys(self::COLUMNS), fn ($k) => in_array($k, $columns, true)));
        // Freeze the report at "now": entries written while it is built (including the log line for this
        // very export) are not part of it, so the count in the heading always matches the rows.
        $this->lastId = (int) ActivityLog::max('id');
    }

    /** @var string[] */
    private array $columns;

    private function query()
    {
        return ActivityLog::query()->filtered($this->filters)->where('id', '<=', $this->lastId);
    }

    public function count(): int
    {
        return $this->query()->count();
    }

    public function filterLine(int $count): string
    {
        return self::describe($this->filters, $this->dir, $count);
    }

    /**
     * @return array{reportTitle:string, filterSummary:string, printedOn:string, generatedAt:string, message:string[], columns:array<int,array{key:string,label:string}>, rows:array<int,array<int,string>>, total:int}
     */
    public function build(): array
    {
        $names = User::withTrashed()->where('role', 'Staff')
            ->get(['user_code', 'first_name', 'last_name'])
            ->mapWithKeys(fn ($u) => [$u->user_code => trim($u->first_name . ' ' . $u->last_name)]);

        $rows = [];
        $staff = [];
        $modules = [];
        $first = $last = null;
        $n = 0;
        foreach ($this->query()->orderBy('created_at', $this->dir)->orderBy('id', $this->dir)->cursor() as $log) {
            $all = [
                'no'          => (string) ++$n,
                'when'        => optional($log->created_at)->format('M j, Y g:i A') ?? '',
                'code'        => (string) $log->user_code,
                'staff'       => (string) ($names[$log->user_code] ?? ''),
                'action'      => (string) $log->action,
                'module'      => (string) $log->module,
                'description' => (string) $log->description,
                'ip'          => (string) ($log->ip_address ?? ''),
            ];
            $rows[] = array_map(fn ($k) => $all[$k], $this->columns);
            $staff[$log->user_code] = true;
            $modules[$log->module] = true;
            $first ??= $log->created_at;
            $last = $log->created_at;
        }

        $count = count($rows);
        $printedOn = now()->format('F j, Y');

        return [
            'reportTitle'   => 'Activity Log Report',
            'filterSummary' => $this->filterLine($count),
            'printedOn'     => $printedOn,
            'generatedAt'   => now()->format('F j, Y g:i A'),
            'officials'     => BarangayOfficials::current(),
            'message'       => $this->withMessage ? $this->message($count, count($staff), count($modules), $first, $last, $printedOn) : [],
            'columns'       => array_map(fn ($k) => ['key' => $k, 'label' => self::COLUMNS[$k][0]], $this->columns),
            'rows'          => $rows,
            'total'         => $count,
        ];
    }

    /** The optional opening "I. MESSAGE": says only what this report holds, in the words of the Residents report. */
    private function message(int $count, int $staff, int $modules, ?Carbon $first, ?Carbon $last, string $printedOn): array
    {
        $entries = $count . ($count === 1 ? ' entry' : ' entries');
        $fields = array_map(fn ($k) => strtolower(self::COLUMNS[$k][0]), array_values(array_diff($this->columns, ['no'])));
        $fieldList = count($fields) > 1 ? implode(', ', array_slice($fields, 0, -1)) . ' and ' . end($fields) : ($fields[0] ?? '');

        $scope = 'all the activity recorded by staff in the system';
        $applied = $this->appliedFilterText();
        if ($applied !== '') {
            $scope = 'the activity recorded by staff in the system, narrowed by ' . $applied;
        }

        if ($count === 0) {
            $second = "It covers {$entries} ({$scope}), so there is no itemized list.";
        } else {
            $span = $first && $last
                ? ($first->isSameDay($last)
                    ? 'on ' . $first->format('F j, Y')
                    : 'from ' . ($this->dir === 'asc' ? $first : $last)->format('F j, Y') . ' to ' . ($this->dir === 'asc' ? $last : $first)->format('F j, Y'))
                : '';
            $second = "It covers {$entries} ({$scope}), written by {$staff} staff " . ($staff === 1 ? 'member' : 'members')
                . " in {$modules} " . ($modules === 1 ? 'module' : 'modules') . ", recorded {$span}, listed "
                . ($this->dir === 'asc' ? 'oldest' : 'newest') . ' first' . ($fieldList !== '' ? " with their {$fieldList}" : '') . '.';
        }

        return [
            "This Activity Log Report is prepared by the Barangay Piao office through the Piao Connect system to present the actions recorded by staff in the system as of {$printedOn}.",
            $second,
            "All information is taken directly from the activity log of Piao Connect as of {$printedOn} and is respectfully submitted for the information and guidance of the Barangay Council.",
        ];
    }

    /** "module Events; the date November 13, 2026; the search "scan"" -- only the filters actually on. */
    private function appliedFilterText(): string
    {
        $f = $this->filters;
        $parts = [];
        $type = $f['type'] ?? null;
        if ($type && $type !== 'all' && isset(ActivityLog::MODULE_FILTERS[$type])) {
            $parts[] = 'module ' . ActivityLog::MODULE_FILTERS[$type];
        }
        $day = fn (?string $v) => $v ? Carbon::parse($v, 'Asia/Manila')->format('F j, Y') : null;
        if (!empty($f['date'])) {
            $parts[] = 'the date ' . $day($f['date']);
        } elseif (!empty($f['date_from']) || !empty($f['date_to'])) {
            $parts[] = 'the dates ' . ($day($f['date_from'] ?? null) ?? 'the start') . ' to ' . ($day($f['date_to'] ?? null) ?? 'today');
        }
        $search = trim((string) ($f['search'] ?? ''));
        if ($search !== '') {
            $parts[] = 'the search "' . mb_substr($search, 0, 100) . '"';
        }

        return implode('; ', $parts);
    }
}
