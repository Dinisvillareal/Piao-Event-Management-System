            if (!empty($data['current_statuses'])) {
                $ids = collect($data['current_statuses'])
                    ->map(fn ($label) => $currentStatusIds[$label] ?? null)
                    ->filter()
                    ->values();
                if ($ids->isNotEmpty()) {
                    $user->currentStatuses()->attach($ids);
                }
            }

