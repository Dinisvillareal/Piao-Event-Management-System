<file path="resources/css/app.css">
@import url('https://fonts.googleapis.com/css2?family=Lexend:wght@600;700;800&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/* Piao design system — base surface + text color. Individual pages still
   set their own backgrounds in places; this just keeps the default (and
   anything that doesn't) on the warm-paper canvas instead of pure white. */
html, body {
  background-color: #F8F5EF;
  color: #1A1A1A;
}

/* Defaults for the print-only "Page X of Y" footer's two words (see the
   @page rule below). ReportsView.tsx overwrites these on <html> to match
   whichever language is selected -- these English defaults are what a
   print preview would show before that effect has run, or for any future
   page that prints without setting them. */
:root {
  --print-page-word: "Page";
  --print-of-word: "of";
}

/* Tailwind's Preflight resets font-family to `inherit` on <select>,
   <input>, <button>, <textarea> -- but it can't reach into a file input's
   native "Choose File" button, which lives in a browser shadow root
   (::file-selector-button / the older WebKit ::-webkit-file-upload-button).
   Left alone, that button renders in the OS UI font (e.g. Segoe UI on
   Windows) instead of the app's Public Sans, which is what made the ID
   Photo field on Add/Edit Resident look like it belonged to a different
   app. Forcing it to inherit keeps every control on the same typeface. */
input[type="file"]::file-selector-button,
input[type="file"]::-webkit-file-upload-button {
  font-family: inherit;
}

/* Edge/Chromium draws its own "reveal password" eye icon inside
   type="password" fields (::-ms-reveal). It renders as a dark icon by
   default, which disappears against the app's dark navy password inputs
   (Settings' Change Password, Login). Inverting it turns it white so it's
   actually visible on the dark background. */
input[type="password"]::-ms-reveal {
  filter: invert(1);
}

/* Browsers skip background colors/gradients when printing by default (an
   ink-saving default called "Background graphics" in the print dialog),
   which is why the Reports stat cards' sage/gold/teal/terracotta gradients
   were coming out flat gray on a printed page even though every other
   print: style worked fine. Forcing exact color adjustment app-wide makes
   printed pages render backgrounds exactly as designed, without asking
   every user to dig up their browser's "Background graphics" checkbox. */
@media print {
  * {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
    color-adjust: exact !important;
  }

  /* The warm-paper canvas above (#F8F5EF) is a screen-only touch. Forcing
     exact color adjustment for print (so the Reports gradients show up)
     also means this app-wide background would otherwise print too --
     filling the page, and any leftover forced-height space past the
     content, with a beige wash instead of plain white paper. */
  html, body {
    background-color: #fff !important;
  }

  /* A bordered/rounded card that's too tall to fit the rest of a page
     still has to break somewhere, even with break-inside-avoid on it and
     on each item inside it (that only protects individual pieces, not an
     overall section once it's genuinely longer than one page). Left alone,
     the browser's default box-decoration-break: slice treats a split box
     as one shape sliced in two -- so the fragment on the first page has no
     bottom border/rounded corner, and the one that continues on the next
     page has no top border/rounded corner, reading as an "open" cut. Clone
     gives EVERY fragment its own complete border and rounded corners, so
     a page break always lands on a closed-off box rather than an open one.
     Reports is the only screen that prints, so scoping this to the border
     radii its cards use is safe app-wide. */
  .rounded-\[30px\],
  .rounded-2xl,
  .rounded-xl {
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
}

/* "Page X of Y" printed on every physical sheet, in the page's own bottom
   margin (not part of the report content, so it never collides with a
   card or gets caught by a break-inside-avoid rule). This is the browser's
   native CSS Paged Media margin-box feature -- no PDF library, no JS
   pagination polyfill, just an @page rule, consistent with the rest of
   this app's printing being plain window.print(). Reports is the only
   screen that calls window.print(), so this is scoped safely at the
   stylesheet root without needing a page-specific class. */
@page {
  margin: 14mm 12mm 18mm 12mm;
  @bottom-right {
    content: var(--print-page-word) " " counter(page) " " var(--print-of-word) " " counter(pages);
    font-family: "Public Sans", sans-serif;
    font-size: 9px;
    color: #667777;
  }
}
</file>

<file path="resources/js/components/ui/Charts.tsx">
import React from "react";
import { useLanguage } from "../../i18n/LanguageContext";

/**
 * Small dependency-free SVG chart primitives for the Reports & Analytics
 * view (adviser recommendation: "Filtering — Date, Summary — Attendance,
 * Percentage" + "What Events usually happen per year"). Kept intentionally
 * simple (no charting library) so the dashboard stays visual — cards +
 * charts — rather than another data table.
 */

const TEAL = "#005f63";
const TEAL_LIGHT = "#3ec5c5";
const ORANGE = "#ff7a28";

export function BarChart({
  data,
  color = TEAL,
  height = 180,
  valueSuffix = "",
  dark = false,
}: {
  data: { label: string; value: number }[];
  color?: string;
  height?: number;
  valueSuffix?: string;
  // Same on-dark-navy-background variant used throughout the redesigned
  // pages -- only recolors this chart's own text, the bars keep whatever
  // `color` the caller passes.
  dark?: boolean;
}) {
  const { t } = useLanguage();
  const max = Math.max(1, ...data.map((d) => d.value));

  if (data.length === 0) {
    return <p className={`text-sm italic py-8 text-center ${dark ? "text-white/40 print:text-gray-400" : "text-gray-400"}`}>{t("uiNoDataForFilters")}</p>;
  }

  return (
    <div className="w-full overflow-x-auto">
      <div className="flex items-end gap-3 sm:gap-4 min-w-max px-1" style={{ height }}>
        {data.map((d, i) => {
          const barHeight = Math.max(4, (d.value / max) * (height - 40));
          return (
            <div key={i} className="flex flex-col items-center justify-end w-10 sm:w-12 shrink-0" style={{ height }}>
              {/* dark's white text is invisible once this chart prints on a
                  white page (Reports, via print:bg-white cards) -- give it
                  a print-only dark color like every other dark-mode label
                  in ReportsView already has, instead of vanishing on paper. */}
              <span className={`text-[11px] font-bold mb-1 ${dark ? "text-white print:text-gray-700" : "text-gray-700"}`}>{d.value}{valueSuffix}</span>
              <div
                className="w-full rounded-t-lg transition-all duration-300"
                style={{ height: barHeight, background: color }}
                title={`${d.label}: ${d.value}${valueSuffix}`}
              />
              <span className={`mt-2 text-[10px] text-center leading-tight break-words w-full ${dark ? "text-white/45 print:text-gray-500" : "text-gray-500"}`}>{d.label}</span>
            </div>
          );
        })}
      </div>
    </div>
  );
}

export function DonutChart({
  percentage,
  size = 140,
  stroke = 16,
  label,
  color = TEAL,
  trackColor,
  dark = false,
}: {
  percentage: number;
  size?: number;
  stroke?: number;
  label?: string;
  color?: string;
  trackColor?: string;
  // Same on-dark-navy-background variant used throughout the redesigned
  // pages -- recolors the track ring and label text; the progress color
  // itself stays caller-controlled.
  dark?: boolean;
}) {
  const radius = (size - stroke) / 2;
  const circumference = 2 * Math.PI * radius;
  const clamped = Math.max(0, Math.min(100, percentage));
  const offset = circumference - (clamped / 100) * circumference;
  const resolvedTrackColor = trackColor ?? (dark ? "rgba(255,255,255,0.1)" : "#eef2f2");

  return (
    <div className="flex flex-col items-center gap-2">
      <div className="relative" style={{ width: size, height: size }}>
        <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`}>
          <circle cx={size / 2} cy={size / 2} r={radius} fill="none" stroke={resolvedTrackColor} strokeWidth={stroke} />
          <circle
            cx={size / 2}
            cy={size / 2}
            r={radius}
            fill="none"
            stroke={color}
            strokeWidth={stroke}
            strokeDasharray={circumference}
            strokeDashoffset={offset}
            strokeLinecap="round"
            transform={`rotate(-90 ${size / 2} ${size / 2})`}
            style={{ transition: "stroke-dashoffset 0.4s ease" }}
          />
        </svg>
        <div className="absolute inset-0 flex items-center justify-center">
          <span className="text-2xl font-black" style={{ color }}>{clamped.toFixed(0)}%</span>
        </div>
      </div>
      {/* Same print-invisibility issue as BarChart's labels above -- dark's
          white text disappeared once this donut printed on Reports' white
          page, which is what made the attendance breakdown look unlabeled
          on the printed report. */}
      {label && <span className={`text-xs font-medium text-center ${dark ? "text-white/60 print:text-gray-600" : "text-gray-600"}`}>{label}</span>}
    </div>
  );
}

export { TEAL, TEAL_LIGHT, ORANGE };
</file>

