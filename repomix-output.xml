<file path="resources/js/pages/staff/views/NotificationsView.tsx">
import SpeedDial from "../../../components/ui/SpeedDial";
import useFilterSwitching from "../../../hooks/useFilterSwitching";
import React, { useState, useEffect, useMemo, useRef } from "react";
import { Filter, Users, Bell, X, Send, MapPin, Calendar, Clock, MessageSquare, FileText, Smartphone, Home } from "lucide-react";
import SearchBar from "../../../components/ui/SearchBar";
import FilterBar from "../../../components/ui/FilterBar";
import Skeleton from "../../../components/ui/Skeleton";
import api from "../../../lib/api";
import { useLanguage } from "../../../i18n/LanguageContext";
import FeedbackAlertsPanel from "../components/FeedbackAlertsPanel";
import { useStaffAlertsUnread } from "../../../lib/staffAlertsStore";
import Portal from "../../../components/ui/Portal";


interface Membership {
   id: string | number;
   name: string;
   description: string;
}


interface Event {
   id: number;
   name: string;
   description?: string;
   event_start: string;
   event_end?: string;
   location?: string;
   membership_ids: number[];
}


interface Notification {
   id: number;
   title: string;
   message: string;
   created_at: string;
   is_updated: boolean;
   updated_at_notification: string | null;
   target_name: string;
   target_membership_id: number | null;
   recipient_count: number;
   read: boolean;
   event?: Event;
}


interface NotificationsViewProps {
   // Which tab to show (the bell's "See all" asks for "feedback"); nonce makes repeat requests count.
   initialTab?: { tab: "notifications" | "sms" | "feedback"; nonce: number } | null;
   memberships?: Membership[];
   highlightText: (text: string, query: string) => React.ReactNode;
}


export default function NotificationsView({ memberships = [], highlightText, initialTab = null }: NotificationsViewProps) {
                       const { t, locale } = useLanguage();
   const [allNotifications, setAllNotifications] = useState<Notification[]>([]);
   const [loading, setLoading] = useState<boolean>(true);
   const [searchQuery, setSearchQuery] = useState<string>("");
   const [dateFilter, setDateFilter] = useState<string>("all");
   const [targetFilter, setTargetFilter] = useState<string>("all-residents");
   const [currentPage, setCurrentPage] = useState<number>(1);
   // Brief skeleton flash on every page switch, same as Activity Logs --
   // this list paginates client-side so there's nothing to actually wait
   // on, but the flash keeps page switches feeling consistent app-wide.
   const [pageSwitchingRaw, setPageSwitching] = useState(false);
   const filterSwitching = useFilterSwitching([searchQuery, dateFilter, targetFilter]);
   const pageSwitching = pageSwitchingRaw || filterSwitching;
   const pageSwitchTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
   const goToPage = (updater: number | ((p: number) => number)) => {
       setCurrentPage(updater as any);
       setPageSwitching(true);
       if (pageSwitchTimer.current) clearTimeout(pageSwitchTimer.current);
       pageSwitchTimer.current = setTimeout(() => setPageSwitching(false), 0);
   };
   useEffect(() => () => { if (pageSwitchTimer.current) clearTimeout(pageSwitchTimer.current); }, []);
   const [selectedNotification, setSelectedNotification] = useState<Notification | null>(null);
   const itemsPerPage = 10;


   // Search, date, audience and paging are all done by the server (NotificationController::staffNotifications).
   const [totalMatching, setTotalMatching] = useState<number>(0);
   const [lastPage, setLastPage] = useState<number>(1);
   const [allTotal, setAllTotal] = useState<number>(0);
   const notifSeq = useRef(0);
   const fetchNotifications = async (): Promise<void> => {
       const seq = ++notifSeq.current;
       setLoading(true);
       try {
           const response = await api.get('/notifications/staff', {
               params: {
                   search: searchQuery.trim() || undefined,
                   date_filter: dateFilter,
                   target_membership_id: targetFilter,
                   page: currentPage,
                   per_page: itemsPerPage,
               },
           });
           if (seq !== notifSeq.current) return;
           const data = response.data;
           if ((data.last_page ?? 1) < currentPage) {
               setCurrentPage(Math.max(1, data.last_page));
               return;
           }
           setAllNotifications(Array.isArray(data) ? data : (data.data || []));
           setTotalMatching(data.total ?? 0);
           setLastPage(data.last_page ?? 1);
           setAllTotal(data.all_total ?? data.total ?? 0);
       } catch (error) {
           if (seq === notifSeq.current) console.error('Error fetching notifications:', error);
       } finally {
           if (seq === notifSeq.current) setLoading(false);
       }
   };

   // A new search / filter starts again from page 1.
   const notifFilterKey = `${searchQuery}|${dateFilter}|${targetFilter}`;
   const prevNotifFilterKey = useRef(notifFilterKey);
   useEffect(() => {
       if (prevNotifFilterKey.current !== notifFilterKey) {
           prevNotifFilterKey.current = notifFilterKey;
           if (currentPage !== 1) { setCurrentPage(1); return; }
       }
       const timer = setTimeout(fetchNotifications, 120);
       return () => clearTimeout(timer);
       // eslint-disable-next-line react-hooks/exhaustive-deps
   }, [notifFilterKey, currentPage]);

   // Adviser recommendation: "Notify by household — head of household — SMS
   // contact number per household" — a staff-facing view of what was sent.
   const [smsLogs, setSmsLogs] = useState<any[]>([]);
   const [smsLoading, setSmsLoading] = useState<boolean>(true);
   const [smsPage, setSmsPage] = useState<number>(1);
   const [smsLastPage, setSmsLastPage] = useState<number>(1);
   const [smsTotal, setSmsTotal] = useState<number>(0);
   const smsPerPage = 10;
   // Search + status filter are applied on the server (the list is paginated).
   const [smsSearch, setSmsSearch] = useState("");
   const [smsSearchApplied, setSmsSearchApplied] = useState("");
   const [smsStatus, setSmsStatus] = useState("all");
   const [smsAllTotal, setSmsAllTotal] = useState<number>(0);
   const smsReq = useRef(0);
   // Notifications | Household SMS -- same pill switcher as Returns.
   const [activeTab, setActiveTab] = useState<"notifications" | "sms" | "feedback">(initialTab?.tab ?? "notifications");
   const feedbackUnread = useStaffAlertsUnread();
   useEffect(() => { if (initialTab) setActiveTab(initialTab.tab); }, [initialTab?.nonce]); // eslint-disable-line react-hooks/exhaustive-deps
   // Switching tabs flashes the skeleton briefly, same as a page switch.
   const switchTab = (tab: "notifications" | "sms" | "feedback") => {
       if (tab === activeTab) return;
       setActiveTab(tab);
       setPageSwitching(true);
       if (pageSwitchTimer.current) clearTimeout(pageSwitchTimer.current);
       pageSwitchTimer.current = setTimeout(() => setPageSwitching(false), 0);
   };

   // Server-paginated: each page is its own request, so the skeleton shows
   // while the next page loads.
   const fetchSmsLogs = async (page: number): Promise<void> => {
       const req = ++smsReq.current;
       setSmsLoading(true);
       try {
           const params: Record<string, string | number> = { per_page: smsPerPage, page };
           if (smsSearchApplied) params.search = smsSearchApplied;
           if (smsStatus !== "all") params.status = smsStatus;
           const response = await api.get('/notifications/sms-logs', { params });
           if (req !== smsReq.current) return; // a newer request superseded this one
           const data = response.data;
           const total = Array.isArray(data) ? data.length : (typeof data.total === 'number' ? data.total : (data.data || []).length);
           setSmsLogs(Array.isArray(data) ? data : (data.data || []));
           setSmsLastPage(Array.isArray(data) ? 1 : (data.last_page || 1));
           setSmsTotal(total);
           if (!smsSearchApplied && smsStatus === "all") setSmsAllTotal(total);
       } catch (error) {
           console.error('Error fetching SMS logs:', error);
       } finally {
           if (req === smsReq.current) setSmsLoading(false);
       }
   };

   // Typing waits a moment before asking the server; any change goes back to page 1.
   useEffect(() => {
       const id = setTimeout(() => setSmsSearchApplied(smsSearch.trim()), 300);
       return () => clearTimeout(id);
   }, [smsSearch]);
   useEffect(() => { setSmsPage(1); }, [smsSearchApplied, smsStatus]);

   useEffect(() => {
       fetchSmsLogs(smsPage);
   }, [smsPage, smsSearchApplied, smsStatus]); // eslint-disable-line react-hooks/exhaustive-deps


   const filteredNotifications = { length: totalMatching };
   const totalPages = lastPage;
   const paginatedNotifications = allNotifications;


   // For card view: DD/MM/YYYY
   const formatDateCard = (dateStr: string): string => {
       const d = new Date(dateStr);
       const day = String(d.getDate()).padStart(2, '0');
       const month = String(d.getMonth() + 1).padStart(2, '0');
       const year = d.getFullYear();
       return `${day}/${month}/${year}`;
   };


   // For modal view: DD MMM YYYY, HH:MM am/pm
   const formatDateModal = (dateStr: string): string => {
       const d = new Date(dateStr);
       const day = String(d.getDate()).padStart(2, '0');
       const month = d.toLocaleString(locale, { month: 'short' });
       const year = d.getFullYear();
       const time = d.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit', hour12: true });
       return `${day} ${month} ${year}, ${time}`;
   };


   // Format event date for modal display (without time)
   const formatEventDate = (dateStr: string): string => {
       const d = new Date(dateStr);
       const day = String(d.getDate()).padStart(2, '0');
       const month = d.toLocaleString(locale, { month: 'short' });
       const year = d.getFullYear();
       return `${day} ${month} ${year}`;
   };


   // Format event time for modal display
   const formatEventTime = (dateStr: string): string => {
       const d = new Date(dateStr);
       return d.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit', hour12: true });
   };


   const parseMessage = (notification: Notification): { title: string; actualMessage: string } => {
       const message = notification.message;


       const parts = message.split(' • ');
       if (parts.length >= 2) {
           const rest = parts.slice(1).join(' • ');


           if (rest.includes(' — ')) {
               const restParts = rest.split(' — ');
               const title = restParts[0];
               const actualMessage = restParts.slice(1).join(' — ');
               return { title, actualMessage };
           }
           return { title: rest, actualMessage: '' };
       }
       return { title: message, actualMessage: '' };
   };


   const dateFilterOptions = [
       { value: "all", label: t("allNotifications") },
       { value: "upcoming", label: t("upcomingOption") },
       { value: "past", label: t("pastOption") },
   ];

   const targetFilterOptions = useMemo(() => [
       { value: "all-residents", label: t("allResidentsOption") },
       ...memberships
           .slice()
           .sort((a: Membership, b: Membership) => a.name.localeCompare(b.name))
           .map((m: Membership) => ({ value: String(m.id), label: m.name })),
   ], [memberships, t]);

   return (
       <div className="-m-3 sm:-m-6 h-[calc(100dvh-73px)] dash-canvas p-4 sm:p-8 flex flex-col relative overflow-y-auto lg:overflow-visible">
           {/* Fixed Header - Never scrolls */}
           <div className="flex-shrink-0 pb-6 shadow-b-sm max-sm:flex max-sm:flex-col max-sm:pb-3">
               <div className="dash-card flex items-center justify-between rounded-[32px] p-5 sm:p-6 max-sm:order-[-2]">
                   <div>
                       <h1 className="font-display text-3xl font-extrabold tracking-tight sm:text-4xl page-title-gradient page-title-fit">{t("notificationsAndAnnouncements")}</h1>
                       <p className="mt-1.5 text-sm text-white/50 max-w-xl">{t("staffNotificationsSubtitle")}</p>
                   </div>
               </div>


               {/* Flow switcher -- same pill buttons as Returns */}
               <SpeedDial
                   value={activeTab}
                   items={[
                       { key: "notifications", label: t("notify"), icon: Bell, count: loading && allTotal === 0 ? 0 : allTotal, onSelect: () => switchTab("notifications") },
                       { key: "sms", label: t("householdSmsDeliveries"), icon: Smartphone, count: smsAllTotal, onSelect: () => switchTab("sms") },
                       { key: "feedback", label: t("alertsTabLabel"), icon: MessageSquare, count: feedbackUnread, onSelect: () => switchTab("feedback") },
                   ]}
               />
               <div className="mt-4 flex flex-wrap items-center gap-2.5 max-sm:hidden">
                   <button
                       type="button"
                       onClick={() => switchTab("notifications")}
                       title={t("notify")}
                       aria-label={t("notify")}
                       className={`inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm font-bold transition max-sm:gap-2 max-sm:px-5 max-sm:py-3 ${
                           activeTab === "notifications"
                               ? "bg-gradient-to-r from-[#0B0F14] to-[#18212B] text-white shadow-sm"
                               : "dash-card text-white/60 hover:text-white"
                       }`}
                   >
                       <Bell className="h-4 w-4 max-sm:h-5 max-sm:w-5" />
                       <span className="max-sm:hidden">{t("notify")}</span>
                       <span className={`inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full px-1.5 text-[11px] font-bold ${activeTab === "notifications" ? "bg-white/20 text-white" : "bg-white/10 text-white/70"}`}>
                           {loading && allTotal === 0 ? 0 : allTotal}
                       </span>
                   </button>
                   <button
                       type="button"
                       onClick={() => switchTab("sms")}
                       title={t("householdSmsDeliveries")}
                       aria-label={t("householdSmsDeliveries")}
                       className={`inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm font-bold transition max-sm:gap-2 max-sm:px-5 max-sm:py-3 ${
                           activeTab === "sms"
                               ? "bg-gradient-to-r from-[#0B0F14] to-[#18212B] text-white shadow-sm"
                               : "dash-card text-white/60 hover:text-white"
                       }`}
                   >
                       <Smartphone className="h-4 w-4 max-sm:h-5 max-sm:w-5" />
                       <span className="max-sm:hidden">{t("householdSmsDeliveries")}</span>
                       <span className={`inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full px-1.5 text-[11px] font-bold ${activeTab === "sms" ? "bg-white/20 text-white" : "bg-white/10 text-white/70"}`}>
                           {smsAllTotal}
                       </span>
                   </button>
                   <button
                       type="button"
                       onClick={() => switchTab("feedback")}
                       title={t("alertsTabLabel")}
                       aria-label={t("alertsTabLabel")}
                       className={`inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm font-bold transition max-sm:gap-2 max-sm:px-5 max-sm:py-3 ${
                           activeTab === "feedback"
                               ? "bg-gradient-to-r from-[#0B0F14] to-[#18212B] text-white shadow-sm"
                               : "dash-card text-white/60 hover:text-white"
                       }`}
                   >
                       <MessageSquare className="h-4 w-4 max-sm:h-5 max-sm:w-5" />
                       <span className="max-sm:hidden">{t("alertsTabLabel")}</span>
                       {feedbackUnread > 0 && (
                           <span className={`inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full px-1.5 text-[11px] font-bold ${activeTab === "feedback" ? "bg-white/20 text-white" : "bg-white/10 text-white/70"}`}>
                               {feedbackUnread > 99 ? "99+" : feedbackUnread}
                           </span>
                       )}
                   </button>
               </div>

               {activeTab === "feedback" ? null : activeTab === "notifications" ? (<>
               <div className="dash-card tight-after mt-4 rounded-[28px] p-3 sm:p-4 max-sm:order-[-1]">
                   <FilterBar
                       search={{ value: searchQuery, onChange: setSearchQuery, placeholder: t("searchNotificationsPlaceholder") }}
                       filters={[
                           { key: "when", label: t("fltWhen"), value: dateFilter, onChange: setDateFilter, options: dateFilterOptions },
                           {
                               key: "to", label: t("toColon").replace(":", ""), value: targetFilter, defaultValue: "all-residents", onChange: setTargetFilter,
                               options: targetFilterOptions, searchable: true, minWidthClass: "min-w-[200px]",
                               icon: <Users className="absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-[#4FBEB0] pointer-events-none" />,
                           },
                       ]}
                       count={loading ? undefined : { shown: filteredNotifications.length }}
                   />
               </div>

               <p className="mt-2 text-xs text-white/40 max-sm:order-[-1] max-sm:mt-0">{t("showingPerPage").replace("{n}", String(itemsPerPage))}</p>


               {/* ✅ PAGINATION - ← 1 → STYLE */}
               <div className="flex justify-end mt-4 max-sm:mt-0">
                   {totalPages > 1 && ((pageSwitching || loading) ? null : (
                       <div className="flex items-center gap-2">
                           <button
                               onClick={() => goToPage(p => Math.max(1, p - 1))}
                               disabled={currentPage === 1}
                               className="dash-tile h-8 w-8 rounded-full text-white/70 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed hover:bg-white/[0.08] transition-all active:scale-95"
                           >
                               ←
                           </button>

                           <span className="h-8 w-8 rounded-full bg-gradient-to-r from-[#0B0F14] to-[#18212B] text-white shadow-sm flex items-center justify-center text-sm font-semibold">
                               {currentPage}
                           </span>

                           <button
                               onClick={() => goToPage(p => Math.min(totalPages, p + 1))}
                               disabled={currentPage === totalPages}
                               className="dash-tile h-8 w-8 rounded-full text-white/70 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed hover:bg-white/[0.08] transition-all active:scale-95"
                           >
                               →
                           </button>
                       </div>
                   ))}
               </div>
               </>) : (<>
               <div className="dash-card tight-after mt-4 rounded-[28px] p-3 sm:p-4 max-sm:order-[-1]">
                   <FilterBar
                       search={{ value: smsSearch, onChange: setSmsSearch, placeholder: t("smsSearchPlaceholder") }}
                       filters={[{
                           key: "sms-status", label: t("statusColumn"), value: smsStatus, onChange: setSmsStatus,
                           options: [
                               { value: "all", label: t("smsStatusAll") },
                               { value: "sent", label: t("smsStatusSent") },
                               { value: "failed", label: t("smsStatusFailed") },
                               { value: "simulated", label: t("smsStatusLogged") },
                           ],
                       }]}
                       count={smsLoading ? undefined : { shown: smsTotal }}
                   />
               </div>

               {/* PAGINATION - ← 1 → STYLE (SINGLE NUMBER, RIGHT ALIGNED) */}
               <p className="mt-4 text-xs text-white/40 max-sm:order-[-1] max-sm:mt-0">{t("showingPerPage").replace("{n}", String(smsPerPage))}</p>
               <div className="flex justify-end mt-4 max-sm:mt-0">
                   {smsLastPage > 1 && ((smsLoading || pageSwitching) ? null : (
                       <div className="flex items-center gap-2">
                           <button
                               onClick={() => setSmsPage(p => Math.max(1, p - 1))}
                               disabled={smsPage === 1}
                               className="dash-tile h-8 w-8 rounded-full text-white/70 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed hover:bg-white/[0.08] transition-all active:scale-95"
                           >
                               ←
                           </button>
                           <span className="h-8 w-8 rounded-full bg-gradient-to-r from-[#0B0F14] to-[#18212B] text-white shadow-sm flex items-center justify-center text-sm font-bold">
                               {smsPage}
                           </span>
                           <button
                               onClick={() => setSmsPage(p => Math.min(smsLastPage, p + 1))}
                               disabled={smsPage === smsLastPage}
                               className="dash-tile h-8 w-8 rounded-full text-white/70 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed hover:bg-white/[0.08] transition-all active:scale-95"
                           >
                               →
                           </button>
                       </div>
                   ))}
               </div>
               </>)}
           </div>


           {/* Scrollable content area - only the list scrolls */}
           {activeTab === "feedback" ? (
           <div className="lg:flex-1 lg:min-h-0 lg:overflow-hidden">
               <FeedbackAlertsPanel />
           </div>
           ) : activeTab === "notifications" ? (
           <div className="lg:flex-1 lg:overflow-y-auto pb-4">
               {pageSwitching || loading ? (
                   <div className="space-y-3">
                       {Array.from({ length: 4 }).map((_, i) => (
                           <Skeleton key={i} className="h-20 rounded-2xl sm:rounded-3xl" />
                       ))}
                   </div>
               ) : filteredNotifications.length === 0 ? (
                   <div className="dash-tile rounded-[28px] border border-dashed border-white/15 p-10 text-center text-white/50">
                       <Bell size={40} className="mx-auto mb-3 text-white/20" />
                       <p>{t("noNotificationsMatch")}</p>
                   </div>
               ) : (
                   <div className="space-y-3">
                       {paginatedNotifications.map((n) => {
                           const parsed = parseMessage(n);
                           const cancelledName = (n as any).type === 'event_deleted' ? ((n.title || '').split(/Event Cancelled:\s*/i)[1] || '').trim() : '';
                           const title = cancelledName || parsed.title;
                           const actualMessage = cancelledName ? t("notifCancelledMsg") : parsed.actualMessage;
                           const targetText = n.target_name || t("allResidentsOption");


                           return (
                               <div
                                   key={n.id}
                                   onClick={() => setSelectedNotification(n)}
                                   className="cursor-pointer relative dash-card rounded-[28px] px-5 sm:px-6 py-5 sm:py-6 transition-all duration-250 ease-out hover:-translate-y-1 hover:border-[#4FBEB0]/60 active:translate-y-0 active:scale-[0.985] active:shadow-none active:duration-100"
                               >
                                   <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 w-full">
                                       <div className="flex-1 min-w-0">
