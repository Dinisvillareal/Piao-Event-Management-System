          <p className="text-[13px] font-semibold uppercase tracking-[0.2em] text-white/50">
            {t("loginPortalEyebrow")}
          </p>
          <h1 className="mt-3 font-display text-[36px] font-extrabold uppercase tracking-tight text-white sm:text-[46px]">
