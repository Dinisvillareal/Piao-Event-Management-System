  const lastRow = r;

  ws.pageSetup = {
    paperSize: 9,
    orientation: LAST_COL <= 5 ? "portrait" : "landscape",
    fitToPage: true,
    fitToWidth: 1,
    fitToHeight: 0,
    horizontalCentered: true,
    margins: { left: 0.4, right: 0.4, top: 0.6, bottom: 0.7, header: 0.3, footer: 0.3 },
    printArea: `A1:${String.fromCharCode(64 + LAST_COL)}${lastRow}`,
