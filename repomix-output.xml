<file path="tests/Feature/FeedbackNotificationsTest.php">
<?php

namespace Tests\Feature;

use App\Models\Event;
use App\Models\EventAttendance;
use App\Models\Notification;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Facades\DB;
use Tests\Support;
use Tests\TestCase;

/**
 * The staff bell, the Notifications page and the member's inbox read feedback notifications by
 * their shape and word them in the reader's own language, so the shape has to stay put.
 */
class FeedbackNotificationsTest extends TestCase
{
    use RefreshDatabase, Support;

    private function resident(string $first = 'Maria', string $last = 'Santos')
    {
        return $this->makeUser('Resident', ['first_name' => $first, 'last_name' => $last]);
    }

    private function attendedEvent($resident): Event
    {
        $e = Event::create(['name' => 'Assembly', 'description' => 'x', 'location' => 'Hall', 'event_start' => now()->subHours(3), 'event_end' => now()->subHour()]);
        EventAttendance::create(['event_id' => $e->id, 'user_id' => $resident->id, 'time_in' => now()->subHours(4), 'time_out' => now()->subMinutes(30), 'status' => 'Complete']);

        return $e;
    }

    private function missedEvent(): Event
    {
        return Event::create(['name' => 'Clean-up Drive', 'description' => 'x', 'location' => 'Hall', 'event_start' => now()->subDays(3), 'event_end' => now()->subDays(2)]);
    }

    public function test_a_rating_reaches_staff_with_the_name_the_score_and_the_comment(): void
    {
        $staff = $this->staff();
        $maria = $this->resident();
        $e = $this->attendedEvent($maria);

        $this->actingAs($maria)->postJson('/feedback', ['event_id' => $e->id, 'rating' => 4, 'comment' => 'Well organised'])->assertStatus(201);

        $row = $this->actingAs($staff)->getJson('/staff/alerts')->assertOk()->json('data.0');
        $this->assertSame('Maria Santos sent feedback', $row['title']);
        $this->assertSame(4, $row['rating']);
        $this->assertSame('Well organised', $row['comment']);
        $this->assertSame('rating', $row['kind']);
        $this->assertSame('Assembly', $row['event_name']);
    }

    public function test_an_edited_rating_says_updated_not_sent(): void
    {
        $staff = $this->staff();
        $maria = $this->resident();
        $e = $this->attendedEvent($maria);

        $this->actingAs($maria)->postJson('/feedback', ['event_id' => $e->id, 'rating' => 4])->assertStatus(201);
        $this->actingAs($maria)->postJson('/feedback', ['event_id' => $e->id, 'rating' => 2, 'comment' => 'Changed my mind'])->assertOk();

        $titles = collect($this->actingAs($staff)->getJson('/staff/alerts')->json('data'))->pluck('title')->all();
        $this->assertContains('Maria Santos sent feedback', $titles);
        $this->assertContains('Maria Santos updated their feedback', $titles);
    }

    public function test_a_reason_for_not_attending_lands_in_the_reasons_tab_with_its_label(): void
    {
        $staff = $this->staff();
        $pedro = $this->resident('Pedro', 'Cruz');
        $e = $this->missedEvent();

        $this->actingAs($pedro)->postJson('/feedback/absence', ['event_id' => $e->id, 'reason' => 'sick', 'comment' => 'Fever'])->assertStatus(201);

        $row = $this->actingAs($staff)->getJson('/staff/alerts')->json('data.0');
        $this->assertSame('Pedro Cruz sent a reason for not attending', $row['title']);
        $this->assertSame('absence', $row['kind']);
        $this->assertSame('Sick or unwell', $row['absence_reason'], 'the screens map this label back to the reader\'s language');
        $this->assertSame('Fever', $row['comment']);

        $all = $this->actingAs($staff)->getJson('/staff/alerts/all')->json('counts');
        $this->assertSame(['rating' => 0, 'absence' => 1], $all);
    }

    public function test_a_heart_and_a_reply_reach_the_member_with_the_event_and_the_reply(): void
    {
        $staff = $this->staff();
        $maria = $this->resident();
        $e = $this->attendedEvent($maria);
        $f = $this->actingAs($maria)->postJson('/feedback', ['event_id' => $e->id, 'rating' => 5])->json('feedback.id');

        $this->actingAs($staff)->putJson("/feedback/rating/{$f}/like")->assertOk();
        $this->actingAs($staff)->putJson("/feedback/rating/{$f}/reply", ['reply' => 'Salamat po!'])->assertOk();

        $items = collect($this->actingAs($maria)->getJson('/notifications/replies')->json('new'))->keyBy('kind');
        $this->assertSame('Barangay staff liked your feedback', $items['like']['title']);
        $this->assertSame('feedback', $items['like']['target']);
        $this->assertSame('Barangay staff replied to your feedback', $items['reply']['title']);
        $this->assertSame('Salamat po!', $items['reply']['preview'], 'the inbox shows what staff wrote');
        $this->assertSame('Assembly', $items['reply']['event_name']);
    }

    public function test_a_reply_to_a_reason_is_marked_as_a_response(): void
    {
        $staff = $this->staff();
        $pedro = $this->resident('Pedro', 'Cruz');
        $e = $this->missedEvent();
        $a = $this->actingAs($pedro)->postJson('/feedback/absence', ['event_id' => $e->id, 'reason' => 'work_family'])->json('absence.id');

        $this->actingAs($staff)->putJson("/feedback/absence/{$a}/reply", ['reply' => 'Okay lang po'])->assertOk();

        $reply = collect($this->actingAs($pedro)->getJson('/notifications/replies')->json('new'))->firstWhere('kind', 'reply');
        $this->assertSame('response', $reply['target']);
        $this->assertSame('Okay lang po', $reply['preview']);
    }

    public function test_a_member_liking_the_reply_reaches_the_staff_member_with_the_name(): void
    {
        $staff = $this->staff();
        $maria = $this->resident();
        $e = $this->attendedEvent($maria);
        $f = $this->actingAs($maria)->postJson('/feedback', ['event_id' => $e->id, 'rating' => 5])->json('feedback.id');
        $this->actingAs($staff)->putJson("/feedback/rating/{$f}/reply", ['reply' => 'Salamat po!'])->assertOk();

        $this->actingAs($maria)->putJson("/feedback/rating/{$f}/reply-like")->assertOk();

        $row = collect($this->actingAs($staff)->getJson('/staff/alerts')->json('data'))->firstWhere('reply_like', true);
        $this->assertSame('Maria Santos liked your reply on their feedback', $row['title']);
        $this->assertSame('Salamat po!', $row['comment']);
    }

    public function test_notifications_written_in_the_old_wording_are_rewritten_by_the_migration(): void
    {
        $staff = $this->staff();
        $maria = $this->resident();
        $e = $this->attendedEvent($maria);
        $now = now();
        $base = ['user_id' => $staff->id, 'event_id' => $e->id, 'read' => false, 'created_at' => $now, 'updated_at' => $now];

        Notification::insert([
            $base + ['type' => 'feedback_received', 'title' => 'New feedback received', 'message' => 'Maria Santos rated "Assembly": 4/5 — Good one'],
            $base + ['type' => 'feedback_received', 'title' => "Couldn't attend reported", 'message' => 'Pedro Cruz reported couldn\'t attend "Assembly": no_transport'],
            ['user_id' => $maria->id, 'event_id' => $e->id, 'type' => 'feedback_reply', 'title' => 'Barangay staff replied to your reason', 'message' => 'Okay lang po', 'read' => false, 'created_at' => $now, 'updated_at' => $now],
            ['user_id' => $maria->id, 'event_id' => $e->id, 'type' => 'feedback_reply', 'title' => 'Barangay staff liked your feedback', 'message' => 'Your rating was acknowledged by barangay staff.', 'read' => false, 'created_at' => $now, 'updated_at' => $now],
        ]);

        $migration = require base_path('database/migrations/2026_11_19_000002_restore_feedback_notification_shape.php');
        $migration->up();
        $migration->up(); // safe to run twice

        $rows = DB::table('notifications')->orderBy('id')->get();
        $this->assertSame('Maria Santos sent feedback', $rows[0]->title);
        $this->assertSame("\"Assembly\" - 4/5\nGood one", $rows[0]->message);
        $this->assertSame('Pedro Cruz sent a reason for not attending', $rows[1]->title);
        $this->assertSame('"Assembly" - No transportation', $rows[1]->message);
        $this->assertSame('Barangay staff replied to your response', $rows[2]->title);
        $this->assertSame("\"Assembly\"\nOkay lang po", $rows[2]->message);
        $this->assertSame('"Assembly"', $rows[3]->message);

        $bell = $this->actingAs($staff)->getJson('/staff/alerts')->json('data');
        $this->assertSame('absence', collect($bell)->firstWhere('title', 'Pedro Cruz sent a reason for not attending')['kind']);
    }
}
</file>

<file path="tests/Feature/LocalizedApiMessagesTest.php">
<?php

namespace Tests\Feature;

use App\Models\Event;
use App\Models\EventInventoryItem;
use App\Models\InventoryItem;
use App\Models\User;
use App\Support\ApiMessageTranslator;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;

class LocalizedApiMessagesTest extends TestCase
{
    use RefreshDatabase;

    private function staff(): User
    {
        return User::create([
            'user_code' => 'PR-' . random_int(10000, 99999), 'first_name' => 'Staff', 'last_name' => 'Tester',
            'contact_number' => '09171234567', 'role' => 'Staff', 'password' => bcrypt('secret123'), 'has_account' => true,
        ]);
    }

    private function borrowedItem(): InventoryItem
    {
        $item = InventoryItem::create(['name' => 'Plastic Chairs', 'quantity' => 50, 'condition' => 'Good']);
        $event = Event::create(['name' => 'Test Event', 'description' => 'x', 'location' => 'Hall', 'event_start' => now()->addDay()]);
        EventInventoryItem::create(['event_id' => $event->id, 'inventory_item_id' => $item->id, 'quantity' => 5]);
        return $item;
    }

    public function test_exact_and_dynamic_messages_translate(): void
    {
        $this->assertSame('Matagumpay na nagawa ang kaganapan', ApiMessageTranslator::translate('Event created successfully', 'tl'));
        $this->assertSame('Malampuson nga nahimo ang kalihokan', ApiMessageTranslator::translate('Event created successfully', 'ceb'));
        $this->assertSame('Hindi pa bukas ang sign-in. Magbubukas ito sa 8:00 AM.', ApiMessageTranslator::translate('Sign-in is not open yet. It opens at 8:00 AM.', 'tl'));
        $this->assertSame('Nabigong gumawa ng kaganapan: Kulang ang stock ng "Mic" (available: 1, hiniling: 3).',
            ApiMessageTranslator::translate('Failed to create event: Not enough stock for "Mic" (available: 1, requested: 3).', 'tl'));
        $this->assertSame('Unknown thing', ApiMessageTranslator::translate('Unknown thing', 'tl'));
        $this->assertSame('Event created successfully', ApiMessageTranslator::translate('Event created successfully', 'en'));
    }

    public function test_every_message_keeps_its_placeholders(): void
    {
        foreach (['tl', 'ceb'] as $loc) {
            foreach (require lang_path("$loc/messages.php") as $en => $tr) {
                preg_match_all('/\{\d+\}/', $en, $a);
                preg_match_all('/\{\d+\}/', $tr, $b);
                $this->assertEquals(array_unique($a[0]), array_unique($b[0]), "[$loc] $en");
            }
        }
    }

    public function test_api_response_follows_the_language_cookie(): void
    {
        $staff = $this->staff();
        $item = $this->borrowedItem();

        $en = $this->actingAs($staff)->deleteJson("/inventory/{$item->id}");
        $en->assertStatus(409);
        $this->assertStringContainsString('is currently borrowed for an event', $en->json('message'));

        $tl = $this->actingAs($staff)->withCredentials()->withUnencryptedCookie('piao_lang', 'tl')->deleteJson("/inventory/{$item->id}");
        $tl->assertStatus(409);
        $this->assertStringContainsString('Kasalukuyang hiniram ang "Plastic Chairs"', $tl->json('message'));

        $ceb = $this->actingAs($staff)->withCredentials()->withUnencryptedCookie('piao_lang', 'ceb')->deleteJson("/inventory/{$item->id}");
        $this->assertStringContainsString('Gihulam karon ang "Plastic Chairs"', $ceb->json('message'));

        $bad = $this->actingAs($staff)->withCredentials()->withUnencryptedCookie('piao_lang', 'xx')->deleteJson("/inventory/{$item->id}");
        $this->assertStringContainsString('is currently borrowed', $bad->json('message'));
    }

    public function test_validation_errors_follow_the_language_cookie(): void
    {
        $staff = $this->staff();

        $en = $this->actingAs($staff)->postJson('/age-brackets', []);
        $this->assertContains($en->status(), [422, 404, 405]);

        $v = \Illuminate\Support\Facades\Validator::make([], ['label' => 'required']);
        app()->setLocale('tl');
        $this->assertSame('Kinakailangan ang label.', $v->errors()->first('label') ?: \Illuminate\Support\Facades\Validator::make([], ['label' => 'required'])->errors()->first('label'));
        app()->setLocale('ceb');
        $this->assertSame('Gikinahanglan ang label.', \Illuminate\Support\Facades\Validator::make([], ['label' => 'required'])->errors()->first('label'));
        app()->setLocale('tl');
        $this->assertSame('Kinakailangan ang unang pangalan.', \Illuminate\Support\Facades\Validator::make([], ['first_name' => 'required'])->errors()->first('first_name'));
    }
}
</file>

<file path="tests/Feature/NoFutureTimeLockTest.php">
<?php

namespace Tests\Feature;

use Illuminate\Database\QueryException;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;
use Tests\Support;
use Tests\TestCase;

/**
 * A time that records when something happened cannot be in the future, whatever route writes it
 * (migration 2026_11_19_000014). Times that plan something may be.
 */
class NoFutureTimeLockTest extends TestCase
{
    use RefreshDatabase, Support;

    private const WHY = 'A time that records when something happened cannot be in the future';

    private int $n = 0;

    private function migration(): object
    {
        return require database_path('migrations/2026_11_19_000014_lock_recorded_times_against_the_future.php');
    }

    private function refused(callable $write): void
    {
        try {
            $write();
        } catch (QueryException $e) {
            $this->assertStringContainsString(self::WHY, $e->getMessage(), 'refused, but not by the expected rule');

            return;
        }
        $this->fail('The database accepted a time in the future.');
    }

    private function log(array $extra = []): int
    {
        return DB::table('activity_logs')->insertGetId(array_merge([
            'user_code' => 'PR-0001', 'action' => 'Test', 'module' => 'Events', 'description' => 'x',
        ], $extra));
    }

    private function user(array $extra = []): int
    {
        $this->n++;

        return DB::table('users')->insertGetId(array_merge([
            'user_code' => sprintf('PR-%04d', $this->n), 'first_name' => "N{$this->n}", 'last_name' => "T{$this->n}",
            'contact_number' => '09171234567', 'role' => 'Resident',
        ], $extra));
    }

    private function event(array $extra = []): int
    {
        $this->n++;

        return DB::table('events')->insertGetId(array_merge([
            'name' => "Fiesta {$this->n}", 'description' => 'x', 'location' => "Hall {$this->n}",
            'event_start' => now()->addDays(5)->toDateTimeString(), 'event_end' => now()->addDays(5)->addHours(3)->toDateTimeString(),
        ], $extra));
    }

    // ---------- created / updated / archived ----------

    public function test_a_record_cannot_be_created_or_updated_with_a_future_time(): void
    {
        $this->refused(fn () => $this->log(['created_at' => now()->addDay()->toDateTimeString()]));
        $this->refused(fn () => $this->log(['updated_at' => now()->addHours(2)->toDateTimeString()]));
        $this->assertSame(0, DB::table('activity_logs')->count());

        $id = $this->log();
        $this->withoutTimeLocks(function () use ($id) {   // the written-once and add-only locks are lifted so only this rule is judged
            $this->refused(fn () => DB::table('activity_logs')->where('id', $id)->update(['created_at' => now()->addYear()->toDateTimeString()]));
            $this->refused(fn () => DB::table('activity_logs')->where('id', $id)->update(['updated_at' => now()->addMinutes(10)->toDateTimeString()]));
        });
    }

    public function test_now_the_past_and_a_few_seconds_of_clock_difference_are_accepted(): void
    {
        $this->log(['created_at' => now()->toDateTimeString()]);
        $this->log(['created_at' => now()->subYears(3)->toDateTimeString()]);
        $this->log(['created_at' => now()->addSeconds(30)->toDateTimeString()]);   // one minute of grace
        $this->refused(fn () => $this->log(['created_at' => now()->addMinutes(5)->toDateTimeString()]));

        $this->assertSame(3, DB::table('activity_logs')->count());
    }

    public function test_an_archive_time_cannot_be_in_the_future(): void
    {
        $event = $this->event();

        $this->refused(fn () => DB::table('events')->where('id', $event)->update(['deleted_at' => now()->addDay()->toDateTimeString(), 'deleted_by' => 'PR-0001']));
        DB::table('events')->where('id', $event)->update(['deleted_at' => now()->toDateTimeString(), 'deleted_by' => 'PR-0001']);
        $this->assertNotNull(DB::table('events')->where('id', $event)->value('deleted_at'));
    }

    // ---------- sign-in and sign-out ----------

    public function test_a_sign_in_or_sign_out_cannot_be_in_the_future(): void
    {
        // an event with no call time lets anyone sign in until it starts, so only the clock refuses these
        $event = $this->event();
        $user = $this->user();
        $row = fn (array $t) => DB::table('attendances')->insert(['event_id' => $event, 'user_id' => $user, 'status' => 'Incomplete'] + $t);   // one scan, so Incomplete is the true status

        $this->refused(fn () => $row(['time_in' => now()->addDay()->toDateTimeString()]));
        $this->refused(fn () => $row(['time_out' => now()->addDays(6)->toDateTimeString()]));
        $this->assertSame(0, DB::table('attendances')->count());

        $row(['time_in' => now()->subMinute()->toDateTimeString()]);
        $id = DB::table('attendances')->value('id');
        $this->refused(fn () => DB::table('attendances')->where('id', $id)->update(['time_out' => now()->addHour()->toDateTimeString(), 'status' => 'Complete']));
    }

    // ---------- account times ----------

    public function test_account_times_such_as_last_login_cannot_be_in_the_future(): void
    {
        $user = $this->user();

        foreach (['last_login_at', 'suspended_at', 'password_changed_at', 'two_factor_confirmed_at'] as $column) {
            $this->refused(fn () => DB::table('users')->where('id', $user)->update([$column => now()->addDay()->toDateTimeString()]));
            DB::table('users')->where('id', $user)->update([$column => now()->subHour()->toDateTimeString()]);
        }
    }

    // ---------- times that plan something may be in the future ----------

    public function test_planned_times_may_lie_in_the_future(): void
    {
        $event = $this->event(['call_time_start' => now()->addDays(4)->toDateTimeString(), 'call_time_end' => now()->addDays(6)->toDateTimeString()]);
        DB::table('events')->where('id', $event)->update(['event_start' => now()->addDays(8)->toDateTimeString(), 'event_end' => now()->addDays(8)->addHours(2)->toDateTimeString(), 'call_time_end' => now()->addDays(9)->toDateTimeString()]);

        $user = $this->user();
        DB::table('users')->where('id', $user)->update(['locked_until' => now()->addMinutes(15)->toDateTimeString()]);

        $this->assertNotNull(DB::table('users')->where('id', $user)->value('locked_until'));
        $this->assertSame(now()->addDays(9)->toDateString(), substr((string) DB::table('events')->where('id', $event)->value('call_time_end'), 0, 10));
    }

    // ---------- judged only on change ----------

    public function test_a_future_time_stored_before_the_lock_never_blocks_an_unrelated_edit(): void
    {
        $m = $this->migration();
        $m->down();
        $id = $this->log(['created_at' => now()->addDays(3)->toDateTimeString()]);   // bad data from before the lock
        $m->up();                                                                       // the migration does not scan, so it cannot fail on it

        $this->withoutTimeLocks(function () use ($id) {   // with the written-once and add-only locks lifted
            DB::table('activity_logs')->where('id', $id)->update(['description' => 'edited']);   // other columns are free
            $this->assertSame('edited', DB::table('activity_logs')->where('id', $id)->value('description'));

            $this->refused(fn () => DB::table('activity_logs')->where('id', $id)->update(['created_at' => now()->addDays(4)->toDateTimeString()]));   // but moving it is judged
            DB::table('activity_logs')->where('id', $id)->update(['created_at' => now()->subDay()->toDateTimeString()]);                              // and fixing it is welcome
        });
    }

    public function test_the_lock_can_be_rolled_back_and_run_again(): void
    {
        $m = $this->migration();
        $m->down();
        $this->log(['created_at' => now()->addDay()->toDateTimeString()]);   // accepted while unlocked
        $this->withoutTimeLocks(fn () => DB::table('activity_logs')->delete());
        $m->up();
        $m->up();

        $this->refused(fn () => $this->log(['created_at' => now()->addDay()->toDateTimeString()]));
    }

    // ---------- every date-time column is classified ----------

    public function test_every_date_time_column_is_either_recorded_or_planned(): void
    {
        $m = $this->migration();
        $listed = [];
        $scans = require database_path('migrations/2026_11_19_000022_create_attendance_scan_ledger.php');   // added later, so it lists its own recorded times
        foreach ([$m::RECORDED, $m::PLANNED, [$scans::TABLE => $scans::RECORDED]] as $group) {
            foreach ($group as $table => $columns) {
                foreach ($columns as $column) {
                    $listed[] = "{$table}.{$column}";
                }
            }
        }
        $this->assertSame($listed, array_values(array_unique($listed)), 'a column is in both lists, or twice');

        $found = [];
        foreach (Schema::getTables() as $table) {
            foreach (Schema::getColumns($table['name']) as $column) {
                if (in_array(strtolower($column['type_name']), ['datetime', 'timestamp'], true)) {
                    $found[] = "{$table['name']}.{$column['name']}";
                }
            }
        }
        // framework tables that hold plain numbers or are not part of the system's records
        $found = array_filter($found, fn ($c) => !preg_match('/^(sessions|cache|cache_locks|jobs|job_batches|failed_jobs|migrations|password_reset_tokens|personal_access_tokens)\./', $c));

        $this->assertSame([], array_values(array_diff($found, $listed)), 'a date-time column has not been classified as recorded or planned');
        $this->assertSame([], array_values(array_diff($listed, $found)), 'a classified column does not exist');
    }
}
