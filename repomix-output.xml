<file path="resources/js/components/ui/FilterBar.tsx">
import { useEffect, useState, type ReactNode } from "react";
import { ArrowUpDown, ChevronDown, Filter, Search, SlidersHorizontal, X } from "lucide-react";
import FilterDropdown, { type FilterDropdownOption } from "./FilterDropdown";
import SearchBar from "./SearchBar";
import { useLanguage } from "../../i18n/LanguageContext";

export interface FilterDef {
  key: string;
  /** Short name shown on the chip, e.g. "Civil status". */
  label: string;
  value: string;
  /** The "no filter" value ("all" or ""). The chip only shows when value differs. */
  defaultValue?: string;
  onChange: (value: string) => void;
  options: FilterDropdownOption[];
  icon?: ReactNode;
  searchable?: boolean;
  /** Dropdown trigger width helper. */
  minWidthClass?: string;
}

export interface ExtraChip {
  key: string;
  label: string;
  onRemove: () => void;
}

interface FilterBarProps {
  search?: { value: string; onChange: (v: string) => void; placeholder: string };
  filters?: FilterDef[];
  sort?: { value: string; onChange: (v: string) => void; options: FilterDropdownOption[] };
  /** "Showing x of y" -- total is the unfiltered size of the list. Leave total out for a plain "n results". */
  count?: { shown: number; total?: number };
  /** Chips for filters that aren't dropdowns (a picked date, a quick tab...). */
  extraChips?: ExtraChip[];
  /** Resets everything the bar doesn't own (dates, tabs). Called by "Clear all". */
  onClearExtras?: () => void;
  /** Quick tabs (All / Today ...). Shown above the bar on larger screens; on phones they live inside the filter panel. */
  tabs?: ReactNode;
  /** Label for the `children` row in the phone filter panel (default "Date"). */
  childrenLabel?: string;
  /** Set false when the page shows its tabs some other way on phones (e.g. a floating speed dial). */
  tabsOnPhone?: boolean;
  /** Extra content shown at the top of the phone filter panel only (e.g. a small summary). */
  panelExtra?: ReactNode;
  /** Controls placed at the end of the first row (a date picker, an Add button). */
  children?: ReactNode;
  className?: string;
}

// Strip a trailing " (12)" count off an option label so the chip reads cleanly.
const cleanLabel = (s: string) => s.replace(/\s*\(\d+\)\s*$/, "");

/**
 * The one filter toolbar every list page uses: search, filter dropdowns, an
 * optional sort, then a second row with the result count, a removable chip
 * for every active filter, and a single "Clear all filters" button. Pages own
 * their own state and pass it in; the bar only draws it and works out which
 * chips to show, so every page filters, sorts and clears the same way.
 */
export default function FilterBar({ search, filters = [], sort, count, extraChips = [], onClearExtras, tabs, tabsOnPhone = true, childrenLabel, panelExtra, children, className = "" }: FilterBarProps) {
  const { t } = useLanguage();
  const [open, setOpen] = useState(false); // phones: the dropdowns start collapsed behind one "Filters" button
  const [isPhone, setIsPhone] = useState(() => typeof window !== "undefined" && window.matchMedia("(max-width: 639px)").matches);
  useEffect(() => {
    const mq = window.matchMedia("(max-width: 639px)");
    const on = () => setIsPhone(mq.matches);
    mq.addEventListener("change", on);
    return () => mq.removeEventListener("change", on);
  }, []);

  const active = filters
    .filter((f) => f.value !== (f.defaultValue ?? "all"))
    .map((f) => {
      const opt = f.options.find((o) => o.value === f.value);
      return { key: f.key, label: `${f.label}: ${cleanLabel(opt?.label ?? f.value)}`, onRemove: () => f.onChange(f.defaultValue ?? "all") };
    });
  const chips: ExtraChip[] = [...active, ...extraChips];
  const searching = !!search && search.value.trim() !== "";
  const anyActive = chips.length > 0 || searching;

  const clearAll = () => {
    filters.forEach((f) => { if (f.value !== (f.defaultValue ?? "all")) f.onChange(f.defaultValue ?? "all"); });
    if (search && search.value) search.onChange("");
    onClearExtras?.();
  };

  // Three or more dropdowns: search gets a full-width row of its own and the
  // dropdowns sit below in an even grid, so the search box is never squeezed.
  // One or two dropdowns fit beside the search box on a single row.
  const stacked = filters.length + (sort ? 1 : 0) > 2;
  const triggerCls = stacked ? "h-11 w-full pl-10 pr-8" : "h-11 w-full pl-10 pr-8 sm:w-auto sm:min-w-[11rem] sm:shrink-0";
  const iconCls = "absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-[#4FBEB0] pointer-events-none";

  const searchBox = search && (
    <div className={stacked ? "min-w-[240px] flex-1 basis-full sm:basis-0" : "min-w-[220px] flex-1 basis-64"}>
      <SearchBar dark value={search.value} onChange={search.onChange} placeholder={search.placeholder} />
    </div>
  );

  const hasDropdowns = filters.length + (sort ? 1 : 0) > 0;
  const toggle = hasDropdowns && (
    <button
      type="button"
      onClick={() => setOpen((v) => !v)}
      aria-expanded={open}
      className="dash-tile flex h-11 w-full basis-full items-center justify-between gap-3 rounded-full px-4 text-sm font-semibold text-white sm:hidden"
    >
      <span className="flex items-center gap-2"><Filter className="h-4 w-4 text-[#2E8E82]" />{t("rpFiltersLabel")}</span>
      <span className="flex items-center gap-2">
        {active.length > 0 && <span className="inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-[#2E8E82] px-1.5 text-[11px] font-bold !text-white">{active.length}</span>}
        <ChevronDown className={`h-4 w-4 text-white/60 transition-transform ${open ? "rotate-180" : ""}`} />
      </span>
    </button>
  );

  const dropdowns = (
    <>
      {filters.map((f) => {
        // Long lists get a type-to-filter box on top, like memberships always had.
        const searchable = f.searchable ?? f.options.length > 7;
        return (
          <FilterDropdown
            key={f.key}
            value={f.value}
            onChange={f.onChange}
            options={f.options}
            className={`${triggerCls} ${f.minWidthClass ?? ""} max-sm:!min-w-0`}
            wrapperClassName={stacked ? "min-w-0" : "w-full sm:w-auto"}
            icon={f.icon ?? <Filter className={iconCls} />}
            searchable={searchable}
            searchPlaceholder={t("search")}
            noResultsLabel={t("noMatchesFoundLabel")}
            panelWidthPx={searchable ? 288 : undefined}
            dark
          />
        );
      })}
      {sort && (
        <FilterDropdown
          value={sort.value}
          onChange={sort.onChange}
          options={sort.options}
          className={triggerCls}
          wrapperClassName={stacked ? "" : "w-full sm:w-auto"}
          icon={<ArrowUpDown className={iconCls} />}
          align="right"
          dark
        />
      )}
    </>
  );

  // Phones (Gmail-style): one search pill with a "tune" button on its right. The button opens a
  // small panel with one labelled row per filter (label on the left, choice on the right).
  // No search box (e.g. Reports): just the labelled rows, always visible -- no button, no extra card.
  if (isPhone && !search && hasDropdowns) {
    const rowLabelP = "w-[5.5rem] shrink-0 text-[13px] font-semibold text-white/60";
    return (
      <div className={`space-y-3 ${className}`}>
        {filters.map((f) => {
          const searchable = f.searchable ?? f.options.length > 7;
          return (
            <div key={f.key} className="flex items-center gap-3">
              <span className={rowLabelP}>{f.label}</span>
              <div className="min-w-0 flex-1">
                <FilterDropdown
                  value={f.value}
                  onChange={f.onChange}
                  options={f.options}
                  className="h-11 w-full pl-10 pr-8 !text-[14px]"
                  wrapperClassName="min-w-0"
                  icon={f.icon ?? <Filter className={iconCls} />}
                  searchable={searchable}
                  searchPlaceholder={t("search")}
                  noResultsLabel={t("noMatchesFoundLabel")}
                  fullWidth
                  dark
                />
              </div>
            </div>
          );
        })}
        {anyActive && (
          <button type="button" onClick={clearAll} className="px-1 text-[13px] font-bold text-white/60 transition hover:text-white">
            {t("fltClearAll")}
          </button>
        )}
      </div>
    );
  }

  if (isPhone && search && (hasDropdowns || !!children)) {
    const rowLabel = "w-[5.5rem] shrink-0 text-[13px] font-semibold text-white/60";
    return (
      <div data-phone-filterbar className={`space-y-3 ${className}`}>
        <div className="relative">
          <Search className="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-white/50" />
          <input
            type="text"
            value={search.value}
            onChange={(e) => search.onChange(e.target.value)}
            placeholder={search.placeholder}
            className="phone-search h-12 w-full rounded-full pl-12 pr-24 text-[15px] text-white placeholder:text-white/45 focus:outline-none"
          />
          <div className="absolute right-1.5 top-1/2 flex -translate-y-1/2 items-center gap-0.5">
            {search.value && (
              <button type="button" onClick={() => search.onChange("")} aria-label={t("clearSearchAria")} className="flex h-9 w-9 items-center justify-center rounded-full text-white/60 transition active:bg-white/10">
                <X className="h-4 w-4" />
              </button>
            )}
            <button
              type="button"
              onClick={() => setOpen((v) => !v)}
              aria-expanded={open}
              aria-label={t("rpFiltersLabel")}
              className={`relative flex h-9 w-9 items-center justify-center rounded-full transition active:scale-95 ${open ? "bg-[#2E8E82] !text-white" : "text-white/70 active:bg-white/10"}`}
            >
              <SlidersHorizontal className="h-5 w-5" />
              {chips.length > 0 && (
                <span className="absolute -right-0.5 -top-0.5 flex h-4 min-w-[1rem] items-center justify-center rounded-full bg-[#F5C451] px-1 text-[10px] font-bold !text-[#0B0F14]">{chips.length}</span>
              )}
            </button>
          </div>
        </div>

        {open && (
          <div className="dash-card space-y-3 rounded-2xl p-4">
            {panelExtra && <div className="border-b border-white/10 pb-4">{panelExtra}</div>}
            {tabs && tabsOnPhone && <div className="border-b border-white/10 pb-4">{tabs}</div>}
            {filters.map((f) => {
              const searchable = f.searchable ?? f.options.length > 7;
              return (
                <div key={f.key} className="flex items-center gap-3">
                  <span className={rowLabel}>{f.label}</span>
                  <div className="min-w-0 flex-1">
                    <FilterDropdown
                      value={f.value}
                      onChange={f.onChange}
                      options={f.options}
                      className="h-11 w-full pl-10 pr-8 !text-[14px]"
                      wrapperClassName="min-w-0"
                      icon={f.icon ?? <Filter className={iconCls} />}
                      searchable={searchable}
                      searchPlaceholder={t("search")}
                      noResultsLabel={t("noMatchesFoundLabel")}
                      fullWidth
                      dark
                    />
                  </div>
                </div>
              );
            })}
            {sort && (
              <div className="flex items-center gap-3">
                <span className={rowLabel}>{t("fltSortBy")}</span>
                <div className="min-w-0 flex-1">
                  <FilterDropdown
                    value={sort.value}
                    onChange={sort.onChange}
                    options={sort.options}
                    className="h-11 w-full pl-10 pr-8 !text-[14px]"
                    wrapperClassName="min-w-0"
                    icon={<ArrowUpDown className={iconCls} />}
                    fullWidth
                    dark
                  />
                </div>
              </div>
            )}
            {children && (
              <div className="flex items-center gap-3">
                <span className={rowLabel}>{childrenLabel ?? t("fltDateChip")}</span>
                <div className="min-w-0 flex-1 [&>*]:w-full">{children}</div>
              </div>
            )}
            <div className="flex items-center justify-between gap-3 border-t border-white/10 pt-3">
              <button
                type="button"
                onClick={clearAll}
                disabled={!anyActive}
                className="px-2 text-[13px] font-bold text-white/60 transition disabled:opacity-40"
              >
                {t("fltClearAll")}
              </button>
              <button
                type="button"
                onClick={() => setOpen(false)}
                className="h-10 rounded-full bg-[#2E8E82] px-6 text-sm font-bold !text-white shadow-sm transition active:scale-95"
              >
                {t("doneLabel")}
              </button>
            </div>
          </div>
        )}

        {(count || chips.length > 0) && (
          <div className="flex flex-wrap items-center gap-x-3 gap-y-2" aria-live="polite">
            {count && (
              <p className={`text-[13px] ${anyActive ? "font-semibold text-[#7DD8CB]" : "text-white/45"}`}>
                {count.total === undefined
                  ? t("fltResults").replace("{n}", String(count.shown))
                  : t("fltShowing").replace("{shown}", String(count.shown)).replace("{total}", String(count.total))}
              </p>
            )}
            {chips.map((c) => (
              <span key={c.key} className="inline-flex items-center gap-1 rounded-full border border-[#4FBEB0]/30 bg-[#4FBEB0]/10 py-1 pl-3 pr-1.5 text-xs font-semibold text-[#7DD8CB]">
                {c.label}
                <button type="button" onClick={c.onRemove} aria-label={`${t("fltRemove")}: ${c.label}`} className="flex h-5 w-5 items-center justify-center rounded-full transition hover:bg-white/15 hover:text-white">
                  <X className="h-3 w-3" />
                </button>
              </span>
            ))}
          </div>
        )}
      </div>
    );
  }

  return (
    <div data-phone-filterbar={search && !hasDropdowns ? "" : undefined} className={`space-y-3 ${className}`}>
      {tabs}
      {stacked ? (
        <>
          {(searchBox || children) && (
            <div className="flex flex-wrap items-center gap-3">
              {searchBox}
              {children}
            </div>
          )}
          {toggle}
          <div className={`${open ? "grid grid-cols-2" : "hidden"} gap-3 sm:grid sm:grid-cols-[repeat(auto-fill,minmax(13rem,1fr))]`}>{dropdowns}</div>
        </>
      ) : (
        <div className="flex flex-wrap items-center gap-3">
          {searchBox}
          {toggle}
          <div className={`${open ? "grid grid-cols-2" : "hidden"} basis-full gap-3 sm:contents`}>{dropdowns}</div>
          {children}
        </div>
      )}

      {(count || chips.length > 0) && (
        <div className="flex flex-wrap items-center gap-x-3 gap-y-2" aria-live="polite">
          {count && (
            <p className={`text-[13px] ${anyActive ? "font-semibold text-[#7DD8CB]" : "text-white/45"}`}>
              {count.total === undefined
                ? t("fltResults").replace("{n}", String(count.shown))
                : t("fltShowing").replace("{shown}", String(count.shown)).replace("{total}", String(count.total))}
            </p>
          )}
          {chips.map((c) => (
            <span key={c.key} className="inline-flex items-center gap-1 rounded-full border border-[#4FBEB0]/30 bg-[#4FBEB0]/10 py-1 pl-3 pr-1.5 text-xs font-semibold text-[#7DD8CB]">
              {c.label}
              <button
                type="button"
                onClick={c.onRemove}
                aria-label={`${t("fltRemove")}: ${c.label}`}
                className="flex h-5 w-5 items-center justify-center rounded-full transition hover:bg-white/15 hover:text-white"
              >
                <X className="h-3 w-3" />
              </button>
            </span>
          ))}
          {anyActive && (
            <button type="button" onClick={clearAll} className="text-xs font-bold text-white/60 underline-offset-2 transition hover:text-white hover:underline">
              {t("fltClearAll")}
            </button>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="resources/js/components/ui/FormDrawer.tsx">
import type { FormEvent, ReactNode } from "react";
import { createPortal } from "react-dom";
import { ChevronLeft } from "lucide-react";
import { useLanguage } from "../../i18n/LanguageContext";
import SlideOutGhost from "./SlideOutGhost";

// The shared shell for every staff form that slides in from the right: the
// same layout as Create New Event -- "Cancel" link, centred title and
// subtitle, sections with underlined headings -- but with the save button
// pinned to the bottom of the panel so it never floats mid-screen under a
// short form. Wrap the body in <FormSection> blocks.
export default function FormDrawer({
  title,
  subtitle,
  onClose,
  onSubmit,
  footer,
  children,
  z = "z-50",
  wide = false,
}: {
  title: ReactNode;
  subtitle?: ReactNode;
  onClose: () => void;
  onSubmit?: (e: FormEvent<HTMLFormElement>) => void;
  footer?: ReactNode;
  children: ReactNode;
  z?: string;
  /** A wider content area (for two-column layouts such as the event budget). */
  wide?: boolean;
}) {
  const { t } = useLanguage();
  const panelClass = `resident-form-panel slide-over-in staff-drawer-panel fixed ${z} flex flex-col overflow-hidden bg-[#0A0E1A]`;
  const inner = (
    <>
      <img
        src="/logo-removebg-preview.png"
        alt=""
        aria-hidden="true"
        className="pointer-events-none absolute bottom-[-4rem] right-[-4rem] z-0 h-[28rem] w-[28rem] select-none object-contain opacity-[0.06] sm:h-[40rem] sm:w-[40rem]"
      />
      <div className="relative z-10 flex-1 overflow-y-auto px-6 py-10 sm:px-12 sm:py-14">
        <div className={`mx-auto w-full ${wide ? "max-w-[1280px]" : "max-w-5xl"}`}>
          <button
            type="button"
            onClick={onClose}
            className="dash-tile inline-flex min-h-10 items-center gap-1.5 rounded-full px-4 text-sm font-semibold text-white/80 hover:text-white transition mb-8"
          >
            <ChevronLeft className="h-4 w-4" /> {t("cancel")}
          </button>
          <h1 className="text-center font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{title}</h1>
          {subtitle && <p className="mx-auto mt-3 max-w-md text-center text-base text-white/60">{subtitle}</p>}
          <div className="mt-10 space-y-10">{children}</div>
        </div>
      </div>
      {footer && (
        <div className="relative z-10 shrink-0 border-t border-white/10 bg-[#0A0E1A] px-6 py-4 sm:px-12">
          <div className={`mx-auto w-full ${wide ? "max-w-[1280px]" : "max-w-5xl"}`}>{footer}</div>
        </div>
      )}
    </>
  );
  // Always rendered at the top of <body>, so the panel and its dimmed backdrop
  // cover the whole window from top to bottom no matter which page opened it
  // (a parent with a transform/animation would otherwise offset a "fixed" panel).
  const drawer = (
    <>
      <SlideOutGhost />
      <div className={`staff-drawer-backdrop ${z} bg-black/80`} onClick={onClose} />
      {onSubmit ? (
        <form onSubmit={onSubmit} noValidate className={panelClass}>{inner}</form>
      ) : (
        <div className={panelClass}>{inner}</div>
      )}
    </>
  );
  return typeof document === "undefined" ? drawer : createPortal(drawer, document.body);
}

export function FormSection({ title, children, className = "space-y-4" }: { title: ReactNode; children: ReactNode; className?: string }) {
  return (
    <section>
      <h2 className="mb-6 border-b-2 border-white/40 pb-3 text-base font-bold uppercase tracking-wider text-white">{title}</h2>
      <div className={className}>{children}</div>
    </section>
  );
}
</file>

<file path="resources/js/components/ui/NumberStepper.tsx">
import React from "react";
import { ChevronUp, ChevronDown } from "lucide-react";

interface NumberStepperProps {
  /** Kept as a string, like a normal controlled <input>, so this works for
      both integer quantities and free-typed decimal amounts without this
      component owning any parsing opinions beyond its own +/- buttons. */
  value: string;
  onChange: (value: string) => void;
  min?: number;
  max?: number;
  step?: number;
  disabled?: boolean;
  required?: boolean;
  placeholder?: string;
  /** Classes for the input itself -- sizing, colors, border, focus ring.
      This component adds the padding needed to clear its own buttons. */
  className?: string;
  /** True makes the whole control (input + buttons) stretch to fill its
      parent's width -- pass this, and put `w-full` on `className` too,
      wherever the field used to be a plain `w-full` input in a form
      layout. Leave false (the default) for a fixed-width field like a
      small quantity box, so the wrapper hugs the input instead of the
      buttons drifting away from it. */
  fullWidth?: boolean;
}

/**
 * A number input with its own up/down buttons, instead of the browser's
 * native <input type="number"> spinner. The native one turned out not to
 * be worth it: its arrow color follows `color-scheme`, which some browsers
 * resolve against the OS's own light/dark setting rather than the page's
 * theme, and there's no reliable, cross-browser way to give it a specific
 * dark-with-visible-arrows look (Firefox doesn't support styling it via
 * `::-webkit-inner-spin-button` at all). Building the two buttons ourselves
 * means their color is just an ordinary Tailwind class, consistent for
 * every visitor regardless of OS or browser.
 *
 * The underlying element is still a real <input type="number"> (so
 * required/min/max/step and native keyboard Up/Down-arrow stepping all
 * keep working); only its native spin buttons are hidden.
 */
export default function NumberStepper({
  value,
  onChange,
  min,
  max,
  step = 1,
  disabled = false,
  required = false,
  placeholder,
  className = "",
  fullWidth = false,
}: NumberStepperProps) {
  const current = Number.isFinite(parseFloat(value)) ? parseFloat(value) : min ?? 0;
  const atMin = min !== undefined && current <= min;
  const atMax = max !== undefined && current >= max;
  // How many digits after the decimal point `step` implies -- 0.01 means 2,
  // a plain 1 means none at all. Both the +/- buttons and typed input are
  // held to this, so a money field (step 0.01) can't end up with a third
  // decimal digit from either source.
  const decimals = (String(step).split(".")[1] || "").length;

  const bump = (delta: number) => {
    let next = current + delta;
    // Round to the step's own precision so repeated 0.01 bumps don't drift
    // into floating-point noise like 0.1 + 0.2.
    next = Number(next.toFixed(decimals));
    if (min !== undefined) next = Math.max(min, next);
    if (max !== undefined) next = Math.min(max, next);
    onChange(String(next));
  };

  const handleTyped = (raw: string) => {
    // Reject the keystroke outright (don't call onChange) rather than
    // silently truncating after the fact -- for a controlled input, not
    // updating `value` means React just redraws the field back to what it
    // was before that keystroke, so the extra digit never visibly sticks.
    if (decimals === 0) {
      if (raw.includes(".")) return;
    } else {
      const dot = raw.indexOf(".");
      if (dot !== -1 && raw.length - dot - 1 > decimals) return;
    }
    onChange(raw);
  };

  return (
    <div className={`relative ${fullWidth ? "flex w-full" : "inline-flex"}`}>
      <input
        type="number"
        inputMode="decimal"
        min={min}
        max={max}
        step={step}
        disabled={disabled}
        required={required}
        placeholder={placeholder}
        value={value}
        onChange={(e) => handleTyped(e.target.value)}
        className={`min-w-0 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none ${className}`}
      />
      <div className="absolute right-1 top-1/2 -translate-y-1/2 flex flex-col">
        <button
          type="button"
          tabIndex={-1}
          disabled={disabled || atMax}
          onClick={() => bump(step)}
          className="flex h-5 w-6 sm:h-3 sm:w-4 items-center justify-center text-white/50 hover:text-white disabled:opacity-30 disabled:hover:text-white/50 transition"
        >
          <ChevronUp className="h-3 w-3 sm:h-2.5 sm:w-2.5" />
        </button>
        <button
          type="button"
          tabIndex={-1}
          disabled={disabled || atMin}
          onClick={() => bump(-step)}
          className="flex h-5 w-6 sm:h-3 sm:w-4 items-center justify-center text-white/50 hover:text-white disabled:opacity-30 disabled:hover:text-white/50 transition"
        >
          <ChevronDown className="h-3 w-3 sm:h-2.5 sm:w-2.5" />
        </button>
      </div>
    </div>
  );
}
</file>

<file path="resources/js/components/ui/OfflineBanner.tsx">
import { WifiOff, RefreshCw, AlertTriangle } from "lucide-react";
import { useEffect, useState } from "react";
import { useOnlineStatus } from "../../hooks/useOnlineStatus";
import { flushQueue, queueLength, getRejected, clearRejected, type RejectedScan } from "../../lib/offlineQueue";
import { useLanguage } from "../../i18n/LanguageContext";

/**
 * Adviser recommendation: "Piao has slow/limited connectivity — include
 * offline functionality too." Shown app-wide (both Staff and Member shells)
 * so nobody is left guessing why a save "isn't working" — and reports how
 * many QR scans are queued locally waiting to sync once back online.
 */
export default function OfflineBanner() {
  const { t } = useLanguage();
  const isOnline = useOnlineStatus();
  const [pending, setPending] = useState(0);
  const [syncing, setSyncing] = useState(false);
  const [justSynced, setJustSynced] = useState<number | null>(null);
  // A queued scan the server permanently rejected on replay (already
  // recorded from an earlier attempt, no longer eligible, window closed) --
  // flushQueue() now drops these from the queue instead of retrying them
  // forever, but that means someone needs to be told the scan never made it
  // in, instead of it just silently vanishing.
  // Kept (and shown) until dismissed, so a refused scan can never vanish in a few seconds.
  const [rejected, setRejected] = useState<RejectedScan[]>(() => getRejected());

  useEffect(() => {
    setPending(queueLength());
    const interval = setInterval(() => setPending(queueLength()), 3000);
    return () => clearInterval(interval);
  }, []);

  useEffect(() => {
    if (!isOnline) return;
    const current = queueLength();
    if (current === 0) return;

    setSyncing(true);
    flushQueue().then(({ synced, rejected: rejectedCount }) => {
      setSyncing(false);
      setPending(queueLength());
      if (synced > 0) {
        setJustSynced(synced);
        setTimeout(() => setJustSynced(null), 4000);
      }
      if (rejectedCount > 0) setRejected(getRejected());
    });
  }, [isOnline]);

  if (isOnline && pending === 0 && justSynced === null && rejected.length === 0) return null;

  if (!isOnline) {
    return (
      <div className="print:hidden flex items-center gap-2 bg-orange-500 text-white text-xs sm:text-sm font-medium px-4 py-2 justify-center">
        <WifiOff className="h-4 w-4 shrink-0" />
        <span>
          {t("uiOfflineBanner")}
          {pending > 0 ? ` (${t("uiPendingCount").replace("{n}", String(pending))})` : ""}.
        </span>
      </div>
    );
  }

  if (syncing) {
    return (
      <div className="print:hidden flex items-center gap-2 bg-[#005f63] text-white text-xs sm:text-sm font-medium px-4 py-2 justify-center">
        <RefreshCw className="h-4 w-4 shrink-0 animate-spin" />
        <span>{t("uiSyncing").replace("{n}", String(pending))}</span>
      </div>
    );
  }

  // Shown ahead of the plain "synced" toast below -- a refused scan means a resident's attendance did NOT
  // make it in, so it stays on screen, with who and why, until staff dismiss it.
  if (rejected.length > 0) {
    const shown = rejected.slice(-3);
    return (
      <div className="print:hidden bg-amber-600 text-white text-xs sm:text-sm font-medium px-4 py-2" role="alert">
        <div className="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
          <AlertTriangle className="h-4 w-4 shrink-0" />
          <span>
            {t("uiScansRejected").replace("{n}", String(rejected.length))}
            {justSynced ? ` ${t("uiOtherScansSynced").replace("{n}", String(justSynced))}` : ""}
          </span>
          <button
            type="button"
            onClick={() => { clearRejected(); setRejected([]); }}
            className="rounded-full border border-white/60 px-3 py-0.5 text-xs font-semibold hover:bg-white/15"
          >
            {t("uiDismiss")}
          </button>
        </div>
        <ul className="mt-1 text-center text-[11px] font-normal text-white/90">
          {shown.map((r) => (
            <li key={r.localId}>
              {r.residentName}
              {r.reason ? ` — ${r.reason}` : ""}
            </li>
          ))}
        </ul>
      </div>
    );
  }

  if (justSynced) {
    return (
      <div className="print:hidden flex items-center gap-2 bg-teal-600 text-white text-xs sm:text-sm font-medium px-4 py-2 justify-center">
        <RefreshCw className="h-4 w-4 shrink-0" />
        <span>{t("uiSynced").replace("{n}", String(justSynced))}</span>
      </div>
    );
  }

  return null;
}
</file>

<file path="resources/js/components/ui/PhotoViewer.tsx">
import { useEffect, useState } from "react";
import { ChevronLeft, ChevronRight, Download, Eye, FileText, ImagePlus, X } from "lucide-react";
import Portal from "./Portal";
import ConfirmDialog from "./ConfirmDialog";
import StatusModal from "./StatusModal";
import { useLanguage } from "../../i18n/LanguageContext";

/**
 * The one full-size photo / file viewer used everywhere (Inventory, Events,
 * Returns, Budget receipts, Residents). Dark like the rest of the app, steps
 * through a record's files (arrows, thumbnails, keyboard), shows PDFs inline,
 * and every viewer gets the same Download: confirm first, then a success
 * message once the file has actually been saved.
 */
export interface ViewerFile {
  url: string;
  mime?: string;
}

interface PhotoViewerProps {
  /** Currently shown file; null closes the viewer. */
  url: string | null;
  /** Title shown next to the chip (item name, resident name...). */
  name: string;
  /** Every file of the record, so the viewer can step through them. */
  urls?: string[];
  /** Optional per-file MIME types (for blob: URLs that have no extension). */
  mimes?: Record<string, string>;
  /** Chip text; defaults to "View photo". */
  label?: string;
  /** Small grey text after the name (for example a file size). */
  meta?: string;
  /** Hide Download for files that are not saved yet (just-picked blob: files). */
  allowDownload?: boolean;
  /** When given, an "Edit photo" button shows next to Download (for example to change a resident's photo). */
  onEdit?: () => void;
  editLabel?: string;
  onSelect: (url: string) => void;
  onClose: () => void;
  z?: number;
}

const extOf = (url: string) => {
  const clean = url.split("?")[0].split("#")[0];
  const dot = clean.lastIndexOf(".");
  return dot === -1 ? "" : clean.slice(dot + 1).toLowerCase();
};

export default function PhotoViewer({ url, name, urls, mimes, label, meta, allowDownload = true, onEdit, editLabel, onSelect, onClose, z = 80 }: PhotoViewerProps) {
  const { t } = useLanguage();
  const [confirmDownload, setConfirmDownload] = useState(false);
  const [downloading, setDownloading] = useState(false);
  const [downloaded, setDownloaded] = useState(false);
  const [failed, setFailed] = useState(false);

  const list = urls && urls.length > 0 ? urls : url ? [url] : [];
  const index = url ? Math.max(0, list.indexOf(url)) : 0;
  const many = list.length > 1;
  const step = (dir: 1 | -1) => onSelect(list[(index + dir + list.length) % list.length]);

  useEffect(() => {
    if (!url) return;
    const onKey = (e: KeyboardEvent) => {
      if (confirmDownload || downloaded || failed) return;
      if (e.key === "ArrowRight" && many) step(1);
      else if (e.key === "ArrowLeft" && many) step(-1);
      else if (e.key === "Escape") onClose();
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  });

  if (!url) return null;

  // A file that was only just picked (blob:/data:) is not saved anywhere yet, so there is nothing to download.
  const canDownload = allowDownload && !/^(blob|data):/.test(url);
  const mime = mimes?.[url];
  const ext = extOf(url);
  const kind: "image" | "pdf" | "other" = mime
    ? mime.startsWith("image/") ? "image" : mime === "application/pdf" ? "pdf" : "other"
    : url.startsWith("blob:") || ["jpg", "jpeg", "png", "gif", "webp", "bmp", "svg"].includes(ext) ? "image" : ext === "pdf" ? "pdf" : ext ? "other" : "image";

  // Only after the person confirms. Fetching the file as a blob and saving it
  // is the closest the browser gives JS to "it was downloaded", so the success
  // message appears only once that has actually worked.
  const doDownload = async () => {
    setConfirmDownload(false);
    setDownloading(true);
    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error("download failed");
      const blob = await res.blob();
      const href = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = href;
      const base = (name || "file").replace(/[\\/:*?"<>|]+/g, "-").trim() || "file";
      const suffix = ext || (blob.type.split("/")[1] ?? "");
      a.download = many ? `${base}-${index + 1}${suffix ? "." + suffix : ""}` : `${base}${suffix ? "." + suffix : ""}`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(href);
      setDownloaded(true);
    } catch {
      setFailed(true);
    } finally {
      setDownloading(false);
    }
  };

  return (
    <>
      <Portal>
        <div className="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center px-4" style={{ zIndex: z }} onClick={onClose}>
          <div className="bg-[#0A0E1A] border border-white/10 rounded-[30px] w-full max-w-2xl max-h-[90vh] overflow-hidden shadow-2xl flex flex-col" onClick={(e) => e.stopPropagation()}>
            <div className="px-5 py-4 border-b border-white/10 flex items-center justify-between gap-3">
              <div className="flex items-center gap-2.5 min-w-0">
                <span className="inline-flex items-center gap-1.5 rounded-full bg-[#4FBEB0]/10 text-[#7DD8CB] text-[11px] font-bold uppercase tracking-wide px-3 py-1 shrink-0">
                  <Eye className="h-3 w-3" />
                  {label ?? t("viewPhotoLabel")}
                </span>
                <span className="text-sm font-medium text-white truncate">{name}</span>
                {meta && <span className="text-xs text-white/40 shrink-0">&middot; {meta}</span>}
              </div>
              <button type="button" onClick={onClose} className="text-white/50 hover:text-white p-1 shrink-0" aria-label={t("closeLabel")}>
                <X className="h-5 w-5" />
              </button>
            </div>

            <div className="relative flex-1 overflow-auto bg-black/40 flex items-center justify-center p-6">
              {kind === "image" ? (
                <img src={url} alt={name} className="max-w-full max-h-[65vh] rounded-xl shadow-2xl" />
              ) : kind === "pdf" ? (
                <iframe src={url} title={name} className="w-full h-[65vh] rounded-xl border border-white/10 bg-white" />
              ) : (
                <div className="text-center py-10">
                  <FileText className="h-10 w-10 mx-auto text-white/40 mb-3" />
                  <p className="text-sm text-white/40">{t("previewNotAvailableLabel")}</p>
                </div>
              )}
              {many && (
                <>
                  <button
                    type="button"
                    onClick={() => step(-1)}
                    aria-label={t("viewerPrevLabel")}
                    className="absolute left-3 top-1/2 -translate-y-1/2 h-10 w-10 rounded-full border border-white/15 bg-black/60 text-white/85 backdrop-blur hover:bg-black/80 hover:text-white flex items-center justify-center transition active:scale-95"
                  >
                    <ChevronLeft className="h-5 w-5" />
                  </button>
                  <button
                    type="button"
                    onClick={() => step(1)}
                    aria-label={t("viewerNextLabel")}
                    className="absolute right-3 top-1/2 -translate-y-1/2 h-10 w-10 rounded-full border border-white/15 bg-black/60 text-white/85 backdrop-blur hover:bg-black/80 hover:text-white flex items-center justify-center transition active:scale-95"
                  >
                    <ChevronRight className="h-5 w-5" />
                  </button>
                  <span className="absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-black/60 px-3 py-1 text-[11px] font-bold text-white/80">
                    {index + 1} / {list.length}
                  </span>
                </>
              )}
            </div>

            <div className="px-5 py-4 border-t border-white/10 flex flex-wrap items-center justify-between gap-3">
              {many ? (
                <div className="flex items-center gap-2">
                  {list.map((u, i) => (
                    <button
                      key={u + i}
                      type="button"
                      onClick={() => onSelect(u)}
                      className={`flex h-10 w-10 items-center justify-center overflow-hidden rounded-lg border transition ${u === url ? "border-[#7DD8CB]" : "border-white/20 opacity-60 hover:opacity-100"}`}
                    >
                      {extOf(u) === "pdf" || mimes?.[u] === "application/pdf" ? <FileText className="h-5 w-5 text-white/60" /> : <img src={u} alt="" className="h-full w-full object-cover" />}
                    </button>
                  ))}
                </div>
              ) : (
                <span />
              )}
              <div className="flex flex-wrap items-center gap-2">
                {onEdit && (
                  <button
                    type="button"
                    onClick={onEdit}
                    className="inline-flex items-center gap-1.5 rounded-full border border-[#4FBEB0]/40 px-5 py-2.5 text-sm font-semibold text-[#7DD8CB] transition hover:bg-[#4FBEB0]/10"
                  >
                    <ImagePlus className="h-4 w-4" /> {editLabel ?? t("editPhotoLabel")}
                  </button>
                )}
                {canDownload && (
                  <button
                    type="button"
                    onClick={() => setConfirmDownload(true)}
                    disabled={downloading}
                    className="inline-flex items-center gap-1.5 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10 disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    <Download className="h-4 w-4" /> {downloading ? t("downloadingLabel") : t("downloadLabel")}
                  </button>
                )}
                <button type="button" onClick={onClose} className="px-5 py-2.5 rounded-full bg-sage-700 hover:bg-sage-800 text-white text-sm font-bold transition">
                  {t("closeLabel")}
                </button>
              </div>
            </div>
          </div>
        </div>
      </Portal>

      <ConfirmDialog
        open={confirmDownload}
        icon={<Download className="h-9 w-9" />}
        title={t("confirmDownloadFileTitle")}
        body={t("confirmDownloadFileBody")}
        cancelLabel={t("cancelLabel")}
        confirmLabel={t("downloadLabel")}
        onCancel={() => setConfirmDownload(false)}
        onConfirm={doDownload}
        z={z + 10}
      />
      <StatusModal open={downloaded} type="success" title={t("downloadSuccessTitle")} message={t("downloadFileSuccessMessage")} okLabel={t("okLabel")} onClose={() => setDownloaded(false)} z={z + 10} />
      <StatusModal open={failed} type="error" title={t("errorTitle")} message={t("downloadFileFailedMessage")} okLabel={t("okLabel")} onClose={() => setFailed(false)} z={z + 10} />
    </>
  );
}
</file>

<file path="resources/js/components/ui/ReceiptField.tsx">
import React, { useRef, useState } from "react";
import { FileText, Paperclip, Plus, Trash2, X } from "lucide-react";
import { useLanguage } from "../../i18n/LanguageContext";

/**
 * One file of an expense receipt. A receipt is either up to 5 photos
 * (JPG/PNG) or exactly one PDF -- never a mix.
 */
export interface ReceiptItem {
  id: string;
  url: string;
  name: string;
  isPdf: boolean;
  file: File | null;
  /** Position in the saved list (first file first) when it is already saved. */
  existingIndex: number | null;
}

const MAX_FILES = 5;
const MAX_BYTES = 5 * 1024 * 1024;

let uid = 0;
const nextId = () => `receipt-${Date.now()}-${uid++}`;

const extOf = (url: string) => (url.split("?")[0].split("#")[0].split(".").pop() || "").toLowerCase();
const nameOf = (url: string) => {
  try {
    const clean = url.split("?")[0].split("#")[0];
    return decodeURIComponent(clean.substring(clean.lastIndexOf("/") + 1)) || "receipt";
  } catch {
    return "receipt";
  }
};
const formatSize = (bytes: number) =>
  bytes >= 1048576 ? (bytes / 1048576).toFixed(1) + " MB" : Math.max(1, Math.round(bytes / 1024)) + " KB";

/** Saved receipt URLs (first file first) -> items for the field. */
export function receiptItemsFromUrls(urls: (string | null | undefined)[] | null | undefined): ReceiptItem[] {
  return (urls ?? [])
    .filter((u): u is string => !!u)
    .map((url, i) => ({ id: nextId(), url, name: nameOf(url), isPdf: extOf(url) === "pdf", file: null, existingIndex: i }));
}

/**
 * Writes the whole receipt list into a FormData the way the server expects:
 * receipts_sync=1, keep_receipts[] = saved files to keep (in order) and
 * receipts[] = newly picked files. Saved files not listed are removed.
 */
export function appendReceiptFields(fd: FormData, items: ReceiptItem[]) {
  fd.append("receipts_sync", "1");
  items.forEach((it) => {
    if (it.file) fd.append("receipts[]", it.file);
    else if (it.existingIndex !== null) fd.append("keep_receipts[]", String(it.existingIndex));
  });
}

/** True when the list differs from what is saved (added, removed or swapped). */
export function receiptItemsChanged(items: ReceiptItem[], savedCount: number): boolean {
  if (items.some((i) => i.file)) return true;
  if (items.length !== savedCount) return true;
  return items.some((it, i) => it.existingIndex !== i);
}

const BTN_WHITE =
  "inline-flex items-center rounded-full border border-white/25 px-4 py-2 text-sm font-semibold text-white hover:bg-white/15 transition";
const BTN_RED =
  "inline-flex items-center gap-1.5 rounded-full border border-red-500/30 px-4 py-2 text-sm font-semibold text-red-400 hover:bg-red-500/10 transition";
const BTN_GREEN =
  "inline-flex items-center gap-1.5 rounded-full border border-[#4FBEB0]/40 px-4 py-2 text-[13px] font-semibold text-[#7DD8CB] hover:bg-[#4FBEB0]/10 transition";
const BTN_WHITE_SM =
  "inline-flex items-center rounded-full border border-white/25 px-5 py-2.5 text-[15px] font-semibold text-white hover:bg-white/15 transition";
const BTN_RED_SM =
  "inline-flex items-center gap-1.5 rounded-full border border-red-500/30 px-5 py-2.5 text-[15px] font-semibold text-red-400 hover:bg-red-500/10 transition";
const X_BADGE_SM =
  "absolute -top-2 -right-2 h-6 w-6 rounded-full bg-black/60 hover:bg-black/80 border border-white/40 text-white backdrop-blur-sm flex items-center justify-center transition";
const X_BADGE =
  "absolute -top-2 -right-2 h-6 w-6 rounded-full bg-black/60 hover:bg-black/80 border border-white/40 text-white backdrop-blur-sm flex items-center justify-center transition";

interface ReceiptFieldProps {
  items: ReceiptItem[];
  onChange: (items: ReceiptItem[]) => void;
  /** Open the viewer on `item`; `all` is the whole list so it can step through the photos. */
  onPreview: (item: ReceiptItem, all: ReceiptItem[]) => void;
  /** Called with a ready-to-show message when a picked file is rejected. */
  onError?: (message: string) => void;
  /** Text of the green button while nothing is attached. */
  emptyLabel?: string;
}

/**
 * Receipt field for expense forms (Budget and Events, add and edit).
 *  - Photos: up to 5, a thumbnail grid with an X on each, a "+" tile, plus
 *    Preview and Delete (Delete clears all of them, the X removes one).
 *  - PDF: exactly one, shown as a file row with Replace and Preview.
 */
export default function ReceiptField({ items, onChange, onPreview, onError, emptyLabel }: ReceiptFieldProps) {
  const { t } = useLanguage();
  const inputRef = useRef<HTMLInputElement>(null);
  const [selectedId, setSelectedId] = useState<string | null>(null);

  const pdfMode = items.length > 0 && items[0].isPdf;
  const imageMode = items.length > 0 && !pdfMode;
  const full = items.length >= MAX_FILES;
  const selectedIndex = Math.max(0, items.findIndex((i) => i.id === selectedId));
  const selected = items[selectedIndex];

  const release = (list: ReceiptItem[]) => list.forEach((i) => i.file && URL.revokeObjectURL(i.url));

  const handlePick = (e: React.ChangeEvent<HTMLInputElement>) => {
    const picked = Array.from(e.target.files ?? []);
    e.target.value = "";
    if (picked.length === 0) return;

    const isPdfFile = (f: File) => f.type === "application/pdf" || f.name.toLowerCase().endsWith(".pdf");
    const isImgFile = (f: File) => f.type === "image/jpeg" || f.type === "image/png";

    const bad = picked.filter((f) => !isPdfFile(f) && !isImgFile(f));
    if (bad.length > 0) {
      onError?.(t("receiptTypeError"));
    }
    const ok = picked.filter((f) => isPdfFile(f) || isImgFile(f));
    if (ok.some((f) => f.size > MAX_BYTES)) {
      onError?.(t("photoTooLarge"));
      return;
    }
    const pdfs = ok.filter(isPdfFile);
    const imgs = ok.filter((f) => !isPdfFile(f));
    if (pdfs.length > 0 && imgs.length > 0) {
      onError?.(t("receiptMixError"));
      return;
    }

    const make = (f: File): ReceiptItem => ({
      id: nextId(),
      url: URL.createObjectURL(f),
      name: f.name,
      isPdf: isPdfFile(f),
      file: f,
      existingIndex: null,
    });

    if (pdfs.length > 0) {
      // One PDF only -- it replaces whatever receipt was attached.
      if (pdfs.length > 1) onError?.(t("receiptPdfSingleError"));
      release(items);
      onChange([make(pdfs[0])]);
      return;
    }
    if (imgs.length > 0) {
      // Photos replace a PDF, or are added to the photos already attached.
      const base = pdfMode ? [] : items;
      if (pdfMode) release(items);
      const room = MAX_FILES - base.length;
      if (imgs.length > room) onError?.(t("photosMaxReached").replace("{n}", String(MAX_FILES)));
      onChange([...base, ...imgs.slice(0, room).map(make)]);
    }
  };

  const remove = (id: string) => {
    const gone = items.find((i) => i.id === id);
    if (gone?.file) URL.revokeObjectURL(gone.url);
    onChange(items.filter((i) => i.id !== id));
  };

  const removeAll = () => {
    release(items);
    onChange([]);
  };

  const input = (
    <input
      ref={inputRef}
      type="file"
      multiple
      accept="image/jpeg,image/png,application/pdf,.jpg,.jpeg,.png,.pdf"
      className="hidden"
      onChange={handlePick}
    />
  );

  // ── Nothing attached yet ────────────────────────────────────────────────
  if (items.length === 0) {
    return (
      <div>
        {input}
        <button type="button" onClick={() => inputRef.current?.click()} className={BTN_GREEN}>
          <Paperclip className="h-4 w-4" /> {emptyLabel ?? t("attachReceiptLabel")}
        </button>
      </div>
    );
  }

  // ── One PDF ─────────────────────────────────────────────────────────────
  if (pdfMode) {
    const pdf = items[0];
    return (
      <div className="flex flex-wrap items-center gap-x-4 gap-y-2">
        {input}
        <div className="flex min-w-0 flex-1 basis-48 items-center gap-3">
          <div className="relative shrink-0">
            <button
              type="button"
              onClick={() => onPreview(pdf, items)}
              title={t("photoPreviewBtn")}
              aria-label={t("photoPreviewBtn")}
              className="h-16 w-16 rounded-lg border border-[#4FBEB0]/40 bg-[#4FBEB0]/10 text-[#7DD8CB] flex items-center justify-center hover:border-[#7DD8CB] transition"
            >
              <FileText className="h-5 w-5" />
            </button>
            <button type="button" onClick={() => remove(pdf.id)} title={t("removeLabel")} aria-label={t("removeLabel")} className={X_BADGE_SM}>
              <X className="h-3.5 w-3.5" />
            </button>
          </div>
          <div className="min-w-0">
            <button
              type="button"
              onClick={() => onPreview(pdf, items)}
              className="block max-w-full truncate text-left text-sm font-semibold text-[#7DD8CB] hover:underline"
            >
              {pdf.file ? pdf.name : t("savedReceiptLabel")}
            </button>
            <p className="text-xs text-white/45">PDF{pdf.file ? ` · ${formatSize(pdf.file.size)}` : ""}</p>
          </div>
        </div>
        <div className="ml-auto flex items-center gap-2">
          <button type="button" onClick={() => inputRef.current?.click()} className={BTN_WHITE_SM}>
            {t("replaceReceiptLabel")}
          </button>
          <button type="button" onClick={() => onPreview(pdf, items)} className={BTN_WHITE_SM}>
            {t("photoPreviewBtn")}
          </button>
        </div>
      </div>
    );
  }

  // ── Photos ──────────────────────────────────────────────────────────────
  return (
    <div className="flex flex-wrap items-center gap-2">
      {input}
      {items.map((it) => {
        const isSelected = selected?.id === it.id;
        return (
          <div key={it.id} className="relative">
            <button
              type="button"
              onClick={() => setSelectedId(it.id)}
              onDoubleClick={() => onPreview(it, items)}
              aria-pressed={isSelected}
              className={`block h-16 w-16 overflow-hidden rounded-lg border-2 bg-black/30 transition ${
                isSelected ? "border-[#7DD8CB]" : "border-white/15 hover:border-white/40"
              }`}
            >
              <img src={it.url} alt="" className="h-full w-full object-cover" />
            </button>
            <button type="button" onClick={() => remove(it.id)} title={t("removeLabel")} aria-label={t("removeLabel")} className={X_BADGE_SM}>
              <X className="h-3.5 w-3.5" />
            </button>
          </div>
        );
      })}
      {!full && (
        <button
          type="button"
          onClick={() => inputRef.current?.click()}
          title={t("addMorePhotosLabel")}
          aria-label={t("addMorePhotosLabel")}
          className="h-16 w-16 rounded-lg border border-dashed border-white/25 bg-white/[0.02] text-white/50 hover:text-[#7DD8CB] hover:border-[#4FBEB0]/50 flex items-center justify-center transition"
        >
          <Plus className="h-6 w-6" />
        </button>
      )}
      <span className="text-xs text-white/45">
        {t("photosCountLabel").replace("{n}", String(items.length)).replace("{max}", String(MAX_FILES))}
      </span>
      <div className="ml-auto flex items-center gap-2">
        <button type="button" onClick={() => selected && onPreview(selected, items)} className={BTN_WHITE_SM}>
          {t("photoPreviewBtn")}
        </button>
        <button type="button" onClick={removeAll} className={BTN_RED_SM}>
          <Trash2 className="h-4 w-4" /> {t("photoDeleteBtn")}
        </button>
      </div>
    </div>
  );
}
</file>

<file path="resources/js/components/ui/SaveButton.tsx">
import type { ReactNode } from "react";
import { Save, type LucideIcon } from "lucide-react";

// The one save/submit button used by every form: a pill with the action's
// label and a round icon chip. It stays flat and un-clickable until there is
// something to save (`active`), then turns navy -- same look as Add New Record
// and Create New Event, so every form behaves the same.
export default function SaveButton({
  active,
  children,
  type = "submit",
  onClick,
  title,
  className = "",
  size = "md",
  icon: Icon = Save,
  plain = false,
}: {
  active: boolean;
  children: ReactNode;
  type?: "submit" | "button";
  onClick?: () => void;
  title?: string;
  className?: string;
  size?: "md" | "sm";
  icon?: LucideIcon;
  /** Flat white pill (no colour gradient) -- used for Close buttons. */
  plain?: boolean;
}) {
  const sm = size === "sm";
  return (
    <button
      type={type}
      onClick={onClick}
      disabled={!active}
      title={title}
      className={`group inline-flex items-center justify-center rounded-full border font-semibold uppercase tracking-wide shadow-sm transition-all duration-500 ease-out ${
        sm ? "gap-2.5 py-1.5 pl-5 pr-1.5 text-[13px]" : "gap-3 py-2 pl-6 pr-2 text-base"
      } ${
        active && plain
          ? "border-slate-300 bg-white text-slate-700 hover:bg-slate-50"
          : active
          ? "btn-live-navy border-[#1E3A5F] bg-[#1E3A5F] text-white hover:border-[#274A77] hover:bg-[#274A77]"
          : "border-white/10 bg-white/[0.02] text-white/30 cursor-not-allowed"
      } ${className}`}
    >
      {children}
      <span
        className={`flex shrink-0 items-center justify-center rounded-full transition-colors duration-500 ease-out ${
          sm ? "h-8 w-8" : "h-11 w-11"
        } ${active && plain ? "bg-slate-100 group-hover:bg-slate-200" : active ? "bg-white/20 group-hover:bg-white/30" : "bg-white/5"}`}
      >
        <Icon className={`${sm ? "h-4 w-4" : "h-5 w-5"} ${active && plain ? "text-slate-700" : active ? "text-white" : "text-white/20"}`} />
      </span>
    </button>
  );
}
