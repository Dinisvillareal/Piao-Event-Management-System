<file path="app/Console/Commands/DbGrants.php">
<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\Schema;

/**
 * Prints the SQL that creates a restricted database account for the running application.
 *
 * Why: the triggers and the hash chain protect the records, but an account that may drop triggers or
 * rewrite the log tables could still undo them. The application account therefore gets only what it needs:
 *   - the three history tables: SELECT and INSERT (the ledger also UPDATE, for the one-time undo mark)
 *   - every other table: SELECT, INSERT, UPDATE, DELETE
 *   - never TRIGGER, ALTER, DROP, CREATE, or any global privilege
 * Migrations are run by a separate administrator account, never by this one.
 * The command only prints; it changes nothing, so it can be read and reviewed before it is run.
 */
class DbGrants extends Command
{
    protected $signature = 'db:grants {--user=piao_app : account name} {--host=localhost : host it connects from} {--database= : database name}';

    protected $description = 'Print the SQL for a restricted application database account (read it, then run it as the administrator).';

    /** table => privileges. Anything not listed gets the default. */
    public const HISTORY = [
        'activity_logs'      => 'SELECT, INSERT',
        'generated_reports'  => 'SELECT, INSERT',
        'inventory_unit_logs' => 'SELECT, INSERT, UPDATE',
        'attendance_scans'   => 'SELECT, INSERT',
    ];

    public const DEFAULT = 'SELECT, INSERT, UPDATE, DELETE';

    public function handle(): int
    {
        $db = $this->option('database') ?: config('database.connections.' . config('database.default') . '.database');
        $user = $this->option('user');
        $host = $this->option('host');
        if (! preg_match('/^[A-Za-z0-9_]+$/', (string) $user) || ! preg_match('/^[A-Za-z0-9_.%-]+$/', (string) $host) || ! preg_match('/^[A-Za-z0-9_]+$/', (string) $db)) {
            $this->error('The account, host and database names may only hold letters, digits, and _ . % -');

            return self::FAILURE;
        }

        $this->line("-- Run as the database administrator. Replace the password first.");
        $this->line("CREATE USER IF NOT EXISTS '{$user}'@'{$host}' IDENTIFIED BY 'CHANGE-THIS-PASSWORD';");
        $this->line("REVOKE ALL PRIVILEGES, GRANT OPTION FROM '{$user}'@'{$host}';");

        foreach ($this->tables() as $table) {
            $this->line("GRANT " . (self::HISTORY[$table] ?? self::DEFAULT) . " ON `{$db}`.`{$table}` TO '{$user}'@'{$host}';");
        }
        $this->line('FLUSH PRIVILEGES;');
        $this->line("-- Then set DB_USERNAME={$user} and DB_PASSWORD in .env. Keep the administrator account for `php artisan migrate` only.");

        return self::SUCCESS;
    }

    /** @return string[] */
    public function tables(): array
    {
        $names = array_map(fn ($t) => $t['name'], Schema::getTables());
        $names = array_values(array_unique(array_filter($names, fn ($n) => $n !== 'migrations')));
        sort($names);

        return $names;
    }
}
</file>

<file path="app/Console/Commands/LogVerify.php">
<?php

namespace App\Console\Commands;

use App\Support\AuditChain;
use Illuminate\Console\Command;
use Illuminate\Support\Facades\Schema;

/**
 * Checks the activity log, the report history, the inventory ledger and the attendance scan ledger for tampering (see App\Support\AuditChain).
 *
 *   php artisan log:verify            walks all four and names the rows that were edited, removed or added by hand
 *   php artisan log:verify --anchor   when a table is intact, also saves a checkpoint (its newest row), so that rows
 *                                     later cut off the end are caught as well
 *
 * It only reads; it changes nothing except the checkpoint files when asked to.
 */
class LogVerify extends Command
{
    protected $signature = 'log:verify {--anchor : Save the newest row of each intact table as a checkpoint}';

    protected $description = 'Check the activity log, the report history, the inventory ledger and the attendance scan ledger for edited, removed or hand-added rows';

    private const TITLES = ['activity_logs' => 'Activity log', 'generated_reports' => 'Report history', 'inventory_unit_logs' => 'Inventory ledger', 'attendance_scans' => 'Attendance scan ledger'];

    public function handle(): int
    {
        $failed = false;

        foreach (array_keys(AuditChain::TABLES) as $table) {
            $failed = !$this->verify($table) || $failed;
        }

        return $failed ? self::FAILURE : self::SUCCESS;
    }

    private function verify(string $table): bool
    {
        $title = self::TITLES[$table] ?? $table;

        if (!Schema::hasColumn($table, 'row_hash')) {
            $this->newLine();
            $this->line("== {$title} ==");
            $this->warn('Not set up yet: run php artisan migrate.');

            return true;
        }

        $r = AuditChain::check($table);

        $this->newLine();
        $this->line("== {$title} ==");
        $this->line("Rows:                    {$r['rows']}");
        $this->line("Protected by the chain: {$r['chained']}");
        $this->line("Older, before the chain: {$r['unchained']}");
        if ($r['anchor']) {
            $this->line("Checkpoint:             row #{$r['anchor']['id']}, saved {$r['anchor']['saved_at']}");
        }

        if ($r['problems']) {
            $this->error("TAMPERING DETECTED in the " . strtolower($title) . ". It does not match its fingerprints:");
            foreach (array_slice($r['problems'], 0, 25) as $p) {
                $this->line("  Row #{$p['id']} {$p['problem']}");
            }
            if (count($r['problems']) > 25) {
                $this->line('  ... and ' . (count($r['problems']) - 25) . ' more.');
            }

            return false;
        }

        $this->info($r['chained']
            ? "The " . strtolower($title) . " is intact: every protected row matches its fingerprint and follows the one before it."
            : "No row of the " . strtolower($title) . " is protected by the chain yet (new rows will be).");

        if ($this->option('anchor') && $r['head']) {
            file_put_contents(AuditChain::anchorPath($table), json_encode(['id' => $r['head']['id'], 'hash' => $r['head']['hash'], 'saved_at' => now()->toDateTimeString()]));
            $this->line("Checkpoint saved at row #{$r['head']['id']}.");
        }

        return true;
    }
}
</file>

<file path="app/Console/Commands/SecurityCheck.php">
<?php

namespace App\Console\Commands;

use App\Support\AuditChain;
use Illuminate\Console\Command;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;

/**
 * One command that says whether this installation is set up safely. It only reads.
 *
 *   php artisan security:check
 *
 * FAIL = fix before going live (the command then exits with an error); WARN = worth fixing; OK = fine.
 */
class SecurityCheck extends Command
{
    protected $signature = 'security:check';

    protected $description = 'Check the settings, the database account, the database locks and the log fingerprints for safety problems';

    /** @var array<int, array{0:string,1:string,2:string}> */
    private array $results = [];

    public function handle(): int
    {
        $this->settings();
        $this->databaseAccount();
        $this->locks();
        $this->fingerprints();
        $this->attendance();

        $this->table(['', 'Check', 'Detail'], array_map(fn ($r) => $r, $this->results));
        $failed = count(array_filter($this->results, fn ($r) => $r[0] === 'FAIL'));
        $warned = count(array_filter($this->results, fn ($r) => $r[0] === 'WARN'));
        $this->line($failed ? "{$failed} problem(s) to fix." : ($warned ? "No failures; {$warned} warning(s)." : 'All checks passed.'));

        return $failed ? self::FAILURE : self::SUCCESS;
    }

    private function add(string $level, string $check, string $detail = ''): void
    {
        $this->results[] = [$level, $check, $detail];
    }

    private function settings(): void
    {
        config('app.debug') ? $this->add('FAIL', 'Debug mode is off', 'APP_DEBUG is true: error pages would show code and settings. Set APP_DEBUG=false.') : $this->add('OK', 'Debug mode is off');
        strlen((string) config('app.key')) > 10 ? $this->add('OK', 'Application key is set') : $this->add('FAIL', 'Application key is set', 'Run php artisan key:generate.');
        config('app.env') === 'production' ? $this->add('OK', 'Environment is production') : $this->add('WARN', 'Environment is production', 'APP_ENV is "' . config('app.env') . '".');

        $https = str_starts_with((string) config('app.url'), 'https://');
        if ($https) {
            config('session.secure') ? $this->add('OK', 'Session cookie only over https') : $this->add('FAIL', 'Session cookie only over https', 'Set SESSION_SECURE_COOKIE=true.');
        } else {
            $this->add('WARN', 'Site is served over https', 'APP_URL is not https; passwords and sessions travel unencrypted outside a closed network.');
        }
        config('session.http_only') ? $this->add('OK', 'Session cookie hidden from scripts') : $this->add('FAIL', 'Session cookie hidden from scripts', 'Set SESSION_HTTP_ONLY=true.');
        in_array(strtolower((string) config('session.same_site')), ['lax', 'strict'], true) ? $this->add('OK', 'Session cookie same-site') : $this->add('FAIL', 'Session cookie same-site', 'Set SESSION_SAME_SITE=lax.');
        (int) config('session.lifetime') <= 240 ? $this->add('OK', 'Session expires after inactivity') : $this->add('WARN', 'Session expires after inactivity', config('session.lifetime') . ' minutes is long.');
        (int) config('hashing.bcrypt.rounds', 12) >= 12 ? $this->add('OK', 'Password hashing cost') : $this->add('WARN', 'Password hashing cost', 'BCRYPT_ROUNDS is below 12.');

        $own = (string) env('AUDIT_LOG_KEY');
        $own !== '' && $own !== (string) config('app.key')
            ? $this->add('OK', 'Log fingerprint key is separate', 'AUDIT_LOG_KEY differs from APP_KEY.')
            : $this->add('WARN', 'Log fingerprint key is separate', 'Set AUDIT_LOG_KEY so that changing APP_KEY never breaks the fingerprints, and keep a copy of it outside the database.');
    }

    private function databaseAccount(): void
    {
        $driver = DB::getDriverName();
        if (! in_array($driver, ['mysql', 'mariadb'], true)) {
            $this->add('WARN', 'Database account is restricted', "Not checked on {$driver}.");

            return;
        }
        try {
            $grants = collect(DB::select('SHOW GRANTS FOR CURRENT_USER()'))->map(fn ($r) => (string) array_values((array) $r)[0])->implode("\n");
        } catch (\Throwable $e) {
            $this->add('WARN', 'Database account is restricted', 'The grants could not be read.');

            return;
        }
        $broad = preg_match('/ALL PRIVILEGES|\bTRIGGER\b|\bALTER\b|\bDROP\b|\bCREATE\b/i', $grants);
        $broad
            ? $this->add('FAIL', 'Database account is restricted', 'The account can change tables or triggers, so it could remove the locks. Create a limited account with php artisan db:grants and use it in .env.')
            : $this->add('OK', 'Database account is restricted', 'It cannot alter tables or triggers.');
    }

    private function locks(): void
    {
        $names = $this->triggerNames();
        $need = ['activity_logs_append_only_update', 'activity_logs_append_only_delete', 'generated_reports_append_only_update', 'inventory_unit_logs_ledger_core_update', 'attendance_scans_append_only_update', 'attendance_scans_append_only_delete', 'attendances_scanned_row_delete_lock', 'attendances_status_follows_times_update', 'users_deleted_at_lock'];
        $missing = array_values(array_diff($need, $names));
        $missing
            ? $this->add('FAIL', 'Database locks are in place', 'Missing: ' . implode(', ', $missing) . '. Run php artisan migrate.')
            : $this->add('OK', 'Database locks are in place', count($names) . ' triggers found.');
    }

    /** @return string[] */
    private function triggerNames(): array
    {
        if (DB::getDriverName() === 'sqlite') {
            return array_map(fn ($r) => $r->name, DB::select("SELECT name FROM sqlite_master WHERE type = 'trigger'"));
        }

        return array_map(fn ($r) => $r->TRIGGER_NAME, DB::select('SELECT TRIGGER_NAME FROM information_schema.TRIGGERS WHERE TRIGGER_SCHEMA = DATABASE()'));
    }

    private function attendance(): void
    {
        if (! Schema::hasTable('attendance_scans')) {
            $this->add('FAIL', 'Attendance matches the scan ledger', 'The scan ledger is missing. Run php artisan migrate.');

            return;
        }
        $n = count(\App\Support\AttendanceLedger::check());
        $n
            ? $this->add('FAIL', 'Attendance matches the scan ledger', "{$n} row(s) differ. Run php artisan attendance:reconcile for the details.")
            : $this->add('OK', 'Attendance matches the scan ledger', 'Every attendance row agrees with its scans.');
    }

    private function fingerprints(): void
    {
        $bad = [];
        foreach (array_keys(AuditChain::TABLES) as $table) {
            if (! Schema::hasTable($table) || ! Schema::hasColumn($table, 'row_hash')) {
                $bad[] = "{$table} (no fingerprint column)";

                continue;
            }
            if (AuditChain::check($table)['problems'] ?? false) {
                $bad[] = $table;
            }
        }
        $bad
            ? $this->add('FAIL', 'Log fingerprints are intact', 'Check: ' . implode(', ', $bad) . '. Run php artisan log:verify for the exact rows.')
            : $this->add('OK', 'Log fingerprints are intact', 'Activity log, report history, inventory ledger and attendance scan ledger verify.');
    }
}
</file>

<file path="app/Console/Commands/TranslateContent.php">
<?php

namespace App\Console\Commands;

use App\Models\AgeBracket;
use App\Models\CivilStatus;
use App\Models\ContentTranslation;
use App\Models\CurrentStatus;
use App\Models\Event;
use App\Models\EventExpense;
use App\Models\Feedback;
use App\Models\InventoryItem;
use App\Models\Membership;
use Illuminate\Console\Command;
use Stichoza\GoogleTranslate\GoogleTranslate;

class TranslateContent extends Command
{
    protected $signature = 'content:translate';
    protected $description = 'Translate all DB content into tl/ceb and store in content_translations';

    public function handle()
    {
        if (! class_exists(GoogleTranslate::class)) {
            $this->error('The translation package is not installed yet.');
            $this->line('Run:  composer require stichoza/google-translate-php');
            $this->line('Then run this command again.');
            return self::FAILURE;
        }

        $locales = ['tl' => 'fil', 'ceb' => 'ceb'];

        $strings = [];

        // Memberships
        foreach (Membership::withoutTrashed()->get() as $m) {
            foreach (['name', 'description'] as $f) {
                if ($m->$f) $strings[] = $m->$f;
            }
        }

        // Events
        foreach (Event::withoutTrashed()->get() as $e) {
            foreach (['name', 'description', 'location', 'notification_message'] as $f) {
                if ($e->$f) $strings[] = $e->$f;
            }
        }

        // Inventory
        foreach (InventoryItem::withoutTrashed()->get() as $i) {
            foreach (['name', 'notes', 'storage_location'] as $f) {
                if ($i->$f) $strings[] = $i->$f;
            }
        }

        // Event expenses (budget)
        foreach (EventExpense::withTrashed()->get() as $x) {
            foreach (['item', 'notes'] as $f) {
                if ($x->$f) $strings[] = $x->$f;
            }
        }

        // Civil statuses
        foreach (CivilStatus::withTrashed()->get() as $c) {
            if ($c->label) $strings[] = $c->label;
        }

        // Current statuses
        foreach (CurrentStatus::withTrashed()->get() as $c) {
            if ($c->label) $strings[] = $c->label;
        }

        // Age brackets
        foreach (AgeBracket::withTrashed()->get() as $a) {
            if ($a->label) $strings[] = $a->label;
        }

        // Feedback comments (optional, but included since they're user-visible)
        foreach (Feedback::all() as $fb) {
            if ($fb->comment) $strings[] = $fb->comment;
        }

        $strings = array_values(array_unique(array_filter($strings)));
        $this->info("Collected " . count($strings) . " unique strings to translate.");

        foreach ($locales as $ourCode => $googleCode) {
            $this->info("Translating to {$ourCode} ({$googleCode})...");
            $bar = $this->output->createProgressBar(count($strings));
            $bar->start();

            foreach ($strings as $text) {
                $exists = ContentTranslation::where('key', $text)
                    ->where('locale', $ourCode)
                    ->exists();
                if ($exists) {
                    $bar->advance();
                    continue;
                }

                try {
                    $tr = new GoogleTranslate('en');
                    $tr->setTarget($googleCode);
                    $translated = $tr->translate($text);

                    ContentTranslation::create([
                        'key'    => $text,
                        'locale' => $ourCode,
                        'value'  => $translated,
                    ]);
                } catch (\Exception $e) {
                    $this->newLine();
                    $this->error("Failed: " . substr($text, 0, 50) . " — " . $e->getMessage());
                }
                $bar->advance();
            }
            $bar->finish();
            $this->newLine();
        }

        $this->info('DONE.');
        return 0;
    }
}
</file>

<file path="app/Http/Controllers/AgeBracketController.php">
<?php

namespace App\Http\Controllers;

use App\Models\AgeBracket;
use App\Models\ActivityLog;
use Illuminate\Http\Request;

class AgeBracketController extends Controller
{
    public function index()
    {
        return response()->json(AgeBracket::orderBy('sort_order')->orderBy('min_age')->get());
    }

    /**
     * Finds an existing bracket whose [min_age, max_age] range overlaps
     * the given range, so Staff can't accidentally define two brackets
     * that both claim the same ages (e.g. adding "Teens" 12-18 while
     * "Youth" 13-17 already exists). A null max_age means "no upper
     * limit" on either side. $excludeId skips the bracket being edited
     * so saving it unchanged (or just renaming it) never conflicts with
     * itself.
     */
    private function findOverlappingBracket(int $minAge, ?int $maxAge, ?int $excludeId = null): ?AgeBracket
    {
        $incomingMax = $maxAge ?? PHP_INT_MAX;

        $query = AgeBracket::query();
        if ($excludeId !== null) {
            $query->where('id', '!=', $excludeId);
        }

        foreach ($query->get() as $bracket) {
            $existingMax = $bracket->max_age ?? PHP_INT_MAX;
            if ($minAge <= $existingMax && $bracket->min_age <= $incomingMax) {
                return $bracket;
            }
        }

        return null;
    }

    public function store(Request $request)
    {
        // One change at a time per list: the "already exists" / "still in use"
        // checks and the write that follows must not be interleaved with
        // another staff member's change to the same list.
        return $this->exclusively('lookup:age_brackets', fn () => $this->storeLocked($request));
    }

    private function storeLocked(Request $request)
    {
        if (!$this->isStaff()) {
            return response()->json(['message' => 'Unauthorized'], 403);
        }

        $request->validate([
            'label'      => 'required|string|max:50',
            'min_age'    => 'required|integer|min:0|max:120',
            'max_age'    => 'nullable|integer|min:0|max:120|gte:min_age',
            'sort_order' => 'nullable|integer|min:0|max:9999',
        ]);

        $conflict = $this->findOverlappingBracket($request->min_age, $request->max_age);
        if ($conflict) {
            $conflictRange = $conflict->min_age . '-' . ($conflict->max_age ?? '∞');
            $msg = "This age range overlaps with \"{$conflict->label}\" ({$conflictRange}). Adjust the range so it doesn't overlap an existing bracket.";
            return response()->json([
                'message' => $msg,
                'errors' => ['min_age' => [$msg]],
            ], 422);
        }

        $bracket = AgeBracket::create([
            'label'      => $request->label,
            'min_age'    => $request->min_age,
            'max_age'    => $request->max_age,
            'sort_order' => $request->sort_order ?? ((int) AgeBracket::max('sort_order') + 1),
        ]);

        AgeBracket::forgetCache();
        $this->createLog('Create Age Bracket', 'Profiling Settings', "Created age bracket '{$bracket->label}'");

        return response()->json($bracket, 201);
    }

    public function update(Request $request, $id)
    {
        // One change at a time per list: the "already exists" / "still in use"
        // checks and the write that follows must not be interleaved with
        // another staff member's change to the same list.
        return $this->exclusively('lookup:age_brackets', fn () => $this->updateLocked($request, $id));
    }

    private function updateLocked(Request $request, $id)
    {
        if (!$this->isStaff()) {
            return response()->json(['message' => 'Unauthorized'], 403);
        }

        $bracket = AgeBracket::findOrFail($id);

        $request->validate([
            'label'      => 'required|string|max:50',
            'min_age'    => 'required|integer|min:0|max:120',
            'max_age'    => 'nullable|integer|min:0|max:120|gte:min_age',
            'sort_order' => 'nullable|integer|min:0|max:9999',
        ]);

        $conflict = $this->findOverlappingBracket($request->min_age, $request->max_age, $bracket->id);
        if ($conflict) {
            $conflictRange = $conflict->min_age . '-' . ($conflict->max_age ?? '∞');
            $msg = "This age range overlaps with \"{$conflict->label}\" ({$conflictRange}). Adjust the range so it doesn't overlap an existing bracket.";
            return response()->json([
                'message' => $msg,
                'errors' => ['min_age' => [$msg]],
            ], 422);
        }

        $bracket->update([
            'label'      => $request->label,
            'min_age'    => $request->min_age,
            'max_age'    => $request->max_age,
            'sort_order' => $request->sort_order ?? $bracket->sort_order,
        ]);

        AgeBracket::forgetCache();
        $this->createLog('Update Age Bracket', 'Profiling Settings', "Updated age bracket '{$bracket->label}'");

        return response()->json($bracket);
    }

    public function destroy($id)
    {
        // One change at a time per list: the "already exists" / "still in use"
        // checks and the write that follows must not be interleaved with
        // another staff member's change to the same list.
        return $this->exclusively('lookup:age_brackets', fn () => $this->destroyLocked($id));
    }

    private function destroyLocked($id)
    {
        if (!$this->isStaff()) {
            return response()->json(['message' => 'Unauthorized'], 403);
        }

        $bracket = AgeBracket::findOrFail($id);

        // Guard against silently breaking a membership's eligibility rule
        // -- mirrors Membership::hasResidentsAssigned() / InventoryController's
        // own "still in use" checks.
        if ($bracket->memberships()->exists()) {
            return response()->json([
                'message' => "Archive Failed: \"{$bracket->label}\" is currently in use by a membership's eligibility rule.",
            ], 422);
        }

        $name = $bracket->label;
        // Record who archived it before soft-deleting -- otherwise the
        // Archive page has nothing to show but "SYSTEM".
        $bracket->deleted_by = auth()->user()->user_code;
        $bracket->save();
        $bracket->delete();

        AgeBracket::forgetCache();
        $this->createLog('Delete Age Bracket', 'Profiling Settings', "Deleted age bracket '{$name}'");

        return response()->json(['message' => 'Age bracket deleted successfully']);
    }

    public function restore($id)
    {
        // One change at a time per list: the "already exists" / "still in use"
        // checks and the write that follows must not be interleaved with
        // another staff member's change to the same list.
        return $this->exclusively('lookup:age_brackets', fn () => $this->restoreLocked($id));
    }

    private function restoreLocked($id)
    {
        if (!$this->isStaff()) {
            return response()->json(['message' => 'Unauthorized'], 403);
        }

        $bracket = AgeBracket::onlyTrashed()->findOrFail($id);
        $bracket->deleted_by = null;
        $bracket->restore();

        AgeBracket::forgetCache();
        $this->createLog('Restore Age Bracket', 'Profiling Settings', "Restored age bracket '{$bracket->label}'");

        return response()->json(['message' => 'Age bracket restored successfully']);
    }
}
</file>

<file path="app/Http/Controllers/MembershipController.php">
<?php

namespace App\Http\Controllers;

use App\Models\Membership;
use App\Models\ActivityLog;
use App\Models\AgeBracket;
use App\Support\Paged;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class MembershipController extends Controller
{
    // =========================
    // GET ALL (ACTIVE ONLY)
    // =========================
    public function index(Request $request)
    {
        // ✅ ONLY show active (not archived) memberships
        $query = Membership::withoutTrashed()
            ->where('is_active', true)
            ->with(['eligibleAgeBrackets', 'eligibleCivilStatus', 'eligibleCurrentStatus']);

        // paged=1 (Memberships screen): search, order and page are done here.
        if ($request->boolean('paged')) {
            // mine=<user id>: only the groups that resident belongs to (own id, or staff).
            if ($request->filled('mine')) {
                $mine = (int) $request->input('mine');
                if ($mine !== (int) auth()->id() && !$this->isStaff()) {
                    return response()->json(['message' => 'Unauthorized'], 403);
                }
                $query->whereIn('id', DB::table('membership_residents')->where('user_id', $mine)->select('membership_id'));
            }
            foreach (Paged::tokens($request->input('search')) as $word) {
                $like = Paged::like($word);
                $query->where(fn ($q) => $q->whereRaw('LOWER(name) LIKE ?', [$like])->orWhereRaw("LOWER(COALESCE(description, '')) LIKE ?", [$like]));
            }
            $paginator = $query->orderBy('id')->paginate(Paged::perPage($request, 6), ['*'], 'page', Paged::page($request));

            return response()->json(Paged::body($paginator, $paginator->getCollection()->values(), [
                'all_total' => Membership::withoutTrashed()->where('is_active', true)->count(),
            ]));
        }

        $memberships = $query->get();
        // eligible_gender is a plain enum column (no relation to eager-load)
        
        return response()->json($memberships);
    }

    // =========================
    // CREATE MEMBERSHIP
    // =========================
    public function store(Request $request)
    {
        if (!$this->isStaff()) {
            return response()->json(['message' => 'Unauthorized'], 403);
        }

        $request->validate([
            'name' => 'required|string|max:255',
            'description' => 'nullable|string',
            'eligible_age_bracket_ids' => 'nullable|array|max:20',
            'eligible_age_bracket_ids.*' => 'integer|distinct|exists:age_brackets,id',
            'eligible_civil_status_id' => 'nullable|exists:civil_statuses,id',
            'eligible_current_status_id' => 'nullable|exists:current_statuses,id',
            'eligible_gender' => 'nullable|in:Male,Female',
        ]);

        DB::beginTransaction();

        try {
            $membership = Membership::create([
                'name' => $request->name,
                'description' => $request->description,
                'is_active' => true,  // ✅ Explicitly set active
                'eligible_civil_status_id' => $request->eligible_civil_status_id ?: null,
                'eligible_current_status_id' => $request->eligible_current_status_id ?: null,
                'eligible_gender' => $request->eligible_gender ?: null,
            ]);

            $membership->eligibleAgeBrackets()->sync($this->ageBracketIds($request));

            $this->createLog(
                'Create Membership',
                'Membership',
                "Created membership '{$membership->name}'"
            );

            DB::commit();
            return response()->json($membership->load('eligibleAgeBrackets'), 201);

        } catch (\Exception $e) {
            DB::rollBack();
            return response()->json([
                'message' => 'Failed to create membership',
                'error' => $this->safeError($e),
            ], 500);
        }
    }

    /**
     * Live "who would qualify?" check for the Add / Edit form. Applies the same
     * rule as checkMembershipEligibility(): the resident's age bracket must be
     * one of the selected brackets (nothing selected = any age), and every other
     * filter that is set must match too. Nothing is saved.
     *
     * Residents with no birth date can never match an age rule, so they are
     * counted separately (missing_birth_date) for staff to fix.
     */
    public function eligibilityPreview(Request $request)
    {
        if (!$this->isStaff()) {
            return response()->json(['message' => 'Unauthorized'], 403);
        }

        $request->validate([
            'eligible_age_bracket_ids' => 'nullable|array|max:20',
            'eligible_age_bracket_ids.*' => 'integer|exists:age_brackets,id',
            'eligible_civil_status_id' => 'nullable|integer',
            'eligible_current_status_id' => 'nullable|integer',
            'eligible_gender' => 'nullable|in:Male,Female',
            'membership_id' => 'nullable|integer',
        ]);

        $bracketIds = $this->ageBracketIds($request);
        $civil = $request->filled('eligible_civil_status_id') ? (int) $request->eligible_civil_status_id : null;
        $current = $request->filled('eligible_current_status_id') ? (int) $request->eligible_current_status_id : null;
        $gender = $request->input('eligible_gender') ?: null;

        $matches = function ($user) use ($bracketIds, $civil, $current, $gender): bool {
            if (!empty($bracketIds)) {
                $bracket = AgeBracket::resolveForAge($user->age);
                if (!$bracket || !in_array((int) $bracket->id, $bracketIds, true)) return false;
            }
            if ($civil && (int) $user->civil_status_id !== $civil) return false;
            if ($current && !$user->currentStatuses->contains('id', $current)) return false;
            if ($gender && $user->gender !== $gender) return false;
            return true;
        };

        $residents = \App\Models\User::where('role', 'Resident')
            ->with('currentStatuses:id')
            ->get(['id', 'birth_date', 'civil_status_id', 'gender']);

        $qualify = $residents->filter($matches)->count();
        $missingBirth = empty($bracketIds) ? 0 : $residents->whereNull('birth_date')->count();

        // Editing a live program: how many CURRENT members would stop matching.
        $wouldLose = 0;
        if ($request->filled('membership_id')) {
            $membership = Membership::withoutTrashed()->find((int) $request->membership_id);
            if ($membership) {
                $wouldLose = $membership->users()->with('currentStatuses:id')->get()
                    ->reject($matches)->count();
            }
        }

        return response()->json([
            'qualify' => $qualify,
            'total_residents' => $residents->count(),
            'missing_birth_date' => $missingBirth,
            'current_members_no_longer_match' => $wouldLose,
        ]);
    }

    /** De-duplicated bracket ids from the request (empty = any age). */
    private function ageBracketIds(Request $request): array
    {
        return collect($request->input('eligible_age_bracket_ids', []))
            ->filter()->map(fn ($v) => (int) $v)->unique()->values()->all();
    }

    // =========================
    // SHOW MEMBERSHIP
    // =========================
    public function show($id)
    {
        return response()->json(
            Membership::withoutTrashed()
                ->with(['eligibleAgeBrackets', 'eligibleCivilStatus', 'eligibleCurrentStatus'])
                ->findOrFail($id)
        );
    }

    // =========================
    // UPDATE MEMBERSHIP
    // =========================
    public function update(Request $request, $id)
    {
        if (!$this->isStaff()) {
            return response()->json(['message' => 'Unauthorized'], 403);
        }

        $request->validate([
            'name' => 'required|string|max:255',
            'description' => 'nullable|string',
            'eligible_age_bracket_ids' => 'nullable|array|max:20',
            'eligible_age_bracket_ids.*' => 'integer|distinct|exists:age_brackets,id',
            'eligible_civil_status_id' => 'nullable|exists:civil_statuses,id',
            'eligible_current_status_id' => 'nullable|exists:current_statuses,id',
            'eligible_gender' => 'nullable|in:Male,Female',
        ]);

        DB::beginTransaction();

        try {
            // lockForUpdate: two staff saving the same membership at once are serialized, so the
            // age-bracket list is replaced by one save at a time (no mixed result).
            $membership = Membership::withoutTrashed()->lockForUpdate()->findOrFail($id);

            $membership->update([
                'name' => $request->name,
                'description' => $request->description,
                'eligible_civil_status_id' => $request->eligible_civil_status_id ?: null,
                'eligible_current_status_id' => $request->eligible_current_status_id ?: null,
                'eligible_gender' => $request->eligible_gender ?: null,
            ]);

            $membership->eligibleAgeBrackets()->sync($this->ageBracketIds($request));

            $this->createLog(
                'Update Membership',
                'Membership',
                "Updated membership '{$membership->name}'"
            );

            DB::commit();
            return response()->json($membership);

        } catch (\Exception $e) {
            DB::rollBack();
            return response()->json([
                'message' => 'Failed to update membership',
                'error' => $this->safeError($e),
            ], 500);
        }
    }

    // =========================
    // DELETE → NOW ARCHIVE
    // =========================
  public function destroy($id)
{
    if (!$this->isStaff()) {
        return response()->json(['message' => 'Unauthorized'], 403);
    }

    try {
        $membership = Membership::withoutTrashed()->findOrFail($id);
        $name = $membership->name;
        $residentCount = $membership->users()->count();
        
        if ($residentCount > 0) {
            $this->createLog(
                'Archive Membership Failed',
                'Membership',
                "Failed to archive membership '{$name}' - has {$residentCount} resident(s) assigned"
            );
            
            return response()->json([
                'message' => "Archive Failed: Membership is currently in use."
            ], 422);
        }
        
        DB::beginTransaction();
        
        // ✅ Pass the logged-in user's user_code
        $membership->archive(null, auth()->user()?->user_code);
        
        DB::commit();
        
        $this->createLog(
            'Archive Membership',
            'Membership',
            "Archived membership '{$name}'"
        );

        return response()->json([
            'message' => 'Membership archived successfully'
        ]);

    } catch (\Exception $e) {
        DB::rollBack();
        
        $this->createLog(
            'Archive Membership Error',
            'Membership',
            "Error archiving membership: " . $this->safeError($e)
        );
        
        return response()->json([
            'message' => 'Failed to archive membership: ' . $this->safeError($e)
        ], 500);
    }
}

    // ✅ NEW: Restore archived membership
    public function restore($id)
    {
        if (!$this->isStaff()) {
            return response()->json(['message' => 'Unauthorized'], 403);
        }

        DB::beginTransaction();

        try {
            $membership = Membership::onlyTrashed()->findOrFail($id);
            $name = $membership->name;
            
            $membership->unarchive();

            $this->createLog(
                'Restore Membership',
                'Membership',
                "Restored membership '{$name}'"
            );

            DB::commit();

            return response()->json([
                'message' => 'Membership restored successfully'
            ]);

        } catch (\Exception $e) {
            DB::rollBack();
            return response()->json([
                'message' => 'Failed to restore membership',
                'error' => $this->safeError($e),
            ], 500);
        }
    }

    // =========================
    // PAGINATION (ACTIVE ONLY)
    // =========================
    public function getPaginated(Request $request)
    {
        $perPage = $request->get('per_page', 15);
        
        // ✅ ONLY active memberships
        $memberships = Membership::withoutTrashed()
            ->where('is_active', true)
            ->paginate($perPage);
        
        return response()->json($memberships);
    }

    public function getSimplePaginated()
    {
        // ✅ ONLY active memberships
        return response()->json(
            Membership::withoutTrashed()
                ->where('is_active', true)
                ->simplePaginate(10)
        );
    }

    public function getCursorPaginated()
    {
        // ✅ ONLY active memberships
        return response()->json(
            Membership::withoutTrashed()
                ->where('is_active', true)
                ->cursorPaginate(10)
        );
    }

    public function searchPaginated(Request $request)
    {
        $search = $request->get('search');
        $perPage = $request->get('per_page', 10);

        // ✅ ONLY active memberships
        $memberships = Membership::withoutTrashed()
            ->where('is_active', true)
            ->when($search, function ($query, $search) {
                return $query->where('name', 'like', '%' . $search . '%')
                             ->orWhere('description', 'like', '%' . $search . '%');
            })
            ->paginate($perPage);

        return response()->json($memberships);
    }

    public function sortPaginated(Request $request)
    {
        $sortBy = $request->get('sort_by', 'id');
        $sortOrder = $request->get('sort_order', 'asc');
        $perPage = $request->get('per_page', 10);

        // ✅ ONLY active memberships
        return response()->json(
            Membership::withoutTrashed()
                ->where('is_active', true)
                ->orderBy($sortBy, $sortOrder)
                ->paginate($perPage)
        );
    }

    /**
     * Residents currently enrolled in this membership who no longer match
     * its eligibility rule (age bracket / civil status / current status /
     * gender). Eligibility is only checked when a resident is FIRST
     * assigned to a gated membership (see UserController::
     * checkMembershipEligibility) -- nothing re-checks it afterward, so a
     * resident who ages out of a bracket or whose status changes stays
     * enrolled indefinitely unless staff notice and remove them by hand.
     * This lets staff proactively find those cases instead of relying on
     * noticing by accident.
     */
    public function ineligibleMembers($id)
    {
        if (!$this->isStaff()) {
            return response()->json(['message' => 'Unauthorized'], 403);
        }

        $membership = Membership::withoutTrashed()->findOrFail($id);

        $requiredBracketIds = $membership->eligibleAgeBracketIds();

        if (empty($requiredBracketIds)
            && !$membership->eligible_civil_status_id
            && !$membership->eligible_current_status_id
            && !$membership->eligible_gender) {
            return response()->json(['ineligible' => []]);
        }

        $members = $membership->users()->with('currentStatuses')->get();

        $ineligible = [];

        foreach ($members as $user) {
            $reasons = [];

            if (!empty($requiredBracketIds)) {
                $bracket = AgeBracket::resolveForAge($user->age);
                if (!$bracket || !in_array((int) $bracket->id, $requiredBracketIds, true)) {
                    $reasons[] = 'no longer in the required age group';
                }
            }

            if ($membership->eligible_civil_status_id
                && (int) $user->civil_status_id !== (int) $membership->eligible_civil_status_id) {
                $reasons[] = 'civil status no longer matches';
            }

            if ($membership->eligible_current_status_id) {
                $currentStatusIds = $user->getRelationValue('currentStatuses')->pluck('id')->map(fn ($v) => (int) $v)->all();
                if (!in_array((int) $membership->eligible_current_status_id, $currentStatusIds, true)) {
                    $reasons[] = 'current status no longer matches';
                }
            }

            if ($membership->eligible_gender && $user->gender !== $membership->eligible_gender) {
                $reasons[] = 'gender no longer matches';
            }

            if (!empty($reasons)) {
                $ineligible[] = [
                    'id' => $user->id,
                    'name' => trim("{$user->first_name} {$user->last_name}"),
                    'user_code' => $user->user_code,
                    'reasons' => $reasons,
                ];
            }
        }

        return response()->json(['ineligible' => $ineligible]);
    }
}
