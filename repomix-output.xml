<file path="tests/Feature/ErrorTextHidingTest.php">
<?php

namespace Tests\Feature;

use App\Models\Event;
use App\Models\EventAttendance;
use App\Models\EventExpense;
use App\Models\InventoryItem;
use App\Models\Membership;
use App\Services\FacebookService;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Http\Client\ConnectionException;
use Illuminate\Http\UploadedFile;
use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Storage;
use Tests\Support;
use Tests\TestCase;

/**
 * When something unexpected breaks (a database error, a bug), the screen must show a
 * plain message only. The technical detail (SQL, table names, file paths) goes to the
 * server log. Messages written for staff, such as "Not enough stock", must still show.
 */
class ErrorTextHidingTest extends TestCase
{
    use RefreshDatabase, Support;

    /** What a real database failure looks like -- none of this may reach the browser. */
    private const SECRET = "SQLSTATE[42S02]: Base table or view not found: 1146 Table 'piao_db.secret_table' doesn't exist (Connection: mysql, SQL: insert into `secret_table`)";

    protected function setUp(): void
    {
        parent::setUp();
        Cache::flush();
        Storage::fake('public');
    }

    private function assertNoLeak($response): void
    {
        $body = $response->getContent();
        foreach (['SQLSTATE', 'secret_table', 'piao_db', 'Connection: mysql', 'insert into'] as $needle) {
            $this->assertStringNotContainsString($needle, $body, "'{$needle}' reached the browser");
        }
    }

    private function eventPayload(array $extra = []): array
    {
        return array_merge([
            'name' => 'Clean-up', 'description' => 'Drive', 'location' => 'Plaza',
            'event_start' => now()->addHours(4)->toDateTimeString(), 'event_end' => now()->addHours(6)->toDateTimeString(),
            'call_time_start' => now()->addHour()->toDateTimeString(), 'call_time_end' => now()->addHours(7)->toDateTimeString(),
        ], $extra);
    }

    // ---------------------------------------------------------------- events

    public function test_a_database_failure_while_creating_an_event_shows_a_plain_message_and_is_logged(): void
    {
        Log::spy();
        Event::creating(fn () => throw new \RuntimeException(self::SECRET));

        $res = $this->actingAs($this->staff())->postJson('/events', $this->eventPayload())->assertStatus(500);

        $this->assertNoLeak($res);
        $this->assertSame('Failed to create event: Something went wrong. Please try again.', $res->json('message'));
        Log::shouldHaveReceived('error')->withArgs(fn ($msg) => str_contains((string) $msg, 'secret_table'))->once();
    }

    public function test_the_plain_message_is_translated_for_tagalog_and_bisaya_users(): void
    {
        Event::creating(fn () => throw new \RuntimeException(self::SECRET));
        $staff = $this->staff();

        foreach (['tl', 'ceb'] as $lang) {
            $res = $this->actingAs($staff)->withHeader('X-Lang', $lang)->postJson('/events', $this->eventPayload())->assertStatus(500);

            $this->assertNoLeak($res);
            $this->assertStringNotContainsString('Something went wrong', $res->json('message'), "not translated for {$lang}");
        }
    }

    public function test_a_stock_shortage_while_creating_an_event_is_still_shown_to_staff(): void
    {
        $chairs = InventoryItem::create(['name' => 'Chairs', 'quantity' => 12, 'new_quantity' => 0, 'good_quantity' => 12, 'fair_quantity' => 0, 'poor_quantity' => 0]);

        $res = $this->actingAs($this->staff())->postJson('/events', $this->eventPayload([
            'borrowed_items' => [['inventory_item_id' => $chairs->id, 'quantity' => 20]],
        ]))->assertStatus(500);

        $this->assertStringContainsString('Not enough stock for "Chairs" (available: 12, requested: 20)', $res->json('message'));
        $this->assertSame(0, Event::count(), 'the whole event is cancelled');
    }

    // ---------------------------------------------------------------- scanning

    public function test_a_failed_scan_shows_only_a_plain_message(): void
    {
        $staff = $this->staff();
        $resident = $this->makeUser('Resident');
        $event = Event::create([
            'name' => 'Assembly', 'description' => 'Test', 'location' => 'Hall',
            'event_start' => now()->addHours(3), 'event_end' => now()->addHours(5),
            'call_time_start' => now()->subHour(), 'call_time_end' => now()->addHours(6),
        ]);
        EventAttendance::where('event_id', $event->id)->delete();
        EventAttendance::creating(fn () => throw new \RuntimeException(self::SECRET));

        $res = $this->actingAs($staff)->postJson('/attendance/time-in', ['event_id' => $event->id, 'user_id' => $resident->id]);

        $this->assertSame(500, $res->status(), $res->getContent());
        $this->assertNoLeak($res);
        $this->assertSame('Time-in failed', $res->json('message'));
        $this->assertSame('Something went wrong. Please try again.', $res->json('error'));
    }

    public function test_signing_out_twice_is_refused_and_leaves_no_open_transaction(): void
    {
        $staff = $this->staff();
        $resident = $this->makeUser('Resident');
        $event = Event::create([
            'name' => 'Assembly', 'description' => 'Test', 'location' => 'Hall',
            'event_start' => now()->subHours(3), 'event_end' => now()->subHour(),
            'call_time_start' => now()->subHours(4), 'call_time_end' => now()->addHours(2),
        ]);
        EventAttendance::updateOrCreate(
            ['event_id' => $event->id, 'user_id' => $resident->id],
            ['time_in' => now()->subHours(3), 'time_out' => now()->subMinutes(10), 'status' => 'Complete']
        );
        $before = DB::transactionLevel();

        $res = $this->actingAs($staff)->putJson('/attendance/time-out', ['event_id' => $event->id, 'user_id' => $resident->id]);

        $this->assertSame(400, $res->status(), $res->getContent());
        $this->assertSame('Member already signed out.', $res->json('message'));
        $this->assertSame($before, DB::transactionLevel(), 'the refused sign-out left a transaction open');
    }

    // ---------------------------------------------------------------- memberships

    public function test_a_failure_creating_a_membership_shows_a_plain_message(): void
    {
        Membership::creating(fn () => throw new \RuntimeException(self::SECRET));

        $res = $this->actingAs($this->staff())->postJson('/api/memberships', ['name' => 'Farmers'])->assertStatus(500);

        $this->assertNoLeak($res);
        $this->assertSame('Failed to create membership', $res->json('message'));
        $this->assertSame('Something went wrong. Please try again.', $res->json('error'));
    }

    // ---------------------------------------------------------------- archive, even with debug on

    public function test_the_archive_never_shows_the_technical_text_even_when_debug_is_on(): void
    {
        config(['app.debug' => true]);
        $staff = $this->staff();
        $event = Event::create([
            'name' => 'Assembly', 'description' => 'Test', 'location' => 'Hall',
            'event_start' => now()->addHours(3), 'event_end' => now()->addHours(5),
        ]);
        $x = $event->expenses()->create(['item' => 'Food', 'amount' => 100, 'receipt_path' => 'expense_receipts/1731900000_r.jpg']);
        $this->archived($x);
        EventExpense::restoring(fn () => throw new \RuntimeException(self::SECRET));

        $res = $this->actingAs($staff)->postJson('/api/archive/restore', ['type' => 'expense', 'id' => $x->id])->assertStatus(500);

        $this->assertNoLeak($res);
        $this->assertSame('Something went wrong. Please try again.', $res->json('message'));
    }

    // ---------------------------------------------------------------- facebook

    public function test_a_facebook_network_failure_does_not_expose_the_technical_text(): void
    {
        app(FacebookService::class)->connect('1234567890', 'TOKEN-abc');
        Http::fake(fn () => throw new ConnectionException('cURL error 6: Could not resolve host: graph.facebook.com for https://graph.facebook.com/v19.0/1234567890/feed'));

        [$ok, $message] = app(FacebookService::class)->postEvent('Title', 'Body');

        $this->assertFalse($ok);
        $this->assertSame('Could not reach Facebook. Please try again later.', $message);
        $this->assertStringNotContainsString('1234567890', $message);
        $this->assertStringNotContainsString('cURL', $message);
    }
}
</file>

<file path="tests/Feature/ExpenseAmountLimitsTest.php">
<?php

namespace Tests\Feature;

use App\Models\Event;
use App\Models\EventExpense;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Http\UploadedFile;
use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\Storage;
use Tests\Support;
use Tests\TestCase;

/**
 * An expense must be a real amount: more than PHP 0, at most PHP 99,999,999.99
 * (what the money column holds) and at most two decimal places. A bad amount
 * must get a clear 422 message, never a server error, and nothing is saved.
 */
class ExpenseAmountLimitsTest extends TestCase
{
    use RefreshDatabase, Support;

    protected function setUp(): void
    {
        parent::setUp();
        Cache::flush();
        Storage::fake('public');
    }

    private function event(array $extra = []): Event
    {
        return Event::create(array_merge([
            'name' => 'Assembly', 'description' => 'Test', 'location' => 'Barangay Hall',
            'event_start' => now()->addHours(3), 'event_end' => now()->addHours(5),
            'call_time_start' => now()->subHour(), 'call_time_end' => now()->addHours(6),
        ], $extra));
    }

    private function add(Event $e, $amount)
    {
        return $this->actingAs($this->staff())->post("/events/{$e->id}/expenses", [
            'item' => 'Sound system', 'amount' => $amount, 'receipt' => $this->fakeImage('r.jpg'),
        ], ['Accept' => 'application/json']);
    }

    public function test_a_typo_with_too_many_zeros_is_refused_with_a_message_and_saves_nothing(): void
    {
        $e = $this->event();

        $this->add($e, '15000000000')->assertStatus(422)->assertJsonValidationErrors('amount');

        $this->assertSame(0, EventExpense::count());
    }

    public function test_the_largest_allowed_amount_is_accepted_and_one_cent_more_is_not(): void
    {
        $e = $this->event();

        $this->add($e, '99999999.99')->assertStatus(201);
        $this->add($e, '100000000')->assertStatus(422);

        $this->assertSame(1, EventExpense::count());
    }

    public function test_a_zero_peso_expense_is_refused(): void
    {
        $e = $this->event();

        $this->add($e, '0')->assertStatus(422)->assertJsonValidationErrors('amount');
        $this->add($e, '0.00')->assertStatus(422);
        $this->add($e, '-5')->assertStatus(422);

        $this->assertSame(0, EventExpense::count());
    }

    public function test_an_amount_that_would_round_down_to_zero_is_refused(): void
    {
        $e = $this->event();

        $this->add($e, '0.004')->assertStatus(422)->assertJsonValidationErrors('amount');
        $this->add($e, '12.345')->assertStatus(422);

        $this->assertSame(0, EventExpense::count());
    }

    public function test_one_centavo_and_normal_amounts_are_accepted(): void
    {
        $e = $this->event();

        $this->add($e, '0.01')->assertStatus(201);
        $this->add($e, '15000')->assertStatus(201);
        $this->add($e, '249.50')->assertStatus(201);

        $this->assertEquals(15249.51, round((float) EventExpense::sum('amount'), 2));
    }

    public function test_editing_an_expense_cannot_set_it_to_zero_or_too_large(): void
    {
        $e = $this->event();
        $id = $this->add($e, '400')->assertStatus(201)->json('expense.id');
        $staff = $this->staff();

        foreach (['0', '15000000000', '1.999'] as $bad) {
            $this->actingAs($staff)->putJson("/events/{$e->id}/expenses/{$id}", ['item' => 'Changed', 'amount' => $bad])
                ->assertStatus(422)->assertJsonValidationErrors('amount');
        }
        $this->assertEquals(400, EventExpense::find($id)->amount);

        $this->actingAs($staff)->putJson("/events/{$e->id}/expenses/{$id}", ['item' => 'Changed', 'amount' => 450.75])->assertOk();
        $this->assertEquals(450.75, EventExpense::find($id)->amount);
    }

    public function test_approved_budget_has_the_same_ceiling_everywhere(): void
    {
        $staff = $this->staff();
        $e = $this->event();

        $this->actingAs($staff)->putJson("/events/{$e->id}/budget", ['approved_budget' => '15000000000'])->assertStatus(422);
        $this->actingAs($staff)->putJson("/events/{$e->id}/budget", ['approved_budget' => '1000.456'])->assertStatus(422);
        $this->actingAs($staff)->putJson("/events/{$e->id}/budget", ['approved_budget' => '99999999.99'])->assertOk();
        $this->assertEquals(99999999.99, $e->fresh()->approved_budget);

        // A budget of exactly 0 stays allowed (it means "no money set aside").
        $this->actingAs($staff)->putJson("/events/{$e->id}/budget", ['approved_budget' => '0'])->assertOk();
    }

    public function test_the_error_message_is_clear_in_each_language(): void
    {
        $e = $this->event();
        $seen = [];

        foreach (['en', 'tl', 'ceb'] as $lang) {
            $msg = (string) $this->actingAs($this->staff())
                ->withHeader('X-Lang', $lang)
                ->post("/events/{$e->id}/expenses", [
                    'item' => 'x', 'amount' => '0', 'receipt' => $this->fakeImage('r.jpg'),
                ], ['Accept' => 'application/json'])
                ->assertStatus(422)->json('errors.amount.0');

            $this->assertNotSame('', $msg);
            $this->assertStringNotContainsString('validation.', $msg, "raw message key shown for $lang");
            $seen[$lang] = $msg;
        }

        $this->assertCount(3, array_unique($seen), 'each language should have its own wording');
    }
}
</file>

<file path="tests/Feature/ExpenseEditDeleteTest.php">
<?php

namespace Tests\Feature;

use App\Models\ActivityLog;
use App\Models\Event;
use App\Models\EventExpense;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Http\UploadedFile;
use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\Storage;
use Tests\Support;
use Tests\TestCase;

/**
 * Editing or deleting an expense must move the event's budget figures by exactly the
 * right amount, leave an audit trail, never lose a receipt, and respect who may do it.
 */
class ExpenseEditDeleteTest extends TestCase
{
    use RefreshDatabase, Support;

    protected function setUp(): void
    {
        parent::setUp();
        Cache::flush();
        Storage::fake('public');
    }

    private function event(float $budget = 10000, array $extra = []): Event
    {
        return Event::create(array_merge([
            'name' => 'Fiesta', 'description' => 'Test', 'location' => 'Barangay Hall',
            'event_start' => now()->addHours(3), 'event_end' => now()->addHours(5),
            'call_time_start' => now()->subHour(), 'call_time_end' => now()->addHours(6),
            'approved_budget' => $budget,
        ], $extra));
    }

    private function add(Event $e, string $item, $amount, $staff = null): EventExpense
    {
        $res = $this->actingAs($staff ?? $this->staff())->post("/events/{$e->id}/expenses", [
            'item' => $item, 'amount' => $amount, 'receipt' => $this->fakeImage('r.jpg'),
        ], ['Accept' => 'application/json'])->assertStatus(201);

        return EventExpense::findOrFail($res->json('expense.id'));
    }

    /** PUT with files has to be sent as a multipart POST with _method, like the app does. */
    private function edit(Event $e, EventExpense $x, array $data, $staff = null)
    {
        return $this->actingAs($staff ?? $this->staff())->post(
            "/events/{$e->id}/expenses/{$x->id}", $data + ['_method' => 'PUT'], ['Accept' => 'application/json']
        );
    }

    private function trail(EventExpense $x): array
    {
        return $x->fresh()->activity_log ?? [];
    }

    // ---------------------------------------------------------------- totals follow edits

    public function test_editing_an_amount_moves_the_totals_by_exactly_the_difference(): void
    {
        $e = $this->event(10000);
        $x = $this->add($e, 'Sound system', 4000);
        $this->add($e, 'Tarpaulin', 1000);

        $res = $this->edit($e, $x, ['item' => 'Sound system', 'amount' => 4500])->assertOk();

        $this->assertEquals(5500, $res->json('total_expenses'));
        $this->assertEquals(4500, $res->json('remaining'));
        $this->assertFalse($res->json('is_over_budget'));
        $this->assertEquals(4500, $x->fresh()->amount);
    }

    public function test_an_edit_can_push_the_event_over_budget_and_back_under(): void
    {
        $e = $this->event(10000);
        $x = $this->add($e, 'Stage', 9000);

        $over = $this->edit($e, $x, ['item' => 'Stage', 'amount' => 11000])->assertOk();
        $this->assertTrue($over->json('is_over_budget'));
        $this->assertEquals(1000, $over->json('over_by'));
        $this->assertEquals(-1000, $over->json('remaining'));
        $this->assertTrue(ActivityLog::where('description', 'like', '%over its approved budget%')->exists());

        $back = $this->edit($e, $x, ['item' => 'Stage', 'amount' => 9000])->assertOk();
        $this->assertFalse($back->json('is_over_budget'));
        $this->assertEquals(0, $back->json('over_by'));
        $this->assertEquals(1000, $back->json('remaining'));
        $this->assertTrue(ActivityLog::where('description', 'like', '%back within its approved budget%')->exists());
    }

    public function test_the_budget_report_shows_the_edited_amount_not_the_old_one(): void
    {
        $e = $this->event(10000);
        $x = $this->add($e, 'Food', 2000);
        $this->edit($e, $x, ['item' => 'Food', 'amount' => 2750.50])->assertOk();

        $row = collect($this->actingAs($this->staff())->getJson('/reports/budget-summary')->json('per_event'))->firstWhere('name', 'Fiesta');

        $this->assertEquals(2750.50, $row['total_expenses']);
        $this->assertEquals(7249.50, $row['remaining']);
    }

    // ---------------------------------------------------------------- delete

    public function test_deleting_an_expense_takes_it_out_of_the_totals_and_reports(): void
    {
        $e = $this->event(10000);
        $this->add($e, 'Food', 4000);
        $snack = $this->add($e, 'Snacks', 500);

        $res = $this->actingAs($this->staff())->deleteJson("/events/{$e->id}/expenses/{$snack->id}")->assertOk();

        $this->assertEquals(4000, $res->json('total_expenses'));
        $this->assertEquals(6000, $res->json('remaining'));
        $row = collect($this->actingAs($this->staff())->getJson('/reports/budget-summary')->json('per_event'))->firstWhere('name', 'Fiesta');
        $this->assertEquals(4000, $row['total_expenses']);
        $this->assertSame(1, $row['expense_count']);
    }

    public function test_a_deleted_expense_is_kept_in_the_database_and_can_be_recovered(): void
    {
        $e = $this->event();
        $x = $this->add($e, 'Snacks', 500);

        $this->actingAs($this->staff())->deleteJson("/events/{$e->id}/expenses/{$x->id}")->assertOk();

        $this->assertNull(EventExpense::find($x->id));
        $this->assertNotNull(EventExpense::withTrashed()->find($x->id));
        Storage::disk('public')->assertExists($x->receipt_path);   // the receipt file stays too
    }

    public function test_deleting_the_expense_that_made_an_event_over_budget_says_it_is_back_within(): void
    {
        $e = $this->event(1000);
        $x = $this->add($e, 'Sound system', 1500);

        $res = $this->actingAs($this->staff())->deleteJson("/events/{$e->id}/expenses/{$x->id}")->assertOk();

        $this->assertFalse($res->json('is_over_budget'));
        $this->assertEquals(1000, $res->json('remaining'));
        $this->assertTrue(ActivityLog::where('action', 'Delete')->where('description', 'like', '%back within its approved budget%')->exists());
    }

    // ---------------------------------------------------------------- archive and restore

    public function test_a_deleted_expense_shows_up_in_the_archive_as_an_expense(): void
    {
        $e = $this->event();
        $x = $this->add($e, 'Snacks', 500);
        $this->actingAs($this->staff())->deleteJson("/events/{$e->id}/expenses/{$x->id}")->assertOk();

        $row = collect($this->actingAs($this->staff())->getJson('/api/archived')->json())
            ->first(fn ($r) => $r['type'] === 'expense' && $r['id'] === $x->id);

        $this->assertNotNull($row, 'the deleted expense is listed in the Archive');
        $this->assertSame('Snacks', $row['name']);
    }

    public function test_restoring_an_expense_while_the_event_is_running_brings_the_money_back(): void
    {
        $e = $this->event(10000);
        $this->add($e, 'Food', 4000);
        $snack = $this->add($e, 'Snacks', 500);
        $staff = $this->staff();
        $this->actingAs($staff)->deleteJson("/events/{$e->id}/expenses/{$snack->id}")->assertOk();
        $this->assertEquals(4000, $e->fresh()->total_expenses);

        $this->actingAs($staff)->postJson('/api/archive/restore', ['type' => 'expense', 'id' => $snack->id])->assertOk();

        $this->assertNull($snack->fresh()->deleted_at);
        $this->assertEquals(4500, $e->fresh()->total_expenses);
        $this->assertTrue(ActivityLog::where('action', 'Restore')->where('description', 'like', "%Snacks%")->exists());
    }

    public function test_an_expense_cannot_be_restored_into_an_event_that_has_ended(): void
    {
        $e = $this->event(10000);
        $this->add($e, 'Food', 4000);
        $snack = $this->add($e, 'Snacks', 500);
        $staff = $this->staff();
        $this->actingAs($staff)->deleteJson("/events/{$e->id}/expenses/{$snack->id}")->assertOk();

        // The event finishes; its books are now closed.
        $e->update(['event_start' => now()->subDays(2), 'event_end' => now()->subDay(), 'call_time_start' => now()->subDays(2)->subHour(), 'call_time_end' => now()->subDay()]);

        $res = $this->actingAs($staff)->postJson('/api/archive/restore', ['type' => 'expense', 'id' => $snack->id])->assertStatus(422);

        $this->assertStringContainsString('already ended', (string) $res->json('message'));
        $this->assertNotNull(EventExpense::withTrashed()->find($snack->id)->deleted_at, 'still archived');
        $this->assertEquals(4000, $e->fresh()->total_expenses, 'the closed total did not change');
        $this->assertFalse(ActivityLog::where('action', 'Restore')->exists());
    }

    public function test_residents_cannot_restore_expenses(): void
    {
        $e = $this->event();
        $x = $this->add($e, 'Snacks', 500);
        $this->actingAs($this->staff())->deleteJson("/events/{$e->id}/expenses/{$x->id}")->assertOk();

        $this->actingAs($this->makeUser('Resident'))->postJson('/api/archive/restore', ['type' => 'expense', 'id' => $x->id])->assertStatus(403);

        $this->assertNotNull(EventExpense::withTrashed()->find($x->id)->deleted_at);
    }

    // ---------------------------------------------------------------- the audit trail

    public function test_an_edit_is_logged_with_what_changed_who_did_it_and_when(): void
    {
        $e = $this->event();
        $x = $this->add($e, 'Sound system', 4000);
        $staff = $this->staff();

        $this->edit($e, $x, ['item' => 'Sound system rental', 'amount' => 4500, 'notes' => 'Added speakers'], $staff)->assertOk();

        $entry = $this->trail($x)[0];
        $this->assertSame($staff->user_code, $entry['by']);
        $this->assertNotEmpty($entry['at']);
        $changes = collect($entry['changes'])->keyBy('field');
        $this->assertSame(['from' => 'Sound system', 'to' => 'Sound system rental'], ['from' => $changes['item']['from'], 'to' => $changes['item']['to']]);
        $this->assertSame(['from' => '4000.00', 'to' => '4500.00'], ['from' => $changes['amount']['from'], 'to' => $changes['amount']['to']]);
        $this->assertSame('Added speakers', $changes['notes']['to']);

        $this->assertTrue(ActivityLog::where('module', 'Budget')->where('description', 'like', '%PHP 4,000.00 -> PHP 4,500.00%')->exists());
    }

    public function test_saving_without_changing_anything_adds_nothing_to_the_trail(): void
    {
        $e = $this->event();
        $x = $this->add($e, 'Food', 800);

        $this->edit($e, $x, ['item' => 'Food', 'amount' => 800])->assertOk();

        $this->assertSame([], $this->trail($x));
    }

    public function test_several_edits_build_a_trail_in_order(): void
    {
        $e = $this->event();
        $x = $this->add($e, 'Food', 800);

        $this->edit($e, $x, ['item' => 'Food', 'amount' => 900])->assertOk();
        $this->edit($e, $x, ['item' => 'Food', 'amount' => 950])->assertOk();

        $trail = $this->trail($x);
        $this->assertCount(2, $trail);
        $this->assertSame('900.00', $trail[0]['changes'][0]['to']);
        $this->assertSame('950.00', $trail[1]['changes'][0]['to']);
    }

    // ---------------------------------------------------------------- receipts

    public function test_a_receipt_can_never_be_removed_without_a_replacement(): void
    {
        $e = $this->event();
        $x = $this->add($e, 'Food', 800);
        $path = $x->receipt_path;

        $this->edit($e, $x, ['item' => 'Food', 'amount' => 800, 'remove_receipt' => true])->assertStatus(422);
        $this->edit($e, $x, ['item' => 'Food', 'amount' => 800, 'receipts_sync' => true, 'keep_receipts' => []])->assertStatus(422);

        $this->assertSame($path, $x->fresh()->receipt_path);
        Storage::disk('public')->assertExists($path);
    }

    public function test_replacing_a_receipt_keeps_the_old_file_and_lists_it_in_the_history(): void
    {
        $e = $this->event();
        $x = $this->add($e, 'Food', 800);
        $old = $x->receipt_path;

        $this->edit($e, $x, ['item' => 'Food', 'amount' => 800, 'receipt' => $this->fakeImage('new.jpg')])->assertOk();

        $x = $x->fresh();
        $this->assertNotSame($old, $x->receipt_path);
        Storage::disk('public')->assertExists($old);                    // the old proof is not thrown away
        Storage::disk('public')->assertExists($x->receipt_path);
        $entry = $this->trail($x)[0];
        $this->assertContains($old, $entry['photos']);
        $this->assertContains($x->receipt_path, $entry['added']);
    }

    public function test_receipts_can_be_swapped_through_the_photo_list_and_the_removed_one_stays_in_history(): void
    {
        $e = $this->event();
        $x = $this->add($e, 'Food', 800);
        $old = $x->receipt_path;

        $this->edit($e, $x, [
            'item' => 'Food', 'amount' => 800, 'receipts_sync' => true, 'keep_receipts' => [],
            'receipts' => [$this->fakeImage('a.jpg'), $this->fakeImage('b.jpg')],
        ])->assertOk();

        $x = $x->fresh();
        $this->assertCount(2, $x->allReceiptPaths());
        $this->assertNotContains($old, $x->allReceiptPaths());
        Storage::disk('public')->assertExists($old);
        $this->assertContains($old, $this->trail($x)[0]['photos']);
    }

    // ---------------------------------------------------------------- scope and access

    public function test_an_expense_cannot_be_edited_or_deleted_through_another_event(): void
    {
        $fiesta = $this->event(10000);
        $other = $this->event(5000, ['name' => 'Sports Fest']);
        $x = $this->add($fiesta, 'Food', 800);

        $this->edit($other, $x, ['item' => 'Hacked', 'amount' => 1])->assertStatus(404);
        $this->actingAs($this->staff())->deleteJson("/events/{$other->id}/expenses/{$x->id}")->assertStatus(404);

        $x = $x->fresh();
        $this->assertSame('Food', $x->item);
        $this->assertEquals(800, $x->amount);
        $this->assertNull($x->deleted_at);
    }

    public function test_residents_and_visitors_cannot_edit_or_delete_expenses(): void
    {
        $e = $this->event();
        $x = $this->add($e, 'Food', 800);
        $resident = $this->makeUser('Resident');

        $this->edit($e, $x, ['item' => 'Changed', 'amount' => 1], $resident)->assertStatus(403);
        $this->actingAs($resident)->deleteJson("/events/{$e->id}/expenses/{$x->id}")->assertStatus(403);
        auth()->logout();
        $this->deleteJson("/events/{$e->id}/expenses/{$x->id}")->assertStatus(401);

        $this->assertSame('Food', $x->fresh()->item);
        $this->assertNull($x->fresh()->deleted_at);
    }

    public function test_an_expense_of_an_ended_event_cannot_be_edited_or_deleted(): void
    {
        $e = $this->event();
        $x = $this->add($e, 'Food', 800);
        $e->update(['event_start' => now()->subDays(2), 'event_end' => now()->subDay(), 'call_time_start' => now()->subDays(2)->subHour(), 'call_time_end' => now()->subDay()]);

        $this->edit($e, $x, ['item' => 'Food', 'amount' => 900])->assertStatus(422);
        $this->actingAs($this->staff())->deleteJson("/events/{$e->id}/expenses/{$x->id}")->assertStatus(422);

        $this->assertEquals(800, $x->fresh()->amount);
        $this->assertNull($x->fresh()->deleted_at);
    }

    public function test_a_failed_edit_leaves_the_expense_and_its_trail_untouched(): void
    {
        $e = $this->event();
        $x = $this->add($e, 'Food', 800);

        $this->edit($e, $x, ['item' => 'Food', 'amount' => 0])->assertStatus(422);
        $this->edit($e, $x, ['item' => '', 'amount' => 900])->assertStatus(422);

        $this->assertEquals(800, $x->fresh()->amount);
        $this->assertSame([], $this->trail($x));
    }
}
