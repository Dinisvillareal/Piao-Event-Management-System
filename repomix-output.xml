      <CornerWaveArt className="pointer-events-none absolute bottom-0 right-0 h-40 w-72 rotate-180 opacity-60 sm:h-56 sm:w-96" />

      <div className="relative flex items-center justify-end px-6 py-6 sm:px-10">
