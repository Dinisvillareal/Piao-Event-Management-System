<file path="resources/js/hooks/usePager.ts">
import { useCallback, useEffect, useRef, useState } from "react";

/**
 * Client-side paging for a list that is already in memory. `go` changes the
 * page and raises `switching` for ~350ms, so the list and the pager can show
 * the same skeleton every other paginated page flashes on Next / Previous.
 */
export default function usePager<T>(items: T[], pageSize: number, ms = 350, resetKey?: string) {
  const [page, setPage] = useState(1);
  const [switching, setSwitching] = useState(false);
  const timer = useRef<ReturnType<typeof setTimeout> | null>(null);

  const totalPages = Math.max(1, Math.ceil(items.length / pageSize));
  const current = Math.min(page, totalPages);
  const shown = items.slice((current - 1) * pageSize, current * pageSize);

  const go = useCallback((next: number) => {
    setPage(next);
    setSwitching(true);
    if (timer.current) clearTimeout(timer.current);
    timer.current = setTimeout(() => setSwitching(false), ms);
  }, [ms]);

  // A new filter / search / sort starts again from page 1.
  useEffect(() => { setPage(1); }, [resetKey]);

  useEffect(() => () => { if (timer.current) clearTimeout(timer.current); }, []);

  return { page: current, totalPages, shown, switching, go };
}
</file>

<file path="resources/js/hooks/useServerMatchIds.ts">
import { useEffect, useState } from "react";
import api from "../lib/api";

/**
 * Lets a small in-memory pick list use the server's search: while `query` is empty it returns
 * null (show everything); otherwise it asks `endpoint` (a paged list route) which records match
 * and returns their ids, so the list can be narrowed to those. Debounced; stale answers ignored.
 */
export default function useServerMatchIds(endpoint: string, query: string, params: Record<string, unknown> = {}): Set<string> | null {
  const [ids, setIds] = useState<Set<string> | null>(null);
  const extra = JSON.stringify(params);
  useEffect(() => {
    const q = query.trim();
    if (!q) { setIds(null); return; }
    let cancelled = false;
    const timer = setTimeout(async () => {
      try {
        const res = await api.get(endpoint, { params: { paged: 1, search: q, per_page: 100, ...JSON.parse(extra) } });
        const rows = Array.isArray(res.data?.data) ? res.data.data : Array.isArray(res.data) ? res.data : [];
        if (!cancelled) setIds(new Set(rows.map((r: any) => String(r.id))));
      } catch {
        if (!cancelled) setIds(new Set());
      }
    }, 250);
    return () => { cancelled = true; clearTimeout(timer); };
  }, [endpoint, query, extra]);
  return ids;
}
</file>

