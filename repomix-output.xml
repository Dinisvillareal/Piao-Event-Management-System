  secAskSetupBody: { en: "You will need your phone with an authenticator app (Google Authenticator, Microsoft Authenticator or Authy). Continue?", tl: "Kakailanganin mo ang iyong telepono na may authenticator app (Google Authenticator, Microsoft Authenticator o Authy). Magpatuloy?", ceb: "Kinahanglan nimo ang imong telepono nga naay authenticator app (Google Authenticator, Microsoft Authenticator o Authy). Magpadayon?" },
  secAskSetupYes: { en: "Yes, set up", tl: "Oo, i-set up", ceb: "Oo, i-set up" },
  secAskOnTitle: { en: "Turn on two-step login?", tl: "Buksan ang two-step login?", ceb: "Ablihi ang two-step login?" },
  secAskOnBody: { en: "From now on you will be asked for a 6-digit code from your authenticator app each time you sign in.", tl: "Mula ngayon, hihingan ka ng 6-digit na code mula sa iyong authenticator app sa bawat pag-sign in.", ceb: "Gikan karon, pangayoan ka og 6-digit nga code gikan sa imong authenticator app matag pag-sign in." },
  secAskOnYes: { en: "Yes, turn on", tl: "Oo, buksan", ceb: "Oo, ablihi" },
  secAskOffTitle: { en: "Turn off two-step login?", tl: "Isara ang two-step login?", ceb: "Sirhi ang two-step login?" },
  secAskOffBody: { en: "Your account will be less protected: a stolen password alone will be enough to sign in. Are you sure?", tl: "Mas mababa ang proteksyon ng account: sapat na ang nakaw na password para makapag-sign in. Sigurado ka ba?", ceb: "Mas ubos ang panalipod sa account: igo na ang kawatang password aron maka-sign in. Sigurado ka ba?" },
  secAskOffYes: { en: "Yes, turn off", tl: "Oo, isara", ceb: "Oo, sirhi" },
  secAskPwTitle: { en: "Change your password?", tl: "Palitan ang iyong password?", ceb: "Usbon ang imong password?" },
  secAskPwBody: { en: "Every other device will be signed out.", tl: "Masa-sign out ang lahat ng ibang device.", ceb: "Ma-sign out ang tanang ubang device." },
  secAskPwYes: { en: "Yes, change it", tl: "Oo, palitan", ceb: "Oo, usbon" },
  secDiscardTitle: { en: "Discard changes?", tl: "I-discard ang mga pagbabago?", ceb: "I-discard ang mga kausaban?" },
  secDiscardSetupBody: { en: "Your two-step setup will be lost and the QR code will stop working. You will need to start again.", tl: "Mawawala ang iyong setup at titigil ang QR code. Kailangan mong magsimula muli.", ceb: "Mawala ang imong setup ug mohunong ang QR code. Kinahanglan nimo magsugod pag-usab." },
  secDiscardTypedBody: { en: "Are you sure you want to cancel? Anything you typed will be cleared.", tl: "Sigurado ka bang kakanselahin ito? Buburahin ang mga na-type mo.", ceb: "Sigurado ka nga kanselahon ni? Papason ang imong gi-type." },
  secDiscardYes: { en: "Yes, discard", tl: "Oo, i-discard", ceb: "Oo, i-discard" },
  secKeepEditing: { en: "Keep editing", tl: "Ituloy ang pag-edit", ceb: "Padayon sa pag-edit" },
  secTwoStepBadge: { en: "Two-step", tl: "Two-step", ceb: "Two-step" },
  secAlertsTitle: { en: "Security alerts", tl: "Mga abiso sa seguridad", ceb: "Mga pahibalo sa seguridad" },
  secAlertsDesc: { en: "Staff changes, password resets, lock-outs and new sign-ins.", tl: "Mga pagbabago sa staff, pag-reset ng password, lock-out at bagong sign-in.", ceb: "Mga kausaban sa staff, pag-reset sa password, lock-out ug bag-ong sign-in." },
  secNoAlerts: { en: "No security alerts yet.", tl: "Wala pang abiso sa seguridad.", ceb: "Wala pay pahibalo sa seguridad." },
  secTransferOfferedTitle: { en: "You were offered the Head Staff role", tl: "Inalok sa iyo ang tungkulin ng Head Staff", ceb: "Gitanyag kanimo ang tahas sa Head Staff" },
  secTransferOfferedBody: { en: "{name} wants to hand the Head Staff role to you.", tl: "Nais ipasa ni {name} ang tungkulin ng Head Staff sa iyo.", ceb: "Gusto ni {name} nga ipasa kanimo ang tahas sa Head Staff." },
  secTransferExpires: { en: "The offer ends {when}.", tl: "Matatapos ang alok sa {when}.", ceb: "Matapos ang tanyag sa {when}." },
  secAcceptHeadRole: { en: "Accept Head Staff role", tl: "Tanggapin ang tungkulin ng Head Staff", ceb: "Dawata ang tahas sa Head Staff" },
  secAcceptBody: { en: "You will become the Head Staff and the current Head Staff becomes regular staff.", tl: "Ikaw ang magiging Head Staff at magiging regular na staff ang kasalukuyang Head Staff.", ceb: "Ikaw na ang Head Staff ug mahimong regular nga staff ang karon nga Head Staff." },
  secHeadOnly: { en: "Only the Head Staff can open this page.", tl: "Ang Head Staff lamang ang maaaring magbukas ng pahinang ito.", ceb: "Ang Head Staff lang ang makaabli niini nga panid." },
  secStaffAccountsSubtitle: { en: "Manage who has Staff access. Every sensitive action asks for your password and is recorded in the activity log.", tl: "Pamahalaan kung sino ang may Staff access. Humihingi ng password ang bawat sensitibong aksyon at naitatala sa activity log.", ceb: "Pagdumala kung kinsa ang naay Staff access. Nangayo og password ang matag sensitibong lihok ug natala sa activity log." },
  secStaffTeam: { en: "Staff team", tl: "Pangkat ng staff", ceb: "Grupo sa staff" },
  secStaffTeamDesc: { en: "Everyone with Staff access, their last sign-in and signed-in devices.", tl: "Lahat ng may Staff access, huling pag-sign in at mga naka-sign in na device.", ceb: "Tanang naay Staff access, katapusang pag-sign in ug mga naka-sign in nga device." },
  secHeadStaff: { en: "Head Staff", tl: "Head Staff", ceb: "Head Staff" },
  secSuspendedBadge: { en: "Suspended", tl: "Suspendido", ceb: "Suspendido" },
  secMustChangeBadge: { en: "Must change password", tl: "Kailangang magpalit ng password", ceb: "Kinahanglan mag-ilis og password" },
  secSecretary: { en: "Barangay Secretary", tl: "Kalihim ng Barangay", ceb: "Sekretaryo sa Barangay" },
  secDevicesSignedIn: { en: "{n} device(s) signed in", tl: "{n} device na naka-sign in", ceb: "{n} ka device nga naka-sign in" },
  secResetPassword: { en: "Reset password", tl: "I-reset ang password", ceb: "I-reset ang password" },
  secResetBody: { en: "The old password of {name} stops working and an activation slip is printed. They are signed out everywhere, then use “Activate my account” on the sign-in page to choose their own password. You never see it.", tl: "Titigil ang lumang password ni {name} at magpi-print ng activation slip. Masa-sign out sila sa lahat ng device, saka gagamitin ang “I-activate ang account ko” sa sign-in page para pumili ng sariling password. Hindi mo ito makikita.", ceb: "Dili na molihok ang daan nga password ni {name} ug mag-print og activation slip. Ma-sign out sila sa tanang device, unya gamiton ang “I-activate akong account” sa sign-in page aron mopili og kaugalingong password. Dili nimo kini makita." },
  secSignOutEverywhere: { en: "Sign out everywhere", tl: "I-sign out sa lahat", ceb: "I-sign out sa tanan" },
  secSignOutOthers: { en: "Sign out other devices", tl: "I-sign out ang ibang device", ceb: "I-sign out ang ubang device" },
  secSignedOutNotice: { en: "{name} was signed out of all devices.", tl: "Na-sign out si {name} sa lahat ng device.", ceb: "Na-sign out si {name} sa tanang device." },
  secMakeHead: { en: "Make Head Staff", tl: "Gawing Head Staff", ceb: "Himoa nga Head Staff" },
  secOfferHeadRole: { en: "Offer Head Staff role", tl: "Ialok ang tungkulin ng Head Staff", ceb: "Itanyag ang tahas sa Head Staff" },
  secTransferBody: { en: "{name} must accept the offer with their own password within {hours} hours. When they accept, you become regular staff and are signed out of your other devices.", tl: "Kailangang tanggapin ni {name} ang alok gamit ang sariling password sa loob ng {hours} oras. Kapag tinanggap, magiging regular na staff ka at masa-sign out ang iyong ibang device.", ceb: "Kinahanglan dawaton ni {name} ang tanyag gamit ang iyang password sulod sa {hours} ka oras. Kung dawaton, mahimo kang regular nga staff ug ma-sign out ang imong ubang device." },
  secTransferStartedNotice: { en: "Offer sent to {name}. It becomes final when they accept.", tl: "Naipadala ang alok kay {name}. Magiging pinal ito kapag tinanggap nila.", ceb: "Napadala ang tanyag kang {name}. Mahuman kini kung dawaton nila." },
  secSuspend: { en: "Suspend", tl: "Suspindihin", ceb: "Suspindihon" },
  secSuspendBody: { en: "{name} is signed out right away and cannot sign in until you reactivate the account. Their history stays in the logs. This needs your password and the code from your authenticator app.", tl: "Agad na masa-sign out si {name} at hindi makakapag-sign in hanggang muling buksan ang account. Mananatili ang kasaysayan sa logs. Kailangan dito ang password mo at ang code mula sa authenticator app.", ceb: "Dayon ma-sign out si {name} ug dili makasulod hangtod ablihan pag-usab ang account. Magpabilin ang kasaysayan sa logs. Kinahanglan niini ang imong password ug ang code gikan sa authenticator app." },
  secSuspendedNotice: { en: "{name} was suspended and signed out.", tl: "Sinuspinde at na-sign out si {name}.", ceb: "Gisuspinde ug na-sign out si {name}." },
  secReactivate: { en: "Reactivate", tl: "Muling buksan", ceb: "Ablihi pag-usab" },
  secReactivateBody: { en: "{name} will be able to sign in again.", tl: "Makakapag-sign in muli si {name}.", ceb: "Makasulod na usab si {name}." },
  secReactivatedNotice: { en: "{name} was reactivated.", tl: "Muling binuksan ang account ni {name}.", ceb: "Giablihan pag-usab ang account ni {name}." },
  secRemoveAccess: { en: "Remove staff access", tl: "Alisin ang staff access", ceb: "Kuhaa ang staff access" },
  secRemoveBody: { en: "{name} becomes a regular resident again and is signed out. Their history stays in the logs. This needs your password and the code from your authenticator app.", tl: "Magiging karaniwang residente muli si {name} at masa-sign out. Mananatili ang kasaysayan sa logs. Kailangan dito ang password mo at ang code mula sa authenticator app.", ceb: "Mahimong ordinaryong residente na usab si {name} ug ma-sign out. Magpabilin ang kasaysayan sa logs. Kinahanglan niini ang imong password ug ang code gikan sa authenticator app." },
  secDemotedNotice: { en: "{name} no longer has Staff access.", tl: "Wala nang Staff access si {name}.", ceb: "Wala na'y Staff access si {name}." },
  secAddStaffTitle: { en: "Give Staff access", tl: "Magbigay ng Staff access", ceb: "Hatagi og Staff access" },
  secAddStaffDesc: { en: "Search a resident who already has a portal account.", tl: "Maghanap ng residenteng may portal account na.", ceb: "Pangita og residente nga naay portal account na." },
  secSearchResidents: { en: "Search by name or user code...", tl: "Maghanap ayon sa pangalan o user code...", ceb: "Pangita pinaagi sa ngalan o user code..." },
  secNoCandidates: { en: "No matching residents with a portal account.", tl: "Walang katugmang residente na may portal account.", ceb: "Walay katugbang nga residente nga naay portal account." },
  secGiveStaffAccess: { en: "Give Staff access", tl: "Bigyan ng Staff access", ceb: "Hatagi og Staff access" },
  secPromoteBody: { en: "{name} will be able to see and manage resident records. Only give this to someone you trust.", tl: "Makikita at mapapamahalaan ni {name} ang mga talaan ng residente. Ibigay lamang sa pinagkakatiwalaan.", ceb: "Makita ug madumala ni {name} ang mga rekord sa residente. Hatagi lang ang kasaligan." },
  secPromotedNotice: { en: "{name} now has Staff access.", tl: "May Staff access na si {name}.", ceb: "Naa nay Staff access si {name}." },
  secAddStaffNote: { en: "Staff access is only given here. The Role field on resident records is locked.", tl: "Dito lamang ibinibigay ang Staff access. Naka-lock ang Role field sa mga talaan ng residente.", ceb: "Dinhi lang gihatag ang Staff access. Naka-lock ang Role field sa mga rekord sa residente." },
  secHandoverTitle: { en: "Head Staff handover", tl: "Paglilipat ng Head Staff", ceb: "Pagpasa sa Head Staff" },
  secHandoverDesc: { en: "Hand the Head Staff role to a new person safely.", tl: "Ligtas na ilipat ang tungkulin ng Head Staff sa bagong tao.", ceb: "Luwas nga ipasa ang tahas sa Head Staff sa bag-ong tawo." },
  secHandoverHow: { en: "Choose \"Make Head Staff\" on a staff member above. They accept with their own password, then the roles swap. There is always exactly one Head Staff.", tl: "Piliin ang \"Gawing Head Staff\" sa isang staff sa itaas. Tatanggapin nila gamit ang sariling password, saka magpapalit ang mga tungkulin. Palaging iisa ang Head Staff.", ceb: "Pilia ang \"Himoa nga Head Staff\" sa usa ka staff sa ibabaw. Dawaton nila gamit ang ilang password, unya mag-ilis ang mga tahas. Kanunay usa ra ang Head Staff." },
  secHandoverNeedStaff: { en: "Give Staff access to the new person first, then offer them the role.", tl: "Bigyan muna ng Staff access ang bagong tao, saka ialok ang tungkulin.", ceb: "Hatagi una og Staff access ang bag-ong tawo, unya itanyag ang tahas." },
  secTransferPending: { en: "Waiting for {name} to accept. The offer ends {when}.", tl: "Naghihintay na tanggapin ni {name}. Matatapos ang alok sa {when}.", ceb: "Naghulat nga dawaton ni {name}. Matapos ang tanyag sa {when}." },
  secCancelTransfer: { en: "Cancel offer", tl: "Kanselahin ang alok", ceb: "Kanselahon ang tanyag" },
  secTransferCancelledNotice: { en: "The offer was cancelled.", tl: "Kinansela ang alok.", ceb: "Gikansela ang tanyag." },
  secRecoveryCodesTitle: { en: "Recovery codes", tl: "Mga recovery code", ceb: "Mga recovery code" },
  secRecoveryCodesDesc: { en: "One-time codes that let you reset the Head Staff password if you ever forget it.", tl: "Mga one-time na code na magagamit para i-reset ang password ng Head Staff kung makalimutan.", ceb: "Mga one-time nga code nga magamit sa pag-reset sa password sa Head Staff kung makalimtan." },
  secCodesRemaining: { en: "{n} unused recovery codes remain.", tl: "{n} hindi pa nagagamit na recovery code ang natitira.", ceb: "{n} ka wala pa magamit nga recovery code ang nahabilin." },
  secNoCodes: { en: "No recovery codes yet. Create them and keep them safe.", tl: "Wala pang recovery code. Gumawa at itago nang ligtas.", ceb: "Wala pay recovery code. Paghimo ug tipigi nga luwas." },
  secCreateCodes: { en: "Create new codes", tl: "Gumawa ng bagong code", ceb: "Paghimo og bag-ong code" },
  secNewRecoveryCodes: { en: "New recovery codes", tl: "Bagong recovery code", ceb: "Bag-ong recovery code" },
  secCodesBody: { en: "Creating new codes voids every existing recovery code, including any you have already printed or used. Only the new set will work, so destroy the old printed sheet. The new codes are shown only once.", tl: "Ang paggawa ng bagong code ay magpapawalang-bisa sa lahat ng umiiral na recovery code, kasama ang mga naka-print o nagamit na. Ang bagong set lang ang gagana, kaya sirain ang lumang naka-print na papel. Isang beses lamang ipapakita ang mga bagong code.", ceb: "Ang paghimo og bag-ong code magpawalay-bisa sa tanang anaa nang recovery code, lakip ang gi-print o nagamit na. Ang bag-ong set ra ang molihok, busa gub-a ang daan nga gi-print nga papel. Kausa ra ipakita ang bag-ong mga code." },
  secCodesAdvice: { en: "Print them and keep them sealed with the Barangay Captain or in the barangay hall vault. Never store them on a shared computer.", tl: "I-print at itago nang selyado sa Punong Barangay o sa vault ng barangay hall. Huwag itago sa pinagsasaluhang computer.", ceb: "I-print ug tipigi nga selyado sa Kapitan sa Barangay o sa vault sa barangay hall. Ayaw tipigi sa gipaambit nga computer." },
  secRecoveryShowNote: { en: "Write these down or print them now. They will not be shown again. Any older codes, printed or not, no longer work.", tl: "Isulat o i-print ngayon. Hindi na ito ipapakita muli. Hindi na gagana ang mga lumang code, naka-print man o hindi.", ceb: "Isulat o i-print karon. Dili na kini ipakita pag-usab. Dili na molihok ang mga daan nga code, gi-print man o dili." },
  secRecoveryPrintNote: { en: "Keep this sheet sealed and locked away. Each code works once.", tl: "Itago nang selyado at naka-lock ang papel na ito. Isang beses lang gumagana ang bawat code.", ceb: "Tipigi nga selyado ug naka-lock kini nga papel. Kausa ra molihok ang matag code." },
  secPrint: { en: "Print", tl: "I-print", ceb: "I-print" },
  secCopy: { en: "Copy", tl: "Kopyahin", ceb: "Kopyaha" },
  secCopied: { en: "Copied", tl: "Nakopya", ceb: "Nakopya" },
  secDone: { en: "Done", tl: "Tapos na", ceb: "Human na" },
  secShownOnce: { en: "Shown only once.", tl: "Isang beses lang ipapakita.", ceb: "Kausa ra ipakita." },
  secTempPwTitle: { en: "Temporary password", tl: "Pansamantalang password", ceb: "Temporaryo nga password" },
  secTempPwBody: { en: "Give this to {name} in person. They must choose a new password when they sign in.", tl: "Ibigay ito kay {name} nang personal. Kailangan silang pumili ng bagong password pag-sign in.", ceb: "Ihatag kini kang {name} personal. Kinahanglan sila mopili og bag-ong password inig sign in." },
  secForgotLink: { en: "Forgot password?", tl: "Nakalimutan ang password?", ceb: "Nakalimot sa password?" },
  secForgotTitle: { en: "Forgot your password?", tl: "Nakalimutan ang password?", ceb: "Nakalimot sa imong password?" },
  secForgotAskTitle: { en: "Ask for a reset in person", tl: "Humingi ng reset nang personal", ceb: "Pangayo og reset personal" },
  secForgotAskBody: { en: "For safety, passwords are not reset online. Residents ask the barangay records office; staff ask the Head Staff. You will get a one-time password and choose your own when you sign in.", tl: "Para sa kaligtasan, hindi nire-reset online ang password. Magtanong ang residente sa records office; ang staff ay sa Head Staff. Makakakuha ka ng one-time na password at pipili ng sarili mo pag-sign in.", ceb: "Alang sa kaluwasan, dili gi-reset online ang password. Mangutana ang residente sa records office; ang staff sa Head Staff. Makadawat ka og one-time nga password ug mopili sa imong kaugalingon inig sign in." },
  secHeadRecoveryLink: { en: "I am the Head Staff and have a recovery code", tl: "Ako ang Head Staff at may recovery code ako", ceb: "Ako ang Head Staff ug naa koy recovery code" },
  secHeadRecoveryTitle: { en: "Head Staff recovery", tl: "Recovery ng Head Staff", ceb: "Recovery sa Head Staff" },
  secHeadRecoveryBody: { en: "Enter your user code, one unused recovery code, and a new password. Using a code also turns off two-step login, and every staff member is alerted.", tl: "Ilagay ang user code, isang hindi pa nagagamit na recovery code, at bagong password. Isinasara rin nito ang two-step login at aabisuhan ang lahat ng staff.", ceb: "Ibutang ang user code, usa ka wala pa magamit nga recovery code, ug bag-ong password. Gisirhan usab niini ang two-step login ug pahibaloan ang tanang staff." },
  secResetWithCode: { en: "Reset with recovery code", tl: "I-reset gamit ang recovery code", ceb: "I-reset gamit ang recovery code" },
  secRecoveryDone: { en: "Password reset. You can sign in now.", tl: "Na-reset na ang password. Maaari ka nang mag-sign in.", ceb: "Na-reset na ang password. Makasulod ka na." },
  secBackToSignIn: { en: "Back to sign in", tl: "Bumalik sa pag-sign in", ceb: "Balik sa pag-sign in" },
  secRoleLockedNote: { en: "Staff access is given or removed by the Head Staff in Staff Accounts.", tl: "Ang Head Staff ang nagbibigay o nag-aalis ng Staff access sa Staff Accounts.", ceb: "Ang Head Staff ang naghatag o nagkuha sa Staff access sa Staff Accounts." },
  secRoleHeadNote: { en: "As Head Staff you can set this. You will be asked for your password when you save.", tl: "Bilang Head Staff, maaari mo itong itakda. Hihingin ang iyong password pag-save.", ceb: "Isip Head Staff, imong mahimo kini i-set. Hangyoon ang imong password inig save." },
  secRoleSelfNote: { en: "You cannot change your own role. Use Make Head Staff in Staff Accounts to hand over.", tl: "Hindi mo mababago ang sarili mong role. Gamitin ang Make Head Staff sa Staff Accounts.", ceb: "Dili nimo mabag-o ang imong kaugalingong role. Gamita ang Make Head Staff sa Staff Accounts." },
  secRoleNeedsAccountNote: { en: "This resident needs a portal account before they can be made Staff.", tl: "Kailangan muna ng portal account ng residenteng ito bago maging Staff.", ceb: "Kinahanglan una og portal account kini nga residente sa dili pa mahimong Staff." },
  secNeedsAccountShort: { en: "needs portal account", tl: "kailangan ng portal account", ceb: "kinahanglan og portal account" },
  secStatusOn: { en: "On", tl: "Naka-on", ceb: "Naka-on" },
  secStatusOff: { en: "Off", tl: "Naka-off", ceb: "Naka-off" },
  secUnreadAlerts: { en: "New alerts", tl: "Bagong alerto", ceb: "Bag-ong alerto" },
  secStatStaff: { en: "Staff members", tl: "Mga Staff", ceb: "Mga Staff" },
  secStatTwoStep: { en: "Two-step on", tl: "May two-step", ceb: "Naay two-step" },
  secStatSuspended: { en: "Suspended", tl: "Naka-suspend", ceb: "Gi-suspend" },
  secStatCodes: { en: "Recovery codes left", tl: "Natitirang recovery code", ceb: "Nahabilin nga recovery code" },
  secMoreActions: { en: "More actions", tl: "Iba pang aksyon", ceb: "Uban pang aksyon" },
  secPwRulesTitle: { en: "Your new password must have:", tl: "Dapat may ganito ang bagong password:", ceb: "Kinahanglan niining bag-ong password:" },
  secStatStaffDesc: { en: "People with Staff access", tl: "May Staff access", ceb: "Naay Staff access" },
  secStatTwoStepDesc: { en: "Out of {n} use a login code", tl: "Sa {n} ay gumagamit ng login code", ceb: "Sa {n} migamit og login code" },
  secStatSuspendedDesc: { en: "Cannot sign in right now", tl: "Hindi makapag-sign in ngayon", ceb: "Dili makasulod karon" },
  secStatCodesDesc: { en: "For Head Staff account recovery", tl: "Para sa recovery ng Head Staff", ceb: "Para sa recovery sa Head Staff" },
  secManageAccount: { en: "Manage account", tl: "Pamahalaan ang account", ceb: "Dumala sa account" },
  secSectionAccount: { en: "Account", tl: "Account", ceb: "Account" },
  secSectionRecords: { en: "Records & audit", tl: "Mga record at audit", ceb: "Mga record ug audit" },
  secSectionConfig: { en: "Configuration", tl: "Konpigurasyon", ceb: "Konpigurasyon" },
  secChangeRoleTitle: { en: "Change role", tl: "Baguhin ang role", ceb: "Usba ang role" },
  secChangeRoleToStaff: { en: "This resident will get Staff access. Confirm with your password.", tl: "Magkakaroon ng Staff access ang residente. Kumpirmahin gamit ang iyong password.", ceb: "Makakuha og Staff access ang residente. Kumpirma gamit ang imong password." },
  secChangeRoleToResident: { en: "This person will lose Staff access and become a regular resident. Confirm with your password.", tl: "Mawawalan ng Staff access ang taong ito at magiging karaniwang residente. Kumpirmahin gamit ang iyong password.", ceb: "Mawad-an og Staff access kini nga tawo ug mahimong regular nga residente. Kumpirma gamit ang imong password." },
  secConfirmRoleChange: { en: "Confirm role change", tl: "Kumpirmahin ang pagbabago", ceb: "Kumpirma ang pagbag-o" },
  secItemDetails: { en: "Item Details", tl: "Detalye ng Item", ceb: "Detalye sa Item" },
  secItemsToRelease: { en: "Items to Release", tl: "Mga Item na I-release", ceb: "Mga Item nga I-release" },
  secStock: { en: "Stock", tl: "Stock", ceb: "Stock" },
  secAdditionalInfo: { en: "Additional Info", tl: "Karagdagang Impormasyon", ceb: "Dugang Impormasyon" },
  secHouseholdDetails: { en: "Household Details", tl: "Detalye ng Sambahayan", ceb: "Detalye sa Panimalay" },
  secContact: { en: "Contact", tl: "Kontak", ceb: "Kontak" },
