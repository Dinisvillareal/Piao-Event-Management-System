import { useEffect, useMemo, useRef, useState } from "react";
import Sidebar from "../../components/layout/Sidebar";
import TopHeader from "../../components/layout/TopHeader";
import MobileBrandBanner from "../../components/layout/MobileBrandBanner";
import SettingsView from "./views/SettingsView";
import DashboardView, { MemberDashboardSkeleton } from "./views/DashboardView";
import QRCodesView from "./views/QRCodesView";
import AttendanceView, { AttendanceRecord } from "./views/AttendanceView";
import NotificationsView from "./views/NotificationsView";
import EventsView from "./views/EventsView";
import MemberReplyAlerts from "../../components/ui/MemberReplyAlerts";
import type { AbsenceEntry } from "./views/EventsView";
import OfflineBanner from "../../components/ui/OfflineBanner";
import FeedbackPrompt from "../../components/ui/FeedbackPrompt";
import Skeleton from "../../components/ui/Skeleton";
import api from "../../lib/api";
import { memberKeyFromPath, memberUrlFor } from "../../lib/memberRoutes";
import { attendanceStatus } from "../../lib/attendanceStatus";
import { useThemeScope } from "../../lib/theme";
import { useFeedHealth, useVisiblePoll } from "../../hooks/useLiveFeeds";

export default function MemberDashboard() {
  const { t } = useLanguage();
  useThemeScope();
  const [active, setActiveState] = useState(() => memberKeyFromPath(window.location.pathname));
  const [member, setMember] = useState({
    id: "",
    name: "",
    // Last known first name, so the dashboard headline reads "Welcome back, Ana"
    // even during the first moments before the account call returns.
    first_name: (() => { try { return localStorage.getItem("member_first_name") || ""; } catch { return ""; } })(),
    last_name: "",
    user_code: ""
  });
  const [loading, setLoading] = useState(true);
  // Which dashboard feeds failed on their last try (kept data stays on screen; the dashboard says so).
  const { failedCount, lastOkAt, report, completeCycle } = useFeedHealth();
  const [retryingFeeds, setRetryingFeeds] = useState(false);
  const [memberships, setMemberships] = useState([]);
  const [userMemberships, setUserMemberships] = useState<any[]>([]);
  const [userMembershipsCount, setUserMembershipsCount] = useState(0);
  const [attendanceRecords, setAttendanceRecords] = useState<AttendanceRecord[]>([]);
  const [myFeedback, setMyFeedback] = useState<{ id: number; event_id: number; rating: number; comment: string | null; staff_liked_at?: string | null; staff_reply?: string | null; staff_replied_at?: string | null; edit_until?: number }[]>([]);
  const [myAbsences, setMyAbsences] = useState<AbsenceEntry[]>([]);
  const [focusEventId, setFocusEventId] = useState<number | null>(null);
  const [feedbackRules, setFeedbackRules] = useState({ close_after_hours: 12, edit_window_minutes: 30 });
  const [replyUnread, setReplyUnread] = useState(0);
  const [attended, setAttended] = useState(0);
  const [missed, setMissed] = useState(0);
  // Missed = no sign-in for an event that has already ENDED (upcoming / ongoing events don't count).
  const missedNow = useMemo(() => attendanceRecords.filter((r) => attendanceStatus(r) === 'missed').length, [attendanceRecords]);
  const [upcomingEvents, setUpcomingEvents] = useState<any[]>([]);
  const [pastEvents, setPastEvents] = useState<any[]>([]);
  const [notifications, setNotifications] = useState<any[]>([]);
  const [mobileSidebarOpen, setMobileSidebarOpen] = useState(false);
  // First-load flags for the data-driven pages, so each page can show its own
  // skeleton (like the staff pages) instead of flashing empty states / zeros.
  const [eventsLoading, setEventsLoading] = useState(true);
  const [attendanceLoading, setAttendanceLoading] = useState(true);

  const parseApiDate = (value: string) => {
    if (!value) return new Date(0);
    return new Date(value.replace(" ", "T"));
  };

  const allEvents = useMemo(() => [
    ...(Array.isArray(upcomingEvents) ? upcomingEvents : []),
    ...(Array.isArray(pastEvents) ? pastEvents : [])
  ], [upcomingEvents, pastEvents]);

  const fetchNotifications = async () => {
    try {
      const response = await api.get('/notifications');
      const data = response.data;
      const notificationsData = data.data || data || [];
      setNotifications(notificationsData.map((notification: any) => ({
        id: notification.id,
        title: notification.title,
        message: notification.message || notification.body,
        created_at: notification.created_at,
        is_updated: notification.is_updated,
        read: notification.read || false,
        updated_at_notification: notification.updated_at_notification,
      })));
      report('notifications', true);
    } catch (error) {
      console.error('Failed to fetch notifications:', error);
      report('notifications', false);
    }
  };

  useEffect(() => {
    const handlePopState = () => {
      setActiveState(memberKeyFromPath(window.location.pathname));
    };
    window.addEventListener("popstate", handlePopState);
    return () => window.removeEventListener("popstate", handlePopState);
  }, []);

  useEffect(() => {
    if (active === "dashboard") fetchNotifications();
  }, [active]);

  // Re-checks every 20s while the Notifications page is open -- paused while the tab is hidden.
  useVisiblePoll(() => { void fetchNotifications(); }, 20000, active === "notify");

  // Keeps the sidebar's unread badge live on every page: loads once, re-checks
  // every 20s, and refreshes right away when the Notifications page marks
  // something read (it fires "member-notifications-changed").
  // The badge number comes from the server's own unread count. Counting rows of
  // GET /notifications is wrong: that endpoint is paginated (unread first), so the
  // count was capped at one page and, after reading some, the next unread rows slid
  // in and the badge never went down.
  const [unreadNotificationCount, setUnreadNotificationCount] = useState(0);
  const fetchUnreadCount = async () => {
    try {
      const res = await api.get('/notifications/unread-count');
      setUnreadNotificationCount(Number(res.data?.count) || 0);
      report('unread', true);
    } catch (error) {
      console.error('Failed to fetch unread count:', error);
      report('unread', false);
    }
  };

  useEffect(() => {
    fetchNotifications();
    fetchUnreadCount();
    const onChanged = () => { fetchNotifications(); fetchUnreadCount(); };
    window.addEventListener("member-notifications-changed", onChanged);
    return () => window.removeEventListener("member-notifications-changed", onChanged);
  }, []);

  // The sidebar badge re-checks every 20s -- paused while the tab is hidden, and refreshed
  // straight away when the tab comes back to the front.
  useVisiblePoll(() => { void fetchNotifications(); void fetchUnreadCount(); }, 20000);

  useEffect(() => {
    api.get('/me')
      .then((res) => {
        const user = res.data;
        try { localStorage.setItem("member_first_name", user.first_name || ""); } catch { /* storage unavailable */ }
        setMember({
          id: user.id,
          name: `${user.first_name} ${user.last_name}${user.suffix ? `, ${user.suffix}` : ''}`,
          first_name: user.first_name,
          last_name: user.last_name,
          user_code: user.user_code || ''
        });
      })
      .catch((err) => console.error("Failed to fetch user:", err))
      .finally(() => setLoading(false));
  }, []);

  useEffect(() => {
    api.get('/api/memberships')
      .then((res) => {
        const data = res.data;
        setMemberships(data.data || data || []);
      })
      .catch(err => {
        console.error('Failed to fetch memberships:', err);
        setMemberships([]);
      });
  }, []);

  const fetchEvents = async () => {
    const portalMode = localStorage.getItem("portalMode") || sessionStorage.getItem("portalMode") || "member";
    try {
      const res = await api.get('/events-data', { headers: { 'X-Portal-Mode': portalMode } });
      const data = res.data;
      if (!data?.data) return;
      const now = new Date();
      const formattedEvents = data.data.map((event: any) => ({
        id: event.id,
        title: event.name,
        date: event.event_start,
        event_start: event.event_start,
        event_end: event.event_end,
        location: event.location,
        description: event.description,
        membership_ids: Array.isArray(event.membership_ids) ? event.membership_ids : [],
        memberships: Array.isArray(event.memberships) ? event.memberships : [],
        notificationMessage: event.notification_message,
        membershipNames: event.memberships?.map((m: any) => m.name) || [],
        startDate: event.event_start?.split(" ")[0],
        startTime: new Date(event.event_start).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      }));
      setUpcomingEvents(formattedEvents.filter((e: any) => parseApiDate(e.date) >= now));
      setPastEvents(formattedEvents.filter((e: any) => parseApiDate(e.date) < now));
      report('events', true);
    } catch (err) {
      console.error('Failed to fetch events:', err);
      report('events', false);
    } finally {
      setEventsLoading(false);
    }
  };

  const fetchUserMembershipsCount = async (memberId: string) => {
    try {
      const res = await api.get(`/membership-residents/${memberId}`, { params: { per_page: 100 } });
      const data = res.data;
      setUserMembershipsCount(data.total || data.memberships?.length || 0);
      setUserMemberships(Array.isArray(data.memberships) ? data.memberships : []);
      report('memberships', true);
    } catch (err) {
      console.error('Failed to fetch user memberships count:', err);
      report('memberships', false);
    }
  };

  const fetchAttendanceRecords = async (memberId: string) => {
    try {
      const res = await api.get(`/attendance/${memberId}`);
      const data = res.data;
      if (!Array.isArray(data)) return;
      const records: AttendanceRecord[] = data.map((item: any) => ({
        id: item.id,
        eventId: item.eventId,
        eventTitle: item.eventTitle ?? '—',
        eventDate: item.eventDate ?? '',
        eventEnd: item.eventEnd ?? '',
        location: item.location ?? '—',
        timeIn: item.timeIn ?? '',
        timeOut: item.timeOut ?? '',
        status: (!item.timeIn && !item.timeOut) ? 'missed' : (item.status?.toLowerCase() ?? 'incomplete'),
      }));
      const attendedCount = records.filter(r => r.status === 'complete').length;
      const missedCount = records.filter(r => attendanceStatus(r) === 'missed').length;
      setAttendanceRecords(records);
      setAttended(attendedCount);
      setMissed(missedCount);
      sessionStorage.setItem(`attendance_cache_${memberId}`, JSON.stringify({
        records, attended: attendedCount, missed: missedCount
      }));
      report('attendance', true);
    } catch (err) {
      console.error('Failed to fetch attendance:', err);
      report('attendance', false);
    } finally {
      setAttendanceLoading(false);
    }
  };

  useEffect(() => { fetchEvents(); }, []);
  useEffect(() => { fetchNotifications(); }, []);

  useEffect(() => {
    if (!member.id) return;
    fetchUserMembershipsCount(member.id);
  }, [member.id]);

  useEffect(() => {
    if (!member.id) return;
    const cacheKey = `attendance_cache_${member.id}`;
    const cachedData = sessionStorage.getItem(cacheKey);
    if (cachedData) {
      const parsedData = JSON.parse(cachedData);
      setAttendanceRecords(parsedData.records);
      setAttended(parsedData.attended);
      setMissed(parsedData.missed);
      setAttendanceLoading(false); // cached copy is good enough to show right away
    }
    fetchAttendanceRecords(member.id);
  }, [member.id]);

  // One refresh of everything the dashboard shows. "Last updated" only moves forward when
  // every feed answered, so the page never looks fresh while part of it is stale.
  const refreshDashboard = async () => {
    await Promise.all([
      fetchNotifications(),
      fetchEvents(),
      member.id ? fetchUserMembershipsCount(member.id) : Promise.resolve(),
      member.id ? fetchAttendanceRecords(member.id) : Promise.resolve(),
    ]);
    completeCycle();
  };

  // Every 20s while the dashboard is open -- paused while the tab is hidden, and run
  // straight away when it is shown again or the connection comes back.
  useVisiblePoll(() => { void refreshDashboard(); }, 20000, active === "dashboard");

  const retryDashboard = async () => {
    setRetryingFeeds(true);
    try { await refreshDashboard(); } finally { setRetryingFeeds(false); }
  };

  useEffect(() => {
    if (!member.id) return;
    // Re-read whenever the Events page is opened or staff respond, so a heart or reply shows up.
    const load = () => {
      api.get('/feedback/mine')
        .then((res) => setMyFeedback(Array.isArray(res.data) ? res.data.map((f: any) => ({ ...f, edit_until: Date.now() + (Number(f.edit_seconds_left) || 0) * 1000 })) : []))
        .catch((err) => console.error('Failed to fetch my feedback:', err));
      api.get('/feedback/absence/mine')
        .then((res) => setMyAbsences(Array.isArray(res.data) ? res.data.map((r: any) => ({ ...r, edit_until: Date.now() + (Number(r.edit_seconds_left) || 0) * 1000 })) : []))
        .catch((err) => console.error('Failed to fetch my absence reasons:', err));
      api.get('/settings/feedback-rules')
        .then((res) => { if (res.data?.close_after_hours) setFeedbackRules(res.data); })
        .catch(() => {});
    };
    load();
    window.addEventListener("member:feedback-responded", load);
    return () => window.removeEventListener("member:feedback-responded", load);
  }, [member.id, active === "events"]); // eslint-disable-line react-hooks/exhaustive-deps

  // Other parts of the portal (e.g. a notification card) ask to jump to a page.
  useEffect(() => {
    const go = (e: Event) => {
      const page = (e as CustomEvent).detail?.page;
      const eventId = (e as CustomEvent).detail?.eventId;
      if (page === "events" && typeof eventId === "number") setFocusEventId(eventId);
      if (typeof page === "string") setActiveRef.current(page);
    };
    window.addEventListener("member:open-page", go);
    return () => window.removeEventListener("member:open-page", go);
  }, []);

  // Data pages (Dashboard / Attendance / Events) read from state that is kept
  // in this component, so re-opening them would otherwise appear instantly with
  // no loading state. Like the staff pages, every visit shows the page's
  // skeleton briefly while the data is quietly refreshed.
  const [navSwitching, setNavSwitching] = useState(false);
  const navTimer = useRef<ReturnType<typeof setTimeout> | null>(null);

  const setActive = (page: string) => {
    window.history.pushState({}, "", memberUrlFor(page));
    if (["dashboard", "attendance", "events"].includes(page)) {
      setNavSwitching(true);
      if (navTimer.current) clearTimeout(navTimer.current);
      navTimer.current = setTimeout(() => setNavSwitching(false), 450);
      fetchEvents();
      if (member.id) fetchAttendanceRecords(member.id);
    }
    setActiveState(page);
  };
  // Listeners registered once always call the latest version.
  const setActiveRef = useRef(setActive);
  setActiveRef.current = setActive;

  const highlightText = (text: string, query: string) => {
    if (!query.trim()) return text;
    const regex = new RegExp(`(${query})`, "gi");
    const parts = text.split(regex);
    return parts.map((part, i) =>
      part.toLowerCase() === query.toLowerCase() ? (
        <mark key={i} className="bg-yellow-300 rounded-sm px-0.5">{part}</mark>
      ) : (part)
    );
  };

  return (
    <div className="member-shell min-h-screen overflow-x-hidden bg-[#0A0E1A] text-white">
      <div className="flex min-h-screen">
        <Sidebar
          active={active}
          setActive={setActive}
          mobileOpen={mobileSidebarOpen}
          onCloseMobile={() => setMobileSidebarOpen(false)}
          userName={member.name}
          userRole="Member"
          badges={{ notify: unreadNotificationCount, events: replyUnread }}
        />

        <main className="flex-1 min-w-0 flex flex-col">
          <TopHeader memberName={member.name} onMenuClick={() => setMobileSidebarOpen(true)} userId={member.id} userCode={member.user_code} onNavigate={setActive} />
          <MobileBrandBanner />
          <OfflineBanner />
          <FeedbackPrompt />
          <MemberReplyAlerts active={active} onOpenEvents={(eventId) => { if (typeof eventId === "number") setFocusEventId(eventId); setActive("events"); }} onOpenNotifications={() => setActive("notify")} onUnreadChange={setReplyUnread} />

          {/* ================================================================
              THE ACTUAL FIX:
              The outer wrapper no longer scrolls itself. It just bounds the
              height. Each view below is now the ONLY scroll container, which
              is what allows its flex-shrink-0 header (containing the
              pagination) to stay pinned while only the list scrolls.
              ================================================================ */}
          <div className="h-[calc(100dvh-73px)] overflow-hidden flex-1">
            <div className="h-full">
              {/* Same behaviour as the staff portal: the shell (sidebar +
                  header) is always on screen and only the page body shows a
                  skeleton while the account loads. */}
              {loading && active === "dashboard" && <MemberDashboardSkeleton memberName={member.name} />}
              {loading && (active === "qr" || active === "settings") && (
                <div className="h-full overflow-hidden dash-canvas p-4 sm:p-8 max-sm:!pt-[calc(76px+1rem)]">
                  <div className="dash-card rounded-[32px] p-5 sm:p-6">
                    <h1 className="font-display text-3xl font-extrabold tracking-tight sm:text-4xl page-title-gradient page-title-fit">{t(PAGE_HEADINGS[active]?.[0] ?? "settings")}</h1>
                    <p className="mt-1.5 text-sm text-white/55 max-w-xl">{t(PAGE_HEADINGS[active]?.[1] ?? "memberSettingsSubtitle")}</p>
                  </div>
                    <div className="mt-6 space-y-3">
                      <Skeleton className="h-16 w-full rounded-2xl" />
                      {Array.from({ length: 5 }).map((_, i) => <Skeleton key={i} className="h-20 w-full rounded-3xl" />)}
                    </div>
                </div>
              )}
              {!loading && active === "dashboard" && (
                <DashboardView
                  loading={eventsLoading || attendanceLoading || navSwitching}
                  memberName={member.first_name}
                  fullName={member.name}
                  userId={member.id}
                  userCode={member.user_code}
                  membershipsCount={userMembershipsCount}
                  attendedCount={attended}
                  missedCount={missedNow}
                  attendanceRecords={attendanceRecords}
                  setActive={setActive}
                  notifications={notifications}
                  upcomingEvents={upcomingEvents}
                  pastEventsCount={pastEvents.length}
                  highlightText={highlightText}
                  failedFeeds={failedCount}
                  lastUpdatedAt={lastOkAt}
                  onRetryFeeds={retryDashboard}
                  retryingFeeds={retryingFeeds}
                />
              )}

              {!loading && active === "qr" && (
                <QRCodesView
                  highlightText={highlightText}
                  userId={member.id}
                  userCode={member.user_code}
                  fullName={member.name}
                />
              )}

              {active === "attendance" && (
                <AttendanceView
                  loading={attendanceLoading || navSwitching}
                  attendanceRecords={attendanceRecords}
                  memberId={member.id}
                  highlightText={highlightText}
                  allEvents={allEvents}
                  userMemberships={userMemberships}
                />
              )}

              {active === "events" && (
                <EventsView
                  loading={eventsLoading || navSwitching}
                  allEvents={allEvents}
                  highlightText={highlightText}
                  allMemberships={memberships}
                  userMemberships={userMemberships}
                  attendanceRecords={attendanceRecords}
                  myFeedback={myFeedback}
                  myAbsences={myAbsences}
                  focusEventId={focusEventId}
                  member={member}
                  onFocusHandled={() => setFocusEventId(null)}
                  feedbackRules={feedbackRules}
                  onAbsenceSubmitted={(entry) =>
                    setMyAbsences((prev) => [...prev.filter((r) => r.event_id !== entry.event_id), entry])
                  }
                  // onFeedbackSubmitted={(entry) =>
                  //   setMyFeedback((prev) => {
                  //     const rest = prev.filter((f) => f.event_id !== entry.event_id);
                  //     return [...rest, entry];
                  //   })
                  // }

                  onFeedbackSubmitted={(entry) => {
                    setMyFeedback((prev) => {
                      const rest = prev.filter((f) => f.event_id !== entry.event_id);
                      if ((entry as any).deleted_at) {
                        return rest;
                      }
                      return [...rest, entry];
                    });
                  }}
                />
              )}

              {active === "notify" && (
                <NotificationsView highlightText={highlightText} />
              )}

              {!loading && active === "settings" && (
                <SettingsView member={member} />
              )}
            </div>
          </div>
        </main>
      </div>
    </div>
  );
}
</file>

<file path="resources/js/pages/staff/Staff.tsx">
import { highlightMatches } from "../../lib/highlight";
import React, { useEffect, useMemo, useState } from "react";

// --- LAYOUT IMPORTS ---
import Sidebar from "./components/Sidebar";
import TopHeader from "./components/TopHeader";
import MobileBrandBanner from "../../components/layout/MobileBrandBanner";

// --- VIEW IMPORTS ---
import DashboardView from "./views/DashboardView";
import ScanView from "./views/ScanView";
import ResidentsView from "./views/ResidentsView";
import HouseholdsView from "./views/HouseholdsView";
import QRCodesView from "./views/QRCodesView";
import { EventsView } from "./views/EventsView";
import NotificationsView from "./views/NotificationsView";
import ActivityLogsView from "./views/ActivityLogsView";
import ArchiveView from "./views/ArchiveView";
import ReportsView from "./views/ReportsView";
import InventoryView from "./views/InventoryView";
import ReturnsView from "./views/ReturnsView";
import BudgetView from "./views/BudgetView";
import IntegrationsView from "./views/IntegrationsView";
import FeedbackRulesView from "./views/FeedbackRulesView";
import ProfilingSettingsView from "./views/ProfilingSettingsView";
import MyAccountView from "./views/MyAccountView";
import StaffAccountsView from "./views/StaffAccountsView";

import MemberModules, { MemberModuleTab } from "../members/components/MemberModules";

import OfflineBanner from "../../components/ui/OfflineBanner";
import api from "../../lib/api";
import { saveScanCache, loadScanCache, slimResident } from "../../lib/scanCache";
import { useLanguage } from "../../i18n/LanguageContext";
import { useThemeScope } from "../../lib/theme";
import { staffKeyFromPath, staffUrlFor } from "../../lib/staffRoutes";

const STAFF_TO_MEMBER_TAB: Record<string, MemberModuleTab> = {
  memberQr: "qr",
  memberAttendance: "attendance",
  memberEvents: "events",
  memberNotify: "notify",
};

// --- TYPES & MOCK DATA ---
export type Resident = { id: string; name: string; age: number; address: string; contact: string; };
export type Membership = { id: string; name: string; description: string; codeId?: string; note?: string; verified?: boolean; memberIds: string[]; };
export type Notification = { id: number; title: string; body: string; sentAt: string; };
export type AttendanceRecord = { id: number; eventTitle: string; eventDate: string; location: string; timeIn: string; timeOut: string; status: string; };
export type TrashedItem = {
  id: string | number;
  type: 'event' | 'resident' | 'membership' | 'notification';
  name: string;
  deletedAt: string;
  deletedBy: string;
};

export const highlightText = (text: string, query: string) => highlightMatches(text, query);

// --------------------------
// MAIN COMPONENT
// --------------------------
export default function StaffDashboard() {
  const { t } = useLanguage();
  useThemeScope();
  const getInitialActive = () => staffKeyFromPath(window.location.pathname);

  const [active, setActiveState] = useState(getInitialActive());
  const [mobileSidebarOpen, setMobileSidebarOpen] = useState(false);

  // Slide-over forms start right under the top header so it stays visible. Keep the real header height in a CSS
  // variable (it changes with a wrapped title, the offline banner or zoom) for .staff-drawer-panel / -backdrop.
  useEffect(() => {
    const root = document.documentElement;
    const measure = () => {
      const el = document.getElementById("staff-content-scroll");
      if (el) root.style.setProperty("--staff-panel-top", `${Math.round(el.getBoundingClientRect().top)}px`);
    };
    measure();
    const el = document.getElementById("staff-content-scroll");
    const ro = typeof ResizeObserver !== "undefined" && el ? new ResizeObserver(measure) : null;
    if (el) ro?.observe(el);
    window.addEventListener("resize", measure);
    const settle = window.setTimeout(measure, 350);
    return () => {
      ro?.disconnect();
      window.clearTimeout(settle);
      window.removeEventListener("resize", measure);
      root.style.removeProperty("--staff-panel-top");
    };
  }, []);
  // A bell notification asks to open an event on a given tab (e.g. its Feedback).
  const [notifyTabRequest, setNotifyTabRequest] = useState<{ tab: "notifications" | "sms" | "feedback"; nonce: number } | null>(null);
  const [openEventRequest, setOpenEventRequest] = useState<{ eventId: number; tab: string; sub?: string; nonce: number } | null>(null);

  const [eventsCount, setEventsCount] = useState(0);
  const [upcomingEventsList, setUpcomingEventsList] = useState<any[]>([]);
  const [pastEventsCount, setPastEventsCount] = useState(0);
  const [loadingEvents, setLoadingEvents] = useState(true);
  const [allResidents, setAllResidents] = useState<any[]>([]);
  // The Scan screen's resident list: loaded from the server, or from the copy saved on this
  // device when there is no connection. `ready` stays false until one of the two worked.
  const [residentsReady, setResidentsReady] = useState(false);
  const [residentsFromCache, setResidentsFromCache] = useState(false);

  // State for refreshing events
  const [refreshEventsTrigger, setRefreshEventsTrigger] = useState(0);

  // ✅ ADD THIS - State for current logged-in user
  const [currentUser, setCurrentUser] = useState<any>(null);

  const setActive = (page: string, path?: string) => {
    window.history.pushState({}, "", staffUrlFor(page));
    setActiveState(page);
  };

  useEffect(() => {
    const handlePopState = () => {
      setActiveState(getInitialActive());
    };
    window.addEventListener("popstate", handlePopState);
    return () => window.removeEventListener("popstate", handlePopState);
  }, []);

  useEffect(() => {
    const onOpen = (e: Event) => {
      const d = (e as CustomEvent).detail as { eventId?: number; tab?: string; sub?: string } | undefined;
      if (!d?.eventId) return;
      window.history.pushState({}, "", staffUrlFor("events"));
      setActiveState("events");
      setOpenEventRequest({ eventId: d.eventId, tab: d.tab ?? "overview", sub: d.sub, nonce: Date.now() });
    };
    const onNotify = (e: Event) => {
      const tab = ((e as CustomEvent).detail?.tab ?? "feedback") as "notifications" | "sms" | "feedback";
      window.history.pushState({}, "", staffUrlFor("notify"));
      setActiveState("notify");
      setNotifyTabRequest({ tab, nonce: Date.now() });
    };
    window.addEventListener("staff:open-event", onOpen);
    window.addEventListener("staff:open-notifications", onNotify);
    return () => {
      window.removeEventListener("staff:open-event", onOpen);
      window.removeEventListener("staff:open-notifications", onNotify);
    };
  }, []);

  const staff = { id: "STAFF-001", name: "Brgy. Captain", role: t("dashStaffAdminRole") };

  const [membershipOptions, setMembershipOptions] = useState<Membership[]>([]);
  const [allEvents, setAllEvents] = useState<any[]>([]);

  const getMembershipName = (id: string | number | null | undefined) => {
    if (!id) return "";
    const found = membershipOptions.find((m) => String(m.id) === String(id));
    return found?.name || "";
  };

  const fetchEventsCount = async () => {
    try {
      const response = await api.get('/events-data');
      const result = response.data;

      if (result.data) {
        const now = new Date();
        // Soonest first, so the Dashboard's "Upcoming Events" list opens with what is next
        // (the server sends newest-created first, which put the furthest-away events on top).
        const upcoming = result.data
          .filter((event: any) => new Date(event.event_start) >= now)
          .sort((a: any, b: any) => new Date(a.event_start).getTime() - new Date(b.event_start).getTime());
        const past = result.data.filter((event: any) => new Date(event.event_start) < now);

        setEventsCount(result.data.length);
        setUpcomingEventsList(upcoming);
        setPastEventsCount(past.length);
      }
    } catch (error) {
      console.error("Error fetching events count:", error);
      setEventsCount(0);
      setUpcomingEventsList([]);
      setPastEventsCount(0);
    } finally {
      setLoadingEvents(false);
    }
  };

  useEffect(() => {
    fetchEventsCount();
  }, []);

  // Keep-alive: while the person is really using the page (clicking, typing,
  // scrolling) tell the server, at most every 2 minutes. Background polling
  // doesn't count, so an unattended screen still signs out after the idle limit.
  useEffect(() => {
    let last = Date.now();
    const ping = () => {
      const now = Date.now();
      if (now - last < 120000) return;
      last = now;
      api.post("/session/keepalive").catch(() => {});
    };
    const evts = ["pointerdown", "keydown", "wheel", "touchstart"] as const;
    evts.forEach((e) => window.addEventListener(e, ping, { passive: true }));
    return () => evts.forEach((e) => window.removeEventListener(e, ping));
  }, []);

  // ✅ ADD THIS - Fetch current logged-in user
  useEffect(() => {
    const fetchCurrentUser = async () => {
      try {
        const response = await api.get('/me');
        setCurrentUser(response.data);
      } catch (error) {
        console.error('Error fetching current user:', error);
      }
    };

    fetchCurrentUser();
  }, []);

  useEffect(() => {
    const fetchMemberships = async () => {
      try {
        const response = await api.get('/api/memberships');
        const data = response.data;
        setMembershipOptions(data?.data ?? data ?? []);
      } catch (error) {
        console.error('Failed to fetch memberships:', error);
        setMembershipOptions([]);
      }
    };

    fetchMemberships();
  }, []);

  const loadResidents = React.useCallback(async () => {
    try {
      const response = await api.get('/membership-residents');
      const rows = Array.isArray(response.data) ? response.data : [];
      setAllResidents(rows);
      setResidentsReady(true);
      setResidentsFromCache(false);
      saveScanCache("residents", rows.map(slimResident));
      return true;
    } catch (error) {
      console.error('Error fetching real residents:', error);
      // No connection (or a failed request): fall back to the copy saved on this device.
      const saved = loadScanCache<any[]>("residents");
      if (saved && saved.length > 0) {
        setAllResidents((prev) => (prev.length > 0 ? prev : saved));
        setResidentsReady(true);
        setResidentsFromCache(true);
      }
      return false;
    }
  }, []);

  // Load once at start, retry every 20 s until it works, and refresh when the connection returns
  // or when the Scan screen is opened (so a resident added a minute ago is found too).
  useEffect(() => {
    let cancelled = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const attempt = async () => {
      const ok = await loadResidents();
      if (!ok && !cancelled) timer = setTimeout(attempt, 20000);
    };
    attempt();
    const onOnline = () => { clearTimeout(timer); attempt(); setRefreshEventsTrigger((n) => n + 1); };
    window.addEventListener('online', onOnline);
    return () => { cancelled = true; clearTimeout(timer); window.removeEventListener('online', onOnline); };
  }, [loadResidents]);

  useEffect(() => {
    if (active === "scan") loadResidents();
  }, [active, loadResidents]);

  // Listen for refreshEvents from Archive
  useEffect(() => {
    const handleRefreshEvents = () => {
      console.log("🔄 Received refreshEvents - forcing events reload");
      setRefreshEventsTrigger(prev => prev + 1);
    };

    window.addEventListener('refreshEvents', handleRefreshEvents);

    return () => {
      window.removeEventListener('refreshEvents', handleRefreshEvents);
    };
  }, []);

  // Modified - Added refreshEventsTrigger to dependencies
  useEffect(() => {
    const fetchRealEvents = async () => {
      try {
        const response = await api.get('/events-data');
        const result = response.data;

        if (result.data) {
          const formattedEvents = result.data.map((dbEvent: any) => {
            let membershipIds: any[] = [];
          if (Array.isArray(dbEvent.membership_ids)) {
            membershipIds = dbEvent.membership_ids;
          } else if (typeof dbEvent.membership_ids === 'string' && dbEvent.membership_ids.startsWith('[')) {
            try { membershipIds = JSON.parse(dbEvent.membership_ids); } catch(e) {}
          } else if (dbEvent.membership_id) {
            membershipIds = [dbEvent.membership_id]; // Fallback to your old column
          }
            const membershipNames = membershipIds
              .map((id: any) => getMembershipName(id))
              .filter(Boolean);
            const startDate = dbEvent.event_start?.split(' ')[0] ?? '';
            const endDate = dbEvent.event_end?.split(' ')[0] ?? startDate;
            const startTime = dbEvent.event_start?.split(' ')[1]?.slice(0, 5) ?? '';
            const endTime = dbEvent.event_end?.split(' ')[1]?.slice(0, 5) ?? '';
            const callStartTime = dbEvent.call_time_start?.split(' ')[1]?.slice(0, 5) ?? '';
            const callEndTime = dbEvent.call_time_end?.split(' ')[1]?.slice(0, 5) ?? '';

            return {
              id: dbEvent.id,
              title: dbEvent.name,
              date: dbEvent.event_start,
              event_start: dbEvent.event_start,
              // Previously dropped here -- ScanView's "is this event still
              // scannable" check (and the Events page's Upcoming/Ongoing/
              // Past status) both need the event's real end and call-time
              // window, not just its start.
              event_end: dbEvent.event_end,
              call_time_start: dbEvent.call_time_start,
              call_time_end: dbEvent.call_time_end,
              startDate,
              endDate,
              startTime,
              endTime,
              callStartTime,
              callEndTime,
              location: dbEvent.location,
              description: dbEvent.description,
              membershipIds,
              membershipName: membershipNames.length > 0 ? membershipNames.join(', ') : 'Open to all',
            };
          });

          setAllEvents(formattedEvents);
          saveScanCache("events", formattedEvents);
        }
      } catch (error) {
        console.error("Error fetching events from database:", error);
        // Offline: keep the last events saved on this device so an event can still be picked at the gate.
        const saved = loadScanCache<any[]>("events");
        if (saved && saved.length > 0) setAllEvents((prev) => (prev.length > 0 ? prev : saved));
      }
    };

    fetchRealEvents();
  }, [membershipOptions, refreshEventsTrigger]);

  // EventsView already shows its own confirm dialog before calling this,
  // and its own success/error popups after -- this just does the request
  // and lets EventsView's confirmDelete() catch failures, so there's no
  // second (native, jarring) confirm()/alert() stacked on top of it.
  const handleDeleteEvent = async (id: string | number) => {
    await api.delete(`/events/${id}`);

    setAllEvents((prev) => prev.filter((e) => e.id !== id));
    setEventsCount(prev => Math.max(0, prev - 1));
  };

  // ✅ Get the display name from currentUser or fallback to staff.name
  const displayName = currentUser
    ? `${currentUser.first_name} ${currentUser.last_name}`
    : staff.name;

  return (
    <div className="staff-shell flex min-h-screen bg-white text-gray-900 print:min-h-0">
      <Sidebar
        active={active}
        setActive={setActive}
        userName={displayName}
        userRole={staff.role}
        isHeadStaff={!!currentUser?.is_head_staff}
        mobileOpen={mobileSidebarOpen}
        onCloseMobile={() => setMobileSidebarOpen(false)}
      />

      <main className="flex-1 min-w-0 flex flex-col h-[100dvh] print:!block print:!h-auto">
        <TopHeader
          memberName={displayName}
          role={staff.role}
          onMenuClick={() => setMobileSidebarOpen(true)}
          userId={currentUser?.id}
          userCode={currentUser?.user_code}
          isHeadStaff={!!currentUser?.is_head_staff}
          onNavigate={(k) => setActive(k as any)}
        />
        <MobileBrandBanner />
        <OfflineBanner />

        <div id="staff-content-scroll" className="flex-1 min-h-0 overflow-y-auto p-3 sm:p-6 smooth-scroll print:!h-auto print:!overflow-visible print:!p-0">
          {active === "dashboard" && (
            <DashboardView
              membershipsCount={membershipOptions.length}
              eventsCount={eventsCount}
              upcomingEvents={upcomingEventsList}
              pastEventsCount={pastEventsCount}
              setActive={setActive}
            />
          )}
         {active === "scan" && <ScanView events={allEvents} residents={allResidents} memberships={membershipOptions} loading={loadingEvents} residentsReady={residentsReady} residentsFromCache={residentsFromCache} />}
          {active === "residents" && <ResidentsView isHeadStaff={!!currentUser?.is_head_staff} />}
          {active === "households" && <HouseholdsView />}
          {active === "memberships" && <QRCodesView highlightText={highlightText} />}
          {active === "events" && <EventsView allEvents={allEvents} onDeleteEvent={handleDeleteEvent} highlightText={highlightText} memberships={membershipOptions} loading={loadingEvents} openRequest={openEventRequest} onOpenRequestHandled={() => setOpenEventRequest(null)} />}
          {active === "notify" && <NotificationsView memberships={membershipOptions} highlightText={highlightText} initialTab={notifyTabRequest} />}
          {active === "reports" && <ReportsView memberships={membershipOptions} events={allEvents} />}
          {active === "inventory" && <InventoryView />}
          {active === "returns" && <ReturnsView />}
          {active === "budget" && <BudgetView allEvents={allEvents} />}
          {active === "activitylogs" && <ActivityLogsView />}
          {active === "archive" && <ArchiveView/>}
          {active === "integrations" && <IntegrationsView />}
          {active === "feedbackrules" && <FeedbackRulesView isHeadStaff={!!currentUser?.is_head_staff} />}
          {active === "profiling" && <ProfilingSettingsView />}
          {active === "myaccount" && <MyAccountView />}
          {active === "staffaccounts" && <StaffAccountsView />}
          {active in STAFF_TO_MEMBER_TAB && currentUser && (
            <MemberModules
              active={STAFF_TO_MEMBER_TAB[active]}
              member={{
                id: String(currentUser.id),
                name: displayName,
                first_name: currentUser.first_name || "",
                last_name: currentUser.last_name || "",
                user_code: currentUser.user_code || "",
              }}
              allEvents={allEvents}
              allMemberships={membershipOptions}
              embedded
            />
          )}
        </div>
      </main>

      <style>{`
        .smooth-scroll { scroll-behavior: smooth !important; -webkit-overflow-scrolling: touch; }
        .smooth-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
        .smooth-scroll::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
        .smooth-scroll::-webkit-scrollbar-thumb { background: #ccc; border-radius: 10px; }
      `}</style>
    </div>
  );
}
