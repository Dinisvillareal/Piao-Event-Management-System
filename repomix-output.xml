<file path="resources/js/components/ui/FormSelect.tsx">
import React from "react";
import FilterDropdown from "./FilterDropdown";

/**
 * Drop-in replacement for a native <select> in dark form fields. Accepts the
 * same <option> children and an event-style onChange, but renders the app's
 * own dropdown (same look as the filter dropdowns) instead of the browser's
 * unstyleable native list.
 *
 * A first option with value="" that is hidden/disabled (or display:none) is
 * treated as the placeholder text, not as a selectable choice.
 */
interface FormSelectProps {
  value?: string | number | null;
  onChange?: (e: { target: { value: string } }) => void;
  children?: React.ReactNode;
  className?: string;
  disabled?: boolean;
  required?: boolean;
  searchable?: boolean;
  [key: string]: any;
}

function textOf(node: React.ReactNode): string {
  if (node === null || node === undefined || typeof node === "boolean") return "";
  if (typeof node === "string" || typeof node === "number") return String(node);
  if (Array.isArray(node)) return node.map(textOf).join("");
  if (React.isValidElement(node)) return textOf((node.props as any).children);
  return "";
}

export default function FormSelect({ value, onChange, children, className = "", disabled, searchable }: FormSelectProps) {
  const options: { value: string; label: string; disabled?: boolean; hint?: string }[] = [];
  let placeholder: string | undefined;

  React.Children.toArray(children).forEach((child) => {
    if (!React.isValidElement(child)) return;
    const props: any = child.props;
    const v = props.value === undefined ? textOf(props.children) : String(props.value);
    const label = textOf(props.children);
    const isPlaceholder = v === "" && (props.hidden || props.disabled || props.style?.display === "none");
    if (isPlaceholder) {
      placeholder = label;
      return;
    }
    options.push({ value: v, label, disabled: !!props.disabled, hint: props["data-hint"] });
  });

  const hasError = className.includes("border-red-500");
  const current = value === null || value === undefined ? "" : String(value);

  return (
    <FilterDropdown
      value={current}
      onChange={(v) => onChange?.({ target: { value: v } })}
      options={options}
      placeholder={placeholder ?? (options.some((o) => o.value === current) ? undefined : "")}
      fullWidth
      dark
      disabled={disabled}
      searchable={searchable ?? options.length > 8}
      wrapperClassName="w-full"
      className={`w-full h-[54px] px-5 !text-base font-sans !bg-white/10 ${hasError ? "!border-red-500" : "!border-white/25"} focus:!border-[#4FBEB0]/70 focus:ring-[#4FBEB0]/40 ${disabled ? "opacity-60 cursor-not-allowed" : ""}`}
    />
  );
}
</file>

<file path="resources/js/components/ui/HeaderPreferences.tsx">
import { useEffect, useRef, useState } from "react";
import { Check, ChevronDown, Languages, Moon, SlidersHorizontal, Sun } from "lucide-react";
import { useLanguage } from "../../i18n/LanguageContext";
import { LANGUAGES, LanguageCode } from "../../i18n/translations";
import { useTheme } from "../../lib/theme";

/** Top-bar preferences: one button that opens a small menu with the theme switch and the language list. */
export default function HeaderPreferences({ userId }: { userId?: string | number }) {
  const { language, setLanguage, t } = useLanguage();
  const { theme, toggle } = useTheme();
  const [open, setOpen] = useState(false);
  const ref = useRef<HTMLDivElement>(null);
  const toLight = theme === "dark";
  const current = LANGUAGES.find((l) => l.code === language) ?? LANGUAGES[0];

  useEffect(() => {
    if (!open) return;
    const onDown = (e: MouseEvent) => { if (ref.current && !ref.current.contains(e.target as Node)) setOpen(false); };
    const onKey = (e: KeyboardEvent) => { if (e.key === "Escape") setOpen(false); };
    document.addEventListener("mousedown", onDown);
    document.addEventListener("keydown", onKey);
    return () => { document.removeEventListener("mousedown", onDown); document.removeEventListener("keydown", onKey); };
  }, [open]);

  const choose = (code: LanguageCode) => { setLanguage(code, { userId }); setOpen(false); };
  const row = "flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-medium text-white/85 transition hover:bg-white/10";

  return (
    <div ref={ref} className="relative">
      <button
        type="button"
        onClick={() => setOpen((v) => !v)}
        aria-haspopup="menu"
        aria-expanded={open}
        title={t("changeInterfaceLanguage")}
        className="topbar-group flex h-9 sm:h-10 items-center gap-2 rounded-full pl-1.5 pr-2.5 text-white transition-colors hover:bg-white/10 focus:outline-none focus:ring-1 focus:ring-[#4FBEB0]/60"
      >
        <span className="topbar-icon flex h-6 w-6 sm:h-7 sm:w-7 items-center justify-center rounded-full">
          <SlidersHorizontal className="h-3.5 w-3.5" strokeWidth={2.25} />
        </span>
        <span className="text-xs font-bold uppercase tracking-wider">{current.code}</span>
        <ChevronDown className={`h-4 w-4 shrink-0 text-white/70 transition-transform duration-150 ${open ? "rotate-180" : ""}`} />
      </button>

      {open && (
        <div role="menu" className="absolute right-0 top-full z-50 mt-2 w-64 max-w-[calc(100vw-1.5rem)] rounded-2xl border border-white/15 bg-[#0A0E1A] p-2 shadow-2xl">
          <button type="button" role="menuitem" onClick={toggle} className={row}>
            {toLight ? <Sun className="h-4 w-4 text-white/60" /> : <Moon className="h-4 w-4 text-white/60" />}
            {toLight ? t("switchToLightMode") : t("switchToDarkMode")}
          </button>
          <div className="my-2 h-px bg-white/10" />
          <p className="flex items-center gap-2 px-3 pb-1 pt-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-white/40">
            <Languages className="h-3.5 w-3.5" />
            {t("interfaceLanguage")}
          </p>
          <div role="listbox" aria-label={t("interfaceLanguage")}>
            {LANGUAGES.map((l) => {
              const selected = l.code === language;
              return (
                <button
                  key={l.code}
                  type="button"
                  role="option"
                  aria-selected={selected}
                  onClick={() => choose(l.code)}
                  className={`${row} justify-between ${selected ? "bg-[#4FBEB0]/15 font-semibold" : ""}`}
                >
                  <span>{l.label}</span>
                  {selected && <Check className="h-4 w-4 text-[#4FBEB0]" />}
                </button>
              );
            })}
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="resources/js/components/ui/IdCardFlip.tsx">
import React, { useEffect, useState } from "react";

interface IdCardFlipProps {
  frontUrl: string;
  backUrl: string;
  alt?: string;
  /** Flip by itself every `intervalMs` (restarts after any manual flip). */
  autoFlip?: boolean;
  intervalMs?: number;
  /** If given, clicking calls this instead of flipping the card. */
  onClick?: () => void;
  className?: string;
  style?: React.CSSProperties;
  title?: string;
}

const CARD_ASPECT = "1011 / 638";

/**
 * Two-sided ID card that turns smoothly around its vertical axis. Shows the
 * front first; optionally flips on a timer, and flips when clicked (unless an
 * `onClick` override is supplied, e.g. to open a pop-up).
 */
export default function IdCardFlip({
  frontUrl,
  backUrl,
  alt = "ID card",
  autoFlip = false,
  intervalMs = 10000,
  onClick,
  className = "",
  style,
  title,
}: IdCardFlipProps) {
  const [flipped, setFlipped] = useState(false);

  // Depends on `flipped` so every flip -- timed or manual -- restarts the wait.
  useEffect(() => {
    if (!autoFlip) return;
    const id = setTimeout(() => setFlipped((f) => !f), intervalMs);
    return () => clearTimeout(id);
  }, [autoFlip, intervalMs, flipped]);

  const face: React.CSSProperties = {
    position: "absolute",
    inset: 0,
    width: "100%",
    height: "100%",
    backfaceVisibility: "hidden",
    WebkitBackfaceVisibility: "hidden",
  };

  return (
    <button
      type="button"
      onClick={() => (onClick ? onClick() : setFlipped((f) => !f))}
      title={title}
      aria-label={alt}
      className={`block cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40 rounded-[4%] ${className}`}
      style={{ perspective: "1400px", aspectRatio: CARD_ASPECT, ...style }}
    >
      <div
        className="relative h-full w-full"
        style={{
          transformStyle: "preserve-3d",
          transition: "transform 1.4s cubic-bezier(0.45, 0.05, 0.25, 1)",
          transform: flipped ? "rotateY(180deg)" : "rotateY(0deg)",
        }}
      >
        <img src={frontUrl} alt={`${alt} (front)`} draggable={false} style={face} />
        <img
          src={backUrl}
          alt={`${alt} (back)`}
          draggable={false}
          style={{ ...face, transform: "rotateY(180deg)" }}
        />
      </div>
    </button>
  );
}
</file>

<file path="resources/js/components/ui/MemberReplyAlerts.tsx">
import { useCallback, useEffect, useRef, useState } from "react";
import { createPortal } from "react-dom";
import { Bell, Heart, MessageSquareReply, X } from "lucide-react";
import api from "../../lib/api";
import { useLanguage } from "../../i18n/LanguageContext";
import { chime, getSoundPref, installAudioUnlock, MEMBER_SOUND_KEY } from "../../lib/alertSound";

type ReplyAlert = {
  id: number;
  event_id: number | null;
  event_name: string | null;
  kind: "like" | "reply" | "event";
  target: "feedback" | "response";
  preview: string | null;
  title?: string;
  text?: string | null;
  stamp?: string;
};

const POLL_MS = 6000;
const TOAST_MS = 7000;
const TOAST_MAX = 2;

// Live alerts for a member whose rating or "couldn't attend" reason got a
// heart or a reply from staff: a toast with a soft chime (same bell as the
// staff portal, switchable in the profile menu), plus a count for the Events
// nav badge. Opening the Events page marks them as seen.
export default function MemberReplyAlerts({
  active,
  onOpenEvents,
  onOpenNotifications,
  onUnreadChange,
}: {
  active: string;
  onOpenEvents: (eventId?: number | null) => void;
  onOpenNotifications: () => void;
  onUnreadChange: (n: number) => void;
}) {
  const { t } = useLanguage();
  const [toasts, setToasts] = useState<ReplyAlert[]>([]);
  const lastIdRef = useRef(0);
  const firstRef = useRef(true);
  const unreadRef = useRef(0);
  const sinceRef = useRef<string>("");
  const seenRef = useRef<Set<string>>(new Set());

  useEffect(() => installAudioUnlock(), []);

  const poll = useCallback(async () => {
    try {
      const res = await api.get("/notifications/replies", { params: firstRef.current ? { init: 1 } : { after_id: lastIdRef.current, since: sinceRef.current || undefined } });
      const d = res.data as { unread_count: number; latest_id: number; new: ReplyAlert[]; server_time?: string };
      if (d.server_time) sinceRef.current = d.server_time;
      unreadRef.current = d.unread_count ?? 0;
      onUnreadChange(unreadRef.current);
      if (firstRef.current) {
        firstRef.current = false;
      } else {
        // A row counts once per version (new id, or the same id after an update).
        const fresh = (d.new ?? []).filter((n) => {
          const key = n.stamp ?? String(n.id);
          if (seenRef.current.has(key)) return false;
          seenRef.current.add(key);
          return true;
        });
        if (fresh.length > 0) {
          setToasts((prev) => {
            const seen = new Set(prev.map((x) => x.id));
            return [...prev, ...fresh.filter((n) => !seen.has(n.id))].slice(-6);
          });
          if (getSoundPref(MEMBER_SOUND_KEY)) chime();
          // Their own Events page picks up a new heart/reply right away.
          if (fresh.some((n) => n.kind !== "event")) window.dispatchEvent(new Event("member:feedback-responded"));
          window.dispatchEvent(new Event("member-notifications-changed"));
        }
      }
      lastIdRef.current = Math.max(lastIdRef.current, d.latest_id ?? 0);
    } catch { /* offline -- the next tick tries again */ }
  }, [onUnreadChange]);

  useEffect(() => {
    poll();
    let timer: number | undefined;
    const start = () => { if (timer === undefined) timer = window.setInterval(poll, POLL_MS); };
    const stop = () => { if (timer !== undefined) { window.clearInterval(timer); timer = undefined; } };
    const onVis = () => { if (document.visibilityState === "visible") { poll(); start(); } else stop(); };
    if (document.visibilityState === "visible") start();
    document.addEventListener("visibilitychange", onVis);
    window.addEventListener("focus", poll);
    return () => { stop(); document.removeEventListener("visibilitychange", onVis); window.removeEventListener("focus", poll); };
  }, [poll]);

  // Being on the Events page = seeing them: clear the badge.
  useEffect(() => {
    if (active !== "events" || unreadRef.current === 0) return;
    unreadRef.current = 0;
    onUnreadChange(0);
    api.put("/notifications/replies-read")
      .then(() => window.dispatchEvent(new Event("member-notifications-changed")))
      .catch(() => {});
  }, [active, onUnreadChange]);

  // Toasts leave on their own after TOAST_MS.
  useEffect(() => {
    if (toasts.length === 0) return;
    const h = window.setTimeout(() => setToasts((prev) => prev.slice(1)), TOAST_MS);
    return () => window.clearTimeout(h);
  }, [toasts]);

  if (toasts.length === 0) return null;
  const label = (a: ReplyAlert) =>
    a.kind === "event"
      ? a.title || t("memToastNewNotification")
      : t(`memToast${a.kind === "like" ? "Like" : "Reply"}${a.target === "response" ? "Response" : "Feedback"}`);

  return createPortal(
    <div className="pointer-events-none fixed bottom-4 right-4 z-[10002] flex w-[min(92vw,340px)] flex-col-reverse gap-2">
      {toasts.slice(0, TOAST_MAX).map((a) => (
        <div key={a.id} className="pointer-events-auto relative overflow-hidden rounded-xl border border-white/10 bg-[#0A0E1A] shadow-xl shadow-black/40">
          <button
            type="button"
            onClick={() => { setToasts((prev) => prev.filter((x) => x.id !== a.id)); if (a.kind === "event") onOpenNotifications(); else onOpenEvents(a.event_id); }}
            className="flex w-full items-start gap-3 px-3.5 py-3 pr-9 text-left transition hover:bg-white/[0.05]"
          >
            <span className={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full ${a.kind === "like" ? "bg-red-500/15 text-red-400" : a.kind === "event" ? "bg-gold-400/15 text-gold-300" : "bg-[#4FBEB0]/15 text-[#7DD8CB]"}`}>
              {a.kind === "like" ? <Heart className="h-4 w-4 fill-red-400" /> : a.kind === "event" ? <Bell className="h-4 w-4" /> : <MessageSquareReply className="h-4 w-4" />}
            </span>
            <span className="min-w-0 flex-1">
              <span className="block text-[13px] font-bold leading-snug text-white">{label(a)}</span>
              {a.kind !== "event" && a.event_name && <span className="mt-0.5 block truncate text-xs text-white/55">{t("memToastOn")} {a.event_name}</span>}
              {a.kind === "event" && a.text && <span className="mt-0.5 line-clamp-2 block text-xs text-white/60">{a.text}</span>}
              {a.preview && <span className="mt-1 line-clamp-2 block text-[12.5px] italic text-white/70">&ldquo;{a.preview}&rdquo;</span>}
              <span className="mt-1 block text-[11px] font-semibold text-[#7DD8CB]">{t("memToastView")}</span>
            </span>
          </button>
          <button
            type="button"
            aria-label={t("closeLabel")}
            onClick={() => setToasts((prev) => prev.filter((x) => x.id !== a.id))}
            className="absolute right-2 top-2 rounded-full p-1 text-white/40 transition hover:bg-white/10 hover:text-white"
          >
            <X className="h-3.5 w-3.5" />
          </button>
        </div>
      ))}
    </div>,
    document.body
  );
}
