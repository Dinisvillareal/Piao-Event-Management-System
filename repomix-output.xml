  { key: "message", labelKey: "rptSecMessage", descKey: "rptSecMessageDesc", group: "other" },
];

interface MyEvent {
  id: number | string;
  title: string;
  date: string;
  event_start?: string;
  event_end?: string;
  call_time_start?: string;
  call_time_end?: string;
