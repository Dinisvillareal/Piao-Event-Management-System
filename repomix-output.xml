import React, { useEffect, useState, useCallback, useRef } from "react";
import ReactDOM from "react-dom/client";
import MemberDashboard from "./pages/members/Members";
import { MEMBER_BASE, memberKeyFromPath, memberUrlFor } from "./lib/memberRoutes";
import { staffUrlFor } from "./lib/staffRoutes";
import StaffDashboard from "./pages/staff/Staff";
import LoginPage from "./pages/login/Login";
import SplashScreen from "./components/ui/SplashScreen";
import ForcedPasswordChange from "./components/auth/ForcedPasswordChange";
import { LanguageProvider } from "./i18n/LanguageContext";
import { loadContentTranslations } from "./lib/contentTranslations";
import { startResponsiveTables } from "./lib/responsiveTables";

// Fire-and-forget; components will show English until it resolves.
loadContentTranslations();
startResponsiveTables();

const rootElement = document.getElementById("app");

if (rootElement) {
  ReactDOM.createRoot(rootElement).render(
    <LanguageProvider>
      <App />
    </LanguageProvider>
  );
}

// UC (offline access): let the app shell open with no internet connection.
// Only registered against a production build — Vite's dev server streams
// modules live and cannot be usefully cached, so this is a no-op under
// `npm run dev`. Build with `npm run build` for offline opening to work.
if (import.meta.env.PROD && "serviceWorker" in navigator) {
  window.addEventListener("load", () => {
    navigator.serviceWorker.register("/sw.js").catch((err) => {
      console.error("Service worker registration failed:", err);
    });
  });
}

// ─── PORTAL MODE HELPERS ──────────────────────────────────────────────────────
// "portalMode" is stored in sessionStorage so it survives a refresh but clears
// when the browser tab is closed. Use "member" | "staff" as values.

function getPortalMode(): string | null {
  return sessionStorage.getItem("portalMode") || localStorage.getItem("portalMode");
}

export function setPortalMode(mode: "member" | "staff") {
  sessionStorage.setItem("portalMode", mode);
  localStorage.setItem("portalMode", mode);
}

export function clearPortalMode() {
  sessionStorage.removeItem("portalMode");
  localStorage.removeItem("portalMode");
}
// ─────────────────────────────────────────────────────────────────────────────

export default function App() {
  const [userRole, setUserRole] = useState<string | null>(() => {
    const sessionUser = sessionStorage.getItem("user");
    if (sessionUser) {
      try { return JSON.parse(sessionUser).role; } catch { return null; }
    }
    const localUser = localStorage.getItem("user");
    if (localUser) {
      try { return JSON.parse(localUser).role; } catch { return null; }
    }
    return null;
  });

  // portalMode tracks which dashboard a Staff member chose.
  // Non-staff users are always "member", so this only matters for Staff.
  const [portalMode, setPortalModeState] = useState<string | null>(getPortalMode);

  const [loading, setLoading] = useState(true);
  const authCalledRef = useRef(false);

  // Branded splash, shown for every full page load/refresh of the app
  // (login, staff dashboard, member dashboard -- wherever the browser
  // reloads) while the auth check above is in flight, instead of just a
  // blank navy screen. Two-stage like Login.tsx's own portal-transition
  // splash: `splashVisible` drives the fade, `splashMounted` keeps the
  // overlay in the DOM a little longer so the 700ms fade-out actually gets
  // to play over the real page (which is already mounted underneath by the
  // time it starts) instead of vanishing instantly.
  //
  // The splash's own build-in animation (logo assembling, then three lines
  // of text staggering in) takes about 1.55s to finish playing -- see
  // SplashScreen.tsx's keyframes. `loading` can resolve much faster than
  // that (an unauthenticated visit skips the `/me` network call entirely),
  // so the fade is never started before MIN_SPLASH_MS has actually elapsed
  // since the splash first appeared, however quickly `loading` itself
  // settles. The auth check can still take *longer* than that with no
  // issue -- the splash simply keeps showing until it's done either way.
  // No saved session at load time = the login page is what will show, so use
  // the logo-less PIAOCONNECT wordmark splash there.
  const MIN_SPLASH_MS = 6000; // the shine is done by ~6.5s; start fading just before it ends so there is no empty dark gap
  // An account holding a staff-issued temporary password must choose its own first.
  const [forcedPwUser, setForcedPwUser] = useState<{ id: number; head: boolean } | null>(null);
  useEffect(() => {
    const onForced = () => {
      try {
        const u = JSON.parse(sessionStorage.getItem("user") || localStorage.getItem("user") || "null");
        if (u?.id) setForcedPwUser({ id: u.id, head: !!u.is_head_staff });
      } catch { /* ignore */ }
    };
    window.addEventListener("auth:password-change-required", onForced);
    return () => window.removeEventListener("auth:password-change-required", onForced);
  }, []);
  const [splashVisible, setSplashVisible] = useState(true);
  const [splashMounted, setSplashMounted] = useState(true);
  const splashStartRef = useRef(Date.now());

  useEffect(() => {
    if (loading) return;
    // The wordmark splash needs time for one full, unhurried pass of the
    // mirror shine across the logo and letters before it fades out.
    const remaining = Math.max(0, MIN_SPLASH_MS - (Date.now() - splashStartRef.current));
    const startFade = setTimeout(() => setSplashVisible(false), remaining);
    const unmount = setTimeout(() => setSplashMounted(false), remaining + 700);
    return () => {
      clearTimeout(startFade);
      clearTimeout(unmount);
    };
  }, [loading]);

  const checkAuth = useCallback(async () => {
    if (authCalledRef.current) return;
    authCalledRef.current = true;

    const storedUser = sessionStorage.getItem("user") || localStorage.getItem("user");
    if (!storedUser) {
      setUserRole(null);
      setLoading(false);
      return;
    }

    try {
      const token = document.cookie
        .split("; ")
        .find((row) => row.startsWith("XSRF-TOKEN="))
        ?.split("=")[1];

      const response = await fetch("/me", {
        credentials: "include",
        headers: {
          Accept: "application/json",
          "X-Requested-With": "XMLHttpRequest",
          ...(token && { "X-XSRF-TOKEN": decodeURIComponent(token) }),
        },
      });

      if (response.ok) {
        const user = await response.json();
        setUserRole(user.role);
        if (user.must_change_password) {
          setForcedPwUser({ id: user.id, head: !!user.is_head_staff });
        }

        // If this is a Staff user and no portalMode is saved yet, default to
        // "staff" so a fresh login lands on the Staff dashboard.
        if (user.role === "Staff" && !getPortalMode()) {
          setPortalMode("staff");
          setPortalModeState("staff");
        }
      } else {
        // Session expired or invalid — clear everything and go to login.
        localStorage.removeItem("user");
        localStorage.removeItem("isAuthenticated");
        sessionStorage.removeItem("user");
        sessionStorage.removeItem("isAuthenticated");
        clearPortalMode();
        setUserRole(null);
      }
    } catch (error) {
      console.error("Auth error:", error);
      // Network error — keep whatever role we have from storage so the user
      // doesn't get kicked out just because the server hiccuped.
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    checkAuth();
  }, [checkAuth]);

  // ── Listen for portal-switch events dispatched by the login modal or any
  //    "Switch portal" button elsewhere in the app. ──────────────────────────
  useEffect(() => {
    const handleSwitch = (e: Event) => {
      const mode = (e as CustomEvent<"member" | "staff">).detail;
      setPortalMode(mode);
      setPortalModeState(mode);
    };
    window.addEventListener("switchPortal", handleSwitch);
    return () => window.removeEventListener("switchPortal", handleSwitch);
  }, []);

  // ── Keep the address bar honest ───────────────────────────────────────────
  // Login redirects (and a plain "/") don't know the eventual destination
  // ahead of time, so they land on a generic path. Once auth has settled,
  // make sure the URL actually matches what's on screen: unauthenticated
  // always shows "/login", and an authenticated user sitting on "/" or
  // "/login" gets bounced to their real dashboard root instead of the
  // address bar silently disagreeing with the page.
  useEffect(() => {
    if (loading) return;
    const path = window.location.pathname;

    if (!userRole) {
      if (path !== "/login") {
        window.history.replaceState({}, "", "/login");
      }
      return;
    }

    const isStaffPortal = userRole === "Staff" && portalMode !== "member";
    if (path === "/login" || path === "/") {
      window.history.replaceState({}, "", isStaffPortal ? staffUrlFor("dashboard") : memberUrlFor("dashboard"));
    } else if (!isStaffPortal && !path.startsWith(MEMBER_BASE + "/")) {
      // Resident portal: normalise old bare URLs ("/attendance", "/dashboard",
      // a leftover "/admin/..." link) to the same "/member/<page>" scheme the
      // staff portal uses with "/admin/<page>".
      window.history.replaceState({}, "", memberUrlFor(memberKeyFromPath(path)));
    }
  }, [loading, userRole, portalMode]);

  // ── Decide what's underneath the splash ───────────────────────────────────
  // Auth check happens on every full page load (including right after the
  // staff/member portal transition redirects here, right after the dark
  // branded splash screen). While it's in flight there's nothing to decide
  // yet, so the splash overlay below is the only thing on screen; once it
  // resolves, the real page underneath is already mounted and ready by the
  // time the splash finishes fading out.
  let content: React.ReactNode = null;
  if (!loading) {
    if (userRole && forcedPwUser) {
      // ── Must choose a new password before anything else ───────────────
      content = <ForcedPasswordChange userId={forcedPwUser.id} minLength={forcedPwUser.head ? 12 : 8} />;
    } else if (!userRole) {
      // ── Not authenticated → Login ──────────────────────────────────────
      content = <LoginPage />;
    } else if (userRole !== "Staff") {
      // ── Non-staff users always see the Member dashboard ────────────────
      content = <MemberDashboard />;
    } else if (portalMode === "member") {
      // ── Staff: route based on persisted portalMode, not the URL ────────
      // If a Staff member chose "Member Portal" from the login modal,
      // portalMode will be "member" and will remain "member" across
      // refreshes until they explicitly switch back or log out.
      content = <MemberDashboard />;
    } else {
      // Default for Staff: Staff dashboard.
      content = <StaffDashboard />;
    }
  }

  return (
    <>
      {content}
      {splashMounted && <SplashScreen visible={splashVisible} />}
    </>
  );
}
</file>

<file path="resources/js/components/ui/LanguageSwitcher.tsx">
import { useEffect, useLayoutEffect, useRef, useState } from "react";
import Portal from "./Portal";
import { Check, ChevronDown, Languages } from "lucide-react";
import { useLanguage } from "../../i18n/LanguageContext";
import { LANGUAGES, LanguageCode } from "../../i18n/translations";

interface LanguageSwitcherProps {
  userId?: string | number;
  className?: string;
  grouped?: boolean;
}

/** UC-17: Switch Interface Language — compact selector for the top header. */
export default function LanguageSwitcher({ userId, className = "", grouped = false }: LanguageSwitcherProps) {
  const { language, setLanguage, t } = useLanguage();
  const [open, setOpen] = useState(false);
  const [activeIndex, setActiveIndex] = useState(() =>
    Math.max(0, LANGUAGES.findIndex((l) => l.code === language))
  );
  const rootRef = useRef<HTMLDivElement>(null);
  const buttonRef = useRef<HTMLButtonElement>(null);
  const listRef = useRef<HTMLUListElement>(null);
  // The list is drawn on top of the whole page (in <body>), placed under the button, so no header or page
  // content can ever cover or clip it.
  const [pos, setPos] = useState<{ top: number; right: number } | null>(null);

  const current = LANGUAGES.find((l) => l.code === language) ?? LANGUAGES[0];

  useLayoutEffect(() => {
    if (!open) return;
    const place = () => {
      const r = buttonRef.current?.getBoundingClientRect();
      if (r) setPos({ top: Math.round(r.bottom + 6), right: Math.max(8, Math.round(window.innerWidth - r.right)) });
    };
    place();
    window.addEventListener("resize", place);
    window.addEventListener("scroll", place, true);
    return () => {
      window.removeEventListener("resize", place);
      window.removeEventListener("scroll", place, true);
    };
  }, [open]);

  // Close when clicking outside the trigger/panel.
  useEffect(() => {
    if (!open) return;
    const handleClick = (e: MouseEvent) => {
      const target = e.target as Node;
      if (rootRef.current?.contains(target) || listRef.current?.contains(target)) return;
      setOpen(false);
    };
    document.addEventListener("mousedown", handleClick);
    return () => document.removeEventListener("mousedown", handleClick);
  }, [open]);

  // Keyboard users land on the list as soon as it opens.
  useEffect(() => {
    if (open && pos) listRef.current?.focus();
  }, [open, !!pos]);

  const choose = (code: LanguageCode) => {
    setLanguage(code, { userId });
    setOpen(false);
    buttonRef.current?.focus();
  };

  const handleTriggerKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      setOpen(true);
    }
  };

  const handleListKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === "Escape") {
      e.preventDefault();
      setOpen(false);
      buttonRef.current?.focus();
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      setActiveIndex((i) => (i + 1) % LANGUAGES.length);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActiveIndex((i) => (i - 1 + LANGUAGES.length) % LANGUAGES.length);
    } else if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      choose(LANGUAGES[activeIndex].code);
    } else if (e.key === "Tab") {
      setOpen(false);
    }
  };

  return (
    <div ref={rootRef} className={`relative ${className}`}>
      <button
        ref={buttonRef}
        type="button"
        onClick={() => setOpen((o) => !o)}
        onKeyDown={handleTriggerKeyDown}
        aria-haspopup="listbox"
        aria-expanded={open}
        title={t("changeInterfaceLanguage")}
        className={`flex items-center rounded-full text-sm font-medium text-white transition-colors focus:outline-none focus:ring-1 focus:ring-[#4FBEB0]/60 ${grouped ? "h-8 gap-2 pl-2.5 pr-2.5 hover:bg-white/10" : "h-9 sm:h-10 gap-2 sm:gap-2.5 border border-white/40 bg-[#0A0E1A] pl-3.5 pr-3 sm:pl-4 sm:pr-3.5 shadow-sm hover:bg-white/10 hover:border-white/60"}`}
      >
        <Languages className="h-4 w-4 shrink-0 text-white/70" />
        <span className="hidden min-[420px]:inline">{current.label}</span>
        <span className="px-0.5 text-xs font-bold uppercase tracking-wider min-[420px]:hidden">{current.code}</span>
        <ChevronDown className={`h-4 w-4 shrink-0 text-white/70 transition-transform duration-150 ${open ? "rotate-180" : ""}`} />
      </button>

      {open && pos && (
        <Portal>
        <ul
          ref={listRef}
          role="listbox"
          aria-label={t("interfaceLanguage")}
          tabIndex={-1}
          onKeyDown={handleListKeyDown}
          style={{ top: pos.top, right: pos.right }}
          className="fixed z-[300] min-w-[10rem] overflow-hidden rounded-2xl border border-white/10 bg-[#0A0E1A] py-1 shadow-xl outline-none"
        >
          {LANGUAGES.map((l, i) => {
            const selected = l.code === language;
            return (
              <li key={l.code} role="presentation">
                <button
                  type="button"
                  role="option"
                  aria-selected={selected}
                  onMouseEnter={() => setActiveIndex(i)}
                  onClick={() => choose(l.code)}
                  className={`flex w-full items-center justify-between gap-2 px-3 py-2 text-left text-sm transition-colors ${
                    selected
                      ? "bg-[#4FBEB0]/15 font-semibold text-white"
                      : i === activeIndex
                      ? "bg-white/[0.06] text-white"
                      : "text-white/80"
                  }`}
                >
                  <span>{l.label}</span>
                  {selected && <Check className="h-3.5 w-3.5 text-[#4FBEB0]" />}
                </button>
              </li>
            );
          })}
        </ul>
        </Portal>
      )}
    </div>
  );
}
</file>

<file path="resources/js/pages/staff/views/MyAccountView.tsx">
import { useCallback, useEffect, useRef, useState } from "react";
import { QRCodeSVG } from "qrcode.react";
import { KeyRound, ShieldCheck, Smartphone, BellRing, Crown, CheckCircle2, AlertTriangle, ChevronRight, Clock } from "lucide-react";
import api, { apiErrorMessage } from "../../../lib/api";
import { useLanguage } from "../../../i18n/LanguageContext";
import ChangePasswordForm from "../../../components/auth/ChangePasswordForm";
import PasswordConfirmDialog from "../../../components/auth/PasswordConfirmDialog";
import SaveButton from "../../../components/ui/SaveButton";
import ConfirmDialog from "../../../components/ui/ConfirmDialog";
import StatusModal from "../../../components/ui/StatusModal";
import SectionCard from "../../../components/ui/SectionCard";
import Skeleton from "../../../components/ui/Skeleton";
import SimplePager from "../../../components/ui/SimplePager";
import usePager from "../../../hooks/usePager";
import { notifyStaffAlertsChanged, setSecurityUnread } from "../../../lib/staffAlertsStore";

type Me = {
  id: number;
  user_code: string;
  first_name: string;
  last_name: string;
  is_head_staff: boolean;
  last_login_at: string | null;
  two_factor_enabled: boolean;
  validation_id_url?: string | null;
};
type SecAlert = { id: number; type: string; title: string; message: string; read: boolean; created_at: string };

export default function MyAccountView() {
  const { t, locale } = useLanguage();
  const [me, setMe] = useState<Me | null>(null);
  const [alerts, setAlerts] = useState<SecAlert[]>([]);
  const [transfer, setTransfer] = useState<{ from_name: string | null; expires_at: string } | null>(null);
  const [pwDone, setPwDone] = useState(false);
  const [notice, setNotice] = useState("");
  // Which settings section is open on the right (picked from the list on the left).
  const [section, setSection] = useState<"password" | "twostep" | "alerts">("password");

  // two-step login
  const [tfaSetup, setTfaSetup] = useState<{ secret: string; uri: string } | null>(null);
  const [tfaCode, setTfaCode] = useState("");
  const [tfaError, setTfaError] = useState("");
  const [tfaBusy, setTfaBusy] = useState(false);
  const [askSetupPw, setAskSetupPw] = useState(false);
  const [offCode, setOffCode] = useState("");
  const [askOffPw, setAskOffPw] = useState(false);
  const [offOpen, setOffOpen] = useState(false);
  const [acceptOpen, setAcceptOpen] = useState(false);
  // "Are you sure?" and "discard changes?" steps
  const [askSetupSure, setAskSetupSure] = useState(false);
  const [askOnSure, setAskOnSure] = useState(false);
  const [askOffSure, setAskOffSure] = useState(false);
  const [askDiscardSetup, setAskDiscardSetup] = useState(false);
  const [askDiscardOff, setAskDiscardOff] = useState(false);

  const alertsRef = useRef<SecAlert[]>([]);
  alertsRef.current = alerts;

  const load = useCallback(async () => {
    try {
      const [m, a, tr] = await Promise.all([
        api.get("/me"),
        api.get("/security/alerts"),
        api.get("/staff/head-transfer"),
      ]);
      setMe(m.data);
      setAlerts(a.data.data ?? []);
      setTransfer(tr.data.transfer ?? null);
    } catch { /* the api client already handles sign-outs */ }
  }, []);

  useEffect(() => { load(); }, [load]);

  // Opening this page counts as reading the alerts -- they stay highlighted
  // while you look, and are marked read when you leave.
  useEffect(() => () => {
    if (alertsRef.current.some((a) => !a.read)) {
      api.post("/security/alerts/read-all").then(() => { setSecurityUnread(0); notifyStaffAlertsChanged(); }).catch(() => {});
    }
  }, []);

  const minLength = me?.is_head_staff ? 12 : 8;

  const startSetup = async (password: string) => {
    const res = await api.post("/two-factor/setup", { password });
    setTfaSetup({ secret: res.data.secret, uri: res.data.uri });
    setTfaCode("");
    setTfaError("");
    setAskSetupPw(false);
  };

  const confirmSetup = (e: React.FormEvent) => {
    e.preventDefault();
    if (tfaCode.length === 6 && !tfaBusy) setAskOnSure(true);
  };

  const finishSetup = async () => {
    setAskOnSure(false);
    setTfaBusy(true);
    setTfaError("");
    try {
      await api.post("/two-factor/confirm", { code: tfaCode });
      setTfaSetup(null);
      setNotice(t("secTwoStepOnNotice"));
      await load();
    } catch (err: any) {
      setTfaError(err?.response?.data?.errors?.code?.[0] || apiErrorMessage(err));
    } finally {
      setTfaBusy(false);
    }
  };

  const turnOff = async (password: string) => {
    await api.post("/two-factor/disable", { password, code: offCode });
    setAskOffPw(false);
    setOffOpen(false);
    setOffCode("");
    setNotice(t("secTwoStepOffNotice"));
    await load();
  };

  const discardSetup = () => {
    setAskDiscardSetup(false);
    setTfaSetup(null);
    setTfaCode("");
    setTfaError("");
  };

  const cancelOff = () => {
    if (offCode) setAskDiscardOff(true);
    else setOffOpen(false);
  };

  const discardOff = () => {
    setAskDiscardOff(false);
    setOffOpen(false);
    setOffCode("");
  };

  const accept = async (password: string, otp: string) => {
    await api.post("/staff/head-transfer/accept", { password, otp });
    setAcceptOpen(false);
    window.location.reload(); // new role -> reload so the whole page reflects it
  };

  const when = (iso: string | null) => (iso ? new Date(iso).toLocaleString(locale) : t("secNever"));
  const pretty = (s: string) => s.replace(/(.{4})/g, "$1 ").trim();

  const initials = me ? `${me.first_name?.[0] ?? ""}${me.last_name?.[0] ?? ""}`.toUpperCase() || "S" : "";
  const unread = alerts.filter((a) => !a.read).length;
  const alertPager = usePager(alerts, 5);
  const pill = "inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-bold";
  const ghostBtn = "rounded-full border border-white/20 px-5 py-2 text-sm font-semibold text-white transition hover:bg-white/10";

  // The picked section as one card (icon + title + short text + status, then the form).
  const row = (key: "password" | "twostep" | "alerts", Icon: any, title: string, desc: string, badge: React.ReactNode, content: React.ReactNode) =>
    section === key ? (
      <SectionCard key={key} icon={<Icon className="h-5 w-5" />} title={title} desc={desc} action={badge ?? undefined}>
        {content}
      </SectionCard>
    ) : null;

  return (
    <div className="-m-3 sm:-m-6 min-h-[calc(100dvh-73px)] dash-canvas p-4 sm:p-8">
    <div className="space-y-6">
      <div className="dash-card rounded-[32px] p-5 sm:p-6">
        <h1 className="font-display text-3xl font-extrabold tracking-tight sm:text-4xl page-title-gradient page-title-fit">{t("myaccount")}</h1>
        <p className="mt-1.5 max-w-2xl text-sm text-white/55">{t("secMyAccountSubtitle")}</p>
      </div>

      <div className="grid grid-cols-1 gap-6 lg:grid-cols-[300px_minmax(0,1fr)] xl:grid-cols-[300px_minmax(0,1fr)_320px] lg:items-start">
        {/* Left: who you are, and the menu -- one card. */}
        <aside className="lg:sticky lg:top-4">
          <section className="dash-card relative overflow-hidden rounded-3xl">
            {/* Cover, fading into the card like the resident profile (mask works in light and dark) */}
            <div
              className="absolute inset-x-0 top-0 h-[270px] bg-gradient-to-br from-[#0F2A4A] via-[#135863] to-[#2E8E82]"
              style={{ WebkitMaskImage: "linear-gradient(to bottom, #000 80%, transparent 100%)", maskImage: "linear-gradient(to bottom, #000 80%, transparent 100%)" }}
            >
              {me?.validation_id_url ? (
                <img src={me.validation_id_url} alt="" className="h-full w-full object-cover object-[50%_14%]" />
              ) : (
                <div className="flex h-full w-full items-start justify-center pt-8">
                  {me ? (
                    <div className="flex h-28 w-28 items-center justify-center rounded-full bg-gold-400 text-4xl font-extrabold text-[#08130F] ring-4 ring-white/80 shadow-xl">{initials}</div>
                  ) : (
                    <Skeleton className="h-28 w-28 !rounded-full" />
                  )}
                </div>
              )}
            </div>

            <div className="relative z-10 space-y-3.5 px-4 pb-4 pt-[168px]">
              {/* Name panel */}
              <div className="profile-glass rounded-2xl px-5 py-5 text-center">
                {!me ? (
                  <div aria-busy="true" className="flex flex-col items-center">
                    <Skeleton className="h-6 w-40" />
                    <Skeleton className="mt-2 h-4 w-20" />
                  </div>
                ) : (
                  <>
                    <h2 className="break-words font-display text-2xl font-extrabold leading-tight text-white">{me.first_name} {me.last_name}</h2>
                    <p className="mt-1 font-mono text-sm text-white/55">{me.user_code}</p>
                    <span className={`${pill} mt-3 ${me.is_head_staff ? "bg-gold-400/20 text-gold-300" : "bg-[#4FBEB0]/15 text-[#2E8E82]"}`}>
                      {me.is_head_staff ? <><Crown className="h-3.5 w-3.5" /> {t("secHeadStaff")}</> : t("staffOption")}
                    </span>
                    <dl className="mt-4 text-sm">
                      <div className="flex items-center justify-between gap-3 border-t border-white/15 py-2.5">
                        <dt className="shrink-0 text-white/50">{t("secLastSignIn")}</dt>
                        <dd className="min-w-0 truncate text-right font-semibold text-white">{when(me.last_login_at)}</dd>
                      </div>
                    </dl>
                  </>
                )}
              </div>

              {/* At a glance */}
              {me && (
                <div className="grid grid-cols-2 gap-2.5">
                  <div className="min-w-0 rounded-2xl border border-white/20 bg-white/10 px-2 py-3 text-center backdrop-blur-xl">
                    <p className="text-2xl font-black leading-tight text-white">{me.two_factor_enabled ? t("secStatusOn") : t("secStatusOff")}</p>
                    <p className="mt-0.5 truncate text-xs font-medium text-white/60">{t("secTwoStepTitle")}</p>
                    <span className={`mx-auto mt-1.5 block h-1 w-8 rounded-full ${me.two_factor_enabled ? "bg-[#4FBEB0]" : "bg-gold-400"}`} />
                  </div>
                  <div className="min-w-0 rounded-2xl border border-white/20 bg-white/10 px-2 py-3 text-center backdrop-blur-xl">
                    <p className="text-2xl font-black leading-tight text-white">{unread}</p>
                    <p className="mt-0.5 truncate text-xs font-medium text-white/60">{t("secAlertsTitle")}</p>
                    <span className={`mx-auto mt-1.5 block h-1 w-8 rounded-full ${unread > 0 ? "bg-red-400" : "bg-[#4FBEB0]"}`} />
                  </div>
                </div>
              )}

              {/* Menu */}
              <nav className="rounded-2xl border border-white/20 bg-white/[0.06] p-2 backdrop-blur-xl">
                {([
                  { key: "password", label: t("changePassword"), icon: KeyRound, badge: null as string | null },
                  { key: "twostep", label: t("secTwoStepTitle"), icon: Smartphone, badge: me ? (me.two_factor_enabled ? t("secStatusOn") : t("secStatusOff")) : null },
                  { key: "alerts", label: t("secAlertsTitle"), icon: BellRing, badge: unread > 0 ? String(unread) : null },
                ] as const).map((it) => {
                  const on = section === it.key;
                  return (
                    <button
                      key={it.key}
                      type="button"
                      onClick={() => setSection(it.key)}
