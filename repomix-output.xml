      <PasswordConfirmDialog open={askOffPw} title={t("secTurnOff")} body={t("secTurnOffBody")} confirmLabel={t("secTurnOff")} tone="danger" onConfirm={turnOff} onClose={() => setAskOffPw(false)} />
