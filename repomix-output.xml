// UC-17: Switch Interface Language (English / Filipino / Bisaya).
// Coverage focuses on the app chrome (navigation, header, common actions) —
// the highest-visibility strings a resident or staff member sees on every
// screen. Individual view copy stays in English for now; extend this
// dictionary + call t() from within a view to translate further.

import { dashboardTranslations } from "./locales/dashboard";
