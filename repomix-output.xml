<file path="app/Support/PhotoSet.php">
<?php

namespace App\Support;

use Illuminate\Http\Request;
use Illuminate\Validation\ValidationException;

/**
 * Works out the final list of photos for a record that can hold several
 * (inventory items, return evidence). The first photo stays in the record's
 * original single-photo column (it is the "cover"); the rest live in a JSON
 * column, so everything that only knows about one photo keeps working.
 *
 * The request describes the result instead of a list of edits:
 *   - keep_photos[]: indexes (into the record's current photo list) to keep,
 *     in the order they should appear.
 *   - photos[]: newly picked files, appended after the kept ones.
 * Anything not kept is returned in `removed` so the caller can delete the
 * files once the record has been saved.
 */
class PhotoSet
{
    public const MAX = 5;

    /**
     * Checks the request against the current list without touching any file,
     * so callers can fail early (before changing anything else).
     *
     * @param  string[]  $current  the record's current photo paths, cover first
     * @return array{kept: string[], files: array}
     */
    public static function plan(array $current, Request $request, int $max = self::MAX, string $keepKey = 'keep_photos', string $filesKey = 'photos'): array
    {
        $current = array_values($current);
        $kept = [];
        foreach ((array) $request->input($keepKey, []) as $i) {
            $path = $current[(int) $i] ?? null;
            if ($path !== null && !in_array($path, $kept, true)) {
                $kept[] = $path;
            }
        }

        $files = array_values(array_filter((array) $request->file($filesKey, [])));

        if (count($kept) + count($files) > $max) {
            throw ValidationException::withMessages([
                $filesKey => "You can attach up to {$max} files.",
            ]);
        }

        return ['kept' => $kept, 'files' => $files];
    }

    /**
     * @param  string[]  $current  the record's current photo paths, cover first
     * @param  callable  $upload   stores one uploaded file and returns its path
     * @return array{final: string[], removed: string[]}
     */
    public static function resolve(array $current, Request $request, callable $upload, int $max = self::MAX, string $keepKey = 'keep_photos', string $filesKey = 'photos'): array
    {
        $plan = self::plan($current, $request, $max, $keepKey, $filesKey);

        return [
            'final' => array_merge($plan['kept'], array_map($upload, $plan['files'])),
            'removed' => array_values(array_diff(array_values($current), $plan['kept'])),
        ];
    }
}
</file>

<file path="app/Support/StockLedger.php">
<?php

namespace App\Support;

use App\Models\InventoryItem;
use App\Models\InventoryUnitLog;
use Illuminate\Support\Facades\DB;

/**
 * Reconciliation of an item's stock against its ledger (inventory_unit_logs). Two identities must hold
 * for every item, archived ones included:
 *
 *   lost units    lost_quantity  =  units reported lost  -  units found (found reports that were not undone)
 *   all units     in stock + on loan + lost  =  units added  +  net stock adjustments
 *
 * (Units move between stock, a loan and "lost" without changing the total; only an item being added or
 * its stock being adjusted changes how many units the barangay owns.) A difference means a stock number
 * or a ledger entry was changed outside the app. Items that existed before the ledger do not reconcile
 * until their opening balance is written down: adopt() records each difference as an explicit entry
 * (user SYSTEM) instead of hiding it.
 */
class StockLedger
{
    /** @return array<int,array<string,mixed>> one row per item that does not reconcile */
    public static function check(): array
    {
        $added = $adjusted = $lost = $found = $hasAdded = [];

        DB::table('inventory_unit_logs')->orderBy('id')->select(['id', 'inventory_item_id', 'action', 'quantity', 'units', 'undone_at'])
            ->chunkById(1000, function ($chunk) use (&$added, &$adjusted, &$lost, &$found, &$hasAdded) {
                foreach ($chunk as $l) {
                    $i = (int) $l->inventory_item_id;
                    $q = (int) $l->quantity;
                    match ($l->action) {
                        'added' => [$added[$i] = ($added[$i] ?? 0) + $q, $hasAdded[$i] = true],
                        'adjusted' => $adjusted[$i] = ($adjusted[$i] ?? 0) + array_sum(array_map('intval', (array) json_decode((string) $l->units, true))),
                        'lost' => $lost[$i] = ($lost[$i] ?? 0) + $q,
                        'found' => $l->undone_at === null ? $found[$i] = ($found[$i] ?? 0) + $q : null,
                        default => null,
                    };
                }
            });

        $onLoan = DB::table('event_inventory_items')->selectRaw('inventory_item_id, SUM(quantity) AS q')->groupBy('inventory_item_id')->pluck('q', 'inventory_item_id');

        $problems = [];
        foreach (DB::table('inventory_items')->orderBy('id')->get(['id', 'name', 'quantity', 'lost_quantity']) as $item) {
            $i = (int) $item->id;
            $loan = (int) ($onLoan[$i] ?? 0);
            $owned = (int) $item->quantity + $loan + (int) $item->lost_quantity;
            $expectedOwned = ($added[$i] ?? 0) + ($adjusted[$i] ?? 0);
            $expectedLost = ($lost[$i] ?? 0) - ($found[$i] ?? 0);

            $ownedGap = $owned - $expectedOwned;
            $lostGap = (int) $item->lost_quantity - $expectedLost;

            if ($ownedGap !== 0 || $lostGap !== 0) {
                $problems[] = [
                    'id' => $i, 'name' => (string) $item->name, 'stock' => (int) $item->quantity, 'on_loan' => $loan, 'lost' => (int) $item->lost_quantity,
                    'owned' => $owned, 'expected_owned' => $expectedOwned, 'expected_lost' => $expectedLost,
                    'owned_gap' => $ownedGap, 'lost_gap' => $lostGap, 'has_added' => isset($hasAdded[$i]),
                ];
            }
        }

        return $problems;
    }

    /**
     * Writes each difference down as an explicit ledger entry (user SYSTEM), so the ledger agrees with the
     * stock again and the difference stays visible in the history. Returns how many entries were written.
     */
    public static function adopt(): int
    {
        $written = 0;

        foreach (self::check() as $p) {
            DB::transaction(function () use ($p, &$written) {
                $item = InventoryItem::withTrashed()->find($p['id']);
                $main = $item?->condition ?? 'Good';
                $entry = fn (string $action, int $units) => InventoryUnitLog::create([
                    'inventory_item_id' => $p['id'], 'event_id' => null, 'action' => $action,
                    'quantity' => abs($units), 'units' => [$main => $units], 'user_code' => 'SYSTEM',
                ]);

                if ($p['owned_gap'] !== 0) {
                    $entry($p['owned_gap'] > 0 && !$p['has_added'] ? 'added' : 'adjusted', $p['owned_gap']);
                    $written++;
                }
                if ($p['lost_gap'] > 0) {
                    $entry('lost', $p['lost_gap']);
                    $written++;
                } elseif ($p['lost_gap'] < 0) {
                    $entry('found', -$p['lost_gap']);
                    $written++;
                }
            });
        }

        return $written;
    }
}
</file>

<file path="app/Support/Totp.php">
<?php

namespace App\Support;

/**
 * Minimal RFC 6238 TOTP (SHA-1, 6 digits, 30 s) for authenticator apps,
 * with no third-party dependency.
 */
class Totp
{
    private const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';

    public static function generateSecret(int $bytes = 20): string
    {
        return self::base32Encode(random_bytes($bytes));
    }

    public static function uri(string $secret, string $account, string $issuer = 'PiaoConnect'): string
    {
        return 'otpauth://totp/' . rawurlencode($issuer . ':' . $account)
            . '?secret=' . $secret . '&issuer=' . rawurlencode($issuer) . '&algorithm=SHA1&digits=6&period=30';
    }

    /**
     * Returns the matched time-step (so the caller can refuse a replay of
     * the same code) or null when the code is wrong. Allows +/-1 step of
     * clock drift.
     */
    public static function verify(string $secret, string $code, int $window = 1): ?int
    {
        $code = preg_replace('/\s+/', '', $code);
        if (!preg_match('/^\d{6}$/', $code)) {
            return null;
        }
        $step = intdiv(time(), 30);
        for ($i = -$window; $i <= $window; $i++) {
            if (hash_equals(self::at($secret, $step + $i), $code)) {
                return $step + $i;
            }
        }
        return null;
    }

    public static function at(string $secret, int $step): string
    {
        $key = self::base32Decode($secret);
        $binary = pack('N2', 0, $step);
        $hash = hash_hmac('sha1', $binary, $key, true);
        $offset = ord($hash[19]) & 0x0F;
        $value = ((ord($hash[$offset]) & 0x7F) << 24)
            | ((ord($hash[$offset + 1]) & 0xFF) << 16)
            | ((ord($hash[$offset + 2]) & 0xFF) << 8)
            | (ord($hash[$offset + 3]) & 0xFF);
        return str_pad((string) ($value % 1000000), 6, '0', STR_PAD_LEFT);
    }

    private static function base32Encode(string $data): string
    {
        $bits = '';
        foreach (str_split($data) as $c) {
            $bits .= str_pad(decbin(ord($c)), 8, '0', STR_PAD_LEFT);
        }
        $out = '';
        foreach (str_split($bits, 5) as $chunk) {
            $out .= self::ALPHABET[bindec(str_pad($chunk, 5, '0', STR_PAD_RIGHT))];
        }
        return $out;
    }

    private static function base32Decode(string $s): string
    {
        $s = strtoupper(preg_replace('/[^A-Z2-7]/i', '', $s));
        $bits = '';
        foreach (str_split($s) as $c) {
            $bits .= str_pad(decbin(strpos(self::ALPHABET, $c)), 5, '0', STR_PAD_LEFT);
        }
        $out = '';
        foreach (str_split($bits, 8) as $byte) {
            if (strlen($byte) === 8) {
                $out .= chr(bindec($byte));
            }
        }
        return $out;
    }
}
