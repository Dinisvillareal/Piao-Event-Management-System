              </div>
              <div className="p-7">
                <p className="font-display text-[21px] font-bold text-white">{t("loginStaffPortal")}</p>
                <p className="mt-2 text-[14px] leading-relaxed text-white/55">
                  {t("loginStaffPortalDesc")}
                </p>
                <button
                  onClick={onSelectStaff}
                  className="mt-6 flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-gold-400 to-[#4FBEB0] py-3.5 text-[15px] font-bold text-[#08130F] transition hover:opacity-90"
                >
                  {t("loginContinueStaff")} <ArrowRight className="h-4 w-4" />
                </button>
              </div>
            </div>

            <div className="overflow-hidden rounded-2xl border border-white/15 bg-white/[0.05]">
              <div className="flex items-center justify-between border-b border-white/10 px-7 py-5">
                <span className="text-[12px] font-bold uppercase tracking-wide text-white/60">{t("loginMemberAccess")}</span>
                <span className="flex h-11 w-11 items-center justify-center rounded-full bg-white/10">
                  <Users className="h-5 w-5 text-white" />
                </span>
              </div>
              <div className="p-7">
                <p className="font-display text-[21px] font-bold text-white">{t("loginMemberPortalTitle")}</p>
                <p className="mt-2 text-[14px] leading-relaxed text-white/55">
                  {t("loginMemberPortalDesc")}
                </p>
                <button
                  onClick={onSelectMember}
                  className="mt-6 flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-gold-400 to-[#4FBEB0] py-3.5 text-[15px] font-bold text-[#08130F] transition hover:opacity-90"
                >
                  {t("loginContinueMember")} <ArrowRight className="h-4 w-4" />
                </button>
              </div>
            </div>
          </div>

          <p className="relative z-10 mt-11 text-[13px] text-white/40">
            {t("loginNeedHelp")}{" "}
            <span className="font-semibold text-[#7DD8CB]">0917-123-4567</span>
          </p>
        </div>
      </div>
    </div>
  );
}

// ─── Live clock -- Philippine Standard Time, ticking every second, styled
// after the reference gov't sites (plain stacked text, no badge chrome). ──
function LiveClock() {
  const { t, locale } = useLanguage();
  const [now, setNow] = useState(() => new Date());

  useEffect(() => {
    const id = setInterval(() => setNow(new Date()), 1000);
    return () => clearInterval(id);
  }, []);

  const dateLabel = now.toLocaleDateString(locale, {
    timeZone: "Asia/Manila",
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
  });
  const timeLabel = now.toLocaleTimeString(locale, {
    timeZone: "Asia/Manila",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  });

  return (
    <div className="text-right">
      <p className="max-sm:hidden text-[11px] font-semibold uppercase tracking-[0.16em] text-white/45">{t("loginPhilTime")}</p>
      <p className="text-[13px] font-semibold text-white/90 [font-variant-numeric:tabular-nums] sm:hidden">{timeLabel}</p>
      <p className="mt-0.5 hidden text-[13px] font-medium text-white/90 [font-variant-numeric:tabular-nums] sm:block">
        {t("loginDateAtTime").replace("{date}", dateLabel).replace("{time}", timeLabel)}
      </p>
    </div>
  );
}

// ─── Live activity feed -- three sample lines whose "time ago" label keeps
// advancing every few seconds, giving the branded panel a sense of a live,
// in-use system rather than a static marketing graphic. ──────────────────
function LiveActivityFeed() {
  const { t } = useLanguage();
  const [tick, setTick] = useState(0);
  useEffect(() => {
    const id = setInterval(() => setTick((t) => t + 1), 5000);
    return () => clearInterval(id);
  }, []);

  const formatAgo = (baseSeconds: number) => {
    const seconds = baseSeconds + tick * 5;
    if (seconds < 60) return t("justNowLabel");
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return t("minutesAgoShortLabel").replace("{n}", String(minutes));
    return t("hoursAgoShortLabel").replace("{n}", String(Math.floor(minutes / 60)));
  };

  const items = [
    { label: "loginActNewResident", base: 20 },
    { label: "loginActCertApproved", base: 340 },
    { label: "loginActAttendanceLogged", base: 1180 },
  ];

  return (
    <div className="space-y-2.5">
      {items.map((item) => (
        <div key={item.label} className="flex items-center gap-2.5 text-[12px]">
          <span className="relative flex h-1.5 w-1.5 shrink-0">
            <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#4FBEB0] opacity-60" />
            <span className="relative inline-flex h-1.5 w-1.5 rounded-full bg-[#4FBEB0]" />
          </span>
          <span className="text-white/80">{t(item.label)}</span>
          <span className="text-white/35">&middot; {formatAgo(item.base)}</span>
        </div>
      ))}
    </div>
  );
}

// ─── Login Page ───────────────────────────────────────────────────────────────
export default function LoginPage() {
  const { t } = useLanguage();
  useThemeScope();
  const [showContact, setShowContact] = useState(false);
  const [error, setError] = useState("");
  // What kind of message the banner shows: a sign-in failure (red) or a plain
  // notice such as "you were signed out" (neutral). `credsWrong` also flags the
  // username/password inputs; `fieldErr` is for left-empty fields.
  const [errorKind, setErrorKind] = useState<"error" | "notice">("error");
  const [errorTitle, setErrorTitle] = useState("");
  const [credsWrong, setCredsWrong] = useState<"username" | "password" | null>(null);
  const [fieldErr, setFieldErr] = useState<{ username?: string; password?: string }>({});
  // A friendly next step under the username error (activate now / contact the office).
  const [helpCta, setHelpCta] = useState<{ kind: "pending" | "noaccount" | "notfound"; user: string } | null>(null);
  const clearErrors = () => { setError(""); setErrorTitle(""); setCredsWrong(null); setFieldErr({}); setHelpCta(null); };
  const [isLoading, setIsLoading] = useState(false);
  const [keepSignedIn, setKeepSignedIn] = useState(false);
  const [showPassword, setShowPassword] = useState(false);
  // Two-step login: asked for only after the password was right and the account has an authenticator.
  const [otpRequired, setOtpRequired] = useState(false);
  const [showForgot, setShowForgot] = useState(false);
  const [showActivate, setShowActivate] = useState(false);

  // A notice left by the app when it signed the person out (inactivity, suspension...).
  useEffect(() => {
    try {
      const notice = sessionStorage.getItem("login_notice");
      if (notice) { sessionStorage.removeItem("login_notice"); setErrorKind("notice"); setErrorTitle(t("loginNoticeTitle")); setError(notice); }
    } catch { /* ignore */ }
  }, []);

  const [showPortalModal, setShowPortalModal] = useState(false);
  const [loggedInUser, setLoggedInUser] = useState<any>(null);
  // Popped up instead of a blocking native alert() -- OK navigates to /login
  // itself so the message stays on screen until the user has actually read it.
  const [showAccountDeletedModal, setShowAccountDeletedModal] = useState(false);
  // Brief, non-blocking, auto-dismissing toast (also replaces a native alert()) --
  // a "copied!" confirmation doesn't need a click to dismiss.
  const [showCopiedToast, setShowCopiedToast] = useState(false);

  // The shared branded splash (see components/ui/SplashScreen.tsx and
  // app.tsx, which shows it for every full page load/refresh), replayed
  // here briefly after a Staff/Member choice on the Portal Selection screen
  // -- gives that jump to the dashboard the same "building your portal"
  // moment instead of an instant, jarring swap. The page navigates away
  // (window.location.href) once it's had time to play, so there's no need
  // to fade it back out first -- app.tsx's own splash takes over the moment
  // that navigation's fresh page load starts checking auth.
  const [portalTransitionVisible, setPortalTransitionVisible] = useState(false);

  const contactRef = useRef<HTMLDivElement>(null);

  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    clearErrors();
    setErrorKind("error");

    const form = e.currentTarget;
    const username = (form.elements.namedItem("username") as HTMLInputElement).value;
    const password = (form.elements.namedItem("password") as HTMLInputElement).value;

    if (!username.trim() || !password.trim()) {
      setFieldErr({
        username: username.trim() ? undefined : t("loginErrEnterUsername"),
        password: password.trim() ? undefined : t("loginErrEnterPassword"),
      });
      return;
    }

    setIsLoading(true);

    try {
      const csrfToken = document
        .querySelector('meta[name="csrf-token"]')
        ?.getAttribute("content");

      const response = await fetch("/login", {
        method: "POST",
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
          "X-Requested-With": "XMLHttpRequest",
          ...(csrfToken && { "X-CSRF-TOKEN": csrfToken }),
        },
        body: JSON.stringify({
          username,
          password,
          remember_me: keepSignedIn,
          ...(otpRequired && { otp: ((form.elements.namedItem("otp") as HTMLInputElement | null)?.value ?? "").trim() }),
        }),
      });

      const data = await response.json();

      if (response.ok) {
        localStorage.clear();
        sessionStorage.clear();

        if (keepSignedIn) {
          localStorage.setItem("user", JSON.stringify(data.user));
          localStorage.setItem("isAuthenticated", "true");
        } else {
          sessionStorage.setItem("user", JSON.stringify(data.user));
          sessionStorage.setItem("isAuthenticated", "true");
        }

        if (data.user.role === "Staff") {
          setLoggedInUser(data.user);
          setShowPortalModal(true);
          setIsLoading(false);
          return;
        }

        if (keepSignedIn) {
          localStorage.setItem("portalMode", "member");
        } else {
          sessionStorage.setItem("portalMode", "member");
        }
        window.location.href = "/member/dashboard";
      } else {
        if (response.status === 401 && data.two_factor_required) {
          // Password was right -- now ask for the authenticator code.
          // (Only a wrong code is an error; the first ask is just the next step.)
          if (otpRequired) { setErrorTitle(t("loginErrCodeTitle")); setError(data.message || ""); }
          setOtpRequired(true);
          const otpInput = form.elements.namedItem("otp") as HTMLInputElement | null;
          if (otpInput) otpInput.value = "";
          return;
        } else if (response.status === 401) {
          if (data.message && data.message.includes("deleted")) {
            setShowAccountDeletedModal(true);
            return;
          }
          const codeKey: Record<string, string> = {
            username_not_found: "loginErrUserNotFound",
            pending_activation: "loginErrPendingActivation",
            no_portal_account: "loginErrNoPortalAccount",
            account_suspended: "loginErrSuspended",
            wrong_password: "loginErrWrongPassword",
          };
          if (data.field === "username" || data.field === "password") {
            // Specific message right under the field that needs fixing.
            setCredsWrong(data.field);
            const msg = codeKey[data.code] ? t(codeKey[data.code]) : (data.message || t("loginErrInvalidClear"));
            setFieldErr({ [data.field]: msg });
            const kind = data.code === "pending_activation" ? "pending" : data.code === "no_portal_account" ? "noaccount" : data.code === "username_not_found" ? "notfound" : null;
            setHelpCta(kind ? { kind, user: username.trim() } : null);
          } else if (!data.message || data.message === "Invalid credentials") {
            setCredsWrong("username");
            setErrorTitle(t("loginErrInvalidTitle"));
            setError(t("loginErrInvalidClear"));
          } else {
            setErrorTitle(t("loginSignInFailed"));
            setError(data.message);
          }
        } else if (response.status === 419) {
          setError(t("loginErrSessionExpired"));
        } else if (response.status === 429 && data.code === "too_many_attempts") {
          setErrorTitle(t("loginErrLockedTitle"));
          setError(t("loginErrLockedBody"));
        } else if (response.status === 429) {
          const retryAfter = parseInt(response.headers.get("Retry-After") || "", 10);
          setError(
            Number.isFinite(retryAfter) && retryAfter > 0
              ? retryAfter === 1
                ? t("loginErrTooManyOneSecond")
                : t("loginErrTooManySeconds").replace("{n}", String(retryAfter))
              : t("loginErrTooMany")
          );
        } else {
          setError(data.message || t("loginErrFailed"));
        }

        (form.elements.namedItem("password") as HTMLInputElement).value = "";
      }
    } catch (err) {
      setError(t("loginErrNetwork"));
    } finally {
      setIsLoading(false);
    }
  };

  // Matches app.tsx's MIN_SPLASH_MS -- the splash's own build-in animation
  // (logo assembling, then three staggered lines of text) takes about 1.55s
  // to finish playing, so the navigation away is held off until it's had
  // the full time to complete rather than cutting it off mid-animation.
  const PORTAL_TRANSITION_MS = 1800;

  const handleGoToStaff = () => {
    const keepSigned = localStorage.getItem("isAuthenticated") === "true" ? localStorage.getItem("user") !== null : false;
    if (keepSigned) {
      localStorage.setItem("portalMode", "staff");
    } else {
      sessionStorage.setItem("portalMode", "staff");
    }
    // No second splash here: the app's own splash plays once after this reload.
    window.location.href = "/";
  };

  const handleGoToMember = () => {
    const keepSigned = localStorage.getItem("isAuthenticated") === "true" ? localStorage.getItem("user") !== null : false;
    if (keepSigned) {
      localStorage.setItem("portalMode", "member");
    } else {
      sessionStorage.setItem("portalMode", "member");
    }
    // No second splash here: the app's own splash plays once after this reload.
    window.location.href = "/member/dashboard";
  };

  const handleLogoutFromPortalSelect = () => {
    localStorage.clear();
    sessionStorage.clear();
    setShowPortalModal(false);
    setLoggedInUser(null);
    window.location.href = "/login";
  };

  const contactNumber = "0917-123-4567";

  const copyToClipboard = () => {
    navigator.clipboard.writeText(contactNumber);
    setShowCopiedToast(true);
    setTimeout(() => setShowCopiedToast(false), 1800);
  };

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (
        contactRef.current &&
        !contactRef.current.contains(event.target as Node)
      ) {
        setShowContact(false);
      }
    };
    document.addEventListener("mousedown", handleClickOutside);
    return () => {
      document.removeEventListener("mousedown", handleClickOutside);
    };
  }, []);

  return (
    <div className="relative min-h-screen overflow-hidden bg-[#0A0E1A] text-white font-sans">
      {portalTransitionVisible && <SplashScreen visible={true} />}

      {showPortalModal && loggedInUser && (
        <PortalSelectionModal
          userName={loggedInUser.first_name || loggedInUser.user_code}
          onSelectStaff={handleGoToStaff}
          onSelectMember={handleGoToMember}
          onLogout={handleLogoutFromPortalSelect}
        />
      )}

      <StatusModal
        open={showAccountDeletedModal}
        type="error"
        title={t("loginAccountDeletedTitle")}
        message={t("loginAccountDeletedMsg")}
        okLabel={t("okLabel")}
        onClose={() => { setShowAccountDeletedModal(false); window.location.href = "/login"; }}
      />

      {showCopiedToast && (
        <div className="fixed bottom-6 left-1/2 -translate-x-1/2 z-[45] flex items-center gap-2 rounded-full bg-[#0A0E1A] text-white text-sm font-medium px-5 py-2.5 shadow-xl animate-in fade-in slide-in-from-bottom-2">
          <CheckCircle size={16} className="text-gold-400" /> {t("loginCopied")}
        </div>
      )}

      {/* Centered glass-card login -- the pattern real enterprise sign-in
          pages use (GitHub, Vercel, Slack): a full-bleed dimmed backdrop, a
          slim top bar carrying the only "live" chrome (status + clock), and
          a single frosted-glass card holding the form, nothing competing
          with it for attention. ─────────────────────────────────────────── */}
      <div className="relative flex min-h-screen flex-col">
        {/* Full-bleed backdrop: the barangay photo, blurred and dimmed under
            the same dark-navy tone as the rest of the site. */}
        <div className="pointer-events-none absolute inset-0 overflow-hidden">
          <div
            className="absolute inset-0 scale-105 bg-cover bg-center blur-sm"
            style={{ backgroundImage: "url('/barangay-assembly.jpg')" }}
          />
          <div className="absolute inset-0 bg-[#0A0E1A]/75" />
          <div className="absolute inset-0 bg-gradient-to-b from-[#0A0E1A] via-transparent to-[#0A0E1A]" />
        </div>

        {/* Slim top bar -- logo on the left, the only real-time chrome on the right */}
        <div className="relative z-10 flex items-center justify-between gap-3 border-b border-white/10 px-4 py-3 sm:px-10 sm:py-4">
          <div className="flex shrink-0 items-center gap-2.5">
            <div className="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full border border-white/20 bg-white/10">
              <img src="/logo-removebg-preview.png" alt={t("loginLogoAlt")} className="h-full w-full object-contain" />
            </div>
            <span className="whitespace-nowrap text-[13px] font-extrabold tracking-wide text-white">
              PIAO<span className="text-white/40">CONNECT</span>
            </span>
          </div>
          <div className="flex shrink-0 items-center gap-3 sm:gap-4">
            <div className="hidden items-center gap-2 sm:flex">
              <span className="relative flex h-2 w-2">
                <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#4FBEB0] opacity-75" />
                <span className="relative inline-flex h-2 w-2 rounded-full bg-[#4FBEB0]" />
              </span>
              <span className="text-[11px] font-semibold uppercase tracking-wide text-white/55">{t("loginSystemOnline")}</span>
            </div>
            <LiveClock />
            <ThemeToggle />
          </div>
        </div>

        {/* Wording on the left, the sign-in card on the right */}
        <div className="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col items-center gap-7 px-4 py-6 sm:gap-10 sm:px-10 sm:py-14 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
          {/* Left: branding + wording */}
          <div className="w-full max-w-2xl text-center lg:text-left">
            <p className="text-[11px] font-semibold uppercase tracking-[0.25em] text-white/60 sm:text-[15px] sm:tracking-[0.3em]">
              {t("loginWelcomeTo")}
            </p>
            <p className="mt-2 font-display text-[32px] font-extrabold uppercase leading-none tracking-tight min-[400px]:text-[40px] sm:text-[60px]">
              <span
                className="bg-clip-text text-transparent"
                style={{
                  backgroundImage:
                    "linear-gradient(90deg, #F4CE6A 0%, #92C298 33%, #3E989B 66%, #125E85 100%)",
                }}
              >
                {t("loginCommunityName")}
              </span>
            </p>
            <p className="mt-3 text-[11px] font-semibold uppercase leading-relaxed tracking-[0.18em] text-white/50 sm:mt-4 sm:text-[14px] sm:tracking-[0.2em] sm:whitespace-nowrap">
              {t("loginTagline")}
            </p>
            <p className="mx-auto mt-4 max-w-lg text-sm leading-relaxed text-white/55 sm:mt-6 sm:text-[16px] lg:mx-0">
              {t("loginIntro")}
            </p>
          </div>

          {/* Right: the sign-in card */}
          <div className="w-full max-w-lg rounded-3xl border border-white/15 bg-white/[0.07] p-5 shadow-[0_25px_70px_rgba(0,0,0,0.55)] backdrop-blur-2xl sm:p-10">
            <div className="text-center">
              <h2 className="font-display text-2xl font-bold text-white sm:text-[34px]">{t("welcomeBack")}</h2>
              <p className="mt-2 text-sm text-white/55 sm:text-[16px]">
                {t("loginSubtitle")}
              </p>
            </div>

            <form onSubmit={handleSubmit} noValidate className="mt-6 space-y-4 sm:mt-8 sm:space-y-5">
              <div>
                <label className="text-sm font-semibold text-white/80 sm:text-[15px]">{t("usernameLabel")}</label>
                <input
                  type="text"
                  name="username"
                  className={`w-full mt-1.5 rounded-xl border bg-white/5 px-4 py-3 text-[15px] text-white placeholder-white/30 sm:py-3.5 transition focus:outline-none focus:ring-4 ${
                    fieldErr.username || credsWrong === "username" ? "border-red-400 focus:border-red-400 focus:ring-red-400/15" : "border-white/15 focus:border-[#4FBEB0] focus:ring-[#4FBEB0]/15"
                  }`}
                  placeholder="PR-0001"
                  required
                  disabled={isLoading}
                  aria-invalid={!!(fieldErr.username || credsWrong === "username")}
                  onInput={() => { if (error || fieldErr.username || credsWrong) clearErrors(); }}
                />
                {fieldErr.username && <p className="mt-1.5 flex items-center gap-1.5 text-[13px] font-medium text-red-400"><AlertCircle className="h-4 w-4 shrink-0" />{fieldErr.username}</p>}
                {helpCta && (
                  <div className={`mt-3 rounded-2xl border p-4 ${helpCta.kind === "pending" ? "border-[#4FBEB0]/30 bg-[#4FBEB0]/10" : "border-white/15 bg-white/[0.06]"}`}>
                    <p className="text-[13.5px] leading-relaxed text-white/80">
                      {helpCta.kind === "pending" ? t("loginHelpPending") : helpCta.kind === "noaccount" ? t("loginHelpNoAccount") : t("loginHelpNotFound")}
                    </p>
                    {helpCta.kind === "pending" && (
                      <button type="button" onClick={() => setShowActivate(true)} className="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-gold-400 to-[#4FBEB0] px-5 py-2.5 text-[14px] font-bold text-[#08130F] transition hover:opacity-90">
                        {t("loginHelpActivateBtn")} <ArrowRight className="h-4 w-4" />
                      </button>
                    )}
                    {helpCta.kind === "noaccount" && (
                      <button type="button" onClick={() => { setShowContact(true); contactRef.current?.scrollIntoView({ behavior: "smooth", block: "center" }); }} className="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-full border border-white/25 bg-white/10 px-5 py-2.5 text-[14px] font-semibold text-white transition hover:bg-white/15">
                        {t("loginHelpContactBtn")}
                      </button>
                    )}
                    {helpCta.kind === "notfound" && (
                      <button type="button" onClick={() => setShowActivate(true)} className="mt-3 text-[13px] font-semibold text-[#7DD8CB] hover:underline">
                        {t("actLink")}
                      </button>
                    )}
                  </div>
                )}
              </div>

              <div>
                <div className="flex justify-between items-baseline text-sm">
                  <label className="text-sm font-semibold text-white/80 sm:text-[15px]">{t("passwordLabel")}</label>
                  <button type="button" onClick={() => setShowForgot(true)} className="text-[13px] font-semibold text-[#7DD8CB] hover:underline">{t("secForgotLink")}</button>
                </div>
                <div className="relative">
                  <input
                    type={showPassword ? "text" : "password"}
                    name="password"
                    className={`password-field w-full mt-1.5 rounded-xl border bg-white/5 px-4 py-3 pr-11 text-[15px] sm:py-3.5 text-white placeholder-white/30 transition focus:outline-none focus:ring-4 ${
                      fieldErr.password || credsWrong === "password" ? "border-red-400 focus:border-red-400 focus:ring-red-400/15" : "border-white/15 focus:border-[#4FBEB0] focus:ring-[#4FBEB0]/15"
                    }`}
                    placeholder="••••••••"
                    required
                    disabled={isLoading}
                    aria-invalid={!!(fieldErr.password || credsWrong === "password")}
                    onInput={() => { if (error || fieldErr.password || credsWrong) clearErrors(); }}
                  />
                  <button
                    type="button"
                    onClick={() => setShowPassword((v) => !v)}
                    aria-label={showPassword ? t("loginHidePassword") : t("loginShowPassword")}
                    className="absolute right-3 top-1/2 mt-0.5 -translate-y-1/2 text-white/50 transition hover:text-white"
                  >
                    <EyeToggleIcon visible={showPassword} />
                  </button>
                  {/* Edge/IE draw their own native reveal-password eye inside
                      the field itself, which was doubling up with the custom
                      one above -- hide the browser's built-in icon so only
                      ours shows. */}
                  <style>{`
                    .password-field::-ms-reveal,
                    .password-field::-ms-clear {
                      display: none;
                    }
                  `}</style>
                </div>
              </div>

              {fieldErr.password && <p className="-mt-3 flex items-center gap-1.5 text-[13px] font-medium text-red-400"><AlertCircle className="h-4 w-4 shrink-0" />{fieldErr.password}</p>}

              {otpRequired && (
                <div>
                  <label className="text-sm font-semibold text-white/80 sm:text-[15px]">{t("secAuthCodeLabel")}</label>
                  <input
                    type="text"
                    name="otp"
                    inputMode="numeric"
                    pattern="[0-9]{6}"
                    autoComplete="one-time-code"
                    maxLength={6}
                    minLength={6}
                    // Digits only, six of them: typing or pasting anything else is dropped.
                    onInput={(e) => { e.currentTarget.value = e.currentTarget.value.replace(/\D/g, "").slice(0, 6); }}
                    autoFocus
                    className="w-full mt-1.5 rounded-xl border border-white/15 bg-white/5 px-4 py-3.5 text-center text-[20px] tracking-[0.4em] text-white placeholder-white/30 transition focus:outline-none focus:border-[#4FBEB0] focus:ring-4 focus:ring-[#4FBEB0]/15"
                    placeholder="000000"
                    disabled={isLoading}
                  />
                  <p className="mt-1.5 text-[13px] text-white/45">{t("secAuthCodeHint")}</p>
                </div>
              )}

              <div className="flex items-center gap-2.5 text-sm">
                <input
                  type="checkbox"
                  id="keepSignedIn"
                  checked={keepSignedIn}
                  onChange={(e) => setKeepSignedIn(e.target.checked)}
                  className="h-5 w-5 shrink-0 cursor-pointer rounded-md border-white/40 bg-white/10 text-[#4FBEB0] focus:ring-[#4FBEB0]"
                  disabled={isLoading}
                />
                <label htmlFor="keepSignedIn" className="cursor-pointer select-none text-sm text-white/75 sm:text-[15px]">
                  {t("loginKeepSignedIn")}
                </label>
              </div>

              {error && (
                <div
                  role="alert"
                  aria-live="assertive"
                  className={`flex items-start gap-3 rounded-xl border px-4 py-3.5 ${
                    errorKind === "error" ? "border-red-400/40 bg-red-500/10" : "border-[#4FBEB0]/35 bg-[#4FBEB0]/10"
                  }`}
                >
                  {errorKind === "error"
                    ? <AlertCircle className="mt-0.5 h-5 w-5 shrink-0 text-red-400" />
                    : <Info className="mt-0.5 h-5 w-5 shrink-0 text-[#7DD8CB]" />}
                  <div className="min-w-0">
                    <p className={`text-[15px] font-bold ${errorKind === "error" ? "text-red-300" : "text-[#7DD8CB]"}`}>{errorTitle || t("loginSignInFailed")}</p>
                    <p className="mt-0.5 text-[14px] leading-snug text-white/75">{error}</p>
                  </div>
                </div>
              )}

              <button
                type="submit"
                disabled={isLoading}
                className="w-full py-3 sm:py-3.5 rounded-full font-bold text-[15px] sm:text-[16px] shadow-sm transition text-[#08130F] flex items-center justify-center gap-2 bg-gradient-to-r from-gold-400 to-[#4FBEB0] hover:opacity-90 disabled:opacity-50"
              >
                {isLoading ? t("loginSigningIn") : t("signInWord")}
                {!isLoading && <ArrowRight className="h-4 w-4" />}
              </button>

              <div className="relative flex justify-center mt-1" ref={contactRef}>
                <p className="text-[13px] text-white/45">
                  {t("loginNoAccount")}{" "}
                  <span
                    onClick={() => setShowContact(true)}
                    className="font-semibold cursor-pointer text-[#7DD8CB] hover:underline"
                  >
                    {t("loginContactRecords")}
                  </span>
                </p>

                {showContact && (
                  // Below-and-centered on phones/small tablets, where the
                  // trigger text is itself centered on the page -- popping
                  // this out to the right (the sm+ layout below) would push
                  // a fixed 170px box past the right edge of a narrow
                  // viewport, clipping it or forcing the whole page to
                  // scroll horizontally. From `sm:` up there's enough room
                  // beside the centered form for the original side popout.
                  <div className="absolute z-10 left-1/2 top-full mt-2 w-[calc(100vw-2.5rem)] max-w-[240px] -translate-x-1/2 sm:left-full sm:top-0 sm:mt-0 sm:ml-3 sm:w-[170px] sm:max-w-none sm:translate-x-0 flex items-center gap-2 border border-white/10 bg-[#0F1B33] rounded-xl px-4 py-2 text-sm text-white shadow">
                    <span>{contactNumber}</span>
                    <Copy
                      className="h-4 w-4 cursor-pointer text-white/50 hover:text-[#4FBEB0]"
                      onClick={copyToClipboard}
                    />
                  </div>
                )}
              </div>
            </form>

            <p className="mt-5 text-center sm:mt-6">
              <button type="button" onClick={() => setShowActivate(true)} className="text-[14px] font-semibold text-[#7DD8CB] hover:underline">{t("actLink")}</button>
            </p>

            <p className="mt-4 text-center text-[11px] leading-relaxed text-white/35 sm:mt-6 sm:text-[12px]">
              {t("loginResidentNote")}
            </p>
          </div>
        </div>
      </div>

      {showForgot && <ForgotPasswordModal onClose={() => setShowForgot(false)} />}
      {showActivate && <ActivateAccountModal initialUserCode={helpCta?.kind === "pending" ? helpCta.user : ""} onClose={() => { setShowActivate(false); }} onActivated={() => { clearErrors(); window.setTimeout(() => (document.querySelector('input[name="password"]') as HTMLInputElement | null)?.focus(), 50); }} />}

      {/* Giant watermark band -- a huge faint "PC" (PiaoConnect) outline
          behind a two-line statement, echoing the reference's oversized
          agency-initials watermark, done with our own initials and copy. */}
      <section className="login-band relative overflow-hidden bg-gradient-to-b from-[#0A0E1A] via-[#0D1526] to-[#0A0E1A] px-6 py-12 sm:px-10 sm:py-32">
        <div className="pointer-events-none absolute inset-0 flex select-none items-center justify-center overflow-hidden">
          <span
            className="login-band-mark font-display font-extrabold leading-none text-transparent"
            style={{
              fontSize: "clamp(150px, 34vw, 480px)",
              WebkitTextStroke: "2px rgba(255,255,255,0.28)",
              color: "rgba(255,255,255,0.04)",
            }}
          >
            PC
          </span>
        </div>

        <div className="relative mx-auto max-w-3xl text-balance text-center">
          <p className="login-band-text text-[18px] font-bold leading-snug text-white sm:text-[28px]">
            {t("loginBuildingPrefix")}{" "}
            <span className="login-band-gold bg-gradient-to-r from-gold-300 to-gold-400 bg-clip-text text-transparent">
              {t("loginBarangayWord")}
            </span>
            ,{" "}
            <span className="login-band-teal bg-gradient-to-r from-[#8FC59B] to-[#4FBEB0] bg-clip-text text-transparent">
              {t("loginCommittedTo")}
            </span>
          </p>
          <span className="mx-auto mt-5 block h-px w-14 bg-gradient-to-r from-gold-400 to-[#4FBEB0] sm:mt-6 sm:w-20" aria-hidden="true" />
          <p className="login-band-text mt-5 text-[15px] font-semibold leading-snug text-white/90 sm:mt-6 sm:text-[22px]">
            {t("loginOneAtATime")}
          </p>
        </div>
      </section>

      <p className="relative z-10 border-t border-white/10 px-6 py-4 text-center text-[11px] text-white/30 sm:px-10">
        {t("loginFooter")}
      </p>
    </div>
  );
}
