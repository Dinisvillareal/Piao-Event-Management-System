import { scrollListIntoView } from "../../../lib/scrollToList";
import useFilterSwitching from "../../../hooks/useFilterSwitching";
import { useState, useMemo, useEffect, useRef } from "react";
import {
  Filter,
  Star,
  Pencil,
  CheckCircle,
  X,
  HelpCircle,
  Lock,
  Trash2,
  CalendarDays,
  MapPin,
} from "lucide-react";
import FeedbackComment from "../../../components/ui/FeedbackComment";
import type { ResponseFields } from "../../../components/ui/FeedbackComment";
import { ABSENCE_REASON_KEYS, absenceKeyFromLabel } from "../../../lib/absence";
import SearchBar from "../../../components/ui/SearchBar";
import DatePicker from "../../../components/ui/DatePicker";
import FilterDropdown from "../../../components/ui/FilterDropdown";
import FilterBar from "../../../components/ui/FilterBar";
import Skeleton from "../../../components/ui/Skeleton";
import { useLanguage } from "../../../i18n/LanguageContext";
import { tc } from "../../../lib/contentTranslations";
import api, { apiErrorMessage } from "../../../lib/api";
import { matchesSearch } from "../../../lib/search";
import ConfirmDialog from "../../../components/ui/ConfirmDialog";
import StatusModal from "../../../components/ui/StatusModal";

interface Event {
  id: number;
  title: string;
  date: string;
  event_end?: string | null;
  location: string;
  description: string;
  membership_ids?: number[];
  memberships?: { id: number; name: string }[];
}

interface AttendanceRecord {
  eventId?: number;
  status: string;
}

interface FeedbackEntry extends ResponseFields {
  id: number;
  event_id: number;
  rating: number;
  comment: string | null;
  edits_count?: number;
  staff_liked_at?: string | null;
  staff_reply?: string | null;
  staff_replied_at?: string | null;
  is_locked?: boolean;
  edit_until?: number;
  edit_window_minutes?: number;
}

export interface AbsenceEntry extends ResponseFields {
  id: number;
  event_id: number;
  reason: string;
  comment: string | null;
  edits_count?: number;
  staff_liked_at?: string | null;
  staff_reply?: string | null;
  staff_replied_at?: string | null;
  edit_until?: number;
}

interface EventsViewProps {
  allEvents: Event[];
  allMemberships: { id: number; name: string }[];
  userMemberships: { id: number; name: string }[];
  highlightText: (text: string, query: string) => React.ReactNode;
  attendanceRecords?: AttendanceRecord[];
  myFeedback?: FeedbackEntry[];
  onFeedbackSubmitted?: (entry: FeedbackEntry) => void;
  myAbsences?: AbsenceEntry[];
  onAbsenceSubmitted?: (entry: AbsenceEntry) => void;
  focusEventId?: number | null;
  onFocusHandled?: () => void;
  member?: { first_name?: string | null; last_name?: string | null } | null;
  feedbackRules?: { close_after_hours: number; edit_window_minutes: number };
  loading?: boolean;
}

export default function EventsView({
  allEvents,
  allMemberships,
  userMemberships,
  highlightText,
  attendanceRecords = [],
  myFeedback = [],
  onFeedbackSubmitted,
  myAbsences = [],
  onAbsenceSubmitted,
  focusEventId,
  onFocusHandled,
  member,
  feedbackRules,
  loading = false,
}: EventsViewProps) {
  const { t, locale, language } = useLanguage();

  const listTopRef = useRef<HTMLDivElement>(null);

  const [eventSearch, setEventSearch] = useState("");
  const [eventFilter, setEventFilter] = useState("all");
  const [membershipFilter, setMembershipFilter] = useState("all");
  const [dateFilter, setDateFilter] = useState("");
  const [currentPage, setCurrentPage] = useState(1);

  const [pageSwitching, setPageSwitching] = useState(false);
  const pageSwitchTimer = useRef<ReturnType<typeof setTimeout> | null>(null);

  const goToPage = (updater: number | ((p: number) => number)) => {
    setCurrentPage(updater as any);
    setPageSwitching(true);
    if (pageSwitchTimer.current) clearTimeout(pageSwitchTimer.current);
    pageSwitchTimer.current = setTimeout(() => setPageSwitching(false), 0);
    scrollListIntoView(listTopRef.current);
  };

  useEffect(
    () => () => {
      if (pageSwitchTimer.current) clearTimeout(pageSwitchTimer.current);
    },
    []
  );

  const itemsPerPage = 6;

  const [reviewingEventId, setReviewingEventId] = useState<number | null>(null);

  const [removeTarget, setRemoveTarget] = useState<{ id: number; eventTitle: string } | null>(null);
  const [removeBusy, setRemoveBusy] = useState(false);
  const [removeError, setRemoveError] = useState<string | null>(null);

  // --- POPUP MODAL STATES ---
  const [showThankYou, setShowThankYou] = useState(false);
  const [showUpdated, setShowUpdated] = useState(false);
  const [isEditSubmit, setIsEditSubmit] = useState(false);

  // Live clock -- ticks every second so the countdown updates without refresh.
  const [nowTick, setNowTick] = useState<number>(Date.now());
  useEffect(() => {
    const id = setInterval(() => setNowTick(Date.now()), 1000);
    return () => clearInterval(id);
  }, []);

  const [reviewRating, setReviewRating] = useState(0);
  const [reviewHoverRating, setReviewHoverRating] = useState(0);
  const [reviewComment, setReviewComment] = useState("");
  const [submittingReview, setSubmittingReview] = useState(false);
  const [reviewError, setReviewError] = useState<string | null>(null);
  const [confirmReviewEventId, setConfirmReviewEventId] = useState<number | null>(null);

  // ---- LOCAL MIRROR STATE ----
  const [localFeedback, setLocalFeedback] = useState<FeedbackEntry[]>([]);
  const [localAbsences, setLocalAbsences] = useState<AbsenceEntry[]>([]);

  const [reasoningEventId, setReasoningEventId] = useState<number | null>(null);
  const [reasonKey, setReasonKey] = useState<string>("");
  const [reasonComment, setReasonComment] = useState("");
  const [submittingReason, setSubmittingReason] = useState(false);
  const [reasonError, setReasonError] = useState<string | null>(null);
  const [justSubmittedReasonEventId, setJustSubmittedReasonEventId] = useState<number | null>(null);

  useEffect(() => {
    if (justSubmittedReasonEventId === null) return;
    const timer = setTimeout(() => setJustSubmittedReasonEventId(null), 4000);
    return () => clearTimeout(timer);
  }, [justSubmittedReasonEventId]);

  const getAttendanceForEvent = (eventId: number) =>
    attendanceRecords.find((r) => Number(r.eventId) === Number(eventId));

  const getFeedbackForEvent = (eventId: number) =>
    localFeedback.find((f) => Number(f.event_id) === Number(eventId)) ??
    myFeedback.find((f) => Number(f.event_id) === Number(eventId));

  const getAbsenceForEvent = (eventId: number) =>
    localAbsences.find((a) => Number(a.event_id) === Number(eventId)) ??
    myAbsences.find((a) => Number(a.event_id) === Number(eventId));

  const canReviewEvent = (eventId: number) => {
    const attendance = getAttendanceForEvent(eventId);
    if (!attendance) return false;
    if (attendance.status === "complete") return true;
    if (attendance.status !== "incomplete") return false;

    const event = allEvents.find((ev) => ev.id === eventId);
    if (!event?.event_end) return false;
    return new Date(event.event_end).getTime() <= Date.now();
  };

  const canGiveReason = (ev: Event) => {
    // Mirror FeedbackController::eventIsOver(): event_end → call_time_end → end-of-day on start.
    const start = new Date(ev.date);
    if (isNaN(start.getTime())) return false;

    const end = ev.event_end
      ? new Date(ev.event_end)
      : (ev as any).call_time_end
      ? new Date((ev as any).call_time_end)
      : new Date(start.getFullYear(), start.getMonth(), start.getDate(), 23, 59, 59, 999);

    if (Date.now() <= end.getTime()) return false; // event hasn't ended yet

    const attendance = getAttendanceForEvent(ev.id);
    if (attendance && (attendance.status === "complete" || attendance.status === "incomplete")) {
      return false; // they attended → rate instead
    }

    return !getAbsenceForEvent(ev.id); // not answered yet
  };

  // The first review can only be sent for a limited time after the event ends (the Feedback Rules
  // setting). The server enforces this; here the form is locked so nobody types a review that will be refused.
  const reviewWindowClosed = (ev: Event) => {
    const hours = feedbackRules?.close_after_hours ?? 12;
    const endRaw = ev.event_end || (ev as any).call_time_end || ev.date;
    const end = new Date(endRaw);
    if (isNaN(end.getTime())) return false;
    return Date.now() > end.getTime() + hours * 3_600_000;
  };

  const startReview = (eventId: number) => {
    const existing = getFeedbackForEvent(eventId);
    setReviewingEventId(eventId);
    setReviewRating(existing?.rating ?? 0);
    setReviewComment(existing?.comment ?? "");
    setReviewHoverRating(0);
    setReviewError(null);
    setIsEditSubmit(!!existing);
  };

  const cancelReview = () => {
    setReviewingEventId(null);
    setReviewRating(0);
    setReviewComment("");
    setReviewError(null);
    setIsEditSubmit(false);
  };

  const submitReview = async (eventId: number) => {
    if (reviewRating < 1) return;
    setSubmittingReview(true);
    setReviewError(null);
    try {
      const res = await api.post("/feedback", {
        event_id: eventId,
        rating: reviewRating,
        comment: reviewComment || undefined,
      });
      const saved = res.data?.feedback;
      if (saved) {
        const entry = {
          ...saved,
          edit_until: Date.now() + (saved.edit_seconds_left ?? 0) * 1000,
          is_locked: (saved.edit_seconds_left ?? 0) <= 0,
          edit_window_minutes: saved.edit_window_minutes,
        } as FeedbackEntry;

        onFeedbackSubmitted?.(entry);

        setLocalFeedback((prev) => [
          ...prev.filter((f) => Number(f.event_id) !== Number(entry.event_id)),
          entry,
        ]);

        // SHOW THE CORRECT POPUP
        if (isEditSubmit) {
          setShowUpdated(true);
        } else {
          setShowThankYou(true);
        }
      }
      setReviewingEventId(null);
      setConfirmReviewEventId(null);
      setIsEditSubmit(false);
    } catch (err) {
      setReviewError(apiErrorMessage(err, t("submitReviewFailed")));
    } finally {
      setSubmittingReview(false);
    }
  };

  const startReason = (eventId: number) => {
    const existing = getAbsenceForEvent(eventId);
    setReasoningEventId(eventId);
    setReasonKey(existing?.reason ?? "");
    setReasonComment(existing?.comment ?? "");
    setReasonError(null);
    setJustSubmittedReasonEventId(null);
  };

  const cancelReason = () => {
    setReasoningEventId(null);
    setReasonKey("");
    setReasonComment("");
    setReasonError(null);
  };

  const submitReason = async (eventId: number) => {
    if (!reasonKey) return;
    setSubmittingReason(true);
    setReasonError(null);
    try {
      const res = await api.post("/feedback/absence", {
        event_id: eventId,
        reason: reasonKey,
        comment: reasonComment || undefined,
      });
      const saved = res.data?.absence;
      if (saved) {
        const entry = {
          ...saved,
          edit_until: Date.now() + (saved.edit_seconds_left ?? 0) * 1000,
        } as AbsenceEntry;

        onAbsenceSubmitted?.(entry);

        setLocalAbsences((prev) => [
          ...prev.filter((a) => Number(a.event_id) !== Number(entry.event_id)),
          entry,
        ]);
      }
      setReasoningEventId(null);
      setJustSubmittedReasonEventId(eventId);
    } catch (err) {
      setReasonError(apiErrorMessage(err, t("submitReasonFailed") || "Could not save your reason."));
    } finally {
      setSubmittingReason(false);
    }
  };

  const formatTime = (dateTimeStr: string): string => {
    if (!dateTimeStr) return "";
    const date = new Date(dateTimeStr);
    if (isNaN(date.getTime())) return "";
    let hours = date.getHours();
    const minutes = date.getMinutes();
    const ampm = hours >= 12 ? "PM" : "AM";
    hours = hours % 12;
    if (hours === 0) hours = 12;
    const minutesStr = minutes.toString().padStart(2, "0");
    return `${hours}:${minutesStr} ${ampm}`;
  };

  const formatDateOnly = (dateTimeStr: string): string => {
    if (!dateTimeStr) return "";
    return dateTimeStr.split(" ")[0];
  };

  const getStartOfWeek = (date: Date) => {
    const d = new Date(date);
    const day = d.getDay();
    d.setDate(d.getDate() - day);
    d.setHours(0, 0, 0, 0);
    return d;
  };

  const getEndOfWeek = (date: Date) => {
    const d = getStartOfWeek(date);
    d.setDate(d.getDate() + 6);
    d.setHours(23, 59, 59, 999);
    return d;
  };

  // Search, upcoming/past, membership, date, order and paging are all done by the server
  // (EventController::pagedEvents, member mode); the screen only holds the current page.
  const [pageEvents, setPageEvents] = useState<Event[]>([]);
  const [eventMeta, setEventMeta] = useState({ total: 0, last_page: 1 });
  const [visibleTotal, setVisibleTotal] = useState(0);
  const [pageLoading, setPageLoading] = useState(true);
  const pageSeq = useRef(0);
  const fetchPage = async (silent = false) => {
    const seq = ++pageSeq.current;
    if (!silent) setPageLoading(true);
    try {
      const portalMode = localStorage.getItem("portalMode") || sessionStorage.getItem("portalMode") || "member";
      const res = await api.get("/events-data", {
        headers: { "X-Portal-Mode": portalMode },
        params: {
          paged: 1,
          search: eventSearch.trim() || undefined,
          status: eventFilter,
          membership: membershipFilter === "all" ? undefined : membershipFilter,
          date: dateFilter || undefined,
          page: currentPage,
          per_page: itemsPerPage,
        },
      });
      if (seq !== pageSeq.current) return;
      const body = res.data;
      if (body.meta.last_page < currentPage) {
        setCurrentPage(Math.max(1, body.meta.last_page));
        return;
      }
      setPageEvents((body.data ?? []).map((event: any) => ({
        id: event.id,
        title: event.name,
        date: event.event_start,
        event_start: event.event_start,
        event_end: event.event_end,
        location: event.location,
        description: event.description,
        membership_ids: Array.isArray(event.membership_ids) ? event.membership_ids : [],
        memberships: Array.isArray(event.memberships) ? event.memberships : [],
      })));
      setEventMeta({ total: body.meta.total, last_page: body.meta.last_page });
      setVisibleTotal(body.all_total ?? body.meta.total);
    } catch (err) {
      if (seq === pageSeq.current) console.error("Failed to fetch events page:", err);
    } finally {
      // Clear the loader whenever THIS is the latest request, silent or not --
      // otherwise a background refresh that supersedes the first fetch leaves
      // the skeleton on forever.
      if (seq === pageSeq.current) setPageLoading(false);
    }
  };
  const fetchPageRef = useRef(fetchPage);
  fetchPageRef.current = fetchPage;

  // A new search / filter starts again from page 1.
  const eventFilterKey = `${eventSearch}|${eventFilter}|${membershipFilter}|${dateFilter}`;
  const prevEventFilterKey = useRef(eventFilterKey);
  useEffect(() => {
    if (prevEventFilterKey.current !== eventFilterKey) {
      prevEventFilterKey.current = eventFilterKey;
      if (currentPage !== 1) { setCurrentPage(1); return; }
    }
    const timer = setTimeout(() => fetchPageRef.current(), 120);
    return () => clearTimeout(timer);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [eventFilterKey, currentPage]);

  // The page's own quiet refresh updates `allEvents`; mirror it for the list.
  const firstEventsRun = useRef(true);
  useEffect(() => {
    if (firstEventsRun.current) { firstEventsRun.current = false; return; }
    fetchPageRef.current(true);
  }, [allEvents]);

  const filteredEvents = { length: eventMeta.total };
  const totalPages = Math.max(1, eventMeta.last_page);
  const paginatedEvents = pageEvents;


  const THIS_WEEK_KEY = "__THIS_WEEK__";
  const groupedEvents = useMemo(() => {
    const groups: Record<string, Event[]> = {};
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const weekStart = getStartOfWeek(today);
    const weekEnd = getEndOfWeek(today);

    paginatedEvents.forEach((e) => {
      const eventDate = new Date(e.date);
      eventDate.setHours(0, 0, 0, 0);
      const dateOnly = e.date.split(" ")[0];

      let sectionKey: string;
      if (eventDate >= weekStart && eventDate <= weekEnd) {
        sectionKey = THIS_WEEK_KEY;
      } else {
        sectionKey = new Date(dateOnly).toLocaleDateString("en-US", {
          weekday: "long",
          year: "numeric",
          month: "long",
          day: "numeric",
        });
      }

      if (!groups[sectionKey]) groups[sectionKey] = [];
      groups[sectionKey].push(e);
    });

    const sortedGroups = Object.entries(groups).sort(([keyA], [keyB]) => {
      if (keyA === THIS_WEEK_KEY) return -1;
      if (keyB === THIS_WEEK_KEY) return 1;
      return new Date(keyB).getTime() - new Date(keyA).getTime();
    });

    return Object.fromEntries(sortedGroups);
  }, [paginatedEvents]);

  useEffect(() => {
    if (focusEventId == null) return;
    onFocusHandled?.();
  }, [focusEventId, onFocusHandled]);

  return (
    <div
      ref={listTopRef}
      className="h-[calc(100dvh-73px)] overflow-y-auto dash-canvas p-4 sm:p-8"
    >
      <div className="space-y-6">
        <div className="pb-2">
          <div className="w-full">
            <div className="dash-card rounded-[32px] p-5 sm:p-6">
              <h1 className="font-display text-3xl font-extrabold tracking-tight sm:text-4xl page-title-gradient page-title-fit">{t("eventsAndAttendance")}</h1>
              <p className="mt-1.5 text-sm text-white/55 max-w-xl">{t("eventsSubtitle")}</p>
            </div>

            <div className="dash-card tight-after mt-4 rounded-[32px] p-4 sm:p-5">
              <FilterBar
                search={{ value: eventSearch, onChange: setEventSearch, placeholder: t("searchEventsPlaceholder") }}
                filters={[
                  {
                    key: "when", label: t("statusColumn"), value: eventFilter, onChange: setEventFilter,
                    options: [
                      { value: "all", label: t("allEvents") },
                      { value: "upcoming", label: t("upcomingEvents") },
                      { value: "past", label: t("pastEvents") },
                    ],
                  },
                  {
                    key: "membership", label: t("fltMembership"), value: membershipFilter, onChange: setMembershipFilter, searchable: true, minWidthClass: "min-w-[220px]",
                    options: [
                      { value: "all", label: t("allMembershipsOption") },
                      ...userMemberships.slice().sort((a, b) => a.name.localeCompare(b.name)).map((m) => ({ value: String(m.id), label: m.name })),
                    ],
                  },
                ]}
                count={pageSwitching || pageLoading ? undefined : { shown: eventMeta.total, total: visibleTotal }}
                extraChips={dateFilter ? [{ key: "date", label: `${t("fltDateChip")}: ${new Date(dateFilter).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" })}`, onRemove: () => setDateFilter("") }] : []}
                onClearExtras={() => setDateFilter("")}
              >
                <div className="h-11 w-full shrink-0 sm:w-[200px]">
                  <DatePicker value={dateFilter} onChange={setDateFilter} placeholder={t("filterByDate")} dark className="h-11 pl-4 pr-4 py-2.5" />
                </div>
              </FilterBar>
            </div>

            {totalPages > 1 && (
              <div className="flex justify-end mt-4">
                <div className="flex items-center gap-2">
                  <button
                    onClick={() => goToPage((p) => Math.max(1, (p as number) - 1))}
                    disabled={currentPage === 1}
                    className="h-8 w-8 dash-tile rounded-full text-white/70 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed transition-all active:scale-95"
                  >
                    ←
                  </button>

                  <span className="h-8 w-8 rounded-full bg-gradient-to-br from-[#0B0F14] to-[#18212B] text-white border border-white/10 shadow-md flex items-center justify-center text-sm font-bold">
                    {currentPage}
                  </span>

                  <button
                    onClick={() => goToPage((p) => Math.min(totalPages, (p as number) + 1))}
                    disabled={currentPage === totalPages}
                    className="h-8 w-8 dash-tile rounded-full text-white/70 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed transition-all active:scale-95"
                  >
                    →
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>

        <div className="pl-1">
          {pageSwitching || pageLoading ? (
            <div className="grid grid-cols-1 gap-5 md:grid-cols-2">
              {Array.from({ length: 4 }).map((_, i) => (
                <div
                  key={i}
                  className="dash-card rounded-[28px] p-5 space-y-3"
                >
                  <Skeleton className="h-4 w-2/3" />
                  <Skeleton className="h-3 w-1/2" />
                  <Skeleton className="h-3 w-1/3" />
                </div>
              ))}
            </div>
          ) : filteredEvents.length === 0 ? (
            <div className="dash-card rounded-[28px] flex flex-col items-center justify-center h-48 text-center px-4"><Filter className="h-8 w-8 text-white/20 mb-2" /><p className="text-white/50">{t("noEventsMatch")}</p></div>
          ) : (
            <div className="space-y-8">
              {Object.entries(groupedEvents).map(([dateLabel, eventsInGroup]) => (
                <div key={dateLabel}>
                  <h3 className="mb-4 flex items-center gap-3 border-b border-white/10 pb-3 text-lg font-bold text-white">
                    <span className="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#4FBEB0] to-[#F5C451]" />
                    {dateLabel === THIS_WEEK_KEY ? t("thisWeekLabel") : dateLabel}
                  </h3>
                  <div className="grid grid-cols-1 gap-5 md:grid-cols-2">
                    {eventsInGroup.map((e) => {
                      const today = new Date();
                      const isUpcoming = new Date(e.date) >= today;

                      const memNames =
                        Array.isArray(e.memberships) && e.memberships.length > 0
                          ? e.memberships.map((m) => m.name)
                          : Array.isArray(e.membership_ids)
                          ? (e.membership_ids
                              .map((id) => allMemberships.find((m) => m.id === id)?.name)
                              .filter(Boolean) as string[])
                          : [];

                      const dateOnly = formatDateOnly(e.date);
                      const timeOnly = formatTime(e.date);

                      const feedback = getFeedbackForEvent(e.id);
                      const absence = getAbsenceForEvent(e.id);
                      const isReviewing = reviewingEventId === e.id;
                      const isReasoning = reasoningEventId === e.id;

                      return (
                        <div
                          key={e.id}
                          className="dash-row dash-row-white relative rounded-[28px] p-5 sm:p-6 hover:-translate-y-0.5 transition-all duration-200"
                        >
                          <div className={`absolute top-4 right-4 flex items-center gap-1.5 rounded-full border px-2.5 py-1 ${
                              isUpcoming ? "bg-[#F5C451]/20 border-[#F5C451]/40" : "bg-[#4FBEB0]/15 border-[#2E8E82]/30"
                            }`}>
                            <span
                              className={`w-2 h-2 rounded-full ${
                                isUpcoming ? "bg-[#E8B84A]" : "bg-[#2E8E82]"
                              }`}
                            />
                            <span className={`text-xs font-semibold ${isUpcoming ? "text-[#B8860B]" : "text-[#2E8E82]"}`}>
                              {isUpcoming ? t("upcomingBadge") : t("pastBadge")}
                            </span>
                          </div>

                          <h2 className="pr-24 text-base font-bold text-white">
                            {highlightText(tc(e.title, language as any), eventSearch)}
                          </h2>

                          <p className="mt-2 flex items-center gap-1.5 text-sm text-white/50">
                            <CalendarDays className="h-4 w-4 shrink-0 text-[#2E8E82]" />
                            {highlightText(dateOnly, eventSearch)} · {timeOnly}
                          </p>

                          <p className="mt-1 flex items-center gap-1.5 text-sm text-white/50">
                            <MapPin className="h-4 w-4 shrink-0 text-[#2E8E82]" />
                            {highlightText(tc(e.location, language as any), eventSearch)}
                          </p>

                          <p className="mt-3 text-sm text-white/70">
                            {highlightText(tc(e.description, language as any), eventSearch)}
                          </p>

                          <div className="mt-4 flex flex-wrap items-center gap-2">
                            {memNames.length > 0 ? (
                              <>
                                <span className="rounded-full bg-[#4FBEB0]/15 px-3 py-1 text-xs font-semibold text-[#2E8E82] border border-[#2E8E82]/30">
                                  {t("forLabel")} {memNames.join(", ")}
                                </span>
                                <span className="rounded-full bg-white/[0.06] px-3 py-1 text-xs font-semibold text-white/50 border border-white/10">
                                  {t("includedInMembership")}
                                </span>
                              </>
                            ) : (
                              <span className="rounded-full bg-[#4FBEB0]/15 px-3 py-1 text-xs font-semibold text-[#2E8E82] border border-[#2E8E82]/30">
                                {t("openEventAllResidents")}
                              </span>
                            )}
                          </div>

                          {canReviewEvent(e.id) && (
                            <div className="mt-4 pt-4 border-t border-white/10">
                              {isReviewing ? (
                                <div>
                                  <p className="text-xs font-bold uppercase tracking-wide text-[#7DD8CB] mb-2">
                                    {t("rateThisEventLabel")}
                                  </p>
                                  <div className="flex items-center gap-1">
                                    {[1, 2, 3, 4, 5].map((n) => (
                                      <button
                                        key={n}
                                        type="button"
                                        onMouseEnter={() => setReviewHoverRating(n)}
                                        onMouseLeave={() => setReviewHoverRating(0)}
                                        onClick={() => setReviewRating(n)}
                                        disabled={!isEditSubmit && reviewWindowClosed(e)}
                                        className="p-0.5 disabled:cursor-not-allowed disabled:opacity-40"
                                      >
                                        <Star
                                          size={22}
                                          className={
                                            (reviewHoverRating || reviewRating) >= n
                                              ? "text-gold-400 fill-gold-400"
                                              : "text-white/20"
                                          }
                                        />
                                      </button>
                                    ))}
                                  </div>
                                  <textarea
                                    value={reviewComment}
                                    onChange={(ev) => setReviewComment(ev.target.value)}
                                    placeholder={t("optionalCommentPlaceholder")}
                                    rows={2}
                                    disabled={!isEditSubmit && reviewWindowClosed(e)}
                                    className="mt-2 w-full rounded-xl border border-white/15 bg-white/10 px-3 py-2 text-sm text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-[#4FBEB0]/40 focus:border-[#4FBEB0]/70 disabled:cursor-not-allowed disabled:opacity-50"
                                  />
                                  {!isEditSubmit && reviewWindowClosed(e) && (
                                    <p role="status" className="mt-2 flex items-start gap-2 rounded-xl border border-amber-400/30 bg-amber-400/10 px-3 py-2 text-xs font-medium text-amber-300">
                                      <Lock size={14} className="mt-0.5 shrink-0" />
                                      <span>{t("reviewClosedNote").replace("{hours}", String(feedbackRules?.close_after_hours ?? 12))}</span>
                                    </p>
                                  )}
                                  {reviewError && (
                                    <p className="mt-1 text-xs text-red-400">{reviewError}</p>
                                  )}
                                  <div className="mt-2 flex gap-2">
                                    <button
                                      type="button"
                                      onClick={() => setConfirmReviewEventId(e.id)}
                                      disabled={reviewRating < 1 || submittingReview || (!isEditSubmit && reviewWindowClosed(e))}
                                      title={!isEditSubmit && reviewWindowClosed(e) ? t("reviewClosedNote").replace("{hours}", String(feedbackRules?.close_after_hours ?? 12)) : undefined}
                                      className="flex-1 rounded-full bg-gold-400 hover:bg-gold-300 text-[#08130F] text-sm font-bold py-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-gold-400 transition"
                                    >
                                      {submittingReview
                                        ? t("submittingLabel")
                                        : t("submitReviewButton")}
                                    </button>
                                    <button
                                      type="button"
                                      onClick={cancelReview}
                                      disabled={submittingReview}
                                      className="rounded-full border border-white/15 text-white/60 hover:bg-white/5 text-sm font-medium px-4 disabled:opacity-50 transition"
                                    >
                                      {t("cancelLabel")}
                                    </button>
                                  </div>
                                </div>
                              ) : feedback ? (
                                <div>
                                  <FeedbackComment
                                    entry={feedback}
                                    role="member"
                                    member={member}
                                    locked={
                                      feedback.is_locked === true ||
                                      (feedback.edit_until !== undefined &&
                                        feedback.edit_until <= nowTick) ||
                                      (feedback.edit_seconds_left !== undefined &&
                                        feedback.edit_seconds_left <= 0)
                                    }
                                    onEditStart={() => startReview(e.id)}
                                    onRemove={() =>
                                      setRemoveTarget({
                                        id: feedback.id,
                                        eventTitle: e.title,
                                      })
                                    }
                                    onChange={(patch) => {
                                      onFeedbackSubmitted?.({
                                        ...feedback,
                                        ...patch,
                                      } as FeedbackEntry);
                                    }}
                                  />

                                  {(() => {
                                    if (!feedback.created_at || !feedback.edit_window_minutes) return null;
                                    const deadline = new Date(feedback.created_at).getTime() + (feedback.edit_window_minutes * 60_000);
                                    const liveSeconds = Math.max(0, Math.floor((deadline - nowTick) / 1000));
                                    if (liveSeconds <= 0) return null;
                                    const mins = Math.ceil(liveSeconds / 60);
                                    return (
                                      <p className="mt-2 text-xs font-medium text-[#7DD8CB]">
                                        {(t("editableForMinutes") || "Editable for {minutes} more minute(s)").replace(
                                          "{minutes}",
                                          String(mins)
                                        )}
                                      </p>
                                    );
                                  })()}
                                </div>
                              ) : (
                                <button
                                  type="button"
                                  onClick={() => startReview(e.id)}
                                  className="inline-flex items-center gap-1.5 rounded-full border border-white/15 text-white/70 text-sm font-semibold px-4 py-2 hover:bg-white/10 transition"
                                >
                                  <Star className="h-4 w-4" />
                                  {t("rateThisEventButton")}
                                </button>
                              )}
                            </div>
                          )}

                          {/* CHANGED: was `{canGiveReason(e) && (` -- now also renders when an absence entry already exists */}
                          {(canGiveReason(e) || absence) && (
                            <div className="mt-4 pt-4 border-t border-white/10">
                              {isReasoning ? (
                                <div>
                                  <p className="text-xs font-bold uppercase tracking-wide text-[#7DD8CB] mb-2">
                                    {t("whyCouldntAttend")}
                                  </p>
                                  <div className="flex flex-wrap gap-2">
                                    {ABSENCE_REASON_KEYS.map((k) => (
                                      <button
                                        key={k}
                                        type="button"
                                        onClick={() => setReasonKey(k)}
                                        className={`rounded-full border px-3 py-1.5 text-xs font-semibold transition ${
                                          reasonKey === k
                                            ? "border-[#7DD8CB] bg-[#7DD8CB]/20 text-[#7DD8CB]"
                                            : "border-white/15 text-white/60 hover:bg-white/5"
                                        }`}
                                      >
                                        {t(`absReason_${k}`)}
                                      </button>
                                    ))}
                                  </div>
                                  <textarea
                                    value={reasonComment}
                                    onChange={(ev) => setReasonComment(ev.target.value)}
                                    placeholder={t("optionalCommentPlaceholder")}
                                    rows={2}
                                    className="mt-2 w-full rounded-xl border border-white/15 bg-white/10 px-3 py-2 text-sm text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-[#4FBEB0]/40 focus:border-[#4FBEB0]/70"
                                  />
                                  {reasonError && (
                                    <p className="mt-1 text-xs text-red-400">{reasonError}</p>
                                  )}
                                  <div className="mt-2 flex gap-2">
                                    <button
                                      type="button"
                                      onClick={() => submitReason(e.id)}
                                      disabled={!reasonKey || submittingReason}
                                      className="flex-1 rounded-full bg-gold-400 hover:bg-gold-300 text-[#08130F] text-sm font-bold py-2 disabled:opacity-50 transition"
                                    >
                                      {submittingReason
                                        ? t("submittingLabel")
                                        : t("submitButton") || "Submit"}
                                    </button>
                                    <button
                                      type="button"
                                      onClick={cancelReason}
                                      disabled={submittingReason}
                                      className="rounded-full border border-white/15 text-white/60 hover:bg-white/5 text-sm font-medium px-4 disabled:opacity-50 transition"
                                    >
                                      {t("cancelLabel")}
                                    </button>
                                  </div>
                                </div>
                              ) : absence ? (
                                <div className="dash-tile rounded-2xl px-3 py-3">
                                  <p className="text-[11px] font-bold uppercase tracking-wide text-white/40 mb-1">
                                    {t("yourReasonLabel")}
                                  </p>
                                  <p className="text-sm text-white">
                                    {(() => {
                                      // The saved reason is a key (or, for older entries, its English label): show it in the viewer's language.
                                      const rk = (ABSENCE_REASON_KEYS as readonly string[]).includes(absence.reason) ? absence.reason : absenceKeyFromLabel(absence.reason);
                                      return rk ? t(`absReason_${rk}`) : absence.reason.replace(/_/g, " ").replace(/\b\w/g, (c: string) => c.toUpperCase());
                                    })()}
                                  </p>
                                  {absence.comment && (
                                    <p className="mt-1 text-sm text-white/70">"{absence.comment}"</p>
                                  )}

                                  <div className="mt-3 flex items-center gap-2">
                                    <button
                                      type="button"
                                      onClick={() => startReason(e.id)}
                                      className="inline-flex items-center gap-1.5 rounded-full border border-white/15 text-white/70 text-xs font-semibold px-3 py-1.5 hover:bg-white/10 transition"
                                    >
                                      <Pencil className="h-3.5 w-3.5" />
                                      Edit
                                    </button>

                                    {(absence.edits_count ?? 0) > 0 && (
                                      <span className="text-[11px] text-white/40">
                                        Edited · {absence.edits_count}×
                                      </span>
                                    )}
                                  </div>

                                  {justSubmittedReasonEventId === e.id && (
                                    <p className="mt-2 flex items-center gap-1 text-xs font-medium text-[#7DD8CB]">
                                      <CheckCircle className="h-3.5 w-3.5" />
                                      {t("reasonSavedConfirmation") || "Thank you for letting us know."}
                                    </p>
                                  )}
                                </div>
                              ) : (
                                <button
                                  type="button"
                                  onClick={() => startReason(e.id)}
                                  className="inline-flex items-center gap-1.5 rounded-full border border-white/15 text-white/70 text-sm font-semibold px-4 py-2 hover:bg-white/10 transition"
                                >
                                  <HelpCircle className="h-4 w-4" />
                                  {t("couldntAttendButton") ||
                                    "I couldn't attend — tell us why"}
                                </button>
                              )}
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      <ConfirmDialog
        open={!!removeTarget}
        icon={<Trash2 size={40} />}
        title={t("removeFeedbackTitle") || "Remove feedback?"}
        body={
          <>
            {(
              t("removeFeedbackBody") ||
              'This will remove your feedback for "{event}". This cannot be undone once the edit window closes.'
            ).replace("{event}", removeTarget?.eventTitle ?? "")}
          </>
        }
        cancelLabel={t("cancelLabel") || "Cancel"}
        confirmLabel={t("removeFeedback") || "Remove"}
        tone="danger"
        onCancel={() => {
          if (removeBusy) return;
          setRemoveTarget(null);
          setRemoveError(null);
        }}
        onConfirm={async () => {
          if (!removeTarget || removeBusy) return;
          setRemoveBusy(true);
          setRemoveError(null);
          try {
            await api.delete(`/feedback/${removeTarget.id}`);
            onFeedbackSubmitted?.({
              id: removeTarget.id,
              event_id: 0,
              rating: 0,
              comment: null,
              deleted_at: new Date().toISOString(),
            } as any);
            setLocalFeedback((prev) => prev.filter((f) => f.id !== removeTarget.id));
            setRemoveTarget(null);
          } catch (err) {
            setRemoveError(apiErrorMessage(err));
            setRemoveTarget(null);
          } finally {
            setRemoveBusy(false);
          }
        }}
      />

      {removeError && (
        <StatusModal
          open={true}
          type="error"
          title={t("errorTitle") || "Error"}
          message={removeError}
          okLabel={t("okLabel") || "OK"}
          onClose={() => setRemoveError(null)}
        />
      )}

      <ConfirmDialog
        open={confirmReviewEventId !== null}
        icon={<Star size={40} />}
        title={t("submitReviewConfirmTitle") || "Submit this review?"}
        body={
          t("submitReviewConfirmBody") ||
          "You can still edit or remove it for a short time after submitting."
        }
        cancelLabel={t("cancelLabel") || "Cancel"}
        confirmLabel={t("submitReviewButton") || "Submit"}
        tone="brand"
        onCancel={() => setConfirmReviewEventId(null)}
        onConfirm={() => {
          if (confirmReviewEventId !== null) {
            submitReview(confirmReviewEventId);
          }
        }}
      />

      {/* --- THANK YOU POPUP (New Submit) --- */}
      <StatusModal
        open={showThankYou}
        type="success"
        title={t("successTitle") || "Success"}
        message={t("feedbackSubmittedSuccess") || "Thank you for your feedback!"}
        okLabel={t("okLabel") || "OK"}
        onClose={() => setShowThankYou(false)}
      />

      {/* --- FEEDBACK UPDATED POPUP (Edit Submit) --- */}
      <StatusModal
        open={showUpdated}
        type="success"
        title={t("successTitle") || "Success"}
        message={t("feedbackUpdatedSuccess") || "Feedback updated successfully!"}
        okLabel={t("okLabel") || "OK"}
        onClose={() => setShowUpdated(false)}
      />
    </div>
  );
}
</file>

<file path="resources/js/pages/staff/views/BudgetView.tsx">
import KpiCard from "../../../components/ui/KpiCard";
import { highlightMatches } from "../../../lib/highlight";
import React, { useEffect, useRef, useState } from "react";
import { Lock, Banknote, PiggyBank, AlertTriangle, ChevronRight, ChevronDown, TrendingUp, Wallet, LayoutList, Clock, CalendarClock, Archive } from "lucide-react";
import api, { apiErrorMessage } from "../../../lib/api";
import Skeleton from "../../../components/ui/Skeleton";
import DatePicker from "../../../components/ui/DatePicker";
import FormDrawer from "../../../components/ui/FormDrawer";
import FilterBar, { type ExtraChip } from "../../../components/ui/FilterBar";
import QuickTabs from "../../../components/ui/QuickTabs";
import SpeedDial from "../../../components/ui/SpeedDial";
import SimplePager from "../../../components/ui/SimplePager";
import { useLanguage } from "../../../i18n/LanguageContext";

import EventBudgetWorkspace, { type EventOption, money, budgetStateOf } from "../../../components/budget/EventBudgetWorkspace";
import { makeEventTiming, STATUS_META } from "../../../lib/eventTiming";
import { ChartCard } from "./reports/ReportCharts";
import { LineChart, CHART_COLORS } from "../../../components/ui/Charts";

import { tc } from "../../../lib/contentTranslations";
/**
 * UC-8: Record Event Budget and Expenses. A portfolio-wide KPI strip (total
 * approved, total spent, remaining, events over budget) sits on top of the
 * same master-detail layout this page always needed -- pick an event on the
 * left, work its budget on the right -- so staff get the fleet-wide picture
 * before drilling into any one event's ledger.
 */
// Event cards per page (3 x 3 on a wide screen).
const EVENTS_PAGE_SIZE = 9;

export default function BudgetView({ allEvents = [] }: { allEvents?: EventOption[] }) {
  const { t, locale, language } = useLanguage();
  const [search, setSearch] = useState("");
  const [trendOpen, setTrendOpen] = useState(false); // phones: the spending chart starts collapsed
  // Left list: which time bucket to show. "all" keeps every bucket on screen, in sections.
  const [timeTab, setTimeTab] = useState<"all" | "ongoing" | "upcoming" | "past">("all");
  const [selectedEventId, setSelectedEventId] = useState<string | null>(null);
  // Left list filter: every event, only those close to their limit, or only the over-budget ones.
  const [budgetFilter, setBudgetFilter] = useState<"all" | "near" | "over">("all");
  // Left list: one picked day (matches events starting that day; "" = every date) and current page.
  const [selectedDate, setSelectedDate] = useState("");
  const [sortKey, setSortKey] = useState("default");
  // Portfolio-wide KPI strip -- the same /reports/budget-summary endpoint
  // the Reports and Dashboard pages already use, called with no date
  // range so it covers every event ever recorded. Kept as its OWN fetch,
  // separate from the per-event `summary` below, so the top-of-page
  // totals stay put while browsing/searching the event list, and instead
  // refresh on their own short interval like a real live dashboard.
  const [portfolio, setPortfolio] = useState<{ summary: any; per_event: any[]; trend?: any; status_counts?: any } | null>(null);
  const [lastUpdated, setLastUpdated] = useState<Date | null>(null);
  const [nowTick, setNowTick] = useState(() => Date.now());

  // Page-open skeleton: shown every time this page is opened from the
  // sidebar (the view remounts on navigation), until the first portfolio
  // fetch lands. The short minimum keeps it from flashing for a single
  // frame on a fast response, so opening the page always reads as a
  // deliberate load like the other modules.
  // Only the KPI strip waits for the portfolio figures; the event cards load on their own.
  const initialLoading = portfolio === null;

  const fetchPortfolio = async () => {
    try {
      const res = await api.get("/reports/budget-summary");
      setPortfolio({ summary: res.data?.summary ?? null, per_event: res.data?.per_event ?? [], trend: res.data?.trend, status_counts: res.data?.status_counts });
      setLastUpdated(new Date());
    } catch (e) {
      // Silent -- the KPI strip just keeps showing its last good numbers;
      // the per-event panel below has its own error modal if the API is
      // actually unreachable.
      // On the very first load, fall back to an empty portfolio so the
      // page-open skeleton ends instead of spinning forever.
      setPortfolio((p) => p ?? { summary: null, per_event: [] });
    }
  };

  useEffect(() => {
    fetchPortfolio();
    const poll = setInterval(() => fetchPortfolio(), 20000);
    return () => clearInterval(poll);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  useEffect(() => {
    const tick = setInterval(() => setNowTick(Date.now()), 1000);
    return () => clearInterval(tick);
  }, []);

  const secondsSinceUpdate = lastUpdated ? Math.max(0, Math.floor((nowTick - lastUpdated.getTime()) / 1000)) : null;
  const lastUpdatedLabel =
    secondsSinceUpdate === null
      ? ""
      : secondsSinceUpdate < 5
      ? t("updatedJustNowLabel")
      : secondsSinceUpdate < 60
      ? t("updatedSecondsAgoLabel").replace("{n}", String(secondsSinceUpdate))
      : t("updatedMinutesAgoLabel").replace("{n}", String(Math.floor(secondsSinceUpdate / 60)));

  const portfolioSummary = portfolio?.summary ?? {
    total_events: 0,
    total_approved_budget: 0,
    total_expenses: 0,
    total_remaining: 0,
    events_over_budget: 0,
    total_over_amount: 0,
  };

  // Shared event-timing helpers (same ones the budget workspace uses).
  const { eventWindow, relativeLabel, eventStatusLabel, formatTimeFriendly, parseEventDateTime, getEventStatus } = makeEventTiming(t);

  // Search, status tab, budget health, date, sort and paging are all done by the
  // server (EventController::pagedEvents), so the cards, counts and pages agree.
  const [pageEvents, setPageEvents] = useState<(EventOption & { budget_spent?: number; approved_budget?: number | string | null })[]>([]);
  const [pageNo, setPageNo] = useState(1);
  const [meta, setMeta] = useState({ total: 0, last_page: 1 });
  const [counts, setCounts] = useState({ status: { all: 0, ongoing: 0, upcoming: 0, past: 0 }, budget: { all: 0, near: 0, over: 0 } });
  const [pageLoading, setPageLoading] = useState(true);
  // True once the first count has arrived. Until then the tabs show no number at all (never a fake 0),
  // and after that they keep the last real numbers while a new tab / search is loading.
  const [countsReady, setCountsReady] = useState(false);
  const [reloadTick, setReloadTick] = useState(0);
  const pageSeq = useRef(0);
  const prevSearch = useRef(search);

  const fetchPage = async (silent = false) => {
    const seq = ++pageSeq.current;
    if (!silent) setPageLoading(true);
    try {
      const res = await api.get("/events-data", {
        params: {
          paged: 1,
          search: search.trim() || undefined,
          status: timeTab,
          budget: budgetFilter,
          date: selectedDate || undefined,
          sort: sortKey,
          page: pageNo,
          per_page: EVENTS_PAGE_SIZE,
        },
      });
      if (seq !== pageSeq.current) return;
      const body = res.data;
      if (body.meta.last_page < pageNo) {
        setPageNo(Math.max(1, body.meta.last_page));
        return;
      }
      setPageEvents((body.data ?? []).map((d: any) => ({ ...d, title: d.name, date: d.event_start })));
      setMeta({ total: body.meta.total, last_page: body.meta.last_page });
      setCounts({ status: body.counts.status, budget: body.counts.budget });
      setCountsReady(true);
    } catch (e) {
      if (seq === pageSeq.current) console.error("Error loading budget events:", e);
    } finally {
      if (seq === pageSeq.current) setPageLoading(false);
    }
  };
  const fetchPageRef = useRef(fetchPage);
  fetchPageRef.current = fetchPage;

  // A new search / filter / sort starts again from page 1.
  const filterKey = `${search}|${timeTab}|${budgetFilter}|${selectedDate}|${sortKey}`;
  const prevFilterKey = useRef(filterKey);
  useEffect(() => {
    if (prevFilterKey.current !== filterKey) {
      prevFilterKey.current = filterKey;
      if (pageNo !== 1) { setPageNo(1); return; }
    }
    const typed = prevSearch.current !== search;
    prevSearch.current = search;
    const timer = setTimeout(() => fetchPageRef.current(), typed ? 150 : 0);
    return () => clearTimeout(timer);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [filterKey, pageNo]);
  // An expense was saved: refresh the cards quietly.
  useEffect(() => {
    if (reloadTick > 0) fetchPageRef.current(true);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [reloadTick]);

  // Money spent changes while staff work -- keep the cards in step with the KPI strip's poll.
  const firstPortfolio = useRef(true);
  useEffect(() => {
    if (!lastUpdated) return;
    if (firstPortfolio.current) { firstPortfolio.current = false; return; }
    fetchPageRef.current(true);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [lastUpdated]);

  // Spent / approved per event: the page rows already carry both.
  const figuresOf = (e: { budget_spent?: number; approved_budget?: number | string | null }) => {
    const approved = e.approved_budget != null ? Number(e.approved_budget) : null;
    const spent = Number(e.budget_spent) || 0;
    const pct = approved ? Math.min(100, (spent / approved) * 100) : approved === 0 ? (spent > 0 ? 100 : 0) : null;
    return { approved, spent, pct };
  };

  // Cards stay grouped under their real status heading (the server already ordered them that way).
  const pagedSections = (["Ongoing", "Upcoming", "Past"] as const)
    .map((k) => ({
      key: k,
      total: counts.status[k.toLowerCase() as "ongoing" | "upcoming" | "past"],
      items: pageEvents.filter((e) => getEventStatus(e).label === k).map((e) => ({ e, status: k })),
    }))
    .filter((sec) => sec.items.length > 0);

  const listLoading = pageLoading;
  
  const selectedEvent = allEvents.find((e) => String(e.id) === String(selectedEventId)) ?? pageEvents.find((e) => String(e.id) === String(selectedEventId));

  return (
    <>
    {/* Full-bleed dark navy page -- same technique and palette as the
        Dashboard/Residents/Households/Memberships/Events pages, so Budget
        & Expenses reads as part of the same system instead of the old
        light "paper" page. The smaller modals further below (receipt
        viewer, confirm/success/error/delete) stay on their original light
        theme, same scoping used on every other staff view; the Edit
        Expense modal is darkened along with the page, matching the
        Households/Inventory Edit modal treatment. */}
    <div className="-m-3 sm:-m-6 min-h-[calc(100dvh-73px)] dash-canvas p-4 sm:p-8">
    <div className="space-y-6 max-sm:flex max-sm:flex-col">
      <div className="dash-card flex flex-col justify-between gap-4 rounded-[32px] p-5 sm:flex-row sm:items-center sm:p-6 max-sm:order-[-3]">
        <div>
          <h1 className="font-display text-3xl font-extrabold tracking-tight sm:text-4xl page-title-gradient page-title-fit">{t("budget")}</h1>
          <p className="mt-1.5 text-sm text-white/50 max-w-xl">{t("budgetSubtitle")}</p>
        </div>
        {/* Genuinely live -- fetchPortfolio() re-polls /reports/budget-summary
            every 20s (see effect above), this just renders how long ago
            that last landed, ticking every second off nowTick. */}
        <div className="hidden sm:inline-flex items-center gap-1.5 self-start sm:self-auto dash-tile dash-mint rounded-full px-3.5 py-2 text-xs font-medium text-white/70 shrink-0" title={t("liveLabel")}>
          <span className="relative flex h-2 w-2">
            <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#4FBEB0] opacity-75" />
            <span className="relative inline-flex h-2 w-2 rounded-full bg-[#4FBEB0]" />
          </span>
          {lastUpdatedLabel}
        </div>
      </div>

      {/* Portfolio KPI strip -- same gradient-card language as the
          Dashboard's stat strip, computed across every event (see
          fetchPortfolio above), not just the one currently selected. */}
      {/* Phones: title, then search + filters, then ONE compact summary card (2x2 figures) and a collapsible spending chart, then the list. */}
      <div className="sm:space-y-6 max-sm:flex max-sm:flex-col max-sm:gap-3 max-sm:order-[-1]">
      <div className="dash-card rounded-[28px] p-4 sm:hidden">
        <div className="grid grid-cols-2 gap-x-4 gap-y-4">
          {([
            { label: t("totalApprovedBudgetStatLabel"), value: Number(portfolioSummary.total_approved_budget || 0), money: true, icon: Wallet, tone: "" },
            { label: t("totalSpentStatLabel"), value: Number(portfolioSummary.total_expenses || 0), money: true, icon: Banknote, tone: "" },
            { label: t("remainingBudgetStatLabel"), value: Number(portfolioSummary.total_remaining || 0), money: true, icon: PiggyBank, tone: "text-[#2E8E82]" },
            { label: t("eventsOverBudgetStatLabel"), value: Number(portfolioSummary.events_over_budget || 0), money: false, icon: AlertTriangle, tone: Number(portfolioSummary.events_over_budget || 0) > 0 ? "text-red-500" : "" },
          ]).map((c, i) => (
            <div key={i} className={`min-w-0 ${i % 2 === 1 ? "border-l border-white/10 pl-4" : ""} ${i > 1 ? "border-t border-white/10 pt-4" : ""}`}>
              <div className="flex items-center gap-1.5 text-white/50">
                <c.icon className="h-3.5 w-3.5 shrink-0 text-[#2E8E82]" />
                <span className="truncate text-[11px] font-bold uppercase tracking-wide">{c.label}</span>
              </div>
              {initialLoading ? <Skeleton className="mt-2 h-6 w-24" /> : (
                <p className={`mt-1.5 truncate font-display text-xl font-extrabold tabular-nums ${c.tone || "text-white"}`}>{c.money ? money(c.value) : c.value}</p>
              )}
            </div>
          ))}
        </div>
      </div>
      <div className="report-stagger grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 max-sm:hidden">
        {[
          { value: Number(portfolioSummary.total_approved_budget || 0), label: t("totalApprovedBudgetStatLabel"), description: t("totalApprovedBudgetStatDesc"), icon: Wallet, gradient: "from-sage-400 to-sage-700" },
          { value: Number(portfolioSummary.total_expenses || 0), label: t("totalSpentStatLabel"), description: t("totalSpentStatDesc"), icon: Banknote, gradient: "from-sage-400 to-sage-700" },
          { value: Number(portfolioSummary.total_remaining || 0), label: t("remainingBudgetStatLabel"), description: t("remainingBudgetStatDesc"), icon: PiggyBank, gradient: "from-sage-400 to-sage-700" },
          { value: portfolioSummary.events_over_budget || 0, label: t("eventsOverBudgetStatLabel"), description: Number(portfolioSummary.total_over_amount) > 0 ? t("totalOverAmountDesc").replace("{over}", money(Number(portfolioSummary.total_over_amount))) : t("eventsOverBudgetStatDesc"), icon: AlertTriangle, gradient: "from-sage-400 to-sage-700" },
        ].map((card, idx) => initialLoading ? (
          <div key={idx} className="dash-card rounded-[30px] p-6 space-y-3">
            <Skeleton className="h-8 w-2/3" />
            <Skeleton className="h-3 w-1/2" />
            <Skeleton className="h-3 w-3/4" />
          </div>
        ) : (
          <KpiCard key={idx} value={card.value} label={card.label} description={card.description} icon={card.icon} gradient={card.gradient} delay={idx * 70} format={idx < 3 ? money : undefined} />
        ))}
      </div>

      {/* One graphic: spending over time (curve with a hover tooltip). */}
      {portfolio && (
        <>
        <button
          type="button"
          onClick={() => setTrendOpen((v) => !v)}
          aria-expanded={trendOpen}
          className="dash-card flex w-full items-center justify-between gap-3 rounded-2xl px-4 py-3 text-left sm:hidden"
        >
          <span className="flex items-center gap-2.5 text-[15px] font-bold text-white"><TrendingUp className="h-5 w-5 text-[#2E8E82]" />{t("rpSpendTrendTitle")}</span>
          <ChevronDown className={`h-4 w-4 text-white/60 transition-transform ${trendOpen ? "rotate-180" : ""}`} />
        </button>
        <div className={trendOpen ? "" : "max-sm:hidden"}>
        <ChartCard title={t("rpSpendTrendTitle")} desc={t("rpSpendTrendDesc")}>
          {portfolio.trend && portfolio.trend.points?.length >= 2 ? (
            <LineChart
              labels={portfolio.trend.points.map((p: any) => p.label)}
              tooltipLabels={portfolio.trend.points.map((p: any) => p.full)}
              series={[{ key: "cur", label: t("rpMetricSpent"), color: CHART_COLORS[0], area: true, values: portfolio.trend.points.map((p: any) => Number(p.amount) || 0) }]}
              format={(n: number) => money(n)}
            />
          ) : (
            <p className="py-14 text-center text-sm italic text-white/40">{t("rpNoTrend")}</p>
          )}
        </ChartCard>
        </div>
        </>
      )}
      </div>

      {/* Toolbar: status tabs + search / budget health / sort / date, then the event cards. */}
      <div className="dash-card space-y-4 rounded-[32px] p-4 sm:p-5 max-sm:order-[-2]">
        <SpeedDial
          value={timeTab}
          items={([
            { key: "all", label: t("budgetFilterAll"), icon: LayoutList, count: countsReady ? counts.status.all : undefined },
            { key: "ongoing", label: t("timeTabOngoing"), icon: Clock, count: countsReady ? counts.status.ongoing : undefined },
            { key: "upcoming", label: t("timeTabUpcoming"), icon: CalendarClock, count: countsReady ? counts.status.upcoming : undefined },
            { key: "past", label: t("timeTabPast"), icon: Archive, count: countsReady ? counts.status.past : undefined },
          ] as const).map((o) => ({ ...o, onSelect: () => setTimeTab(o.key) }))}
        />
        <FilterBar
          tabsOnPhone={false}
          tabs={
            <QuickTabs
              value={timeTab}
              onChange={(k) => setTimeTab(k as typeof timeTab)}
              tabs={[
                { key: "all", label: t("budgetFilterAll"), count: countsReady ? counts.status.all : undefined },
                { key: "ongoing", label: t("timeTabOngoing"), count: countsReady ? counts.status.ongoing : undefined },
                { key: "upcoming", label: t("timeTabUpcoming"), count: countsReady ? counts.status.upcoming : undefined },
                { key: "past", label: t("timeTabPast"), count: countsReady ? counts.status.past : undefined },
              ]}
            />
          }
          search={{ value: search, onChange: setSearch, placeholder: t("searchEventsPlaceholder") }}
          filters={[{
            key: "budget", label: t("budgetFilterLabel"), value: budgetFilter, onChange: (v) => setBudgetFilter(v as typeof budgetFilter),
            options: [
              { value: "all", label: countsReady ? `${t("budgetFilterAll")} (${counts.budget.all})` : t("budgetFilterAll") },
              { value: "near", label: countsReady ? `${t("budgetFilterNear")} (${counts.budget.near})` : t("budgetFilterNear") },
              { value: "over", label: countsReady ? `${t("budgetFilterOver")} (${counts.budget.over})` : t("budgetFilterOver") },
            ],
          }]}
          sort={{
            value: sortKey, onChange: setSortKey,
            options: [
              { value: "default", label: t("sortEventDefault") },
              { value: "soonest", label: t("sortEventSoonest") },
              { value: "latest", label: t("sortEventLatest") },
              { value: "spent", label: t("sortSpentHigh") },
              { value: "used", label: t("sortUsedHigh") },
            ],
          }}
          count={countsReady && !pageLoading ? { shown: meta.total, total: counts.status.all } : undefined}
          extraChips={[
            ...(timeTab !== "all" ? [{ key: "tab", label: t(timeTab === "ongoing" ? "timeTabOngoing" : timeTab === "upcoming" ? "timeTabUpcoming" : "timeTabPast"), onRemove: () => setTimeTab("all") }] : []),
            ...(selectedDate ? [{ key: "date", label: `${t("fltDateChip")}: ${new Date(selectedDate).toLocaleDateString(locale, { year: "numeric", month: "short", day: "numeric" })}`, onRemove: () => setSelectedDate("") }] : []),
          ] as ExtraChip[]}
          onClearExtras={() => { setTimeTab("all"); setSelectedDate(""); }}
        >
          <div className="h-11 w-full shrink-0 sm:w-[190px]">
            <DatePicker value={selectedDate} onChange={setSelectedDate} className="h-11 px-4" dark align="right" />
          </div>
        </FilterBar>
      </div>

      {listLoading ? (
        <div className="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
          {Array.from({ length: 6 }).map((_, i) => (
            <div key={i} className="dash-card space-y-3 rounded-[28px] p-5 pl-7">
              <Skeleton className="h-3 w-1/3" />
              <Skeleton className="h-4 w-3/5" />
              <Skeleton className="h-3 w-2/5" />
              <Skeleton className="mt-4 h-2 w-full rounded-full" />
              <Skeleton className="h-3 w-1/2" />
            </div>
          ))}
        </div>
      ) : pagedSections.length === 0 ? (
        <div className="dash-card rounded-[28px] p-10 text-center text-sm text-white/50">
          {budgetFilter !== "all" || timeTab !== "all" || selectedDate || search ? t("noEventsInFilter") : t("noEventsFound")}
        </div>
      ) : (
        <div className="space-y-8">
          {pagedSections.map((sec) => {
            const meta = STATUS_META[sec.key];
            return (
              <section key={sec.key}>
                <div className="mb-3 flex items-center gap-2.5">
                  <span className={`h-2 w-2 rounded-full ${meta.dot} ${sec.key === "Ongoing" ? "animate-pulse" : ""}`} />
                  <h3 className={`text-xs font-bold uppercase tracking-wider ${meta.text}`}>{eventStatusLabel(sec.key)}</h3>
                  <span className="rounded-full bg-white/10 px-2 py-0.5 text-[11px] font-semibold text-white/70">{sec.total}</span>
                  <span className="h-px flex-1 bg-white/10" />
                  <span className="text-[11px] text-white/35">{t(meta.hint)}</span>
                </div>
                <div className="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                  {sec.items.map(({ e, status }) => {
                    const locked = status !== "Upcoming";
                    const { approved, spent, pct } = figuresOf(e as any);
                    const state = budgetStateOf(approved, spent);
                    const over = state === "over";
                    const near = state === "near";
                    const startDate = parseEventDateTime(e.event_start || e.date);
                    const timeLine = formatTimeFriendly(e.event_start || e.date);
                    const dateLine = startDate
                      ? `${startDate.toLocaleDateString(locale, { weekday: "short", month: "short", day: "numeric", year: "numeric" })}${timeLine ? ` · ${timeLine}` : ""}`
                      : "";
                    return (
                      <button
                        key={e.id}
                        type="button"
                        onClick={() => setSelectedEventId(String(e.id))}
                        className="dash-card group relative flex w-full flex-col overflow-hidden rounded-[28px] py-5 pl-7 pr-5 text-left text-white transition hover:-translate-y-0.5 hover:border-[#4FBEB0]/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4FBEB0]/50"
                      >
                        <span className={`absolute inset-y-0 left-0 w-1.5 ${meta.accent}`} />
                        <div className="flex items-center justify-between gap-2">
                          <p className={`flex items-center gap-1.5 text-xs font-semibold ${meta.text}`}>
                            {locked && <Lock className="h-3 w-3 shrink-0 opacity-70" aria-label={t("expenseAddLockedHint")} />}
                            {relativeLabel(e, status)}
                          </p>
                          {over && <span className="shrink-0 rounded-full bg-red-500 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide text-white">{t("budgetRowOverTag")}</span>}
                          {near && <span className="shrink-0 rounded-full bg-amber-500 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide text-white">{t("budgetRowNearTag")}</span>}
                        </div>
                        <p className="mt-2 break-words text-base font-semibold leading-snug">{highlightMatches(tc(e.title, language as any), search)}</p>
                        {dateLine && <p className="mt-1 text-xs text-white/45">{dateLine}</p>}
                        <div className="mt-auto pt-4">
                          {pct !== null ? (
                            <>
                              <div className="h-2 overflow-hidden rounded-full bg-white/10">
                                <div className={`h-full rounded-full ${over ? "bg-red-500" : near ? "bg-amber-400" : "bg-[#4FBEB0]"}`} style={{ width: `${pct}%` }} />
                              </div>
                              <p className="mt-2 flex items-center justify-between gap-2 text-xs text-white/50">
                                <span>{money(spent)} / {money(approved ?? 0)}</span>
                                {over ? (
                                  <span className="font-bold text-red-400">{t("budgetRowOverBy").replace("{over}", money(spent - (approved ?? 0)))}</span>
                                ) : (
                                  <span>{t("budgetUsedPct").replace("{pct}", String(Math.round(pct)))}</span>
                                )}
                              </p>
                            </>
                          ) : (
                            <p className="text-xs italic text-white/35">{t("budgetRowNoBudget")}</p>
                          )}
                          <p className="mt-3 flex items-center justify-end gap-1 border-t border-white/10 pt-3 text-xs font-semibold text-[#2E8E82] opacity-80 transition group-hover:opacity-100">
                            {t("budgetOpenCard")} <ChevronRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
                          </p>
                        </div>
                      </button>
                    );
                  })}
                </div>
              </section>
            );
          })}
        </div>
      )}

      <SimplePager page={pageNo} totalPages={meta.last_page} onChange={setPageNo} loading={pageLoading} />

      {/* The event's whole budget slides in from the right, like every other form. */}
      {selectedEvent && (
        <FormDrawer
          wide
          title={tc(selectedEvent.title, language as any)}
          subtitle={(() => {
            const sd = parseEventDateTime(selectedEvent.event_start || selectedEvent.date);
            const tl = formatTimeFriendly(selectedEvent.event_start || selectedEvent.date);
            return sd ? `${sd.toLocaleDateString(locale, { weekday: "short", month: "short", day: "numeric", year: "numeric" })}${tl ? ` · ${tl}` : ""}` : undefined;
          })()}
          onClose={() => setSelectedEventId(null)}
        >
          <EventBudgetWorkspace event={selectedEvent} onChanged={() => { fetchPortfolio(); setReloadTick((n) => n + 1); }} showHeader={false} />
        </FormDrawer>
      )}
      </div>
      </div>

    </>
  );
}
