<file path="resources/js/pages/staff/views/reports/ReportHistoryPanel.tsx">
import { useCallback, useEffect, useRef, useState } from "react";
import { Award, CalendarDays, FileSpreadsheet, FileText, FileType, History, Package, Printer, RotateCw, Wallet } from "lucide-react";
import api, { apiErrorMessage } from "../../../../lib/api";
import FilterBar from "../../../../components/ui/FilterBar";
import QuickTabs from "../../../../components/ui/QuickTabs";
import SimplePager from "../../../../components/ui/SimplePager";
import Skeleton from "../../../../components/ui/Skeleton";
import { useLanguage } from "../../../../i18n/LanguageContext";
import type { ReportFormat } from "./ReportGenerateDrawer";

export interface HistoryItem {
  id: number;
  type: "attendance" | "membership" | "budget" | "inventory";
  format: ReportFormat;
  title: string;
  scope_label: string | null;
  filters: Record<string, string | number>;
  sections: string[] | null;
  generated_by: string;
  generated_at: string | null;
}

const PAGE_SIZE = 8;

const TYPE_ICON = { attendance: CalendarDays, membership: Award, budget: Wallet, inventory: Package };
const TYPE_TINT: Record<string, string> = {
  attendance: "bg-[#4FBEB0]/15 text-[#7DD8CB]",
  membership: "bg-[#E8B84A]/15 text-[#E8B84A]",
  budget: "bg-sky-500/15 text-sky-300",
  inventory: "bg-[#C0705A]/20 text-[#E2A088]",
};
const FORMAT_ICON = { print: Printer, pdf: FileType, word: FileText, csv: FileSpreadsheet };

/** "just now", "5 min ago", "3 hr ago", "2d ago", then a plain date. */
function relativeTime(iso: string | null, t: (k: string) => string, locale: string): string {
  if (!iso) return "";
  const then = new Date(iso).getTime();
  const sec = Math.max(0, Math.floor((Date.now() - then) / 1000));
  if (sec < 45) return t("rpJustNow");
  if (sec < 3600) return t("rpMinAgo").replace("{n}", String(Math.max(1, Math.floor(sec / 60))));
  if (sec < 86400) return t("rpHrAgo").replace("{n}", String(Math.floor(sec / 3600)));
  if (sec < 86400 * 7) return t("rpDayAgo").replace("{n}", String(Math.floor(sec / 86400)));
  return new Date(iso).toLocaleDateString(locale, { year: "numeric", month: "short", day: "numeric" });
}

/**
 * Report History -- every report printed or downloaded from the Reports page.
 * "Open" restores the report's filters and sections on the page; "Generate
 * again" opens the Generate Report drawer with that format ready to go.
 */
export default function ReportHistoryPanel({
  refreshKey,
  onOpen,
  onGenerateAgain,
  onError,
}: {
  refreshKey: number;
  onOpen: (item: HistoryItem) => void;
  onGenerateAgain: (item: HistoryItem) => void;
  onError: (message: string) => void;
}) {
  const { t, locale } = useLanguage();
  const [items, setItems] = useState<HistoryItem[]>([]);
  const [total, setTotal] = useState(0);
  const [lastPage, setLastPage] = useState(1);
  const [page, setPage] = useState(1);
  const [fetching, setFetching] = useState(true);
  const [search, setSearch] = useState("");
  const [debounced, setDebounced] = useState("");
  const [type, setType] = useState("all");
  const [format, setFormat] = useState("all");
  const [scope, setScope] = useState<"all" | "mine">("all");
  const [, setTick] = useState(0);
  const reqId = useRef(0);
  const topRef = useRef<HTMLSpanElement | null>(null);
  const scrollPending = useRef(false);
  // Back to the top of the list: now (so it feels instant) and again once the
  // new page has loaded (the list swaps to a skeleton and back, which can
  // shift the scroll position).
  const toTop = () => {
    scrollPending.current = true;
    topRef.current?.scrollIntoView({ behavior: "auto", block: "start" });
  };

  useEffect(() => {
    const id = window.setTimeout(() => setDebounced(search.trim()), 300);
    return () => window.clearTimeout(id);
  }, [search]);

  // A new filter starts again from page 1.
  useEffect(() => { setPage(1); }, [debounced, type, format, scope]);

  const load = useCallback(async (silent = false) => {
    const id = ++reqId.current;
    if (!silent) setFetching(true);
    try {
      const res = await api.get("/reports/history", {
        params: { page, per_page: PAGE_SIZE, search: debounced || undefined, type, format, mine: scope === "mine" ? 1 : undefined },
      });
      if (id !== reqId.current) return;
      setItems(res.data?.data ?? []);
      setTotal(res.data?.total ?? 0);
      setLastPage(res.data?.last_page ?? 1);
    } catch (e) {
      if (id === reqId.current && !silent) onError(apiErrorMessage(e, t("rpHistLoadFailed")));
    } finally {
      if (id === reqId.current) setFetching(false);
      if (id === reqId.current && scrollPending.current) {
        scrollPending.current = false;
        window.requestAnimationFrame(() => topRef.current?.scrollIntoView({ behavior: "auto", block: "start" }));
      }
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [page, debounced, type, format, scope]);

  useEffect(() => { load(); }, [load, refreshKey]);

  // Quiet background refresh + a tick so "5 min ago" keeps counting.
  useEffect(() => {
    const poll = window.setInterval(() => { if (document.visibilityState === "visible") load(true); }, 15000);
    const tick = window.setInterval(() => setTick((n) => n + 1), 30000);
    return () => { window.clearInterval(poll); window.clearInterval(tick); };
  }, [load]);

  const typeOptions = [
    { value: "all", label: t("rpHistAllTypes") },
    { value: "attendance", label: t("reportTypeAttendance") },
    { value: "membership", label: t("reportTypeMembership") },
    { value: "budget", label: t("reportTypeBudget") },
    { value: "inventory", label: t("reportTypeInventory") },
  ];
  const formatOptions = [
    { value: "all", label: t("rpHistAllFormats") },
    { value: "print", label: t("rpFmtPrint") },
    { value: "pdf", label: t("rpFmtPdf") },
    { value: "word", label: t("rpFmtWord") },
    { value: "csv", label: t("rpFmtCsv") },
  ];
  const formatLabel = (f: string) => ({ print: t("rpFmtPrint"), pdf: t("rpFmtPdf"), word: t("rpFmtWord"), csv: t("rpFmtCsv") } as Record<string, string>)[f] ?? f;
  const typeLabel = (k: string) => t(`reportType${k.charAt(0).toUpperCase()}${k.slice(1)}`);
  const filtering = debounced !== "" || type !== "all" || format !== "all" || scope !== "all";

  const outlineBtn = "inline-flex items-center gap-2 rounded-full border border-white/20 bg-transparent px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10 active:scale-95";

  const goToPage = (next: number) => {
    setPage(next);
    toTop();
  };

  return (
    <div className="space-y-5">
      <span ref={topRef} className="block h-0 w-0 !m-0 scroll-mt-24" />
      <div>
        <h2 className="flex items-center gap-2.5 text-xl font-bold text-white"><History className="h-5 w-5 text-[#4FBEB0]" />{t("rpHistTitle")}</h2>
        <p className="mt-1 max-w-3xl text-sm text-white/50">{t("rpHistSub")}</p>
      </div>


      <FilterBar
        tabs={
          <QuickTabs
            value={scope}
            onChange={(k) => setScope(k as "all" | "mine")}
            tabs={[
              { key: "all", label: t("rpHistEveryone") },
              { key: "mine", label: t("rpHistMine") },
            ]}
          />
        }
        search={{ value: search, onChange: setSearch, placeholder: t("rpHistSearch") }}
        filters={[
          { key: "type", label: t("rpHistType"), value: type, defaultValue: "all", onChange: setType, options: typeOptions },
          { key: "format", label: t("rpHistFormat"), value: format, defaultValue: "all", onChange: setFormat, options: formatOptions },
        ]}
        count={fetching ? undefined : { shown: total }}
      />

      <div className="space-y-3">
        {fetching ? (
          Array.from({ length: 4 }).map((_, i) => <Skeleton key={i} className="h-24 rounded-2xl" />)
        ) : items.length === 0 ? (
          <div className="rounded-[30px] border border-dashed border-white/15 bg-white/[0.02] px-6 py-14 text-center">
            <History className="mx-auto h-9 w-9 text-white/25" />
            <p className="mt-3 text-base font-semibold text-white/70">{filtering ? t("rpHistNoMatch") : t("rpHistEmpty")}</p>
            {!filtering && <p className="mt-1 text-sm text-white/40">{t("rpHistEmptyHint")}</p>}
          </div>
        ) : (
          items.map((it) => {
            const TypeIcon = TYPE_ICON[it.type] ?? CalendarDays;
            const FormatIcon = FORMAT_ICON[it.format] ?? FileText;
            return (
              <div key={it.id} className="flex flex-col gap-4 dash-tile rounded-2xl p-4 sm:flex-row sm:items-center sm:p-5">
                <span className={`flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl ${TYPE_TINT[it.type] ?? TYPE_TINT.attendance}`}>
                  <TypeIcon className="h-6 w-6" />
                </span>
                <div className="min-w-0 flex-1">
                  <div className="flex flex-wrap items-center gap-2">
                    <p className="truncate text-base font-bold text-white">{typeLabel(it.type)}</p>
                    <span className="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-2.5 py-0.5 text-xs font-semibold text-white/70">
                      <FormatIcon className="h-3 w-3" /> {formatLabel(it.format)}
                    </span>
                  </div>
                  {it.scope_label && <p className="mt-0.5 truncate text-sm text-white/60">{it.scope_label}</p>}
                  <p className="mt-1 text-xs text-white/40" title={it.generated_at ? new Date(it.generated_at).toLocaleString(locale) : ""}>
                    {t("rpHistBy").replace("{name}", it.generated_by)} · {relativeTime(it.generated_at, t, locale)}
                  </p>
                </div>
                <div className="flex shrink-0 flex-wrap items-center gap-2">
                  <button type="button" onClick={() => onOpen(it)} className={outlineBtn}>{t("rpHistOpen")}</button>
                  <button type="button" onClick={() => onGenerateAgain(it)} className={outlineBtn}><RotateCw className="h-3.5 w-3.5" />{t("rpHistAgain")}</button>
                </div>
              </div>
            );
          })
        )}
      </div>

      <SimplePager page={page} totalPages={lastPage} onChange={goToPage} loading={fetching && items.length > 0} />
    </div>
  );
}
</file>

<file path="app/Http/Controllers/FeedbackController.php">
<?php

namespace App\Http\Controllers;

use Illuminate\Support\Facades\DB;
use App\Models\AbsenceReason;
use App\Models\AppSetting;
use App\Models\Event;
use App\Models\Feedback;
use App\Models\FeedbackEdit;
use App\Models\EventAttendance;
use App\Models\Notification;
use App\Models\User;
use Illuminate\Http\Request;
use Illuminate\Support\Carbon;

class FeedbackController extends Controller
{
    /**
     * English label of each "couldn't attend" reason. Staff alerts carry the label and the
     * screens map it back to the reader's own language (see resources/js/lib/absence.ts).
     */
    private const REASON_LABELS = [
        'schedule'       => 'Schedule conflict',
        'sick'           => 'Sick or unwell',
        'not_informed'   => "Didn't know about it",
        'no_transport'   => 'No transportation',
        'work_family'    => 'Work or family duties',
        'not_interested' => 'Not interested',
        'other'          => 'Other',
    ];

    /*
     * NOTIFICATION CONTRACT. The staff bell, the Notifications page and the member's inbox read
     * these notifications by their SHAPE and write the wording themselves, in the reader's
     * language (verbs, "on", reason labels all come from the interface dictionaries):
     *   staff:  title "<Name> sent feedback" | "<Name> updated their feedback" |
     *                 "<Name> sent a reason for not attending" |
     *                 "<Name> liked your reply on their feedback|response"
     *           message "\"<Event>\" - 4/5" (or "- <Reason label>"), then the comment on line 2
     *   member: title "Barangay staff liked|replied to your feedback|response",
     *           message "\"<Event>\"", then the staff reply on line 2
     * Changing the title or message text here breaks that reading, so keep to this shape.
     */
    private function personName($user): string
    {
        return trim(($user->first_name ?? '') . ' ' . ($user->last_name ?? '')) ?: 'A member';
    }

    // ------------------------------------------------------------------
    // Window helpers
    // ------------------------------------------------------------------

    private function attendanceIsReviewable(EventAttendance $attendance): bool
    {
        if ($attendance->status === 'Complete') {
            return true;
        }
        $event = $attendance->event;
        return $event && $event->event_end && now()->greaterThan($event->event_end);
    }

    private function attendedScope($query)
    {
        return $query->where(fn ($q) => $q->whereNotNull('time_in')->orWhereNotNull('time_out'));
    }

    private function submitClosesAtFor(Event $event): ?Carbon
    {
        $rules = AppSetting::feedbackRules();
        $end = $event->event_end ?? $event->event_start;
        if (!$end) {
            return null;
        }
        return Carbon::parse($end)->addHours((int) $rules['close_after_hours']);
    }

    // ------------------------------------------------------------------
    // Settings
    // ------------------------------------------------------------------

    public function rules()
    {
        return response()->json(AppSetting::feedbackRules());
    }

    public function updateRules(Request $request)
    {
        $request->validate([
            'close_after_hours'   => 'required|integer|min:1|max:168',
            'edit_window_minutes' => 'required|integer|min:1|max:120',
            'password'            => 'required|string',
        ]);

        app(\App\Services\SecurityService::class)
            ->requirePassword(auth()->user(), $request->password);

        $rules = AppSetting::saveFeedbackRules(
            (int) $request->close_after_hours,
            (int) $request->edit_window_minutes,
        );

        $this->createLog(
            'Update Settings',
            'Feedback',
            "Updated feedback rules: submit window {$rules['close_after_hours']}h, edit window {$rules['edit_window_minutes']}m"
        );

        return response()->json($rules);
    }

    // ------------------------------------------------------------------
    // Submit / edit / remove (Resident)
    // ------------------------------------------------------------------

    public function store(Request $request)
    {
        $request->validate([
            'event_id' => 'required|integer|exists:events,id',
            'rating'   => 'required|integer|min:1|max:5',
            'comment'  => 'nullable|string|max:1000',
        ]);

        $userId = auth()->id();

        // One submit per person per event at a time: a double-tap used to let
        // both requests see "no feedback yet" and race to insert (one then
        // failed on the unique index), or both log the same edit twice.
        return $this->exclusively(
            'feedback:' . (int) $request->event_id . ':' . $userId,
            fn () => $this->storeFeedback($request, $userId)
        );
    }

    private function storeFeedback(Request $request, $userId)
    {
        $attendance = $this->attendedScope(
            EventAttendance::with('event')
                ->where('event_id', $request->event_id)
                ->where('user_id', $userId)
        )->first();

        if (!$attendance) {
            return response()->json([
                'message' => 'Only members who attended this event (checked in at the entrance) can leave feedback.',
            ], 403);
        }

        if (!$this->attendanceIsReviewable($attendance)) {
            return response()->json([
                'message' => 'Feedback is only available after the event has ended.',
            ], 403);
        }

        $event = $attendance->event;

        $existing = Feedback::withTrashed()
            ->where('event_id', $request->event_id)
            ->where('user_id', $userId)
            ->first();

        // ---------- Edit path ----------
        if ($existing && !$existing->trashed()) {
            if ($existing->isEditLocked()) {
                return response()->json([
                    'message' => "Editing is closed. Feedback can only be changed within {$existing->edit_window_minutes} minute(s) after it was first sent.",
                    'code'    => 'edit_window_closed',
                ], 403);
            }

            FeedbackEdit::create([
                'kind'       => 'rating',
                'item_id'    => $existing->id,
                'rating'     => $existing->rating,
                'comment'    => $existing->comment,
                'written_at' => $existing->updated_at ?? $existing->created_at,
            ]);

            $existing->update([
                'rating'  => (int) $request->rating,
                'comment' => $request->comment,
            ]);

            $this->createLog(
                'Update',
                'Feedback',
                "Edited feedback for event '{$event->name}' (rating {$request->rating}/5)"
            );

            $this->notifyStaff($existing, $event, auth()->user(), true);

            return response()->json([
                'message'  => 'Feedback updated.',
                'feedback' => $this->shapeRow($existing->fresh()),
            ]);
        }

        // ---------- First-submit path ----------
        $closes = $this->submitClosesAtFor($event);
        if ($closes && now()->greaterThan($closes)) {
            $rules = AppSetting::feedbackRules();
            return response()->json([
                'message' => "Feedback for this event closed {$rules['close_after_hours']} hour(s) after it ended.",
                'code'    => 'submit_window_closed',
            ], 403);
        }

        $rules = AppSetting::feedbackRules();

        $feedback = Feedback::create([
            'event_id'            => $event->id,
            'user_id'             => $userId,
            'rating'              => (int) $request->rating,
            'comment'             => $request->comment,
            'close_after_hours'   => (int) $rules['close_after_hours'],
            'edit_window_minutes' => (int) $rules['edit_window_minutes'],
        ]);

        $this->createLog(
            'Create',
            'Feedback',
            "Submitted feedback for event '{$event->name}' (rating {$request->rating}/5)"
        );

        $this->notifyStaff($feedback, $event, auth()->user());

        return response()->json([
            'message'  => 'Thank you for your feedback!',
            'feedback' => $this->shapeRow($feedback->fresh()),
        ], 201);
    }

    public function destroy($id)
    {
        $userId = auth()->id();
        $feedback = Feedback::with('event')->findOrFail($id);

        if ((int) $feedback->user_id !== (int) $userId) {
            return response()->json(['message' => 'You can only remove your own feedback.'], 403);
        }

        if ($feedback->isEditLocked()) {
            return response()->json([
                'message' => "Removing feedback is closed. It can only be removed within {$feedback->edit_window_minutes} minute(s) after it was first sent.",
                'code'    => 'edit_window_closed',
            ], 403);
        }

        FeedbackEdit::create([
            'kind'       => 'rating',
            'item_id'    => $feedback->id,
            'rating'     => $feedback->rating,
            'comment'    => $feedback->comment,
            'written_at' => $feedback->updated_at ?? $feedback->created_at,
        ]);

        $feedback->deleted_by = auth()->user()->user_code;
        $feedback->save();
        $feedback->delete();

        $eventName = $feedback->event?->name ?? 'Unknown event';
        $this->createLog('Delete', 'Feedback', "Removed feedback for event '{$eventName}'");

        return response()->json(['message' => 'Feedback removed.']);
    }

    private function shapeRow(Feedback $f): array
    {
        return array_merge($f->toArray(), [
            'edit_seconds_left'   => $f->editSecondsLeft(),
            'edit_window_minutes' => $f->edit_window_minutes,
            'close_after_hours'   => $f->close_after_hours,
            'is_locked'           => $f->isEditLocked(),
        ]);
    }

    // ------------------------------------------------------------------
