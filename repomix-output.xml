import { useEffect, useRef, useState } from "react";
import { SquareMenu, Menu, Settings, LogOut, ChevronDown, Volume2, VolumeX } from "lucide-react";
import { getSoundPref, setSoundPref, MEMBER_SOUND_KEY, SOUND_CHANGED_EVENT } from "../../lib/alertSound";
import HeaderPreferences from "../ui/HeaderPreferences";
import UserAvatar from "../ui/UserAvatar";
import useMyPhoto from "../../hooks/useMyPhoto";
import { useLanguage } from "../../i18n/LanguageContext";

interface TopHeaderProps {
  memberName: string;
  onMenuClick?: () => void;
  userId?: string | number;
  userCode?: string;
  onNavigate?: (key: string) => void;
}

// Same navy/gold/teal treatment as the staff portal's TopHeader
// (pages/staff/components/TopHeader.tsx), plus the initials avatar it
// already shows next to "Signed in as" -- the member header was missing
// that touch, which is what made it read as the less-finished of the two.
export default function TopHeader({ memberName, onMenuClick, userId, userCode, onNavigate }: TopHeaderProps) {
  const { t } = useLanguage();
  const photo = useMyPhoto();
  const [open, setOpen] = useState(false);
  const ref = useRef<HTMLDivElement>(null);
  const [soundOn, setSoundOn] = useState(() => getSoundPref(MEMBER_SOUND_KEY));
  useEffect(() => {
    const sync = () => setSoundOn(getSoundPref(MEMBER_SOUND_KEY));
    window.addEventListener(SOUND_CHANGED_EVENT, sync);
    return () => window.removeEventListener(SOUND_CHANGED_EVENT, sync);
  }, []);

  useEffect(() => {
    if (!open) return;
    const onDown = (e: MouseEvent) => { if (ref.current && !ref.current.contains(e.target as Node)) setOpen(false); };
    const onKey = (e: KeyboardEvent) => { if (e.key === "Escape") setOpen(false); };
    document.addEventListener("mousedown", onDown);
    document.addEventListener("keydown", onKey);
    return () => { document.removeEventListener("mousedown", onDown); document.removeEventListener("keydown", onKey); };
  }, [open]);

  return (
    <div className="flex items-center justify-between border-b border-white/10 bg-[#0A0E1A] px-3 sm:px-6 h-[73px] box-border gap-2">
      <div className="flex min-w-0 flex-1 items-center gap-2">
        <button onClick={onMenuClick} className="xl:hidden shrink-0 -ml-2 inline-flex h-10 w-10 items-center justify-center rounded-full text-white/60 hover:bg-white/10">
          <Menu className="h-5 w-5" />
        </button>
        <SquareMenu className="h-5 w-5 shrink-0 text-[#7DD8CB]" />
        <p className="m-0 min-w-0 truncate text-xs font-semibold uppercase leading-snug tracking-[0.12em] text-white/60 sm:hidden">{t("portalMemberShort")}</p>
        <p className="m-0 hidden min-w-0 truncate text-[11px] uppercase leading-snug tracking-[0.12em] text-white/40 sm:block lg:tracking-[0.2em]">
          {t("memberPortal")}
        </p>
      </div>
      <div className="flex shrink-0 items-center gap-2.5 sm:gap-3 lg:gap-4">
        <HeaderPreferences userId={userId} />
        <div ref={ref} className="relative">
          <button
            type="button"
            onClick={() => setOpen((v) => !v)}
            aria-haspopup="menu"
            aria-expanded={open}
            className="flex items-center gap-2.5 rounded-full py-1 pl-1 pr-1.5 transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-[#4FBEB0]/40 sm:pr-3"
          >
            <UserAvatar src={photo} className="h-8 w-8" title={memberName} />
            <div className="hidden text-left leading-tight sm:block">
              <p className="text-xs text-white/40">{t("signedInAs")}</p>
              {memberName ? (
                <p className="text-sm font-bold text-white">{memberName}</p>
              ) : (
                <span className="mt-0.5 block h-3.5 w-24 animate-pulse rounded bg-white/10" />
              )}
            </div>
            <ChevronDown className={`hidden h-4 w-4 text-white/50 transition-transform sm:block ${open ? "rotate-180" : ""}`} />
          </button>

          {open && (
            <div role="menu" className="absolute right-0 top-full z-50 mt-2 w-72 max-w-[calc(100vw-1.5rem)] rounded-2xl border border-white/15 bg-[#0A0E1A] p-2 shadow-2xl">
              <div className="flex items-center gap-3 px-3 py-3">
                <UserAvatar src={photo} className="h-11 w-11" title={memberName} />
                <div className="min-w-0">
                  <p className="truncate text-base font-bold text-white">{memberName}</p>
                  {userCode && <p className="text-sm font-semibold text-[#7DD8CB]">{userCode}</p>}
                  <p className="text-sm text-white/50">{t("memberRole")}</p>
                </div>
              </div>
              <div className="my-1 border-t border-white/10" />
              <button role="menuitem" className="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-medium text-white/85 transition hover:bg-white/10" onClick={() => { setOpen(false); onNavigate?.("settings"); }}>
                <Settings className="h-4 w-4 shrink-0" />
                <span className="flex-1">{t("secManageAccount")}</span>
              </button>
              <button role="menuitemcheckbox" aria-checked={soundOn} className="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-medium text-white/85 transition hover:bg-white/10" onClick={() => setSoundPref(MEMBER_SOUND_KEY, !soundOn)}>
                {soundOn ? <Volume2 className="h-4 w-4 shrink-0" /> : <VolumeX className="h-4 w-4 shrink-0" />}
                <span className="flex-1">{t("memSoundLabel")}</span>
                <span className={`text-xs font-bold ${soundOn ? "text-[#7DD8CB]" : "text-white/40"}`}>{soundOn ? t("memSoundOn") : t("memSoundOff")}</span>
              </button>
              <div className="my-1 border-t border-white/10" />
              <button role="menuitem" className="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-semibold text-red-400 transition hover:bg-red-500/10" onClick={() => { setOpen(false); window.dispatchEvent(new Event("member:request-logout")); }}>
                <LogOut className="h-4 w-4 shrink-0" />
                <span className="flex-1">{t("signOut")}</span>
              </button>
            </div>
          )}
        </div>
        <div className="hidden min-[420px]:block rounded-full bg-gold-400 px-2.5 sm:px-4 py-1.5 sm:py-2 text-[9px] sm:text-xs font-black uppercase tracking-wide text-[#08130F] shadow-sm whitespace-nowrap">
          {t("memberRole")}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="resources/js/pages/staff/components/TopHeader.tsx">
import { useEffect, useRef, useState } from "react";
import { SquareMenu, Menu, Settings, LogOut, ChevronDown, Crown, Bell } from "lucide-react";
import HeaderPreferences from "../../../components/ui/HeaderPreferences";
import UserAvatar from "../../../components/ui/UserAvatar";
import useMyPhoto from "../../../hooks/useMyPhoto";
import NotificationBell from "./NotificationBell";
import { useLanguage } from "../../../i18n/LanguageContext";
import { useSecurityUnread, useStaffAlertsUnread } from "../../../lib/staffAlertsStore";

interface TopHeaderProps {
  memberName: string;
  role: string;
  onMenuClick?: () => void;
  userId?: string | number;
  userCode?: string;
  isHeadStaff?: boolean;
  onNavigate?: (key: string) => void;
}

export default function TopHeader({ memberName, role, onMenuClick, userId, userCode, isHeadStaff, onNavigate }: TopHeaderProps) {
  const { t } = useLanguage();
  const photo = useMyPhoto();
  const securityUnread = useSecurityUnread();
  const feedbackUnread = useStaffAlertsUnread();
  const [open, setOpen] = useState(false);
  const ref = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (!open) return;
    const onDown = (e: MouseEvent) => { if (ref.current && !ref.current.contains(e.target as Node)) setOpen(false); };
    const onKey = (e: KeyboardEvent) => { if (e.key === "Escape") setOpen(false); };
    document.addEventListener("mousedown", onDown);
    document.addEventListener("keydown", onKey);
    return () => { document.removeEventListener("mousedown", onDown); document.removeEventListener("keydown", onKey); };
  }, [open]);

  const go = (key: string) => { setOpen(false); onNavigate?.(key); };
  const item = "flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-medium text-white/85 transition hover:bg-white/10";

  return (
    <div className="print:hidden flex items-center justify-between border-b border-white/10 bg-[#0A0E1A] px-3 sm:px-6 h-[73px] box-border gap-2">
      <div className="flex min-w-0 flex-1 items-center gap-2">
        <button onClick={onMenuClick} className="xl:hidden shrink-0 -ml-2 inline-flex h-10 w-10 items-center justify-center rounded-full text-white/60 hover:bg-white/10">
          <Menu className="h-5 w-5" />
        </button>
        <SquareMenu className="h-5 w-5 shrink-0 text-[#7DD8CB]" />
        <p className="m-0 min-w-0 truncate text-xs font-semibold uppercase leading-snug tracking-[0.12em] text-white/60 sm:hidden">{t("portalStaffShort")}</p>
        <p className="m-0 hidden min-w-0 truncate text-[11px] uppercase leading-snug tracking-[0.12em] text-white/40 sm:block lg:tracking-[0.2em]">{t("staffPortal")}</p>
      </div>
      <div className="flex shrink-0 items-center gap-2.5 sm:gap-3 lg:gap-4">
        <HeaderPreferences userId={userId} />
        <div className="sm:ml-1 max-sm:hidden"><NotificationBell /></div>
        <div ref={ref} className="relative">
          <button
            type="button"
            onClick={() => setOpen((v) => !v)}
            aria-haspopup="menu"
            aria-expanded={open}
            className="flex items-center gap-2.5 rounded-full py-1 pl-1 pr-1.5 transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-[#4FBEB0]/40 sm:pr-3"
          >
            <span className="relative">
              <UserAvatar src={photo} className="h-8 w-8" title={memberName} />
              {(securityUnread > 0 || feedbackUnread > 0) && <span className={`absolute -right-0.5 -top-0.5 h-2.5 w-2.5 rounded-full bg-red-500 ring-2 ring-[#0A0E1A] ${securityUnread > 0 ? "" : "sm:hidden"}`} />}
            </span>
            <div className="hidden text-left leading-tight sm:block">
              <p className="text-xs text-white/40">{t("signedInAs")}</p>
              <p className="text-sm font-bold text-white">{memberName}</p>
            </div>
            <ChevronDown className={`hidden h-4 w-4 text-white/50 transition-transform sm:block ${open ? "rotate-180" : ""}`} />
          </button>

          {open && (
            <div role="menu" className="absolute right-0 top-full z-50 mt-2 w-72 max-w-[calc(100vw-1.5rem)] rounded-2xl border border-white/15 bg-[#0A0E1A] p-2 shadow-2xl">
              <div className="flex items-center gap-3 px-3 py-3">
                <UserAvatar src={photo} className="h-11 w-11" title={memberName} />
                <div className="min-w-0">
                  <p className="truncate text-base font-bold text-white">{memberName}</p>
                  {userCode && <p className="text-sm font-semibold text-[#7DD8CB]">{userCode}</p>}
                  {isHeadStaff ? (
                    <p className="mt-0.5"><span className="inline-flex items-center gap-1 rounded-full bg-gold-400/20 px-2 py-0.5 text-[11px] font-bold text-gold-300"><Crown className="h-3 w-3" /> {t("secHeadStaff")}</span></p>
                  ) : (
                    <p className="text-sm capitalize text-white/50">{role}</p>
                  )}
                </div>
              </div>
              <div className="my-1 border-t border-white/10" />
              <button role="menuitem" className={`${item} sm:hidden`} onClick={() => go("notify")}>
                <Bell className="h-4 w-4 shrink-0" />
                <span className="flex-1">{t("notify")}</span>
                {feedbackUnread > 0 && <span className="rounded-full bg-red-500 px-2 py-0.5 text-[11px] font-bold text-white" aria-label={`${feedbackUnread} unread`}>{feedbackUnread > 99 ? "99+" : feedbackUnread}</span>}
              </button>
              <button role="menuitem" className={item} onClick={() => go("myaccount")}>
                <Settings className="h-4 w-4 shrink-0" />
                <span className="flex-1">{t("secManageAccount")}</span>
                {securityUnread > 0 && <span className="rounded-full bg-red-500 px-2 py-0.5 text-[11px] font-bold text-white">{securityUnread}</span>}
              </button>
              <div className="my-1 border-t border-white/10" />
              <button role="menuitem" className="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-semibold text-red-400 transition hover:bg-red-500/10" onClick={() => { setOpen(false); window.dispatchEvent(new Event("staff:request-logout")); }}>
                <LogOut className="h-4 w-4 shrink-0" />
                <span className="flex-1">{t("signOut")}</span>
              </button>
            </div>
          )}
        </div>
        <div className="hidden min-[420px]:block rounded-full bg-gold-400 px-2.5 sm:px-4 py-1.5 sm:py-2 text-[9px] sm:text-xs font-black uppercase tracking-wide text-[#08130F] shadow-sm whitespace-nowrap">{role}</div>
      </div>
    </div>
  );
}
</file>

<file path="resources/js/components/layout/Sidebar.tsx">
import {
  Bell,
  CalendarDays,
  ClipboardCheck,
  LayoutDashboard,
  LogOut,
  QrCode,
  Settings,
  X as XIcon,
} from "lucide-react";
import React, { useEffect, useState } from "react";
import { useLanguage } from "../../i18n/LanguageContext";

interface SidebarProps {
  active: string;
  setActive: (page: string) => void;
  mobileOpen?: boolean;
  onCloseMobile?: () => void;
  userName?: string;
  userRole?: string;
  /** Optional per-nav-key count shown as a badge (e.g. { notify: 3 } for unread notifications). */
  badges?: Record<string, number>;
}

// Same navy/gold/teal system, fixed width, and behavior as the staff
// portal's own Sidebar (pages/staff/components/Sidebar.tsx) -- same 340px
// width, header block, nav styling, and logout confirm. No quick-jump
// search box here: this portal's nav list is short enough (6 items) that a
// search input isn't needed the way it is for staff's larger, grouped nav.
export default function Sidebar({ active, setActive, mobileOpen = false, onCloseMobile, userName, userRole, badges }: SidebarProps) {
  const { t } = useLanguage();
  const [showLogoutConfirm, setShowLogoutConfirm] = useState(false);
  const [loggingOut, setLoggingOut] = useState(false);

  // The profile menu in the top bar asks for sign-out through this event.
  useEffect(() => {
    const open = () => setShowLogoutConfirm(true);
    window.addEventListener("member:request-logout", open);
    return () => window.removeEventListener("member:request-logout", open);
  }, []);

  const navItems = [
    { key: "dashboard", label: "Overview", icon: LayoutDashboard },
    { key: "qr", label: "My QR Code", icon: QrCode },
    { key: "attendance", label: "Attendance", icon: ClipboardCheck },
    { key: "events", label: "Events", icon: CalendarDays },
    { key: "notify", label: "Notifications", icon: Bell },
    { key: "settings", label: "Settings", icon: Settings },
  ];

  const handleNavClick = (page: string) => {
    setActive(page);
    onCloseMobile?.();
  };

  const handleLogout = async () => {
    setLoggingOut(true);
    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

      await fetch('/logout', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
          ...(csrfToken && { 'X-CSRF-TOKEN': csrfToken })
        }
      });
    } catch (err) {
      console.error('Logout error:', err);
    } finally {
      // Clear ALL storage (safe because user is logging out)
      localStorage.clear();
      sessionStorage.clear();

      // Redirect to login page
      window.location.href = '/';
    }
  };

  // Same active/inactive nav classes as the staff Sidebar, so a highlighted
  // nav item looks identical in both portals.
  const inactiveNav = "text-white/55 hover:bg-white/[0.06] hover:text-white border border-transparent active:scale-[0.97] active:bg-white/[0.12]";
  const activeNav = "bg-white/10 text-white font-semibold border border-white/40 active:scale-[0.97]";

  return (
    <>
      {mobileOpen && (
        <div className="fixed inset-0 bg-black/55 z-30 xl:hidden" onClick={onCloseMobile} />
      )}

      <aside
        className={`w-[300px] sm:w-[320px] xl:w-[300px] 2xl:w-[340px] max-w-[88vw] flex-col transition-transform duration-300 ease-out overscroll-contain bg-[#0A0E1A] h-[100dvh] fixed xl:sticky top-0 z-40 flex overflow-hidden ${
          mobileOpen ? "translate-x-0" : "-translate-x-full xl:translate-x-0"
        }`}
      >
        <button onClick={onCloseMobile} className="xl:hidden absolute top-3 right-3 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full text-white/50 hover:bg-white/10 hover:text-white">
          <XIcon size={20} />
        </button>

        {/* Sidebar Header -- same block as the staff Sidebar's own. */}
        <div className="border-b border-white/10 px-4 h-[73px] box-border shrink-0 flex items-center gap-3">
          <div className="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 border border-white/15 shrink-0 overflow-hidden">
            <img
              src="/logo-removebg-preview.png"
              alt={t("dashLogoAlt")}
              className="w-full h-full object-contain"
            />
          </div>
          <div>
            <h1 className="font-display text-lg font-extrabold text-white whitespace-nowrap leading-tight">
              Piao<span className="text-white/40">Connect</span>
            </h1>
          </div>
        </div>

        {/* Navigation Menu */}
        <div className="flex-1 px-3 py-5 overflow-y-auto smooth-scroll">
          <p className="mb-3 px-3 text-[11px] font-bold uppercase tracking-[0.12em] text-white/35">
            {t("memberArea")}
          </p>
          <div className="space-y-1.5">
            {navItems.map((item) => {
              const isActive = active === item.key;
              return (
                <button
                  key={item.key}
                  onClick={() => handleNavClick(item.key)}
                  className={`flex items-center w-full rounded-xl px-4 py-3 gap-3 text-[13.5px] transition-all duration-200 group ${isActive ? activeNav : inactiveNav}`}
                >
                  <item.icon className="h-5 w-5 shrink-0" />
                  <span className="truncate flex-1 min-w-0 text-left">{t(item.key)}</span>
                  {(badges?.[item.key] ?? 0) > 0 && (
                    <span
                      className="ml-auto inline-flex h-6 min-w-[1.5rem] shrink-0 items-center justify-center rounded-full bg-red-500 px-2 text-xs font-bold text-white shadow-sm"
                      aria-label={`${badges![item.key]} unread`}
                    >
                      {badges![item.key] > 99 ? "99+" : badges![item.key]}
                    </span>
                  )}
                </button>
              );
            })}
          </div>
        </div>

      </aside>

      {/* Same dark "are you sure" confirm used by the staff Sidebar's own
          logout -- ending the session gets a deliberate, prominent step
          instead of the light peripheral-alert treatment. */}
      {showLogoutConfirm && (
        <div className="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-[90] px-4">
          <div className="w-full max-w-md rounded-[30px] border border-white/10 bg-[#0A0E1A] p-6 text-center shadow-2xl">
            <div className="mb-4 flex justify-center text-[#4FBEB0]"><LogOut size={40} /></div>
            <h3 className="font-display text-xl font-bold text-white mb-3">{t("confirmLogoutTitle")}</h3>
            <p className="text-[15px] text-white/55 mb-5">{t("confirmLogoutMessage")}</p>
            <div className="flex justify-center gap-4">
              <button onClick={() => setShowLogoutConfirm(false)} disabled={loggingOut} className="px-5 py-2.5 rounded-full border border-white/15 text-white/70 hover:bg-white/5 transition disabled:opacity-60">{t("cancel")}</button>
              <button onClick={handleLogout} disabled={loggingOut} className="px-5 py-2.5 rounded-full bg-gradient-to-r from-gold-400 to-[#4FBEB0] text-[#08130F] font-bold hover:opacity-90 transition disabled:opacity-60">{t("yesLogoutButton")}</button>
            </div>
          </div>
        </div>
      )}
    </>
  );
}
