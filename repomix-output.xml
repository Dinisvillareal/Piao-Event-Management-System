    // Same upload/delete convention as InventoryController::localUpload --
    // evidence photos for a release ("the item came back") are required proof
    // images stored on the public disk, exposed via EventInventoryRelease's
    // evidence_photo_url accessor. $folder picks the storage/app/public subfolder.
    private function localUpload($file, string $folder): string
    {
        $original = pathinfo($file->getClientOriginalName(), PATHINFO_FILENAME);
        $ext      = \App\Support\Uploads::extension($file, \App\Support\Uploads::IMAGE);
        $clean    = preg_replace('/[^A-Za-z0-9\-_.]/', '_', $original);
        $filename = time() . '_' . $clean . '.' . $ext;

        $path = $file->storeAs($folder, $filename, 'public');

        if (!$path) {
            throw new \App\Exceptions\UserFacingException('File upload failed');
        }

        return $path;
    }

    private function localDelete(?string $path): void
    {
        if (!$path) {
            return;
        }
        try {
            Storage::disk('public')->delete($path);
        } catch (\Exception $e) {
            \Log::warning($e->getMessage());
        }
    }

    // Mirrors the frontend's Upcoming/Ongoing/Past classification
    // (EventsView.tsx getEventStatus): an event is "ongoing" once its own
    // event_start has passed and until event_end (falling back to
    // call_time_end, then end-of-day on event_start, for legacy rows
    // missing an end time). The UI already disables Edit/Archive while
    // Ongoing or Past, but that was frontend-only -- nothing stopped the
    // same request being sent directly to the API, so this enforces it
    // server-side too.
    private function isEventOngoing(Event $event): bool
    {
        $now = now();
        $start = $event->event_start;
        if (!$start) {
            return false;
        }

        $end = $event->event_end ?? $event->call_time_end;
        if (!$end) {
            $end = $start->copy()->endOfDay();
        }

        return $now->gte($start) && $now->lte($end);
    }

    /**
     * Compact, human-readable schedule line for outbound announcements
     * (Facebook post body / SMS body). Both channels need the full picture:
     * when sign-in opens (call time) AND when the event itself runs.
     *
     * Wording rule: call time is always labeled "sign-in opens" (or similar),
     * never presented as part of the event's own start/end range -- a
     * resident reading "6 AM - 11:30 AM" would think the event itself runs
     * that long, which is not what call time means.
     *
     * Returns an empty string when there's nothing to show, so callers can
     * safely append it without further checks.
     */
    private function eventScheduleLine(Event $event, string $channel = 'sms'): string
    {
        $start = $event->event_start;
        if (!$start) {
            return '';
        }

        $end       = $event->event_end;
        $callStart = $event->call_time_start;

        // Show the sign-in line only when the call time actually gives
        // residents extra time before the event. If call_time_start is
        // missing or equals/after event_start, skip it.
        $hasCallTime = $callStart && $callStart->lt($start);

        if ($channel === 'facebook') {
            $when = $start->format('F j, Y g:i A');
            if ($end) {
                $when .= ' – ' . $end->format('g:i A');
            }

            $parts = ["📅 {$when}"];

            if ($hasCallTime) {
                $parts[] = "⏰ Sign-in opens at " . $callStart->format('g:i A') .
                    " — please arrive early for check-in";
            }

            if ($event->location) {
                $parts[] = "📍 {$event->location}";
            }

            return implode("\n", $parts);
        }

        // SMS: single line, compact, no year.
        if ($hasCallTime) {
            $datePart = $start->format('M j');
            $line = $datePart
                . ', sign-in ' . $callStart->format('g:i A')
                . ', event ' . $start->format('g:i A')
                . ($end ? '-' . $end->format('g:i A') : '');
        } else {
            $line = $start->format('M j, g:i A');
            if ($end) {
                $line .= '-' . $end->format('g:i A');
            }
        }

        if ($event->location) {
            $line .= ' @ ' . $event->location;
        }

        return $line;
    }

    public function index(Request $request)
    {
        $user = Auth::user();

        if (!$user) {
            return response()->json(['message' => 'Unauthenticated'], 401);
        }

        $perPage = $request->get('per_page', 20);

        // ✅ MODIFIED: Exclude soft-deleted events
        if ($user->role === 'Staff') {
            return response()->json(Event::withoutTrashed()->with('borrowedItems.inventoryItem')->paginate($perPage));
        }

        $residentMembershipIds = DB::table('membership_residents')
            ->where('user_id', $user->id)
            ->pluck('membership_id')
            ->toArray();

        // ✅ MODIFIED: Exclude soft-deleted events
        $events = Event::where(function ($q) use ($residentMembershipIds) {
            $q->whereRaw('JSON_LENGTH(membership_ids) = 0')
              ->orWhereNull('membership_ids');

            foreach ($residentMembershipIds as $mid) {
                $q->orWhereJsonContains('membership_ids', $mid);
            }
        })
        ->withoutTrashed()  // ✅ NEW: Exclude soft-deleted
        ->with('borrowedItems.inventoryItem')
        ->paginate($perPage);

        return response()->json($events);
    }

    // ✅ MODIFIED: Improved data() method with portal mode support & soft delete
    public function data(Request $request)
    {
        $user = Auth::user();

        if (!$user) {
            return response()->json(['message' => 'Unauthenticated'], 401);
        }

        // Check portal mode from request header
        $portalMode = $request->header('X-Portal-Mode', 'auto');

        // Determine effective role based on portal mode
        $effectiveRole = $user->role;
        if ($user->role === 'Staff' && $portalMode === 'member') {
            $effectiveRole = 'Resident';
        }

        // paged=1: the Events screens ask for one page at a time, already filtered
        // (search, membership, date, quick tab, status) and sorted by the database.
        if ($request->boolean('paged')) {
            return $this->pagedEvents($request, $user, $effectiveRole === 'Staff');
        }

        if ($effectiveRole === 'Staff') {
            // Staff portal: show all active events (exclude soft-deleted)
            $events = Event::withoutTrashed()->with('borrowedItems.inventoryItem')->orderByDesc('event_start')->get();
            $this->attachInventoryCounts($events);
        } else {
            // Resident mode: filter by user's memberships (exclude soft-deleted)
            $residentMembershipIds = DB::table('membership_residents')
                ->where('user_id', $user->id)
                ->pluck('membership_id')
                ->toArray();

            $events = Event::where(function ($q) use ($residentMembershipIds) {
                $q->whereRaw('JSON_LENGTH(membership_ids) = 0')
                  ->orWhereNull('membership_ids');

                foreach ($residentMembershipIds as $mid) {
                    $q->orWhereJsonContains('membership_ids', $mid);
                }
            })
            ->withoutTrashed()  // ✅ NEW: Exclude soft-deleted
            ->with('borrowedItems.inventoryItem')
            ->orderByDesc('event_start')
            ->get();
        }

        return response()->json(['data' => $events]);
    }

    /**
     * One page of the Events list for the staff or member screen. Filters:
     * search, membership (id), date (Y-m-d), tab (all | today | week | feedback),
     * status (all | upcoming | ongoing | past); sort: default | soonest | latest | name-az.
     * Returns the page plus the size of every tab and status, so the counts always
     * match what the filters would show.
     */
    private function pagedEvents(Request $request, $user, bool $staff)
    {
        $base = Event::withoutTrashed();

        if (!$staff) {
            // A resident only sees events open to everyone or to one of their memberships.
            $mine = DB::table('membership_residents')->where('user_id', $user->id)->pluck('membership_id')->toArray();
            $base->where(function ($q) use ($mine) {
                $q->whereRaw('JSON_LENGTH(membership_ids) = 0')->orWhereNull('membership_ids');
                foreach ($mine as $mid) {
                    $q->orWhereJsonContains('membership_ids', $mid);
                }
            });
        }

        $visibleTotal = (clone $base)->count(); // everything this person may see, before the filters

        if ($request->filled('membership')) {
            $id = (int) $request->input('membership');
            $base->where(fn ($q) => $q->whereJsonContains('membership_ids', $id)->orWhereJsonContains('membership_ids', (string) $id));
        }
        if ($request->filled('date')) {
            $base->whereDate('event_start', (string) $request->input('date'));
        }
        foreach (Paged::tokens($request->input('search')) as $word) {
            $like = Paged::like($word);
            $base->where(function ($q) use ($like) {
                $q->whereRaw('LOWER(name) LIKE ?', [$like])
                  ->orWhereRaw('LOWER(COALESCE(location, \'\')) LIKE ?', [$like])
                  ->orWhereRaw('LOWER(COALESCE(description, \'\')) LIKE ?', [$like])
                  ->orWhereRaw('DATE(event_start) LIKE ?', [$like])
                  ->orWhereRaw("LOWER(DATE_FORMAT(event_start, '%M %e %Y')) LIKE ?", [$like]);
            });
        }

        $now = now();
        $nowSql = $now->toDateTimeString();
        $endExpr = "COALESCE(event_end, call_time_end, CONCAT(DATE(event_start), ' 23:59:59'))";

        $applyTab = function ($q, string $tab) use ($now, $endExpr) {
            if ($tab === 'feedback') {
                $q->whereRaw('((SELECT COUNT(*) FROM feedback WHERE feedback.event_id = events.id) + (SELECT COUNT(*) FROM absence_reasons WHERE absence_reasons.event_id = events.id)) > 0');
            } elseif ($tab === 'today') {
                $q->where('event_start', '<', $now->copy()->addDay()->startOfDay()->toDateTimeString())
                  ->whereRaw('COALESCE(event_end, event_start) >= ?', [$now->copy()->startOfDay()->toDateTimeString()]);
            } elseif ($tab === 'week') {
                $q->where('event_start', '>=', $now->copy()->startOfWeek()->toDateTimeString())
                  ->where('event_start', '<', $now->copy()->startOfWeek()->addWeek()->toDateTimeString());
            }
        };
        $applyStatus = function ($q, string $status) use ($nowSql, $endExpr, $staff) {
            if (!$staff) {
                // Member screen: upcoming = starts from now on, past = already started.
                if ($status === 'upcoming') {
                    $q->where('event_start', '>=', $nowSql);
                } elseif ($status === 'past') {
                    $q->where('event_start', '<', $nowSql);
                }
                return;
            }
            if ($status === 'upcoming') {
                $q->where('event_start', '>', $nowSql);
            } elseif ($status === 'ongoing') {
                $q->where('event_start', '<=', $nowSql)->whereRaw("{$endExpr} >= ?", [$nowSql]);
            } elseif ($status === 'past') {
                $q->whereRaw("{$endExpr} < ?", [$nowSql]);
            }
        };

        // Budget health (Budget screen): spent vs. approved_budget, from the non-deleted expenses.
        $spentExpr = '(SELECT COALESCE(SUM(event_expenses.amount), 0) FROM event_expenses WHERE event_expenses.event_id = events.id AND event_expenses.deleted_at IS NULL)';
        $applyBudget = function ($q, string $budget) use ($spentExpr) {
            if ($budget === 'over') {
                $q->whereNotNull('approved_budget')->whereRaw("{$spentExpr} > approved_budget");
            } elseif ($budget === 'near') {
                $q->whereNotNull('approved_budget')->where('approved_budget', '>', 0)
                  ->whereRaw("{$spentExpr} <= approved_budget")
                  ->whereRaw("{$spentExpr} * 100 >= approved_budget * 80");
            }
        };

        $tab = (string) $request->input('tab', 'all');
        $status = (string) $request->input('status', 'all');
        $budget = (string) $request->input('budget', 'all');

        $tabCounts = [];
        foreach (['all', 'today', 'week', 'feedback'] as $key) {
            $q = clone $base;
            $applyTab($q, $key);
            $tabCounts[$key] = $q->count();
        }
        $statusCounts = [];
        foreach (['all', 'ongoing', 'upcoming', 'past'] as $key) {
            $q = clone $base;
            $applyTab($q, $tab);
            $applyBudget($q, $budget);
            $applyStatus($q, $key);
            $statusCounts[$key] = $q->count();
        }
        $budgetCounts = [];
        foreach (['all', 'near', 'over'] as $key) {
            $q = clone $base;
            $applyTab($q, $tab);
            $applyStatus($q, $status);
            $applyBudget($q, $key);
            $budgetCounts[$key] = $q->count();
        }

        $query = clone $base;
        $applyTab($query, $tab);
        $applyBudget($query, $budget);
        $applyStatus($query, $status);

        // Staff: Ongoing first, then Upcoming, then Past; the sort picks the order inside each group.
        // Members: simply newest event first.
        if ($staff) {
            $rank = "CASE WHEN event_start > ? THEN 1 WHEN {$endExpr} < ? THEN 2 ELSE 0 END";
            $query->orderByRaw($rank, [$nowSql, $nowSql]);
        }
        switch ($staff ? $request->input('sort') : 'latest') {
            case 'soonest':
                $query->orderBy('event_start');
                break;
            case 'latest':
                $query->orderBy('event_start', 'desc');
                break;
            case 'name-az':
                $query->orderBy('name');
                break;
            case 'spent':
                $query->orderByRaw("{$spentExpr} DESC");
                break;
            case 'used': // share of the approved budget already spent; events without a budget last
                $query->orderByRaw("CASE WHEN approved_budget IS NULL THEN -1 WHEN approved_budget = 0 THEN (CASE WHEN {$spentExpr} > 0 THEN 100 ELSE 0 END) ELSE LEAST(100, {$spentExpr} / approved_budget * 100) END DESC");
                break;
            default: // upcoming soonest first, past most recent first
                $query->orderByRaw("CASE WHEN {$endExpr} < ? THEN -UNIX_TIMESTAMP(event_start) ELSE UNIX_TIMESTAMP(event_start) END", [$nowSql]);
        }
        $query->orderBy('id', 'desc');

        $paginator = $query->with('borrowedItems.inventoryItem')
            ->paginate(Paged::perPage($request, 6), ['*'], 'page', Paged::page($request));
        $events = $paginator->getCollection();
        if ($staff) {
            $this->attachInventoryCounts($events);
            // What each card on the Budget screen shows: money spent so far.
            $spent = DB::table('event_expenses')->whereIn('event_id', $events->pluck('id'))->whereNull('deleted_at')
                ->select('event_id', DB::raw('SUM(amount) as s'))->groupBy('event_id')->pluck('s', 'event_id');
            foreach ($events as $event) {
                $event->setAttribute('budget_spent', round((float) ($spent[$event->id] ?? 0), 2));
            }
        }

        return response()->json(Paged::body($paginator, $events->values(), [
            'counts' => ['tabs' => $tabCounts, 'status' => $statusCounts, 'budget' => $budgetCounts],
            'all_total' => $visibleTotal,
        ]));
    }

    /**
     * Gives each event `inventory_items_count` -- how many different items it
     * took from Inventory (still out or already returned) -- in one query, so
     * the event page's Inventory tab can show its count right away.
     */
    private function attachInventoryCounts($events): void
    {
        $ids = $events->pluck('id')->all();
        if (!$ids) {
            return;
        }

        $borrowed = DB::table('event_inventory_items')->whereIn('event_id', $ids)->select('event_id', 'inventory_item_id');
        $returned = DB::table('event_inventory_releases')->whereIn('event_id', $ids)->whereNull('undone_at')->select('event_id', 'inventory_item_id');

        $counts = DB::query()->fromSub($borrowed->union($returned), 'u')
            ->select('event_id', DB::raw('COUNT(DISTINCT inventory_item_id) as c'))
            ->groupBy('event_id')
            ->pluck('c', 'event_id');

        $attendances = DB::table('attendances')->whereIn('event_id', $ids)
            ->select('event_id', DB::raw('COUNT(*) as c'))
            ->groupBy('event_id')
            ->pluck('c', 'event_id');

        // Feedback + non-attendance reasons per event, so the staff Events list
        // can offer a "Has feedback" quick tab without loading every event.
        $feedbackCounts = DB::table('feedback')->whereIn('event_id', $ids)
            ->select('event_id', DB::raw('COUNT(*) as c'))->groupBy('event_id')->pluck('c', 'event_id');
        $absenceCounts = DB::table('absence_reasons')->whereIn('event_id', $ids)
            ->select('event_id', DB::raw('COUNT(*) as c'))->groupBy('event_id')->pluck('c', 'event_id');

        foreach ($events as $event) {
            $event->setAttribute('feedback_count', (int) ($feedbackCounts[$event->id] ?? 0) + (int) ($absenceCounts[$event->id] ?? 0));
            $event->setAttribute('inventory_items_count', (int) ($counts[$event->id] ?? 0));
            // Known up front so the Attendance tab's count doesn't start at 0.
            $event->setAttribute('attendances_count', (int) ($attendances[$event->id] ?? 0));
        }
    }

    public function list()
    {
        // ✅ MODIFIED: Exclude soft-deleted events
        return response()->json(Event::withoutTrashed()->with('borrowedItems.inventoryItem')->get());
