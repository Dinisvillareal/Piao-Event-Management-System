<file path="tests/Feature/ItemOnLoanLockTest.php">
<?php

namespace Tests\Feature;

use Illuminate\Database\QueryException;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Facades\DB;
use Tests\Support;
use Tests\TestCase;

/**
 * An item that is out on loan cannot be archived or permanently deleted
 * (migration 2026_11_19_000012), whatever route tries it.
 */
class ItemOnLoanLockTest extends TestCase
{
    use RefreshDatabase, Support;

    private int $n = 0;

    private function migration(): object
    {
        return require database_path('migrations/2026_11_19_000012_lock_items_on_loan_against_archive_and_delete.php');
    }

    private function refused(callable $write, string $why): void
    {
        try {
            $write();
        } catch (QueryException $e) {
            $this->assertStringContainsString($why, $e->getMessage(), 'refused, but not by the expected rule');

            return;
        }
        $this->fail("The database accepted a bad value ({$why})");
    }

    private function event(): int
    {
        return DB::table('events')->insertGetId([
            'name' => 'Fiesta ' . ++$this->n, 'description' => 'x', 'location' => 'Hall ' . $this->n,
            'event_start' => now()->subDays(2)->toDateTimeString(), 'event_end' => now()->subDay()->toDateTimeString(),
        ]);
    }

    private function item(int $stock = 10): int
    {
        return DB::table('inventory_items')->insertGetId(['name' => 'Chairs ' . ++$this->n, 'quantity' => $stock, 'good_quantity' => $stock]);
    }

    private function archive(int $item, ?string $by = 'PR-0001'): void
    {
        DB::table('inventory_items')->where('id', $item)->update(['deleted_at' => now(), 'deleted_by' => $by]);
    }

    public function test_an_item_on_loan_cannot_be_archived(): void
    {
        $event = $this->event();
        $item = $this->item();
        $this->loanRow($event, $item, 3);

        $this->refused(fn () => $this->archive($item), 'An item that is on loan cannot be archived');
        $this->assertNull(DB::table('inventory_items')->where('id', $item)->value('deleted_at'));
    }

    public function test_an_item_with_no_loan_can_be_archived_and_restored(): void
    {
        $item = $this->item();
        $this->archive($item);
        $this->assertNotNull(DB::table('inventory_items')->where('id', $item)->value('deleted_at'));

        DB::table('inventory_items')->where('id', $item)->update(['deleted_at' => null]);   // restoring is always fine
        $this->assertNull(DB::table('inventory_items')->where('id', $item)->value('deleted_at'));
    }

    public function test_an_item_can_be_archived_once_its_loan_is_closed(): void
    {
        $event = $this->event();
        $item = $this->item();
        $this->loanRow($event, $item, 2);
        $this->refused(fn () => $this->archive($item), 'An item that is on loan cannot be archived');

        DB::table('event_inventory_items')->where('inventory_item_id', $item)->delete();
        $this->archive($item);
        $this->assertNotNull(DB::table('inventory_items')->where('id', $item)->value('deleted_at'));
    }

    public function test_another_items_loan_does_not_matter(): void
    {
        $event = $this->event();
        $this->loanRow($event, $this->item(), 2);
        $free = $this->item();

        $this->archive($free);
        $this->assertNotNull(DB::table('inventory_items')->where('id', $free)->value('deleted_at'));
    }

    public function test_the_archive_button_still_answers_with_a_message_and_the_item_stays(): void
    {
        $staff = $this->staff();
        $event = $this->event();
        $item = $this->item();
        $this->loanRow($event, $item, 2);

        $this->actingAs($staff)->deleteJson("/inventory/{$item}")->assertStatus(409);   // the app says no first, in its own words
        $this->assertNull(DB::table('inventory_items')->where('id', $item)->value('deleted_at'));

        DB::table('event_inventory_items')->delete();
        $this->actingAs($staff)->deleteJson("/inventory/{$item}")->assertOk();
        $this->assertNotNull(DB::table('inventory_items')->where('id', $item)->value('deleted_at'));
    }

    public function test_an_item_on_loan_or_with_a_return_history_cannot_be_permanently_deleted(): void
    {
        $event = $this->event();
        $onLoan = $this->item();
        $this->loanRow($event, $onLoan, 2);
        $returned = $this->item();
        DB::table('event_inventory_releases')->insert(['event_id' => $event, 'inventory_item_id' => $returned, 'quantity' => 0]);
        $plain = $this->item();

        $this->refused(fn () => DB::table('inventory_items')->where('id', $onLoan)->delete(), 'cannot be deleted');
        $this->refused(fn () => DB::table('inventory_items')->where('id', $returned)->delete(), 'cannot be deleted');
        $this->assertSame(1, DB::table('event_inventory_items')->count());     // the loan was not cascaded away
        $this->assertSame(1, DB::table('event_inventory_releases')->count());  // neither was the history

        DB::table('inventory_items')->where('id', $plain)->delete();           // an unused item is fine
        $this->assertSame(0, DB::table('inventory_items')->where('id', $plain)->count());
    }

    public function test_an_old_archived_item_still_on_loan_can_be_restored_and_edited(): void
    {
        $m = $this->migration();
        $m->down();
        $event = $this->event();
        $item = $this->item();
        $this->loanRow($event, $item, 2);
        $this->archive($item);                         // archived while on loan, before the rule
        $m->up();                                      // the migration runs fine over it

        DB::table('inventory_items')->where('id', $item)->update(['notes' => 'edited']);         // an unrelated edit is not blocked
        DB::table('inventory_items')->where('id', $item)->update(['deleted_at' => null]);        // restoring is fine
        $this->assertNull(DB::table('inventory_items')->where('id', $item)->value('deleted_at'));
    }

    public function test_the_migration_can_be_rolled_back_and_run_again(): void
    {
        $m = $this->migration();
        $m->up();   // twice in a row is safe
        $m->down();

        $event = $this->event();
        $item = $this->item();
        $this->loanRow($event, $item, 2);
        $this->archive($item);                         // allowed while unlocked
        DB::table('inventory_items')->where('id', $item)->update(['deleted_at' => null, 'deleted_by' => null]);
        $m->up();

        $this->refused(fn () => $this->archive($item), 'An item that is on loan cannot be archived');
    }
}
</file>

<file path="tests/Feature/MembershipAgeBracketTest.php">
<?php

namespace Tests\Feature;

use App\Models\AgeBracket;
use App\Models\Membership;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Facades\Cache;
use Tests\Support;
use Tests\TestCase;

/** A membership can be open to several age brackets; none picked = any age. */
class MembershipAgeBracketTest extends TestCase
{
    use RefreshDatabase, Support;

    protected function setUp(): void
    {
        parent::setUp();
        Cache::flush();
        AgeBracket::forgetCache();
    }

    private function bracket(string $label): AgeBracket
    {
        return AgeBracket::where('label', $label)->firstOrFail();
    }

    private function resident(int $age): \App\Models\User
    {
        return $this->makeUser('Resident', ['birth_date' => now()->subYears($age)->subDays(3)->toDateString()]);
    }

    public function test_staff_can_create_a_program_for_two_brackets_and_it_is_returned(): void
    {
        $s = $this->staff();
        $youth = $this->bracket('Youth');
        $adult = $this->bracket('Adult');

        $res = $this->actingAs($s)->postJson('/api/memberships', [
            'name' => 'Livelihood',
            'eligible_age_bracket_ids' => [$youth->id, $adult->id],
        ])->assertStatus(201);

        $this->assertEqualsCanonicalizing([$youth->id, $adult->id], Membership::find($res->json('id'))->eligibleAgeBracketIds());

        $list = $this->actingAs($s)->getJson('/api/memberships')->assertOk()->json();
        $this->assertCount(2, $list[0]['eligible_age_brackets']);
    }

    public function test_nothing_picked_means_any_age_and_update_replaces_the_set(): void
    {
        $s = $this->staff();
        $m = Membership::create(['name' => 'Open', 'description' => 'x']);
        $this->assertSame([], $m->eligibleAgeBracketIds());

        $this->actingAs($s)->putJson("/api/memberships/{$m->id}", [
            'name' => 'Open', 'eligible_age_bracket_ids' => [$this->bracket('Senior Citizen')->id],
        ])->assertOk();
        $this->assertCount(1, $m->fresh()->eligibleAgeBracketIds());

        $this->actingAs($s)->putJson("/api/memberships/{$m->id}", ['name' => 'Open', 'eligible_age_bracket_ids' => []])->assertOk();
        $this->assertSame([], $m->fresh()->eligibleAgeBracketIds());
    }

    public function test_invalid_bracket_id_is_rejected(): void
    {
        $this->actingAs($this->staff())->postJson('/api/memberships', [
            'name' => 'Bad', 'eligible_age_bracket_ids' => [999999],
        ])->assertStatus(422);
    }

    public function test_assigning_a_resident_checks_against_any_selected_bracket(): void
    {
        $s = $this->staff();
        $m = Membership::create(['name' => 'Youth & Adult', 'description' => 'x']);
        $m->eligibleAgeBrackets()->sync([$this->bracket('Youth')->id, $this->bracket('Adult')->id]);

        $ok = $this->resident(25);
        $this->actingAs($s)->putJson("/users/{$ok->id}", [
            'first_name' => $ok->first_name, 'last_name' => $ok->last_name,
            'membership_ids' => [$m->id],
        ]);
        // a senior must be refused with a message naming both allowed groups
        $senior = $this->resident(70);
        $res = $this->actingAs($s)->putJson("/users/{$senior->id}", [
            'first_name' => $senior->first_name, 'last_name' => $senior->last_name,
            'membership_ids' => [$m->id],
        ]);
        $this->assertContains($res->getStatusCode(), [403, 422]);
        $this->assertStringContainsString('Youth or Adult', $res->getContent());
    }

    public function test_preview_counts_residents_in_any_selected_bracket(): void
    {
        $s = $this->staff();
        $this->resident(15); $this->resident(30); $this->resident(70);

        $res = $this->actingAs($s)->postJson('/memberships/eligibility-preview', [
            'eligible_age_bracket_ids' => [$this->bracket('Youth')->id, $this->bracket('Adult')->id],
        ])->assertOk();
        $this->assertSame(2, $res->json('qualify'));

        $all = $this->actingAs($s)->postJson('/memberships/eligibility-preview', [])->assertOk();
        $this->assertSame(3, $all->json('qualify'));
    }

    public function test_preview_is_staff_only(): void
    {
        $this->actingAs($this->makeUser('Resident'))->postJson('/memberships/eligibility-preview', [])->assertStatus(403);
    }

    public function test_ineligible_members_uses_the_whole_set(): void
    {
        $s = $this->staff();
        $m = Membership::create(['name' => 'Youth & Adult', 'description' => 'x']);
        $m->eligibleAgeBrackets()->sync([$this->bracket('Youth')->id, $this->bracket('Adult')->id]);
        $adult = $this->resident(30); $senior = $this->resident(70);
        $m->users()->attach([$adult->id, $senior->id]);

        $res = $this->actingAs($s)->getJson("/memberships/{$m->id}/ineligible-members")->assertOk();
        $this->assertCount(1, $res->json('ineligible'));
    }

    public function test_existing_single_values_survive_the_migration_shape(): void
    {
        $m = Membership::create(['name' => 'Seniors', 'description' => 'x']);
        $m->eligibleAgeBrackets()->sync([$this->bracket('Senior Citizen')->id]);
        $this->assertTrue($this->bracket('Senior Citizen')->memberships()->exists());
        $this->assertFalse($this->bracket('Child')->memberships()->exists());
    }
}
