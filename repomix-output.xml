<file path="resources/js/lib/systemQrPoster.ts">
// Draws the printable "Scan to join" poster for the barangay system QR code:
// A4 portrait at 300 dpi (2480 x 3508 px), so it prints sharp on A4 and can
// be scaled up to A3. Everything is drawn with canvas vector calls (no
// external artwork), the barangay seal is the only image besides the QR.

const W = 2480;
const H = 3508;
const NAVY = "#071B33";
const NAVY_2 = "#0D2747";
const GOLD = "#E8B84A";
const TEAL = "#0E7C7B";
const MINT = "#4FBEB0";
const INK = "#0F2A4A";
const SKIN = "#F1C9A5";
const SKIN_SHADE = "#DDA97F";
const FONT = '"Segoe UI", "Helvetica Neue", Arial, sans-serif';

type Ctx = CanvasRenderingContext2D;

function rr(ctx: Ctx, x: number, y: number, w: number, h: number, r: number) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r);
  ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r);
  ctx.arcTo(x, y, x + w, y, r);
  ctx.closePath();
}

const spaced = (ctx: Ctx, px: number) => {
  const c = ctx as unknown as { letterSpacing?: string };
  if ("letterSpacing" in c) c.letterSpacing = `${px}px`;
};

function loadImage(src: string): Promise<HTMLImageElement | null> {
  return new Promise((resolve) => {
    const img = new Image();
    img.onload = () => resolve(img);
    img.onerror = () => resolve(null);
    img.src = src;
  });
}

// Four gold corner brackets around a box: the "scan target" look.
function brackets(ctx: Ctx, x: number, y: number, w: number, h: number, len: number, lw: number, color: string) {
  ctx.save();
  ctx.strokeStyle = color;
  ctx.lineWidth = lw;
  ctx.lineCap = "round";
  ctx.lineJoin = "round";
  const pts: [number, number, number, number][] = [
    [x, y, 1, 1], [x + w, y, -1, 1], [x, y + h, 1, -1], [x + w, y + h, -1, -1],
  ];
  for (const [cx, cy, sx, sy] of pts) {
    ctx.beginPath();
    ctx.moveTo(cx, cy + sy * len);
    ctx.lineTo(cx, cy);
    ctx.lineTo(cx + sx * len, cy);
    ctx.stroke();
  }
  ctx.restore();
}

function capsule(ctx: Ctx, x: number, y: number, w: number, h: number) {
  rr(ctx, x, y, w, h, Math.min(w, h) / 2);
}

// A phone held in a hand (flat illustration), drawn around its own origin
// (0,0 = centre of the phone) and then rotated/placed by the caller.
function drawHandAndPhone(ctx: Ctx) {
  const PW = 620;
  const PH = 1240;
  const px = -PW / 2;
  const py = -PH / 2;

  // forearm / sleeve (behind everything), running off the bottom
  ctx.save();
  const sleeve = ctx.createLinearGradient(0, py + PH - 120, 0, py + PH + 270);
  sleeve.addColorStop(0, TEAL);
  sleeve.addColorStop(0.6, "rgba(14,124,123,0.9)");
  sleeve.addColorStop(1, "rgba(14,124,123,0)");
  ctx.fillStyle = sleeve;
  ctx.beginPath();
  ctx.moveTo(px + 90, py + PH - 120);
  ctx.lineTo(px + PW - 60, py + PH - 120);
  ctx.lineTo(px + PW + 50, py + PH + 270);
  ctx.lineTo(px + 10, py + PH + 270);
  ctx.closePath();
  ctx.fill();
  ctx.fillStyle = "rgba(255,255,255,0.16)";
  ctx.beginPath();
  ctx.moveTo(px + 60, py + PH + 40);
  ctx.lineTo(px + PW - 10, py + PH + 40);
  ctx.lineTo(px + PW - 2, py + PH + 78);
  ctx.lineTo(px + 72, py + PH + 78);
  ctx.closePath();
  ctx.fill();
  ctx.restore();

  // wrist + palm (behind the phone)
  ctx.fillStyle = SKIN;
  rr(ctx, px + 70, py + PH - 520, PW - 120, 470, 140);
  ctx.fill();
  ctx.fillStyle = SKIN_SHADE;
  rr(ctx, px + 120, py + PH - 130, PW - 220, 90, 40);
  ctx.fill();

  // phone body
  ctx.save();
  ctx.shadowColor = "rgba(7,27,51,0.35)";
  ctx.shadowBlur = 60;
  ctx.shadowOffsetY = 30;
  ctx.fillStyle = NAVY;
  rr(ctx, px, py, PW, PH, 96);
  ctx.fill();
  ctx.restore();
  ctx.strokeStyle = "#1B3B63";
  ctx.lineWidth = 6;
  rr(ctx, px + 3, py + 3, PW - 6, PH - 6, 94);
  ctx.stroke();

  // screen
  const sx = px + 30;
  const sy = py + 30;
  const sw = PW - 60;
  const sh = PH - 60;
  ctx.save();
  rr(ctx, sx, sy, sw, sh, 70);
  ctx.clip();
  const sg = ctx.createLinearGradient(0, sy, 0, sy + sh);
  sg.addColorStop(0, "#EAF6F3");
  sg.addColorStop(1, "#FFFFFF");
  ctx.fillStyle = sg;
  ctx.fillRect(sx, sy, sw, sh);

  // top app bar
  ctx.fillStyle = NAVY_2;
  ctx.fillRect(sx, sy, sw, 190);
  ctx.fillStyle = GOLD;
  ctx.fillRect(sx, sy + 190, sw, 8);
  ctx.fillStyle = "rgba(255,255,255,0.9)";
  capsule(ctx, sx + sw / 2 - 70, sy + 26, 140, 30); // speaker slot
  ctx.fill();
  ctx.fillStyle = GOLD;
  ctx.font = `800 44px ${FONT}`;
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  spaced(ctx, 3);
  ctx.fillText("PIAO CONNECT", sx + sw / 2, sy + 120);
  spaced(ctx, 0);

  // mini viewfinder with a QR-like pattern and a scan line
  const vx = sx + 80;
  const vy = sy + 320;
  const vs = sw - 160;
  ctx.fillStyle = "#FFFFFF";
  rr(ctx, vx, vy, vs, vs, 30);
  ctx.fill();
  ctx.fillStyle = INK;
  const cell = vs / 15;
  const rnd = (i: number) => { const v = Math.sin(i * 12.9898) * 43758.5453; return v - Math.floor(v); };
  for (let r = 0; r < 15; r++) {
    for (let c = 0; c < 15; c++) {
      const inFinder = (r < 5 && c < 5) || (r < 5 && c > 9) || (r > 9 && c < 5);
      if (inFinder) continue;
      if (rnd(r * 15 + c + 3) > 0.52) ctx.fillRect(vx + c * cell + 2, vy + r * cell + 2, cell - 4, cell - 4);
    }
  }
  const finder = (fx: number, fy: number) => {
    ctx.fillStyle = INK;
    ctx.fillRect(fx, fy, cell * 4.6, cell * 4.6);
    ctx.fillStyle = "#FFFFFF";
    ctx.fillRect(fx + cell * 0.7, fy + cell * 0.7, cell * 3.2, cell * 3.2);
    ctx.fillStyle = INK;
    ctx.fillRect(fx + cell * 1.4, fy + cell * 1.4, cell * 1.8, cell * 1.8);
  };
  finder(vx + cell * 0.2, vy + cell * 0.2);
  finder(vx + cell * 10.2, vy + cell * 0.2);
  finder(vx + cell * 0.2, vy + cell * 10.2);
  // scan line
  const lg = ctx.createLinearGradient(vx, 0, vx + vs, 0);
  lg.addColorStop(0, "rgba(79,190,176,0)");
  lg.addColorStop(0.5, "rgba(14,124,123,0.95)");
  lg.addColorStop(1, "rgba(79,190,176,0)");
  ctx.fillStyle = lg;
  ctx.fillRect(vx - 10, vy + vs * 0.52, vs + 20, 14);
  brackets(ctx, vx - 24, vy - 24, vs + 48, vs + 48, 90, 16, GOLD);

  // status line above the viewfinder
  ctx.fillStyle = TEAL;
  ctx.font = `800 50px ${FONT}`;
  ctx.fillText("Scanning…", sx + sw / 2, sy + 268);
  ctx.restore();

  // fingers wrapping around the right edge (in front of the phone)
  const fingerH = 128;
  for (let i = 0; i < 4; i++) {
    const fy = py + PH - 700 + i * (fingerH + 14);
    const len = 190 - i * 14;
    ctx.fillStyle = SKIN;
    capsule(ctx, px + PW - 90, fy, len, fingerH);
    ctx.fill();
    ctx.strokeStyle = SKIN_SHADE;
    ctx.lineWidth = 7;
    capsule(ctx, px + PW - 90, fy, len, fingerH);
    ctx.stroke();
  }

  // thumb on the left, resting over the lower screen edge
  ctx.save();
  ctx.translate(px + 40, py + PH - 330);
  ctx.rotate(-0.55);
  ctx.fillStyle = SKIN;
  capsule(ctx, -80, -70, 360, 150);
  ctx.fill();
  ctx.strokeStyle = SKIN_SHADE;
  ctx.lineWidth = 7;
  capsule(ctx, -80, -70, 360, 150);
  ctx.stroke();
  ctx.fillStyle = "rgba(255,255,255,0.45)";
  capsule(ctx, 190, -42, 72, 92); // thumbnail
  ctx.fill();
  ctx.restore();
}

function wrapText(ctx: Ctx, text: string, maxW: number): string[] {
  const words = text.split(" ");
  const lines: string[] = [];
  let line = "";
  for (const w of words) {
    const test = line ? `${line} ${w}` : w;
    if (ctx.measureText(test).width > maxW && line) { lines.push(line); line = w; } else { line = test; }
  }
  if (line) lines.push(line);
  return lines;
}

export interface PosterOptions {
  /** The QR code, as an image/canvas already drawn at a large size. */
  qr: CanvasImageSource;
  /** Shown small under the QR, e.g. the portal address. */
  url?: string;
  /** Overridable copy (kept in English on the printed poster). */
  logoSrc?: string;
}

export async function renderSystemQrPoster({ qr, url, logoSrc = "/logo-removebg-preview.png" }: PosterOptions): Promise<HTMLCanvasElement> {
  const canvas = document.createElement("canvas");
  canvas.width = W;
  canvas.height = H;
  const ctx = canvas.getContext("2d");
  if (!ctx) throw new Error("Canvas is not available");
  const logo = await loadImage(logoSrc);

  ctx.imageSmoothingEnabled = true;
  ctx.imageSmoothingQuality = "high";

  // ---- paper ----
  ctx.fillStyle = "#F6FAF8";
  ctx.fillRect(0, 0, W, H);
  // soft decorative circles
  ctx.save();
  ctx.fillStyle = "rgba(79,190,176,0.10)";
  ctx.beginPath(); ctx.arc(W - 120, 1500, 520, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = "rgba(232,184,74,0.12)";
  ctx.beginPath(); ctx.arc(160, 2750, 460, 0, Math.PI * 2); ctx.fill();
  ctx.restore();
  if (logo) {
    ctx.globalAlpha = 0.045;
    ctx.drawImage(logo, W / 2 - 800, 1500, 1600, 1600);
    ctx.globalAlpha = 1;
  }

  // ---- header band ----
  const hg = ctx.createLinearGradient(0, 0, W, 0);
  hg.addColorStop(0, NAVY);
  hg.addColorStop(1, NAVY_2);
  ctx.fillStyle = hg;
  ctx.fillRect(0, 0, W, 540);
  ctx.fillStyle = GOLD;
  ctx.fillRect(0, 540, W, 20);

  const sealX = 330;
  const sealY = 270;
  ctx.fillStyle = "#FFFFFF";
  ctx.beginPath(); ctx.arc(sealX, sealY, 190, 0, Math.PI * 2); ctx.fill();
  ctx.strokeStyle = GOLD; ctx.lineWidth = 12; ctx.stroke();
  if (logo) ctx.drawImage(logo, sealX - 160, sealY - 160, 320, 320);

  ctx.textAlign = "left";
  ctx.textBaseline = "alphabetic";
  const tx = 600;
  ctx.fillStyle = "rgba(255,255,255,0.9)";
  ctx.font = `600 50px ${FONT}`;
  spaced(ctx, 6);
  ctx.fillText("REPUBLIC OF THE PHILIPPINES", tx, 150);
  spaced(ctx, 1);
  ctx.font = `500 54px ${FONT}`;
  ctx.fillText("Province of Zamboanga del Norte", tx, 225);
  ctx.fillText("Municipality of President Manuel A. Roxas", tx, 300);
  ctx.fillStyle = GOLD;
  ctx.font = `900 170px ${FONT}`;
  spaced(ctx, 8);
  ctx.fillText("BARANGAY PIAO", tx, 470);
  spaced(ctx, 0);

  // ---- headline ----
  ctx.textAlign = "center";
  ctx.fillStyle = INK;
  ctx.font = `900 290px ${FONT}`;
  spaced(ctx, 6);
  ctx.fillText("SCAN TO JOIN", W / 2, 900);
  spaced(ctx, 4);
  ctx.fillStyle = TEAL;
  ctx.font = `800 120px ${FONT}`;
  ctx.fillText("BARANGAY e-MEMBERSHIP", W / 2, 1060);
  spaced(ctx, 0);
  ctx.fillStyle = "#4B5B70";
  ctx.font = `500 66px ${FONT}`;
  ctx.fillText("Open your phone camera, point it at the code, and get started.", W / 2, 1170);

  // ---- QR card (left) ----
  const cardX = 230;
  const cardY = 1330;
  const cardS = 1150;
  ctx.save();
  ctx.shadowColor = "rgba(15,42,74,0.28)";
  ctx.shadowBlur = 90;
  ctx.shadowOffsetY = 34;
  ctx.fillStyle = "#FFFFFF";
  rr(ctx, cardX, cardY, cardS, cardS, 90);
  ctx.fill();
  ctx.restore();
  ctx.strokeStyle = NAVY;
  ctx.lineWidth = 14;
  rr(ctx, cardX, cardY, cardS, cardS, 90);
  ctx.stroke();

  const qrS = 940;
  const qrX = cardX + (cardS - qrS) / 2;
  const qrY = cardY + (cardS - qrS) / 2;
  ctx.fillStyle = "#FFFFFF";
  ctx.fillRect(qrX - 10, qrY - 10, qrS + 20, qrS + 20);
  ctx.imageSmoothingEnabled = false; // keep the QR modules razor sharp
  ctx.drawImage(qr, qrX, qrY, qrS, qrS);
  ctx.imageSmoothingEnabled = true;
  brackets(ctx, cardX - 55, cardY - 55, cardS + 110, cardS + 110, 190, 30, GOLD);

  // caption under the QR card
  ctx.fillStyle = INK;
  ctx.font = `800 78px ${FONT}`;
  ctx.textAlign = "center";
  ctx.fillText("Aim your camera here", cardX + cardS / 2, cardY + cardS + 190);
  if (url) {
    ctx.fillStyle = "#5B6778";
    ctx.font = `500 52px ${FONT}`;
    let shown = url.replace(/^https?:\/\//, "");
    while (ctx.measureText(shown).width > cardS + 40 && shown.length > 8) shown = shown.slice(0, -2);
    ctx.fillText(shown, cardX + cardS / 2, cardY + cardS + 275);
  }

  // ---- hand + phone (right) ----
  ctx.save();
  ctx.translate(1830, 1900);
  ctx.rotate(0.12);
  drawHandAndPhone(ctx);
  ctx.restore();
  // dotted beam from the phone towards the QR card
  ctx.save();
  ctx.strokeStyle = MINT;
  ctx.lineWidth = 16;
  ctx.setLineDash([2, 34]);
  ctx.lineCap = "round";
  ctx.beginPath();
  ctx.moveTo(1500, 1700);
  ctx.quadraticCurveTo(1440, 1560, 1395, 1500);
  ctx.stroke();
  ctx.restore();

  // ---- how it works ----
  const stepsY = 2910;
  ctx.fillStyle = INK;
  ctx.textAlign = "center";
  ctx.font = `800 70px ${FONT}`;
  spaced(ctx, 8);
  ctx.fillText("HOW IT WORKS", W / 2, stepsY);
  spaced(ctx, 0);
  const steps = [
    ["1", "Scan the code", "Use your phone camera. No app to install."],
    ["2", "Sign in", "Use the user code from the Barangay Hall."],
    ["3", "Join events", "See events, show your member QR, give feedback."],
  ];
  const colW = (W - 460) / 3;
  steps.forEach(([n, title, text], i) => {
    const cx = 230 + colW * i + colW / 2;
    const cy = stepsY + 130;
    ctx.fillStyle = i === 1 ? GOLD : TEAL;
    ctx.beginPath(); ctx.arc(cx - colW / 2 + 90, cy, 62, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = i === 1 ? NAVY : "#FFFFFF";
    ctx.font = `900 74px ${FONT}`;
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(n, cx - colW / 2 + 90, cy + 4);
    ctx.textBaseline = "alphabetic";
    ctx.textAlign = "left";
    ctx.fillStyle = INK;
    ctx.font = `800 62px ${FONT}`;
    ctx.fillText(title, cx - colW / 2 + 190, cy - 6);
    ctx.fillStyle = "#4B5B70";
    ctx.font = `500 44px ${FONT}`;
    wrapText(ctx, text, colW - 220).forEach((l, k) => ctx.fillText(l, cx - colW / 2 + 190, cy + 56 + k * 56));
  });

  // ---- footer ----
  const fy = H - 190;
  ctx.fillStyle = hg;
  ctx.fillRect(0, fy, W, 190);
  ctx.fillStyle = GOLD;
  ctx.fillRect(0, fy - 14, W, 14);
  ctx.textBaseline = "middle";
  ctx.textAlign = "left";
  ctx.fillStyle = "#7DD8CB";
  ctx.font = `900 64px ${FONT}`;
  spaced(ctx, 8);
  ctx.fillText("PIAO CONNECT", 230, fy + 95);
  spaced(ctx, 0);
  ctx.textAlign = "right";
  ctx.fillStyle = "rgba(255,255,255,0.85)";
  ctx.font = `500 50px ${FONT}`;
  ctx.fillText("Need help? Visit the Barangay Hall", W - 230, fy + 95);
  ctx.textAlign = "left";
  ctx.textBaseline = "alphabetic";

  return canvas;
}
</file>

<file path="resources/js/lib/tableExport.ts">
import type { Worksheet } from "exceljs";
import { fetchBarangayOfficials } from "./barangayOfficials";

/**
 * The one styled `.xlsx` table every list export uses (Residents Master List, Activity Log Report, ...) --
 * same letterhead, palette, optional "I. MESSAGE" and signature block as the expense report export.
 * The caller picks which columns to include; rows are plain display strings, one entry per column in the
 * same order, so the Excel file, the PDF and the on-screen list always agree.
 */

export interface TableExportColumn {
  key: string;
  /** Header printed in the exported file (exports are always English). */
  label: string;
  /** Excel column width (characters). */
  width: number;
  centered?: boolean;
}

export interface TableExportOptions {
  rows: string[][];
  columns: TableExportColumn[];
  /** Big navy title band, e.g. "RESIDENTS MASTER LIST". */
  title: string;
  /** Sheet tab name. */
  sheetName: string;
  /** Downloaded file name. */
  fileName: string;
  /** The filters line under the title. */
  filterLabel: string;
  message?: string[];
  /** Heading of the table when a message is shown, e.g. "RESIDENTS LIST". */
  sectionTitle: string;
  /** Row shown when there is nothing to list. */
  emptyText: string;
  /** Closing line, e.g. "Total: 12 residents". */
  totalText: string;
  /** Column printed in bold (the person's name). */
  boldKey?: string;
  /** Columns written as numbers when the text is numeric. */
  numberKeys?: string[];
  /** Last chance to reshape a displayed value (e.g. one membership per line). */
  displayValue?: (key: string, value: string) => string;
}

/** Fewest columns an export may have (the letterhead needs room for the seal + address block). */
export const MIN_EXPORT_COLUMNS = 3;

const argb = (hex: string) => "FF" + hex.replace("#", "").toUpperCase();
const NAVY = argb("#0A0E1A");
const WHITE = argb("#FFFFFF");
const GOLD_TEXT = argb("#EFCA85");
const TEAL = argb("#005F63");
const TEAL_LIGHT = argb("#4FBEB0");
const SAGE_TINT = argb("#EEF4F1");
const BORDER = argb("#DCEAE5");
const MUTED = argb("#667777");
const FAINT = argb("#999999");
const FONT = "Calibri";
const thin = (color: string) => ({ style: "thin" as const, color: { argb: color } });

function band(ws: Worksheet, row: number, c1: number, c2: number, value: string | number | null, style: Record<string, any>) {
  if (c2 > c1) ws.mergeCells(row, c1, row, c2);
  for (let c = c1; c <= c2; c++) {
    const cell = ws.getCell(row, c);
    if (c === c1 && value !== null) cell.value = value;
    Object.assign(cell, { style: { ...cell.style, ...style } });
  }
}

async function loadSeal(): Promise<ArrayBuffer | null> {
  try {
    const res = await fetch("/logo-removebg-preview.png");
    return res.ok ? await res.arrayBuffer() : null;
  } catch {
    return null;
  }
}

/**
 * rows: one array per entry, one string per entry of `columns` (already in that order);
 * columns: the selected columns, in print order.
 */
export async function exportTableXlsx(options: TableExportOptions): Promise<void> {
  const { rows, columns, filterLabel, message, title, sheetName, fileName, sectionTitle, emptyText, totalText, boldKey, numberKeys = [], displayValue } = options;
  const ExcelJS = (await import("exceljs")).default;
  const officials = await fetchBarangayOfficials();

  const LAST_COL = columns.length;
  // Few columns would make a narrow sheet that can't hold the letterhead -- widen proportionally.
  const rawTotal = columns.reduce((n, c) => n + c.width, 0);
  const scale = rawTotal < 110 ? 110 / rawTotal : 1;
  const widths = columns.map((c) => Math.round(c.width * scale));

  const wb = new ExcelJS.Workbook();
  wb.creator = "Piao Connect";
  wb.created = new Date();
  const ws = wb.addWorksheet(sheetName, { views: [{ showGridLines: false }], properties: { defaultRowHeight: 18 } });
  ws.columns = widths.map((width) => ({ width }));

  // ── Letterhead. The seal sits flush at the left; the address block starts a small,
  //    fixed gap to its right. Text can only begin on a column boundary, so it starts in
  //    the first column that doesn't fit inside the seal's width and an indent (Excel
  //    indent step ~9px) closes the remaining distance -- no wide empty gutter.
  const generatedLong = new Date().toLocaleDateString("en-PH", { year: "numeric", month: "long", day: "numeric" });
  const generatedFull = new Date().toLocaleString();
  const SEAL_H = 96;
  const SEAL_LEFT = 6;
  const TEXT_GAP = 16;
  const INDENT_PX = 9;
  const colPx = widths.map((w) => Math.round(w * 7 + 5));
  const textStartPx = SEAL_LEFT + SEAL_H + TEXT_GAP; // seal is ~square
  let gutterCols = 0;
  let gutterPx = 0;
  while (gutterCols < LAST_COL - 2 && gutterPx + colPx[gutterCols] <= textStartPx) {
    gutterPx += colPx[gutterCols];
    gutterCols++;
  }
  const TEXT_FROM = gutterCols + 1;
  const textIndent = Math.max(1, Math.min(15, Math.round((textStartPx - gutterPx) / INDENT_PX)));
  let RIGHT_FROM = LAST_COL;
  let tail = widths[LAST_COL - 1];
  for (let j = LAST_COL - 2; j >= TEXT_FROM; j--) {
    if (tail + widths[j] > 40) break;
    tail += widths[j];
    RIGHT_FROM = j + 1;
  }
  RIGHT_FROM = Math.max(RIGHT_FROM, TEXT_FROM + 1 <= LAST_COL ? TEXT_FROM + 1 : LAST_COL);
  // A narrow last column can't hold "November 14, 2026" -- take in the column before it too.
  while (tail < 22 && RIGHT_FROM - 1 > TEXT_FROM) {
    RIGHT_FROM--;
    tail += widths[RIGHT_FROM - 1];
  }
  // The address block needs room to the left of that. When the chosen columns are narrow (e.g. No., Action,
  // Module), widen the last of them instead of clipping the letterhead.
  const LEFT_NEEDED = 66;
  const leftEnd = Math.max(TEXT_FROM, RIGHT_FROM - 1);
  const leftWidth = widths.slice(TEXT_FROM - 1, leftEnd).reduce((n, w) => n + w, 0);
  if (leftWidth < LEFT_NEEDED) {
    widths[leftEnd - 1] += LEFT_NEEDED - leftWidth;
    ws.getColumn(leftEnd).width = widths[leftEnd - 1];
  }
  const lh = (row: number, left: string, right: string | null, leftStyle: Record<string, any>, rightStyle: Record<string, any> = {}) => {
    band(ws, row, TEXT_FROM, Math.max(TEXT_FROM, RIGHT_FROM - 1), left, { alignment: { vertical: "middle", horizontal: "left", indent: textIndent }, ...leftStyle });
    band(ws, row, RIGHT_FROM, LAST_COL, right, { alignment: { vertical: "middle", horizontal: "right", indent: 1 }, ...rightStyle });
  };
  const dk = { name: FONT, size: 11, color: { argb: "FF222222" } };
  lh(1, "REPUBLIC OF THE PHILIPPINES", "PIAO CONNECT", { font: { name: FONT, size: 10, bold: true, color: { argb: "FF222222" } } }, { font: { name: FONT, size: 11, bold: true, color: { argb: TEAL_LIGHT } } });
  lh(2, "Province of Zamboanga del Norte, Region IX", "Generated on", { font: dk }, { font: { name: FONT, size: 10, color: { argb: MUTED } } });
  lh(3, "Municipality of President Manuel A. Roxas", generatedLong, { font: dk }, { font: { name: FONT, size: 12, bold: true, color: { argb: TEAL } } });
  lh(4, "BARANGAY PIAO", null, { font: { name: FONT, size: 16, bold: true, color: { argb: "FF000000" } } });
  lh(5, "Purok Uno — Barangay Hall, Piao, Roxas, Zamboanga del Norte, 7102", null, { font: dk });
  [22, 17, 17, 28, 19, 4, 8].forEach((h, i) => (ws.getRow(i + 1).height = h));
  for (let c = 1; c <= LAST_COL; c++) ws.getCell(7, c).border = { bottom: { style: "thick", color: { argb: TEAL } } };
  ws.getRow(8).height = 12;

  // Seal: true aspect ratio (read from the PNG header), flush left and vertically
  // centered against the letterhead block (rows 1-6), with exact pixel offsets.
  const seal = await loadSeal();
  if (seal) {
    const dv = new DataView(seal);
    const natW = dv.getUint32(16) || 1;
    const natH = dv.getUint32(20) || 1;
    const sealW = Math.round((SEAL_H * natW) / natH);
    const PX = 9525; // EMU per pixel
    const blockPx = Math.round(([22, 17, 17, 28, 19, 4].reduce((n, v) => n + v, 0) * 96) / 72);
    const topPx = Math.max(4, Math.round((blockPx - SEAL_H) / 2));
    const imageId = wb.addImage({ buffer: seal, extension: "png" });
    ws.addImage(imageId, {
      tl: { nativeCol: 0, nativeColOff: SEAL_LEFT * PX, nativeRow: 0, nativeRowOff: topPx * PX },
      ext: { width: sealW, height: SEAL_H },
      editAs: "oneCell",
    } as any);
  }

  // ── Title band + filter line
  let r = 9;
  band(ws, r, 1, LAST_COL, title, {
    font: { name: FONT, size: 20, bold: true, color: { argb: GOLD_TEXT } },
    fill: { type: "pattern", pattern: "solid", fgColor: { argb: NAVY } },
    alignment: { vertical: "middle", horizontal: "left", indent: 1 },
  });
  ws.getRow(r).height = 40;
  r++;
  band(ws, r, 1, LAST_COL, filterLabel, {
    font: { name: FONT, size: 12.5, bold: true, color: { argb: NAVY } },
    fill: { type: "pattern", pattern: "solid", fgColor: { argb: SAGE_TINT } },
    alignment: { vertical: "middle", horizontal: "left", indent: 1, wrapText: true },
    border: { bottom: thin(BORDER) },
  });
  ws.getRow(r).height = 30;
  r++;

  // ── Optional opening message ("I. MESSAGE" ... "II. RESIDENTS LIST"), like the other reports.
  const sectionHeading = (text: string, before: number) => {
    ws.getRow(r).height = before;
    band(ws, r, 1, LAST_COL, text, {
      font: { name: FONT, size: 13, bold: true, color: { argb: "FF000000" } },
      alignment: { vertical: "bottom", horizontal: "left", indent: 1 },
    });
    r++;
  };
  if (message && message.length) {
    const totalWidth = widths.reduce((n, w) => n + w, 0);
    sectionHeading("I.   MESSAGE", 30);
    message.forEach((para) => {
      band(ws, r, 1, LAST_COL, "      " + para, {
        font: { name: FONT, size: 12, color: { argb: argb("#1A1A1A") } },
        alignment: { vertical: "top", horizontal: "justify", indent: 1, wrapText: true },
      });
      const lines = Math.max(1, Math.ceil((para.length + 6) / (totalWidth * 0.95)));
      ws.getRow(r).height = lines * 17 + 8;
      r++;
    });
    sectionHeading(`II.   ${sectionTitle}`, 30);
    ws.getRow(r).height = 8;
    r++;
  } else {
    r++;
  }

  // ── Table
  const headerRow = r;
  columns.forEach((col, i) => {
    const cell = ws.getCell(r, i + 1);
    cell.value = col.label;
    cell.font = { name: FONT, size: 12, bold: true, color: { argb: GOLD_TEXT } };
    cell.fill = { type: "pattern", pattern: "solid", fgColor: { argb: NAVY } };
    cell.alignment = { vertical: "middle", horizontal: col.centered ? "center" : "left", indent: col.centered ? 0 : 1 };
    cell.border = { top: thin(NAVY), bottom: thin(NAVY), left: thin(NAVY), right: thin(NAVY) };
  });
  ws.getRow(r).height = 36;
  ws.views = [{ showGridLines: false, state: "frozen", ySplit: headerRow }];
  r++;

  rows.forEach((row, idx) => {
    const fill = { type: "pattern" as const, pattern: "solid" as const, fgColor: { argb: idx % 2 === 0 ? WHITE : SAGE_TINT } };
    const border = { top: thin(BORDER), bottom: thin(BORDER), left: thin(BORDER), right: thin(BORDER) };
    // A caller may reshape a value (e.g. memberships one per line so a long list stays readable); the row grows to fit.
    const display = columns.map((col, i) => {
      const v = row[i] ?? "";
      return displayValue ? displayValue(col.key, v) : v;
    });
    const lineCount = display.reduce((max, v, i) => {
      const chars = Math.max(6, widths[i] - 6);
      const lines = String(v).split("\n").reduce((n, part) => n + Math.max(1, Math.ceil(part.length / chars)), 0);
      return Math.max(max, lines);
    }, 1);
    columns.forEach((col, i) => {
      const cell = ws.getCell(r, i + 1);
      const raw = display[i] ?? "";
      cell.value = numberKeys.includes(col.key) && raw !== "" && !Number.isNaN(Number(raw)) ? Number(raw) : raw;
      Object.assign(cell, {
        style: {
          font: { name: FONT, size: 12, color: { argb: col.key === "no" ? MUTED : argb("#1A1A1A") }, bold: col.key === boldKey },
          fill,
          border,
          alignment: { vertical: "middle", horizontal: col.centered ? "center" : "left", indent: col.centered ? 0 : 1, wrapText: true },
        },
      });
    });
    ws.getRow(r).height = Math.max(36, lineCount * 18 + 16);
    r++;
  });
  if (rows.length === 0) {
    band(ws, r, 1, LAST_COL, emptyText, {
      font: { name: FONT, size: 12, italic: true, color: { argb: FAINT } },
      alignment: { horizontal: "center", vertical: "middle" },
    });
    ws.getRow(r).height = 26;
    r++;
  }

  // Total line
  band(ws, r, 1, LAST_COL, totalText, {
    font: { name: FONT, size: 13, bold: true, color: { argb: NAVY } },
    fill: { type: "pattern", pattern: "solid", fgColor: { argb: argb("#FCF5E7") } },
    border: { top: { style: "medium", color: { argb: argb("#C6953C") } }, bottom: thin(argb("#C6953C")) },
    alignment: { vertical: "middle", horizontal: "left", indent: 1 },
  });
  ws.getRow(r).height = 34;
  r += 3;

  // ── Signatures (Prepared by: Secretary / Noted: Captain)
  let half = Math.max(1, Math.floor(LAST_COL / 2));
  let rightStart = LAST_COL - half + 1;
  // Each signature needs ~26 characters; when the columns are narrow on one side, split by width instead of by count.
  const sumW = (from: number, to: number) => widths.slice(from - 1, to).reduce((n, w) => n + w, 0);
  if (sumW(1, half) < 26 || sumW(LAST_COL - half + 1, LAST_COL) < 26) {
    let best = half;
    let bestGap = Infinity;
    for (let h = 1; h < LAST_COL; h++) {
      if (sumW(1, h) < 26 || sumW(h + 1, LAST_COL) < 26) continue;
      const gap = Math.abs(sumW(1, h) - sumW(h + 1, LAST_COL));
      if (gap < bestGap) {
        best = h;
        bestGap = gap;
      }
    }
    half = best;
    rightStart = half + 1;
  }
  const signLabel = { font: { name: FONT, size: 12.5, bold: true, color: { argb: argb("#1A1A1A") } }, alignment: { horizontal: "left", vertical: "middle", indent: 1 } };
  band(ws, r, 1, half, "Prepared by:", signLabel);
  band(ws, r, rightStart, LAST_COL, "Noted:", signLabel);
  r++;
  ws.getRow(r).height = 54;
  const signName = { font: { name: FONT, size: 14, bold: true, color: { argb: argb("#000000") } }, alignment: { horizontal: "center", vertical: "bottom" } };
  band(ws, r, 1, half, officials.secretary?.name ?? "", signName);
  band(ws, r, rightStart, LAST_COL, officials.captain?.name ?? "", signName);
  r++;
  const signTitle = { border: { top: thin(MUTED) }, font: { name: FONT, size: 12, bold: false, color: { argb: argb("#1A1A1A") } }, alignment: { horizontal: "center", vertical: "top" } };
  band(ws, r, 1, half, "Brgy. Secretary", signTitle);
  band(ws, r, rightStart, LAST_COL, "Barangay Captain", signTitle);
  r += 2;
  band(ws, r, 1, LAST_COL, `Generated via Piao Connect — Barangay Information Management System · ${generatedFull}`, {
    font: { name: FONT, size: 10, color: { argb: FAINT } },
    alignment: { horizontal: "center" },
  });
  const lastRow = r;

  ws.pageSetup = {
    paperSize: 9,
    orientation: LAST_COL <= 5 ? "portrait" : "landscape",
    fitToPage: true,
    fitToWidth: 1,
    fitToHeight: 0,
    horizontalCentered: true,
    margins: { left: 0.4, right: 0.4, top: 0.6, bottom: 0.7, header: 0.3, footer: 0.3 },
    printArea: `A1:${String.fromCharCode(64 + LAST_COL)}${lastRow}`,
    printTitlesRow: `${headerRow}:${headerRow}`,
  };
  ws.headerFooter = { oddFooter: "&L&8Piao Connect · Barangay Piao&R&8Page &P of &N" };

  const buffer = await wb.xlsx.writeBuffer();
  const blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.download = fileName;
  document.body.appendChild(link);
  link.click();
  link.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}
</file>

<file path="resources/js/lib/theme.ts">
// Light / dark preference for the staff and member portals.
//
// The portals are authored dark-first; css/theme-light.css re-colours them when
// <html data-theme="light"> is present. The attribute is only applied while a
// portal page is mounted (useThemeScope), so the login screen stays dark.
import { useEffect, useSyncExternalStore } from "react";

export type Theme = "dark" | "light";
const KEY = "piao-theme";

// The app calls localStorage.clear() on login and logout, which would wipe a
// localStorage-only preference. A long-lived cookie survives that, so the
// choice made on the login page is still there on the dashboard (and back).
const readCookie = (): Theme | null => {
  try {
    const m = document.cookie.match(/(?:^|;\s*)piao-theme=(light|dark)/);
    return m ? (m[1] as Theme) : null;
  } catch {
    return null;
  }
};

const read = (): Theme => {
  const c = readCookie();
  if (c) return c;
  try {
    return localStorage.getItem(KEY) === "light" ? "light" : "dark";
  } catch {
    return "dark";
  }
};

const persist = (t: Theme) => {
  try {
    document.cookie = `piao-theme=${t}; path=/; max-age=31536000; SameSite=Lax`;
  } catch {
    /* cookies blocked */
  }
  try {
    localStorage.setItem(KEY, t);
  } catch {
    /* private mode / blocked storage */
  }
};

let current: Theme = read();
let scopes = 0;
const listeners = new Set<() => void>();

// Every screen that loads this module is the login page or a portal, so the
// attribute simply follows the saved choice (the blade layout also sets it
// before first paint -- see app.blade.php -- to avoid a dark flash on reload).
const apply = () => {
  const el = document.documentElement;
  if (current === "light") el.setAttribute("data-theme", "light");
  else el.removeAttribute("data-theme");
};
apply();

export const setTheme = (next: Theme) => {
  if (next === current) return;
  current = next;
  persist(next);
  apply();
  listeners.forEach((l) => l());
};

// Keep other open tabs / the login and dashboard pages in step with each other.
if (typeof window !== "undefined") {
  window.addEventListener("storage", (e) => {
    if (e.key !== KEY) return;
    current = read();
    apply();
    listeners.forEach((l) => l());
  });
}

const subscribe = (cb: () => void) => {
  listeners.add(cb);
  return () => {
    listeners.delete(cb);
  };
};

/** Current theme + toggle, for the header button. */
export function useTheme(): { theme: Theme; toggle: () => void } {
  const theme = useSyncExternalStore(subscribe, () => current, () => "dark" as Theme);
  return { theme, toggle: () => setTheme(current === "light" ? "dark" : "light") };
}

/** Call once from a portal page (Staff / Members) to switch the theme on for it. */
export function useThemeScope() {
  useEffect(() => {
    scopes += 1;
    apply();
    return () => {
      scopes -= 1;
      apply();
    };
  }, []);
}
