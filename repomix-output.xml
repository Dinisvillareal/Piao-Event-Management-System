<file path="resources/css/app.css">
@import url('https://fonts.googleapis.com/css2?family=Lexend:wght@600;700;800&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');

@import './theme-light.css';

@tailwind base;
@tailwind components;
@tailwind utilities;

/* Piao design system — base surface + text color. Individual pages still
   set their own backgrounds in places; this just keeps the default (and
   anything that doesn't) on the warm-paper canvas instead of pure white. */
html, body {
  background-color: #F8F5EF;
  color: #1A1A1A;
}

/* Defaults for the print-only "Page X of Y" footer's two words (see the
   @page rule below). ReportsView.tsx overwrites these on <html> to match
   whichever language is selected -- these English defaults are what a
   print preview would show before that effect has run, or for any future
   page that prints without setting them. */
:root {
  --print-page-word: "Page";
  --print-of-word: "of";
}

/* Tailwind's Preflight resets font-family to `inherit` on <select>,
   <input>, <button>, <textarea> -- but it can't reach into a file input's
   native "Choose File" button, which lives in a browser shadow root
   (::file-selector-button / the older WebKit ::-webkit-file-upload-button).
   Left alone, that button renders in the OS UI font (e.g. Segoe UI on
   Windows) instead of the app's Public Sans, which is what made the ID
   Photo field on Add/Edit Resident look like it belonged to a different
   app. Forcing it to inherit keeps every control on the same typeface. */
input[type="file"]::file-selector-button,
input[type="file"]::-webkit-file-upload-button {
  font-family: inherit;
}

/* Edge/Chromium draws its own "reveal password" eye icon inside
   type="password" fields (::-ms-reveal). It renders as a dark icon by
   default, which disappears against the app's dark navy password inputs
   (Settings' Change Password, Login). Inverting it turns it white so it's
   actually visible on the dark background. */
input[type="password"]::-ms-reveal {
  filter: invert(1);
}

/* Browsers skip background colors/gradients when printing by default (an
   ink-saving default called "Background graphics" in the print dialog),
   which is why the Reports stat cards' sage/gold/teal/terracotta gradients
   were coming out flat gray on a printed page even though every other
   print: style worked fine. Forcing exact color adjustment app-wide makes
   printed pages render backgrounds exactly as designed, without asking
   every user to dig up their browser's "Background graphics" checkbox. */
@media print {
  * {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
    color-adjust: exact !important;
  }

  /* The warm-paper canvas above (#F8F5EF) is a screen-only touch. Forcing
     exact color adjustment for print (so the Reports gradients show up)
     also means this app-wide background would otherwise print too --
     filling the page, and any leftover forced-height space past the
     content, with a beige wash instead of plain white paper. */
  html, body {
    background-color: #fff !important;
  }

  /* A bordered/rounded card that's too tall to fit the rest of a page
     still has to break somewhere, even with break-inside-avoid on it and
     on each item inside it (that only protects individual pieces, not an
     overall section once it's genuinely longer than one page). Left alone,
     the browser's default box-decoration-break: slice treats a split box
     as one shape sliced in two -- so the fragment on the first page has no
     bottom border/rounded corner, and the one that continues on the next
     page has no top border/rounded corner, reading as an "open" cut. Clone
     gives EVERY fragment its own complete border and rounded corners, so
     a page break always lands on a closed-off box rather than an open one.
     Reports is the only screen that prints, so scoping this to the border
     radii its cards use is safe app-wide. */
  .rounded-\[30px\],
  .rounded-2xl,
  .rounded-xl {
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
}

/* Paper has no hover or tooltip, so a name cut off with "..." is simply lost information. On screen the
   long names stay on one line (truncate); when printing they wrap onto a second line instead, so no
   event, item or membership name is ever clipped or runs into the column beside it. */
@media print {
  .truncate {
    overflow: visible !important;
    text-overflow: clip !important;
    white-space: normal !important;
    overflow-wrap: anywhere;
  }
}

/* "Page X of Y" printed on every physical sheet, in the page's own bottom
   margin (not part of the report content, so it never collides with a
   card or gets caught by a break-inside-avoid rule). This is the browser's
   native CSS Paged Media margin-box feature -- no PDF library, no JS
   pagination polyfill, just an @page rule, consistent with the rest of
   this app's printing being plain window.print(). Reports is the only
   screen that calls window.print(), so this is scoped safely at the
   stylesheet root without needing a page-specific class. */
@page {
  margin: 14mm 12mm 18mm 12mm;
  @bottom-right {
    content: var(--print-page-word) " " counter(page) " " var(--print-of-word) " " counter(pages);
    font-family: "Public Sans", sans-serif;
    font-size: 9px;
    color: #667777;
  }
}

/* DARK THEME -- every form / dialog field gets the same look as the Register
   Resident and Post Event forms: a clear, slightly lighter glass pill with a
   visible edge. Cards, toggles, checkboxes, error / disabled / focused fields
   and the login card keep their own styling. */
@media screen {
  html:not([data-theme="light"]) :is(form, [class*="fixed"][class*="inset-0"])
    :is(input, select, textarea)[class*="bg-white/"]:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="file"]):not(:disabled):not(:focus):not([class*="border-red"]):not([class*="border-amber"]):not(:is([class~="backdrop-blur-2xl"] *)) {
    background-color: rgba(255, 255, 255, 0.10) !important;
    border-color: rgba(255, 255, 255, 0.25) !important;
  }
}

/* Full-page staff forms (same as Edit Record): they simply open and close, no animation. */
@keyframes slideOverIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.slide-over-in { animation: none; }

/* Slide-over forms fill the whole page area (like Edit Record): from the sidebar to the right edge and from just under
   the top header down, so the header stays visible and clickable. --staff-panel-top is measured in Staff.tsx. */
.staff-drawer-panel { top: var(--staff-panel-top, 73px); bottom: 0; left: 0; right: 0; }
@media (min-width: 1280px) { .staff-drawer-panel { left: 340px; } }
.staff-drawer-backdrop { position: fixed; top: var(--staff-panel-top, 73px); right: 0; bottom: 0; left: 0; }
@keyframes slideBackdropIn { from { opacity: 0; } to { opacity: 1; } }
@media (min-width: 1280px) { .staff-drawer-backdrop { left: 340px; } }
@media (prefers-reduced-motion: reduce) { .slide-over-in { animation: none; } }

/* ...and the way back out (see SlideOutGhost): the panel slides off to the right while its backdrop fades. */
@keyframes slideOverOut {
  from { opacity: 1; }
  to { opacity: 0; }
}
@keyframes slideBackdropOut {
  from { opacity: 1; }
  to { opacity: 0; }
}
.slide-over-out { animation: none; display: none; pointer-events: none; }
.slide-backdrop-out { animation: none; display: none; pointer-events: none; }

/* Staff dashboard "upcoming events" timeline card: in light mode the body is
   plain white; the card has no outer border in either mode. */
html[data-theme="light"] .timeline-card { background-color: #ffffff !important; }
html[data-theme="light"] .timeline-card .timeline-cell:hover { background-color: #F1F3F5; }

/* ── Reports & Analytics entrance animation ───────────────────────────── */
@keyframes report-rise {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: none; }
}
@keyframes report-grow {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}
.report-rise {
  animation: report-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}
.report-stagger > * {
  animation: report-rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}
.report-stagger > *:nth-child(2) { animation-delay: 70ms; }
.report-stagger > *:nth-child(3) { animation-delay: 140ms; }
.report-stagger > *:nth-child(4) { animation-delay: 210ms; }
.report-stagger > *:nth-child(5) { animation-delay: 280ms; }
.report-stagger > *:nth-child(6) { animation-delay: 320ms; }
.report-stagger > *:nth-child(7) { animation-delay: 360ms; }
.report-stagger > *:nth-child(8) { animation-delay: 400ms; }
.report-grow {
  transform-origin: left center;
  animation: report-grow 1s cubic-bezier(0.22, 1, 0.36, 1) 0.3s backwards;
}
@media (prefers-reduced-motion: reduce) {
  .report-rise, .report-stagger > *, .report-grow { animation: none !important; }
}
@media print {
  .report-rise, .report-stagger > *, .report-grow { animation: none !important; }
}

/* A drawer that is still sliding out when the browser's print starts must not end up on the paper
   (it showed up as a dark strip down the right edge). */
@media print {
  .slide-over-out, .slide-backdrop-out, .slide-over-in { display: none !important; }
}

/* Dashboard shortcut pills: same hover feedback in light mode as in dark
   (teal outline, highlighted fill, stronger label). */
html[data-theme="light"] .dash-shortcut{transition:border-color .15s,background-color .15s,box-shadow .15s}
html[data-theme="light"] .dash-shortcut:hover{border-color:rgba(46,142,130,.55) !important;background-color:#E6F5F2 !important;box-shadow:0 2px 10px rgba(46,142,130,.14)}
html[data-theme="light"] .dash-shortcut:hover .dash-shortcut-icon{background-color:rgba(79,190,176,.28) !important}
html[data-theme="light"] .dash-shortcut:hover .dash-shortcut-label{color:#0F172A !important}


/* Page titles: one fixed-width gradient so every title shows the same colours from its first letter
   (a short word like "Events" no longer ends up a different shade from a longer one). */
.page-title-gradient {
  background-image: linear-gradient(90deg, #F6D365 0%, #A9C98A 28%, #5BBBA6 55%, #2A8A93 78%, #146088 100%);
  background-size: 576px 100%;
  background-repeat: no-repeat;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent !important;
  color: transparent !important;
}
.page-title-gradient.page-title-short { background-size: 290px 100%; }
.page-title-gradient.page-title-fit { background-size: 100% 100%; display: inline-block; }

/* Staff Dashboard "bento" layout: a calm canvas with rounded cards. Dark theme = slightly lighter dark
   cards on the navy canvas; light theme = white cards on a soft grey canvas. */
.dash-canvas { background-color: #0A0E1A; }
.dash-card { background-color: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.08); }
.dash-tile { background-color: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.07); transition: border-color .15s, background-color .15s, filter .15s; }
.dash-tile:hover { background-color: rgba(255,255,255,.08); }
html[data-theme="light"] .dash-canvas { background-color: #ffffff !important; }
html[data-theme="light"] .dash-card { background-color: #ffffff !important; border-color: #E8EBEF; box-shadow: 0 6px 24px rgba(15,23,42,.06); }
html[data-theme="light"] .dash-tile { background-color: #F1F3F5 !important; border-color: transparent; }
html[data-theme="light"] .dash-tile:hover { background-color: #E6F5F2 !important; border-color: rgba(46,142,130,.45); }
/* List rows that keep their own coloured left edge (member attendance / events / notification rows):
   the same surface as .dash-tile, without its border shorthand, so the left accent colour is not overwritten. */
.dash-row { background-color: rgba(255,255,255,.08); transition: background-color .15s, transform .2s, box-shadow .2s;
  box-shadow: 0 0 0 1px rgba(255,255,255,.14), 0 2px 4px rgba(0,0,0,.55), 0 10px 22px rgba(0,0,0,.6), 0 20px 40px -10px rgba(0,0,0,.9), inset 0 1px 0 rgba(255,255,255,.09); }
.dash-row:hover { background-color: rgba(255,255,255,.12); }
html[data-theme="light"] .dash-row { background-color: #F1F3F5 !important;
  box-shadow: 0 0 0 1px rgba(15,23,42,.07), 0 2px 4px rgba(15,23,42,.06), 0 12px 24px -8px rgba(15,23,42,.22); }
html[data-theme="light"] .dash-row:hover { background-color: #E6F5F2 !important; box-shadow: 0 0 0 1px rgba(46,142,130,.35), 0 2px 4px rgba(15,23,42,.06), 0 16px 28px -8px rgba(15,23,42,.26); }
.dash-shadow { box-shadow: 0 0 0 1px rgba(255,255,255,.14), 0 2px 4px rgba(0,0,0,.55), 0 10px 22px rgba(0,0,0,.6), 0 20px 40px -10px rgba(0,0,0,.9), inset 0 1px 0 rgba(255,255,255,.09); }
html[data-theme="light"] .dash-shadow { box-shadow: 0 0 0 1px rgba(15,23,42,.07), 0 2px 4px rgba(15,23,42,.06), 0 12px 24px -8px rgba(15,23,42,.22); }
@media print { .dash-row, .dash-shadow { box-shadow: none !important; } }
@media print {
  .dash-card { background: #fff !important; border: 1px solid #d9dee5 !important; box-shadow: none !important; }
  .dash-card, .dash-card * { color: #0F172A !important; }
}
.dash-mint { background-color: rgba(79,190,176,.10) !important; border: 1px solid rgba(79,190,176,.35) !important; }
html[data-theme="light"] .dash-mint { background-color: #E6F5F2 !important; border-color: rgba(46,142,130,.45) !important; }

/* Card colours for the phone/tablet table layout: the dark theme needs real white lines (the old
   "currentColor" border was dark-on-dark and vanished); the light theme keeps a soft slate line. */
:root { --rcard-line: rgba(255, 255, 255, .20); --rcard-bg: rgba(255, 255, 255, .035); --rcard-field-line: rgba(255, 255, 255, .09); }
html[data-theme="light"] { --rcard-line: rgba(15, 23, 42, .16); --rcard-bg: #ffffff; --rcard-field-line: rgba(15, 23, 42, .08); }
html[data-theme="light"] table.rtable tbody > tr { box-shadow: 0 1px 2px rgba(15, 23, 42, .06); }

/* Phone and tablet layout for tables marked class="rtable": every row becomes a card and each value
   is labelled with its column heading (labels are filled in by lib/responsiveTables.ts). Phones stack
   the cards; tablets lay them out two across. */
@media screen and (max-width: 1023px) {
  table.rtable { display: block; width: 100%; min-width: 0 !important; }
  table.rtable thead { display: none; }
  table.rtable tbody { display: block; padding: .5rem; }
  table.rtable tbody > tr {
    display: block; margin: 0 0 .75rem; padding: .35rem 0; min-width: 0;
    border: 1px solid var(--rcard-line); border-radius: 1rem;
    background-color: var(--rcard-bg); box-shadow: 0 1px 2px rgba(0, 0, 0, .25);
  }
  /* A hairline between the fields of one card, so each value reads as its own row. */
  table.rtable tbody > tr > td + td { border-top: 1px solid var(--rcard-field-line) !important; }
  table.rtable tbody > tr > td {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .25rem 1rem;
    width: auto !important; padding: .5rem 1rem !important; border: 0 !important; text-align: right;
  }
  table.rtable tbody > tr > td::before {
    content: attr(data-label); flex-shrink: 0; text-align: left;
    font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; opacity: .5;
  }
  table.rtable tbody > tr > td:first-child { justify-content: flex-start; text-align: left; }
  table.rtable tbody > tr > td:first-child::before,
  table.rtable tbody > tr > td[data-label=""]::before { display: none; }
  table.rtable tbody > tr > td[data-label=""] { justify-content: flex-start; }
}
@media screen and (min-width: 640px) and (max-width: 1023px) {
  table.rtable tbody { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  table.rtable tbody > tr { margin: 0; }
  table.rtable tbody > tr:has(> td[colspan]) { grid-column: 1 / -1; }
}


/* Dark theme, phone and tablet: the faintest dividers (6 percent white) disappear on the navy
   background, so they are lifted to a visible line. Light theme has its own mapping, untouched. */
html:not([data-theme="light"]) [class~="divide-white/[0.06]"] > :not([hidden]) ~ :not([hidden]) { border-color: rgba(255, 255, 255, .13); }
html:not([data-theme="light"]) [class~="border-white/[0.06]"] { border-color: rgba(255, 255, 255, .13); }
@media screen and (max-width: 1023px) {
  html:not([data-theme="light"]) [class~="border-white/10"]:not(:hover) { border-color: rgba(255, 255, 255, .16); }
}

/* Dark theme: default text colour.
   The app root (Staff.tsx / Members.tsx) sets a dark text colour (text-gray-900) and the base rule above is
   #1A1A1A, so any text that has no colour class of its own -- table cells, labels, values -- inherited
   dark-on-dark and vanished on the navy pages. Every dark surface now sets a light default for what it
   contains; light surfaces inside it (white cards, pickers, light modals) put the dark default back.
   :where() keeps these rules at zero specificity, so any explicit text-* class still wins. */
:where(html:not([data-theme="light"]) body) { color: #E8ECF4; }
:where(html:not([data-theme="light"]) [class~="bg-[#0A0E1A]"]),
:where(html:not([data-theme="light"]) [class~="bg-[#161C2E]"]),
:where(html:not([data-theme="light"]) [class~="bg-[#10162a]"]),
:where(html:not([data-theme="light"]) [class~="bg-[#0F1626]"]),
:where(html:not([data-theme="light"]) [class~="bg-[#0F1B33]"]),
:where(html:not([data-theme="light"]) [class~="bg-[#122436]"]),
:where(html:not([data-theme="light"]) [class~="bg-[#123A38]"]) { color: #E8ECF4; }
:where(html:not([data-theme="light"]) [class~="bg-white"]),
:where(html:not([data-theme="light"]) [class~="bg-gray-50"]),
:where(html:not([data-theme="light"]) [class~="bg-gray-100"]),
:where(html:not([data-theme="light"]) [class~="bg-gray-200"]),
:where(html:not([data-theme="light"]) [class~="bg-sage-50"]),
:where(html:not([data-theme="light"]) [class~="bg-gold-50"]),
:where(html:not([data-theme="light"]) [class~="bg-[#EEF4F1]"]),
:where(html:not([data-theme="light"]) [class~="bg-[#FAF9F5]"]),
:where(html:not([data-theme="light"]) [class~="bg-[#DCEAE5]"]),
:where(html:not([data-theme="light"]) [class~="bg-[#E6E0D3]"]),
:where(html:not([data-theme="light"]) [class~="bg-[#ddd5ca]"]) { color: #1A1A1A; }

/* Frosted-glass panel over a cover photo (resident profile): see-through, with the photo blurred behind it. */
.profile-glass {
  background: rgba(10, 14, 26, 0.38);
  border: 1px solid rgba(255, 255, 255, 0.22);
  -webkit-backdrop-filter: blur(14px) saturate(1.3);
  backdrop-filter: blur(14px) saturate(1.3);
}

/* Translucent "live" gradient button (resident profile: View QR code): colours flow slowly, with a soft light sweep. */
.profile-glass-btn {
  position: relative;
  overflow: hidden;
  background: linear-gradient(110deg,
    rgba(79, 190, 176, 0.45), rgba(230, 180, 80, 0.38), rgba(236, 120, 170, 0.38),
    rgba(120, 140, 240, 0.40), rgba(79, 190, 176, 0.45));
  background-size: 300% 100%;
  animation: profile-glass-flow 7s linear infinite;
  border: 1px solid rgba(255, 255, 255, 0.28);
  color: #ffffff;
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  transition: filter 0.2s ease, transform 0.2s ease;
}
.profile-glass-btn::after,
.form-glass-btn::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(100deg, transparent 35%, rgba(255, 255, 255, 0.35) 50%, transparent 65%);
  transform: translateX(-120%);
  animation: profile-glass-sheen 4.5s ease-in-out infinite;
  pointer-events: none;
}
@keyframes profile-glass-flow {
  from { background-position: 0% 50%; }
  to { background-position: 300% 50%; }
}
@keyframes profile-glass-sheen {
  0%, 55% { transform: translateX(-120%); }
  100% { transform: translateX(120%); }
}
.form-glass-btn {
  position: relative;
  overflow: hidden;
  background: linear-gradient(110deg,
    rgba(124, 92, 246, 0.50), rgba(59, 110, 240, 0.48), rgba(52, 190, 130, 0.46),
    rgba(240, 200, 70, 0.46), rgba(124, 92, 246, 0.50));
  background-size: 300% 100%;
  animation: profile-glass-flow 7s linear infinite;
  border: 1px solid rgba(255, 255, 255, 0.28);
  color: #ffffff;
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  transition: filter 0.2s ease, transform 0.2s ease;
}
.profile-glass-btn:hover, .form-glass-btn:hover { filter: brightness(1.15); animation-duration: 3.5s; }
.form-glass-btn:active { transform: scale(0.98); }
.profile-glass-btn:active { transform: scale(0.98); }
@media (prefers-reduced-motion: reduce) {
  .profile-glass-btn, .profile-glass-btn::after, .form-glass-btn, .form-glass-btn::after { animation: none; }
}

/* Dashboard hero card: yellow > green > teal > blue colours that slowly flow (same in light and dark theme). */
.dash-hero-live {
  background-image: linear-gradient(100deg, #F6D365 0%, #A9C98A 28%, #5BBBA6 55%, #2A8A93 78%, #146088 100%) !important;
  background-size: 200% 200%;
  animation: dash-hero-flow 14s ease-in-out infinite alternate;
}
@keyframes dash-hero-flow {
  from { background-position: 0% 40%; }
  to { background-position: 100% 60%; }
}
@media (prefers-reduced-motion: reduce) {
  .dash-hero-live { animation: none; }
}

/* Main action buttons (Register resident, Generate Report...): dark navy with a slow, live colour flow. */
.btn-live-navy {
  background-image: linear-gradient(110deg, #10264A 0%, #1A4373 25%, #135863 50%, #1A4373 75%, #10264A 100%) !important;
  background-size: 300% 100%;
  animation: btn-live-navy-flow 9s ease-in-out infinite alternate;
}
.btn-live-navy:hover { filter: brightness(1.2); animation-duration: 4s; }
.btn-live-navy:disabled { animation: none; }
@keyframes btn-live-navy-flow {
  from { background-position: 0% 50%; }
  to { background-position: 100% 50%; }
}
@media (prefers-reduced-motion: reduce) {
  .btn-live-navy { animation: none; }
}

/* Dark theme: shadowed cards (KPI cards, summary cards...). In the light theme these cards carry a soft dark
   shadow that shows against white. A dark shadow is invisible on the navy page, so in the dark theme the same
   cards get a layered black shadow (tight, medium and long), a slightly lighter surface than the panel they sit
   on, and a thin light top edge, so the shadow reads against the panel instead of a glow. */
html:not([data-theme="light"]) [class*="shadow-[0_"][class*="rgba(15,23,42"],
html:not([data-theme="light"]) [class*="shadow-[0_"][class*="rgba(20,96,136"],
html:not([data-theme="light"]) [class*="shadow-[0_"][class*="rgba(8,12,20"] {
  background-color: rgba(255, 255, 255, .10) !important;
  border-color: rgba(255, 255, 255, .26) !important;
  box-shadow: 0 0 0 1px rgba(255, 255, 255, .26), 0 2px 4px rgba(0, 0, 0, .55), 0 10px 22px rgba(0, 0, 0, .65), 0 28px 56px -6px rgba(0, 0, 0, .95), inset 0 1px 0 rgba(255, 255, 255, .10) !important;
}
@media print { html:not([data-theme="light"]) [class*="shadow-[0_"] { box-shadow: none !important; } }

/* Dark theme: near-black "selected / featured" pills and live-navy buttons.
   In the light theme these dark fills stand out against white. On the dark navy canvas (#0A0E1A) the same
   near-black fill blended in and the pill looked empty. In the dark theme they now use a steel navy blue
   gradient (or a lifted blue) plus a thin light ring, so a dark-coloured item is never dark-on-dark. */
html:not([data-theme="light"]) [class~="from-[#0B0F14]"][class~="to-[#18212B]"] {
  /* darker steel navy, with a deep shadow below and a soft blue glow so the shadow shows on the dark page */
  background-image: linear-gradient(135deg, #25405F 0%, #142640 100%) !important;
  box-shadow: 0 2px 4px rgba(0, 0, 0, .55), 0 10px 22px rgba(0, 0, 0, .65), 0 26px 50px -6px rgba(0, 0, 0, .95), inset 0 1px 0 rgba(255, 255, 255, .18), inset 0 0 0 1px rgba(255, 255, 255, .26) !important;
}
html:not([data-theme="light"]) .btn-live-navy {
  background-image: linear-gradient(110deg, #1B4B8A 0%, #2A6DB0 25%, #1F8A94 50%, #2A6DB0 75%, #1B4B8A 100%) !important;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .20);
}
/* Same for the navy Edit buttons (#1E3A5F): lifted to a lighter blue with a thin ring in the dark theme. */
html:not([data-theme="light"]) [class~="bg-[#1E3A5F]"] {
  background-color: #2F6AA8 !important;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .20);
}

/* Dark theme: white pill buttons ("Add member", "Add age brackets", "Register account"...).
   A solid white pill is a light-theme look; on the dark page it glared. In the dark theme it becomes a soft
   frosted-glass pill with light text. White pills inside a genuinely white panel (not the page root, which also carries bg-white) (light modals, pickers) are left
   alone, so they still match their white background. */
html:not([data-theme="light"]) button[class~="bg-white"][class~="rounded-full"]:not(:is([class~="bg-white"]:not([class~="min-h-screen"]), [class~="bg-gray-50"]:not([class~="min-h-screen"]), [class~="bg-slate-50"]:not([class~="min-h-screen"])) *) {
  background-color: rgba(255, 255, 255, .10) !important;
  background-image: linear-gradient(135deg, rgba(255, 255, 255, .16) 0%, rgba(255, 255, 255, .06) 100%);
  border-color: rgba(255, 255, 255, .24) !important;
  color: #F1F5F9 !important;
  -webkit-backdrop-filter: blur(12px) saturate(140%);
  backdrop-filter: blur(12px) saturate(140%);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .22), 0 10px 24px -12px rgba(0, 0, 0, .7) !important;
}
html:not([data-theme="light"]) button[class~="bg-white"][class~="rounded-full"]:not(:is([class~="bg-white"]:not([class~="min-h-screen"]), [class~="bg-gray-50"]:not([class~="min-h-screen"]), [class~="bg-slate-50"]:not([class~="min-h-screen"])) *):hover:not(:disabled) {
  background-color: rgba(255, 255, 255, .17) !important;
  border-color: rgba(255, 255, 255, .38) !important;
}
html:not([data-theme="light"]) button[class~="bg-white"][class~="rounded-full"]:not(:is([class~="bg-white"]:not([class~="min-h-screen"]), [class~="bg-gray-50"]:not([class~="min-h-screen"]), [class~="bg-slate-50"]:not([class~="min-h-screen"])) *) [class*="text-slate-"],
html:not([data-theme="light"]) button[class~="bg-white"][class~="rounded-full"]:not(:is([class~="bg-white"]:not([class~="min-h-screen"]), [class~="bg-gray-50"]:not([class~="min-h-screen"]), [class~="bg-slate-50"]:not([class~="min-h-screen"])) *) [class*="text-[#1A1A1A]"] { color: #F1F5F9 !important; }
html:not([data-theme="light"]) button[class~="bg-white"][class~="rounded-full"]:not(:is([class~="bg-white"]:not([class~="min-h-screen"]), [class~="bg-gray-50"]:not([class~="min-h-screen"]), [class~="bg-slate-50"]:not([class~="min-h-screen"])) *) [class*="bg-slate-900/"] { background-color: rgba(255, 255, 255, .16) !important; }

/* Dark theme: the featured (first) upcoming event on the staff Overview keeps its original near-black look,
   with a thin light edge and a layered shadow so the shadow is clearly visible. Only this one element. */
html:not([data-theme="light"]) button.featured-glass[class~="from-[#0B0F14]"][class~="to-[#18212B]"] {
  background-image: linear-gradient(135deg, #0B0F14 0%, #18212B 100%) !important;
  border: 1px solid rgba(255, 255, 255, .34) !important;
  box-shadow: 0 0 0 1px rgba(255, 255, 255, .10), 0 2px 4px rgba(0, 0, 0, .6), 0 12px 26px rgba(0, 0, 0, .75), 0 28px 56px -8px rgba(0, 0, 0, 1), 0 22px 44px -14px rgba(130, 175, 230, .30), inset 0 1px 0 rgba(255, 255, 255, .10) !important;
}

/* Member attendance rows: white card in light mode (same shadow), keeps the dark-mode glass look. */
html[data-theme="light"] .dash-row.dash-row-white { background-color: #FFFFFF !important; border: 1px solid rgba(46,142,130,.22); }
html[data-theme="light"] .dash-row.dash-row-white:hover { background-color: #E6F5F2 !important; }

/* Read-only "field" rows (member Settings profile): same look as the form inputs -- white pill, thin neutral border, soft shadow. */
.dash-field { background-color: rgba(255,255,255,.10); border: 1px solid rgba(255,255,255,.15);
  box-shadow: 0 6px 16px -6px rgba(0,0,0,.6); }
html[data-theme="light"] .dash-field { background-color: #FFFFFF !important; border-color: rgba(15,23,42,.14);
  box-shadow: 0 6px 16px -6px rgba(15,23,42,.28), 0 1px 2px rgba(15,23,42,.06); }

/* Small screens: softer corners and tighter padding so cards use the width, and 16px form text so iPhones do not zoom in. */
@media (max-width: 639px) {
  .dash-card[class*="rounded-[32px]"] { border-radius: 26px; }
  .dash-card[class*="rounded-[28px]"] { border-radius: 24px; }
  input, select, textarea { font-size: 16px; }
}

/* Phones: scale the whole UI down a little (rem-based sizes) so text and spacing do not feel oversized. */
@media (max-width: 639px) {
  html { font-size: 15px; }
  .page-title-gradient { font-size: 1.75rem !important; line-height: 1.15 !important; }
}

/* Horizontal chip rows on phones: scroll sideways without a visible scrollbar. */
.no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
.no-scrollbar::-webkit-scrollbar { display: none; }

/* Report summary tiles on phones: one full-width row each (icon tile on the left, number, label, change chip) -- same as the Dashboard stat cards. */
@media screen and (max-width: 639px) {
  .report-stagger > .dash-card:has(> svg:first-child) {
    grid-column: 1 / -1; display: grid; grid-template-columns: 3rem minmax(0, 1fr); column-gap: .875rem;
    align-items: center; padding: 1rem !important; text-align: left;
  }
  .report-stagger > .dash-card:has(> svg:first-child) > svg:first-child {
    grid-row: 1 / span 4; width: 3rem; height: 3rem; padding: .8rem; border-radius: 1rem;
    background: rgba(46,142,130,.12); border: 1px solid rgba(46,142,130,.25);
  }
  .report-stagger > .dash-card:has(> svg:first-child) > :not(svg) { grid-column: 2; }
  .report-stagger > .dash-card:has(> svg:first-child) h2 { margin-top: 0 !important; font-size: 1.5rem; }
  .report-stagger > .dash-card:has(> svg:first-child) p { margin-top: .125rem !important; }
}

/* Phone top bar: a floating glass pill (like the DOST SEI header) holding the menu, brand and controls. */
.brand-glass { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
html[data-theme="light"] .brand-glass { background: rgba(15,23,42,.05) !important; border-color: rgba(15,23,42,.12) !important; }
@media (max-width: 639px) {
  .mobile-glass-header { background: rgba(10,14,26,.82); border: 1px solid rgba(255,255,255,.16); }
  html[data-theme="light"] .mobile-glass-header { background: rgba(255,255,255,.85) !important; border-color: rgba(15,23,42,.1) !important; box-shadow: 0 10px 28px rgba(15,23,42,.18); }
}

/* The floating brand card is fixed under the top bar (76px), so the page scrolls under it: every page starts 76px lower instead. */
@media screen and (max-width: 639px) {
  #staff-content-scroll [class~="h-[calc(100dvh-73px)]"],
  #staff-content-scroll [class~="min-h-[calc(100dvh-73px)]"],
  .member-shell [class~="h-[calc(100dvh-73px)]"] [class~="h-[calc(100dvh-73px)]"] { padding-top: calc(76px + 1rem) !important; }
}

/* Floating brand card: see-through glass in a fixed colour per theme (grey in light mode, deep navy-grey in dark mode),
   exactly like the DOST SEI header. The colour does not change on hover or scroll. */
.brand-banner-glass {
  background: rgba(28, 34, 46, 0.72) !important;
  border: 0 !important;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  -webkit-backdrop-filter: blur(14px) saturate(1.2);
  backdrop-filter: blur(14px) saturate(1.2);
}
html[data-theme="light"] .brand-banner-glass {
  background: rgba(121, 125, 132, 0.52) !important; /* = #B2B5BA over the light page, same as DOST SEI */
  box-shadow: 0 6px 20px rgba(15, 23, 42, 0.10);
}

/* Phones: more breathing room and clear boundaries between sections (like the DOST SEI mobile site):
   soft grey page, white cards that lift off it with a shadow, and bigger gaps between blocks. */
@media screen and (max-width: 639px) {
  html[data-theme="light"] .dash-canvas { background-color: #EEF1F4 !important; }
  html[data-theme="light"] .dash-card { border-color: #E1E6EB; box-shadow: 0 10px 28px rgba(15, 23, 42, 0.10); }
  html:not([data-theme="light"]) .dash-card { border-color: rgba(255, 255, 255, 0.12); box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35); }
  .dash-canvas .space-y-6 > :not([hidden]) ~ :not([hidden]) { margin-top: 1.75rem !important; }
  .dash-canvas .space-y-5 > :not([hidden]) ~ :not([hidden]) { margin-top: 1.5rem !important; }
  .dash-card .space-y-4 > :not([hidden]) ~ :not([hidden]) { margin-top: 1.25rem !important; }
  .dash-card .space-y-5 > :not([hidden]) ~ :not([hidden]) { margin-top: 1.5rem !important; }
}

/* Phone/tablet record cards: each person (row) lifts off the list with its own shadow, so it is obvious where one ends and the next begins. */
@media screen and (max-width: 1023px) {
  table.rtable tbody { padding: .75rem !important; }
  table.rtable tbody > tr { margin-bottom: 1rem !important; border-radius: 1.1rem !important; }
  html[data-theme="light"] table.rtable tbody > tr { box-shadow: 0 4px 14px rgba(15, 23, 42, .14), 0 1px 3px rgba(15, 23, 42, .08) !important; }
  html:not([data-theme="light"]) table.rtable tbody > tr { box-shadow: 0 4px 14px rgba(0, 0, 0, .45) !important; }
}
@media screen and (min-width: 640px) and (max-width: 1023px) {
  table.rtable tbody > tr { margin-bottom: 0 !important; }
  table.rtable tbody { gap: 1rem !important; }
}

/* Phones: the search bar + filter button float on the page by themselves (no card around them). */
@media screen and (max-width: 639px) {
  html:root .dash-card:has(> [data-phone-filterbar]) { background: transparent !important; border: 0 !important; box-shadow: none !important; padding: 0 !important; border-radius: 0 !important; overflow: visible; }
  html[data-theme="light"] .phone-search { background-color: #ffffff !important; box-shadow: 0 6px 18px rgba(15, 23, 42, .10); }
}

/* Phone search bar: plain white (dark: plain tile), no outline until it is tapped, then one thin teal line. */
@media screen and (max-width: 639px) {
  .phone-search { border: 1px solid transparent !important; box-shadow: none !important; outline: none !important; transition: border-color .15s ease; }
  .phone-search:focus { border-color: #4FBEB0 !important; box-shadow: none !important; outline: none !important; }
  html[data-theme="light"] .phone-search, html[data-theme="light"] .phone-search:focus { background-color: #ffffff !important; }
  html[data-theme="light"] .phone-search { box-shadow: 0 5px 16px rgba(15, 23, 42, .12), 0 1px 2px rgba(15, 23, 42, .06) !important; }
  html:not([data-theme="light"]) .phone-search, html:not([data-theme="light"]) .phone-search:focus { background-color: rgba(255, 255, 255, .06) !important; }
}

/* Phones: the Reports filter options open in their own small card under the search-style pill. */
@media screen and (max-width: 639px) {
  .phone-panel { border: 1px solid rgba(255, 255, 255, .12); background: rgba(255, 255, 255, .06); border-radius: 1.25rem; padding: 1rem; }
  html[data-theme="light"] .phone-panel { background: #ffffff; border-color: #E1E6EB; box-shadow: 0 10px 28px rgba(15, 23, 42, .10); }
}

/* Phones: leave generous room after the search bar so the next section clearly starts somewhere else. */
@media screen and (max-width: 639px) {
  html:root .dash-card:has(> [data-phone-filterbar]) { margin-bottom: 1.25rem !important; }
}

/* Phones: a few lists keep the results line close under their search bar. */
@media screen and (max-width: 639px) {
  html:root .dash-card.tight-after:has(> [data-phone-filterbar]) { margin-bottom: .5rem !important; }
}

/* Top bar: theme + language sit together in one soft floating pill (same idea as the phone speed-dial). */
.topbar-group { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); box-shadow: 0 4px 14px rgba(0,0,0,.35); }
.topbar-divider { background: rgba(255,255,255,.16); }
.topbar-icon { background: rgba(79,190,176,.16); color: #7DD8CB; }
html[data-theme="light"] .topbar-group { background: #ffffff !important; border-color: #E1E6EB; box-shadow: 0 4px 14px rgba(15,23,42,.10); }
html[data-theme="light"] .topbar-divider { background: #E1E6EB !important; }
html[data-theme="light"] .topbar-icon { background: #E6F5F2 !important; color: #2E8E82 !important; }
</file>

<file path="resources/js/components/layout/Sidebar.tsx">
import {
  Bell,
  CalendarDays,
  ClipboardCheck,
  LayoutDashboard,
  LogOut,
  QrCode,
  Settings,
  X as XIcon,
} from "lucide-react";
import React, { useEffect, useState } from "react";
import { useLanguage } from "../../i18n/LanguageContext";

interface SidebarProps {
  active: string;
  setActive: (page: string) => void;
  mobileOpen?: boolean;
  onCloseMobile?: () => void;
  userName?: string;
  userRole?: string;
  /** Optional per-nav-key count shown as a badge (e.g. { notify: 3 } for unread notifications). */
  badges?: Record<string, number>;
}

// Same navy/gold/teal system, fixed width, and behavior as the staff
// portal's own Sidebar (pages/staff/components/Sidebar.tsx) -- same 340px
// width, header block, nav styling, and logout confirm. No quick-jump
// search box here: this portal's nav list is short enough (6 items) that a
// search input isn't needed the way it is for staff's larger, grouped nav.

  export const MEMBER_NAV_ITEMS = [
    { key: "dashboard", label: "Overview", icon: LayoutDashboard },
    { key: "qr", label: "My QR Code", icon: QrCode },
    { key: "attendance", label: "Attendance", icon: ClipboardCheck },
    { key: "events", label: "Events", icon: CalendarDays },
    { key: "notify", label: "Notifications", icon: Bell },
    { key: "settings", label: "Settings", icon: Settings },
  ];

export default function Sidebar({ active, setActive, mobileOpen = false, onCloseMobile, userName, userRole, badges }: SidebarProps) {
  const { t } = useLanguage();
  const [showLogoutConfirm, setShowLogoutConfirm] = useState(false);
  const [loggingOut, setLoggingOut] = useState(false);

  // The profile menu in the top bar asks for sign-out through this event.
  useEffect(() => {
    const open = () => setShowLogoutConfirm(true);
    window.addEventListener("member:request-logout", open);
    return () => window.removeEventListener("member:request-logout", open);
  }, []);

  // const navItems = [
  //   { key: "dashboard", label: "Overview", icon: LayoutDashboard },
  //   { key: "qr", label: "My QR Code", icon: QrCode },
  //   { key: "attendance", label: "Attendance", icon: ClipboardCheck },
  //   { key: "events", label: "Events", icon: CalendarDays },
  //   { key: "notify", label: "Notifications", icon: Bell },
  //   { key: "settings", label: "Settings", icon: Settings },
  // ];

  const handleNavClick = (page: string) => {
    setActive(page);
    onCloseMobile?.();
  };

  const handleLogout = async () => {
    setLoggingOut(true);
    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

      await fetch('/logout', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
          ...(csrfToken && { 'X-CSRF-TOKEN': csrfToken })
        }
      });
    } catch (err) {
      console.error('Logout error:', err);
    } finally {
      // Clear ALL storage (safe because user is logging out)
      localStorage.clear();
      sessionStorage.clear();

      // Redirect to login page
      window.location.href = '/';
    }
  };

  // Same active/inactive nav classes as the staff Sidebar, so a highlighted
  // nav item looks identical in both portals.
  const inactiveNav = "text-white/55 hover:bg-white/[0.06] hover:text-white border border-transparent active:scale-[0.97] active:bg-white/[0.12]";
  const activeNav = "bg-white/10 text-white font-semibold border border-white/40 active:scale-[0.97]";

  return (
    <>
      {mobileOpen && (
        <div className="fixed inset-0 bg-black/55 z-30 xl:hidden" onClick={onCloseMobile} />
      )}

      <aside
        className={`w-[300px] sm:w-[320px] xl:w-[300px] 2xl:w-[340px] max-w-[88vw] flex-col transition-transform duration-300 ease-out overscroll-contain bg-[#0A0E1A] h-[100dvh] fixed xl:sticky top-0 z-40 flex overflow-hidden ${
          mobileOpen ? "translate-x-0" : "-translate-x-full xl:translate-x-0"
        }`}
      >
        <button onClick={onCloseMobile} className="xl:hidden absolute top-3 right-3 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full text-white/50 hover:bg-white/10 hover:text-white">
          <XIcon size={20} />
        </button>

        {/* Sidebar Header -- same block as the staff Sidebar's own. */}
        <div className="border-b border-white/10 px-4 h-[73px] box-border shrink-0 flex items-center gap-3">
          <div className="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 border border-white/15 shrink-0 overflow-hidden">
            <img
              src="/logo-removebg-preview.png"
              alt={t("dashLogoAlt")}
              className="w-full h-full object-contain"
            />
          </div>
          <div>
            <h1 className="font-display text-lg font-extrabold text-white whitespace-nowrap leading-tight">
              Piao<span className="text-white/40">Connect</span>
            </h1>
          </div>
        </div>

        {/* Navigation Menu */}
        <div className="flex-1 px-3 py-5 overflow-y-auto smooth-scroll">
          <p className="mb-3 px-3 text-[11px] font-bold uppercase tracking-[0.12em] text-white/35">
            {t("memberArea")}
          </p>
          <div className="space-y-1.5">
            {MEMBER_NAV_ITEMS.map((item) => {
              const isActive = active === item.key;
              return (
                <button
                  key={item.key}
                  onClick={() => handleNavClick(item.key)}
                  className={`flex items-center w-full rounded-xl px-4 py-3 gap-3 text-[13.5px] transition-all duration-200 group ${isActive ? activeNav : inactiveNav}`}
                >
                  <item.icon className="h-5 w-5 shrink-0" />
                  <span className="truncate flex-1 min-w-0 text-left">{t(item.key)}</span>
                  {(badges?.[item.key] ?? 0) > 0 && (
                    <span
                      className="ml-auto inline-flex h-6 min-w-[1.5rem] shrink-0 items-center justify-center rounded-full bg-red-500 px-2 text-xs font-bold text-white shadow-sm"
                      aria-label={`${badges![item.key]} unread`}
                    >
                      {badges![item.key] > 99 ? "99+" : badges![item.key]}
                    </span>
                  )}
                </button>
              );
            })}
          </div>
        </div>

      </aside>

      {/* Same dark "are you sure" confirm used by the staff Sidebar's own
          logout -- ending the session gets a deliberate, prominent step
          instead of the light peripheral-alert treatment. */}
      {showLogoutConfirm && (
        <div className="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-[90] px-4">
          <div className="w-full max-w-md rounded-[30px] border border-white/10 bg-[#0A0E1A] p-6 text-center shadow-2xl">
            <div className="mb-4 flex justify-center text-[#4FBEB0]"><LogOut size={40} /></div>
            <h3 className="font-display text-xl font-bold text-white mb-3">{t("confirmLogoutTitle")}</h3>
            <p className="text-[15px] text-white/55 mb-5">{t("confirmLogoutMessage")}</p>
            <div className="flex justify-center gap-4">
              <button onClick={() => setShowLogoutConfirm(false)} disabled={loggingOut} className="px-5 py-2.5 rounded-full border border-white/15 text-white/70 hover:bg-white/5 transition disabled:opacity-60">{t("cancel")}</button>
              <button onClick={handleLogout} disabled={loggingOut} className="px-5 py-2.5 rounded-full bg-gradient-to-r from-gold-400 to-[#4FBEB0] text-[#08130F] font-bold hover:opacity-90 transition disabled:opacity-60">{t("yesLogoutButton")}</button>
            </div>
          </div>
        </div>
      )}
    </>
  );
}
</file>

