    const memNames = r.memberships ? r.memberships.split(", ").filter(Boolean) : [];
    const memIds = availableMemberships.filter((m) => memNames.includes(m.name)).map((m) => m.id);

    const state: EditForm = {
      real_id: r.real_id,
      firstName: r.firstName,
