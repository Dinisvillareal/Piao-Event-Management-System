    public function mineAbsences()
{
    return response()->json(
        AbsenceReason::withCount('edits')
            ->where('user_id', auth()->id())
            ->get([
                'id', 'event_id', 'reason', 'comment',
                'staff_liked_at', 'staff_reply', 'staff_replied_at',
                'member_liked_reply_at', 'created_at',
            ])
            ->values()
