<file path="Claude outputs/_backup-myaccount/ChangePasswordForm.tsx">
import { useState } from "react";
import { Check, Circle } from "lucide-react";
import api, { apiErrorMessage } from "../../lib/api";
import { useLanguage } from "../../i18n/LanguageContext";
import { checkPassword, PASSWORD_MAX } from "../../lib/passwordPolicy";
import PasswordField from "./PasswordField";
import SaveButton from "../ui/SaveButton";

// Change your OWN password: current password + new password twice, with a
// live checklist. Used by My Account and by the forced "choose a new
// password" screen. `minLength` is 12 for the Head Staff account.
export default function ChangePasswordForm({
  userId,
  minLength = 8,
  currentLabel,
  onDone,
  submitLabel,
  split = false,
}: {
  userId: number | string;
  minLength?: number;
  currentLabel?: string;
  onDone: () => void;
  submitLabel?: string;
  /** Wide layout: fields on the left, rules + button on the right (from lg up). */
  split?: boolean;
}) {
  const { t } = useLanguage();
  const [current, setCurrent] = useState("");
  const [next, setNext] = useState("");
  const [confirm, setConfirm] = useState("");
  const [errors, setErrors] = useState<{ current?: string; next?: string; general?: string }>({});
  const [busy, setBusy] = useState(false);

  const checks = checkPassword(next);
  const longEnough = next.length >= minLength;
  const strong = checks.every((c) => c.ok) && longEnough;
  const matches = confirm.length > 0 && next === confirm;
  const ready = !!current && strong && matches && !busy;

  const submit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!ready) return;
    setBusy(true);
    setErrors({});
    try {
      await api.patch(`/users/${userId}/change-password`, {
        current_password: current,
        new_password: next,
        new_password_confirmation: confirm,
      }, { skipAuthRedirect: true } as any);
      onDone();
    } catch (err: any) {
      const e2 = err?.response?.data?.errors;
      setErrors({
        current: e2?.current_password?.[0],
        next: e2?.new_password?.[0],
        general: !e2 ? apiErrorMessage(err) : undefined,
      });
      setCurrent("");
    } finally {
      setBusy(false);
    }
  };

  const rules = [
    { ok: next.length >= minLength && next.length <= PASSWORD_MAX && !/\s/.test(next), label: t("secPwLength").replace("{n}", String(minLength)) },
    { ok: checks[1].ok, label: t("secPwLower") },
    { ok: checks[2].ok, label: t("secPwUpper") },
    { ok: checks[3].ok, label: t("secPwNumber") },
    { ok: checks[4].ok, label: t("secPwSpecial") },
  ];
  const ruleList = (
    <ul className={split ? "space-y-2.5 text-sm" : "mt-3 grid grid-cols-1 gap-1.5 px-2 text-sm sm:grid-cols-2"}>
      {rules.map((c) => (
        <li key={c.label} className={`flex items-center gap-2 ${c.ok ? "text-[#7DD8CB]" : "text-white/55"}`}>
          {c.ok ? <Check className="h-4 w-4 shrink-0" /> : <Circle className="h-3.5 w-3.5 shrink-0" />} {c.label}
        </li>
      ))}
    </ul>
  );
  const fieldsBlock = (
    <div className="space-y-5">
      <div>
        <label className="mb-1.5 block text-base font-semibold text-white">{currentLabel ?? t("secCurrentPassword")}</label>
        <PasswordField value={current} onChange={setCurrent} placeholder={currentLabel ?? t("secCurrentPassword")} autoComplete="current-password" disabled={busy} invalid={!!errors.current} />
        {errors.current && <p className="mt-1.5 px-2 text-sm text-red-400">{errors.current}</p>}
      </div>

      <div>
        <label className="mb-1.5 block text-base font-semibold text-white">{t("secNewPassword")}</label>
        <PasswordField value={next} onChange={setNext} placeholder={t("secNewPassword")} disabled={busy} invalid={!!errors.next} />
        {errors.next && <p className="mt-1.5 px-2 text-sm text-red-400">{errors.next}</p>}
        {!split && ruleList}
      </div>

      <div>
        <label className="mb-1.5 block text-base font-semibold text-white">{t("secConfirmNewPassword")}</label>
        <PasswordField value={confirm} onChange={setConfirm} placeholder={t("secConfirmNewPassword")} disabled={busy} invalid={confirm.length > 0 && !matches} />
        {confirm.length > 0 && !matches && <p className="mt-1.5 px-2 text-sm text-red-400">{t("passwordsDoNotMatch")}</p>}
      </div>
    </div>
  );
  const general = errors.general && <p className="rounded-xl border border-red-500/25 bg-red-500/10 px-4 py-2.5 text-sm text-red-400">{errors.general}</p>;
  const button = <SaveButton className="w-full" active={ready}>{busy ? t("savingLabel") : (submitLabel ?? t("secUpdatePassword"))}</SaveButton>;

  if (split) {
    return (
      <form onSubmit={submit} noValidate className="grid grid-cols-1 gap-8 lg:grid-cols-2">
        {fieldsBlock}
        <div className="flex flex-col gap-5">
          <div className="rounded-xl border border-white/10 bg-white/[0.03] p-5">
            <p className="mb-3 text-sm font-semibold text-white">{t("secPwRulesTitle")}</p>
            {ruleList}
          </div>
          {general}
          <div className="mt-auto">{button}</div>
        </div>
      </form>
    );
  }

  return (
    <form onSubmit={submit} noValidate className="space-y-5">
      {fieldsBlock}
      {general}
      {button}
    </form>
  );
}
</file>

<file path="Claude outputs/_backup-myaccount/MyAccountView.tsx">
import { useCallback, useEffect, useRef, useState } from "react";
import { QRCodeSVG } from "qrcode.react";
import { KeyRound, ShieldCheck, Smartphone, BellRing, Crown, CheckCircle2 } from "lucide-react";
import api, { apiErrorMessage } from "../../../lib/api";
import { useLanguage } from "../../../i18n/LanguageContext";
import ChangePasswordForm from "../../../components/auth/ChangePasswordForm";
import PasswordConfirmDialog from "../../../components/auth/PasswordConfirmDialog";
import SaveButton from "../../../components/ui/SaveButton";
import SectionCard from "../../../components/ui/SectionCard";
import Skeleton from "../../../components/ui/Skeleton";
import SimplePager from "../../../components/ui/SimplePager";
import usePager from "../../../hooks/usePager";
import { notifyStaffAlertsChanged, setSecurityUnread } from "../../../lib/staffAlertsStore";

type Me = {
  id: number;
  user_code: string;
  first_name: string;
  last_name: string;
  is_head_staff: boolean;
  last_login_at: string | null;
  two_factor_enabled: boolean;
};
type SecAlert = { id: number; type: string; title: string; message: string; read: boolean; created_at: string };

export default function MyAccountView() {
  const { t, locale } = useLanguage();
  const [me, setMe] = useState<Me | null>(null);
  const [alerts, setAlerts] = useState<SecAlert[]>([]);
  const [transfer, setTransfer] = useState<{ from_name: string | null; expires_at: string } | null>(null);
  const [pwDone, setPwDone] = useState(false);
  const [notice, setNotice] = useState("");

  // two-step login
  const [tfaSetup, setTfaSetup] = useState<{ secret: string; uri: string } | null>(null);
  const [tfaCode, setTfaCode] = useState("");
  const [tfaError, setTfaError] = useState("");
  const [tfaBusy, setTfaBusy] = useState(false);
  const [askSetupPw, setAskSetupPw] = useState(false);
  const [offCode, setOffCode] = useState("");
  const [askOffPw, setAskOffPw] = useState(false);
  const [offOpen, setOffOpen] = useState(false);
  const [acceptOpen, setAcceptOpen] = useState(false);

  const alertsRef = useRef<SecAlert[]>([]);
  alertsRef.current = alerts;

  const load = useCallback(async () => {
    try {
      const [m, a, tr] = await Promise.all([
        api.get("/me"),
        api.get("/security/alerts"),
        api.get("/staff/head-transfer"),
      ]);
      setMe(m.data);
      setAlerts(a.data.data ?? []);
      setTransfer(tr.data.transfer ?? null);
    } catch { /* the api client already handles sign-outs */ }
  }, []);

  useEffect(() => { load(); }, [load]);

  // Opening this page counts as reading the alerts -- they stay highlighted
  // while you look, and are marked read when you leave.
  useEffect(() => () => {
    if (alertsRef.current.some((a) => !a.read)) {
      api.post("/security/alerts/read-all").then(() => { setSecurityUnread(0); notifyStaffAlertsChanged(); }).catch(() => {});
    }
  }, []);

  const minLength = me?.is_head_staff ? 12 : 8;

  const startSetup = async (password: string) => {
    const res = await api.post("/two-factor/setup", { password });
    setTfaSetup({ secret: res.data.secret, uri: res.data.uri });
    setTfaCode("");
    setTfaError("");
    setAskSetupPw(false);
  };

  const confirmSetup = async (e: React.FormEvent) => {
    e.preventDefault();
    setTfaBusy(true);
    setTfaError("");
    try {
      await api.post("/two-factor/confirm", { code: tfaCode });
      setTfaSetup(null);
      setNotice(t("secTwoStepOnNotice"));
      await load();
    } catch (err: any) {
      setTfaError(err?.response?.data?.errors?.code?.[0] || apiErrorMessage(err));
    } finally {
      setTfaBusy(false);
    }
  };

  const turnOff = async (password: string) => {
    await api.post("/two-factor/disable", { password, code: offCode });
    setAskOffPw(false);
    setOffOpen(false);
    setOffCode("");
    setNotice(t("secTwoStepOffNotice"));
    await load();
  };

  const accept = async (password: string, otp: string) => {
    await api.post("/staff/head-transfer/accept", { password, otp });
    setAcceptOpen(false);
    window.location.reload(); // new role -> reload so the whole page reflects it
  };

  const when = (iso: string | null) => (iso ? new Date(iso).toLocaleString(locale) : t("secNever"));
  const pretty = (s: string) => s.replace(/(.{4})/g, "$1 ").trim();

  const initials = me ? `${me.first_name?.[0] ?? ""}${me.last_name?.[0] ?? ""}`.toUpperCase() || "S" : "";
  const unread = alerts.filter((a) => !a.read).length;
  const alertPager = usePager(alerts, 5);
  const pill = "inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-bold";
  const ghostBtn = "rounded-full border border-white/20 px-5 py-2 text-sm font-semibold text-white transition hover:bg-white/10";

  return (
    <div className="-m-3 sm:-m-6 min-h-[calc(100dvh-73px)] bg-[#0A0E1A] p-4 sm:p-8">
    <div className="space-y-6">
      <div>
        <h1 className="font-display text-2xl font-bold text-white sm:text-3xl">{t("myaccount")}</h1>
        <p className="mt-1.5 max-w-2xl text-sm text-white/55">{t("secMyAccountSubtitle")}</p>
      </div>

      {notice && (
        <div className="flex items-center gap-2 rounded-xl border border-[#4FBEB0]/30 bg-[#4FBEB0]/10 px-4 py-3 text-sm text-[#7DD8CB]">
          <CheckCircle2 className="h-5 w-5 shrink-0" /> {notice}
        </div>
      )}

      {transfer && (
        <div className="rounded-2xl border border-gold-400/40 bg-gold-400/10 p-5 sm:p-6">
          <div className="flex flex-wrap items-center gap-4">
            <Crown className="h-7 w-7 shrink-0 text-gold-300" />
            <div className="min-w-0 flex-1">
