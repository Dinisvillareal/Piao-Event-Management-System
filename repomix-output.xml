                      <KeyRound className="h-4 w-4 text-white" />
                    </span>
                  </button>
                </div>
              </div>
            </div>
          </Portal>
        );
      })()}
      {activationSlip && <ActivationSlipModal slip={activationSlip} onClose={() => setActivationSlip(null)} />}
      <ConfirmDialog
