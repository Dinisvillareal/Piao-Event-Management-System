<file path="resources/js/pages/staff/components/Sidebar.tsx">
import { useStaffAlertsUnread, useSecurityUnread } from "../../../lib/staffAlertsStore";
import { matchesSearch } from "../../../lib/search";
import React, { useState, useEffect, useMemo } from "react";
import {
  LayoutDashboard,
  ScanLine,
  Users,
  Home,
  Award,
  CalendarDays,
  Bell,
  Settings,
  LogOut,
  FileText,
  Archive,
  ChevronDown,
  ChevronUp,
  BarChart3,
  Package,
  Wallet,
  Link2,
  Tags,
  X as XIcon,
  IdCard,
  CalendarCheck,
  Boxes,
  Undo2,
  Search,
  SearchX,
  UserCog,
  ShieldCheck,
  MessageSquareText,
} from "lucide-react";
import { useLanguage } from "../../../i18n/LanguageContext";
import { staffPathFor } from "../../../lib/staffRoutes";
import { MEMBER_NAV_ITEMS } from "../../../components/layout/Sidebar";
import api from "../../../lib/api";

// --- NAVIGATION CONFIG ---
export const NAV = [
  { key: "dashboard", path: staffPathFor("dashboard"), label: "Overview", icon: LayoutDashboard },
  { key: "scan", path: staffPathFor("scan"), label: "QR Scanner", icon: ScanLine },
  { key: "residents", path: staffPathFor("residents"), label: "Residents", icon: Users },
  { key: "households", path: staffPathFor("households"), label: "Households", icon: Home },
  { key: "memberships", path: staffPathFor("memberships"), label: "Memberships", icon: Award },
  { key: "events", path: staffPathFor("events"), label: "Events & Attendance", icon: CalendarDays },
  { key: "notify", path: staffPathFor("notify"), label: "Notifications", icon: Bell },
  { key: "reports", path: staffPathFor("reports"), label: "Reports & Analytics", icon: BarChart3 },
  { key: "inventory", path: staffPathFor("inventory"), label: "Inventory", icon: Package },
  { key: "budget", path: staffPathFor("budget"), label: "Budget & Expenses", icon: Wallet },
  { key: "returns", path: staffPathFor("returns"), label: "Returns", icon: Undo2 },
];

export const HEAD_STAFF_NAV = [
  { key: "staffaccounts", path: staffPathFor("staffaccounts"), label: "Staff Accounts", icon: ShieldCheck },
  { key: "feedbackrules", path: staffPathFor("feedbackrules"), label: "Feedback Rules", icon: MessageSquareText },
];

export const SETTINGS_NAV = [
  // Account
  { key: "myaccount", section: "account", path: staffPathFor("myaccount"), label: "My Account", icon: UserCog },
  // Head Staff only (hidden for everyone else in the Sidebar below).
  //{ key: "staffaccounts", section: "account", path: staffPathFor("staffaccounts"), label: "Staff Accounts", icon: ShieldCheck },
  // Records & audit
  { key: "activitylogs", section: "records", path: staffPathFor("activitylogs"), label: "Activity Logs", icon: FileText },
  { key: "archive", section: "records", path: staffPathFor("archive"), label: "Trash / Archive", icon: Archive },
  // Configuration
  { key: "profiling", section: "config", path: staffPathFor("profiling"), label: "Age & Status Categories", icon: Tags },
  { key: "integrations", section: "config", path: staffPathFor("integrations"), label: "Integrations", icon: Link2 },
  //{ key: "feedbackrules", section: "config", path: staffPathFor("feedbackrules"), label: "Feedback Rules", icon: MessageSquareText },
];

const STAFF_MEMBER_KEY_MAP: Record<string, string> = {
  dashboard: "memberDashboard",
  qr: "memberQr",
  attendance: "memberAttendance",
  events: "memberEvents",
  notify: "memberNotify",
};

export const MEMBER_NAV = MEMBER_NAV_ITEMS
  .filter((item) => item.key in STAFF_MEMBER_KEY_MAP)
  .map((item) => {
    const staffKey = STAFF_MEMBER_KEY_MAP[item.key];
    return {
      key: staffKey,
      labelKey: item.key,
      path: staffPathFor(staffKey),
      label: item.label,
      icon: item.icon,
    };
  });

// Settings is split into labelled sections so related pages sit together.
export const SETTINGS_SECTIONS = [
  { id: "account", labelKey: "secSectionAccount" },
  { id: "records", labelKey: "secSectionRecords" },
  { id: "config", labelKey: "secSectionConfig" },
];

// --- MODULE GROUPING ---
// The nav used to be one long flat list. It's now organized the same way
// Settings already was: a handful of collapsible modules, each bundling
// related pages together. Dashboard and Reports & Analytics stay as
// standalone top-level links (each is its own single destination, not a
// category), same as Settings' own trigger button below.
const NAV_BY_KEY: Record<string, typeof NAV[number]> = Object.fromEntries(NAV.map((item) => [item.key, item]));

// Each group icon is deliberately different from every icon used by its
// own children below -- reusing a child's icon (e.g. the Events & Check-in
// group and the Events item both showing a calendar) reads as a visual
// duplicate.
const NAV_GROUP_DEFS: { key: string; labelKey: string; icon: any; itemKeys: string[] }[] = [
  { key: "membershipGroup", labelKey: "navGroupMembership", icon: IdCard, itemKeys: ["residents", "households", "memberships"] },
  { key: "eventsGroup", labelKey: "navGroupEvents", icon: CalendarCheck, itemKeys: ["events", "scan", "notify"] },
  { key: "resourcesGroup", labelKey: "navGroupResources", icon: Boxes, itemKeys: ["inventory", "budget", "returns"] },
];

export const NAV_GROUPS = NAV_GROUP_DEFS.map((g) => ({
  ...g,
  items: g.itemKeys.map((k) => NAV_BY_KEY[k]).filter(Boolean),
}));

const STANDALONE_NAV_KEYS = ["dashboard", "reports"];
export const STANDALONE_NAV = STANDALONE_NAV_KEYS.map((k) => NAV_BY_KEY[k]).filter(Boolean);

interface SidebarProps {
  active: string;
  setActive: (key: string, path?: string) => void;
  mobileOpen?: boolean;
  onCloseMobile?: () => void;
  /** Signed-in staff member, shown in the account card above "Sign out". */
  userName?: string;
  userRole?: string;
  /** Only the Head Staff sees the Staff Accounts page. */
  isHeadStaff?: boolean;
}

export default function Sidebar({ active, setActive, mobileOpen = false, onCloseMobile, userName, userRole, isHeadStaff = false }: SidebarProps) {
  const { t } = useLanguage();
  const [showLogoutConfirm, setShowLogoutConfirm] = useState(false);
  const [loggingOut, setLoggingOut] = useState(false);
  const [navQuery, setNavQuery] = useState("");
  // Count of households with no head of household -- red badge on
  // Households (and its group) so staff notice a head must be added.
  const [householdAlerts, setHouseholdAlerts] = useState(0);
  // Unread feedback alerts (shared with the top-bar bell).
  const feedbackUnread = useStaffAlertsUnread();
  // Unread security alerts -- badge on My Account.
  const securityUnread = useSecurityUnread();
  //const settingsNav = useMemo(() => SETTINGS_NAV.filter((i) => (i.key !== "staffaccounts" && i.key !== "feedbackrules") || isHeadStaff), [isHeadStaff]);
  const headStaffNav = useMemo(() => (isHeadStaff ? HEAD_STAFF_NAV : []), [isHeadStaff]);
  const settingsNav = SETTINGS_NAV;
  useEffect(() => {
    let cancelled = false;
    api.get("/households/alerts")
      .then((r) => { if (!cancelled) setHouseholdAlerts(Array.isArray(r.data) ? r.data.length : 0); })
      .catch(() => {});
    return () => { cancelled = true; };
  }, [active]);
  useEffect(() => {
    const onChange = (e: Event) => setHouseholdAlerts(Number((e as CustomEvent).detail) || 0);
    window.addEventListener("household-alerts", onChange);
    return () => window.removeEventListener("household-alerts", onChange);
  }, []);
  const accountName = (userName ?? "").trim();
  const accountInitials = accountName
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join("") || "S";

  // Every real destination in the sidebar, flattened once, so the search
  // box below can filter across standalone links, every module's items,
  // and Settings' submenu all at the same time -- a real quick-jump, not
  // a decorative input that does nothing.
  const allNavItems = useMemo(
    () => [...headStaffNav,...STANDALONE_NAV, ...NAV_GROUPS.flatMap((g) => g.items), ...settingsNav],
    [settingsNav]
  );
  const trimmedQuery = navQuery.trim().toLowerCase();
  const searchResults = trimmedQuery
    ? allNavItems.filter((item) => matchesSearch(navQuery, t(item.key), item.label))
    : [];

  // Which module the currently active page lives under -- "settings" is
  // its own pseudo-group key here, matching the group SETTINGS_NAV renders
  // into below.
  const findGroupKeyForActive = (activeKey: string): string | null => {
    const group = NAV_GROUPS.find((g) => g.items.some((i) => i.key === activeKey));
    if (group) return group.key;
    if (SETTINGS_NAV.some((i) => i.key === activeKey)) return "settings";
    return null;
  };

  // Collapsible modules, same interaction as the pre-existing Settings
  // submenu -- closed by default, but whichever module the current page
  // belongs to starts open so navigating here directly doesn't hide it.
  const [openGroups, setOpenGroups] = useState<Record<string, boolean>>(() => {
    const initial: Record<string, boolean> = {};
    const activeGroup = findGroupKeyForActive(active);
    if (activeGroup) initial[activeGroup] = true;
    return initial;
  });

  useEffect(() => {
    const activeGroup = findGroupKeyForActive(active);
    if (activeGroup) {
      setOpenGroups((prev) => (prev[activeGroup] ? prev : { ...prev, [activeGroup]: true }));
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [active]);

  const toggleGroup = (key: string) => setOpenGroups((prev) => ({ ...prev, [key]: !prev[key] }));

  // Bolds + golds the matched substring inside a nav label while typing in
  // the search box (e.g. "das" in "Dashboard"), rather than just filtering
  // the list with no visual cue about what matched.
  const highlightMatch = (label: string, query: string) => {
    if (!query) return label;
    const idx = label.toLowerCase().indexOf(query.toLowerCase());
    if (idx === -1) return label;
    return (
      <>
        {label.slice(0, idx)}
        <span className="font-bold text-gold-400">{label.slice(idx, idx + query.length)}</span>
        {label.slice(idx + query.length)}
      </>
    );
  };

  const handleNavClick = (key: string, path?: string) => {
    setActive(key, path);
    setNavQuery("");
    onCloseMobile?.();
  };

  // The profile menu in the top bar asks for the same confirm dialog.
  useEffect(() => {
    const open = () => setShowLogoutConfirm(true);
    window.addEventListener("staff:request-logout", open);
    return () => window.removeEventListener("staff:request-logout", open);
  }, []);

  const doLogout = async () => {
    setLoggingOut(true);
    console.log('Logging out...');
    try {
      const token = document.cookie
        .split('; ')
        .find(row => row.startsWith('XSRF-TOKEN='))
        ?.split('=')[1];

      const decodedToken = token ? decodeURIComponent(token) : '';

      await fetch('/logout', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
          'X-XSRF-TOKEN': decodedToken
        }
      });

      localStorage.clear();
      sessionStorage.clear();
      window.location.href = '/';

    } catch (err) {
      console.error('Logout error:', err);
      localStorage.clear();
      sessionStorage.clear();
      window.location.href = '/';
    }
  };

  const inactiveNav = "text-white/55 hover:bg-white/[0.06] hover:text-white border border-transparent active:scale-[0.97] active:bg-white/[0.12]";
  const activeNav = "bg-white/10 text-white font-semibold border border-white/40 active:scale-[0.97]";

  return (
    <>
      {mobileOpen && (
        <div className="print:hidden fixed inset-0 bg-black/55 z-30 xl:hidden" onClick={onCloseMobile} />
      )}

      <aside
        className={`print:hidden w-[300px] sm:w-[320px] xl:w-[300px] 2xl:w-[340px] max-w-[88vw] flex-col transition-transform duration-300 ease-out overscroll-contain bg-[#0A0E1A] h-[100dvh] fixed xl:sticky top-0 z-40 flex overflow-hidden ${
          mobileOpen ? "translate-x-0" : "-translate-x-full xl:translate-x-0"
        }`}
      >
        <button
          onClick={onCloseMobile}
          className="xl:hidden absolute top-3 right-3 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full text-white/50 hover:bg-white/10 hover:text-white"
        >
          <XIcon size={20} />
        </button>
        <div className="border-b border-white/10 px-4 h-[73px] box-border shrink-0 flex items-center gap-3">
          <div className="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 border border-white/15 font-black shrink-0 overflow-hidden">
            <img
              src="/logo-removebg-preview.png"
              alt={t("dashLogoAlt")}
              className="w-full h-full object-contain"
            />
          </div>
          <div>
            <h1 className="font-display text-lg font-extrabold text-white whitespace-nowrap leading-tight">Piao<span className="text-white/40">Connect</span></h1>
          </div>
        </div>

        {/* Quick-jump search -- filters every real nav destination
            (standalone links, module items, and Settings' submenu) as you
            type, rather than sitting there decoratively. */}
        <div className="px-3 pt-4 shrink-0">
          <div className="relative">
            <Search className="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-white/35" />
            <input
              type="text"
              value={navQuery}
              onChange={(e) => setNavQuery(e.target.value)}
              placeholder={t("search")}
              className="w-full rounded-xl border border-white/10 bg-white/[0.05] py-2.5 pl-10 pr-[4.5rem] text-[13.5px] text-white placeholder-white/35 transition focus:outline-none focus:border-[#4FBEB0] focus:ring-2 focus:ring-[#4FBEB0]/20"
            />
            {navQuery && (
              <button
                type="button"
                onClick={() => setNavQuery("")}
                aria-label={t("clearSearchAria")}
                title={t("clearLabel")}
                className="absolute right-3 top-1/2 -translate-y-1/2 flex items-center justify-center rounded-full border border-white/10 bg-[#0A0E1A] px-3 py-1 text-xs font-bold text-white shadow-sm transition hover:bg-[#161C2E]"
              >
                {t("clearLabel")}
              </button>
            )}
          </div>
        </div>

        <div className="flex-1 px-3 py-5 overflow-y-auto smooth-scroll">
          {trimmedQuery ? (
            <>
              <p className="mb-3 px-3 text-[11px] font-bold uppercase tracking-[0.12em] text-white/35">
                {searchResults.length > 0 ? t("dashSearchResults") : t("dashNoMatches")}
              </p>
              {searchResults.length > 0 ? (
                <div className="space-y-1.5">
                  {searchResults.map((item) => (
                    <button
                      key={item.key}
                      onClick={() => handleNavClick(item.key, item.path)}
                      className={`flex items-center w-full rounded-xl px-4 py-3 gap-3 text-[13.5px] transition-all duration-200 group border ${
                        active === item.key
                          ? "bg-white/10 text-white font-semibold border-white/40"
                          : "text-white/55 hover:bg-white/[0.06] hover:text-white border-white/10"
                      }`}
                    >
                      <item.icon className="h-5 w-5 shrink-0" />
                      <span className="truncate flex-1 min-w-0 text-left">{highlightMatch(t(item.key), trimmedQuery)}</span>
                      {item.key === "notify" && feedbackUnread > 0 && (
                        <span className="ml-auto inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-red-500 px-1.5 text-[11px] font-bold leading-none text-white" aria-label={`${feedbackUnread} unread`}>{feedbackUnread > 99 ? "99+" : feedbackUnread}</span>
                      )}
                      {item.key === "myaccount" && securityUnread > 0 && (
                        <span className="ml-auto inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-red-500 px-1.5 text-[11px] font-bold leading-none text-white" aria-label={`${securityUnread} unread`}>{securityUnread > 99 ? "99+" : securityUnread}</span>
                      )}
                    </button>
                  ))}
                </div>
              ) : (
                <div className="flex flex-col items-center gap-2 px-4 py-8 text-center text-white/35">
                  <SearchX className="h-6 w-6" />
                  <p className="text-[13px]">{t("dashNothingMatches").replace("{query}", navQuery)}</p>
                </div>
              )}
            </>
          ) : (
            <>

            {isHeadStaff && (
                <div className="mb-6 border-b border-white/10 pb-5">
                  <p className="mb-3 px-3 text-[11px] font-bold uppercase tracking-[0.12em] text-white/35">
                    Head Staff
                  </p>
                  <div className="space-y-1.5">
                    {HEAD_STAFF_NAV.map((item) => (
                      <button
                        key={item.key}
                        onClick={() => handleNavClick(item.key, item.path)}
                        className={`flex items-center w-full rounded-xl px-4 py-3 gap-3 text-[13.5px] transition-all duration-200 group ${
                          active === item.key ? activeNav : inactiveNav
                        }`}
                      >
                        <item.icon className="h-5 w-5 shrink-0" />
                        <span className="truncate flex-1 min-w-0 text-left">{t(item.key)}</span>
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <p className="mb-3 px-3 text-[11px] font-bold uppercase tracking-[0.12em] text-white/35">{t("staffConsole")}</p>
              <div className="space-y-1.5">
                {/* STANDALONE LINKS -- Dashboard and Reports each go straight
                    to one page, so they stay flat instead of being wrapped in
                    a one-item module. */}
                {STANDALONE_NAV.map((item) => (
                  <button key={item.key} onClick={() => handleNavClick(item.key, item.path)} className={`flex items-center w-full rounded-xl px-4 py-3 gap-3 text-[13.5px] transition-all duration-200 group ${active === item.key ? activeNav : inactiveNav}`}>
                    <item.icon className="h-5 w-5 shrink-0" />
                    <span className="truncate flex-1 min-w-0 text-left">{t(item.key)}</span>
                  </button>
                ))}

                {/* MODULES -- same collapsible pattern as Settings below, just
                    generalized to every related group of pages. */}
                {NAV_GROUPS.map((group) => (
                  <div key={group.key} className="space-y-1">
                    <button
                      onClick={() => toggleGroup(group.key)}
                      className={`flex items-center w-full rounded-xl px-4 py-3 gap-3 text-[13.5px] transition-all duration-200 group ${inactiveNav}`}
                    >
                      <group.icon className="h-5 w-5 shrink-0" />
                      <span className="truncate flex-1 min-w-0 text-left">{t(group.labelKey)}</span>
                      {group.key === "membershipGroup" && householdAlerts > 0 && !openGroups[group.key] && (
                        <span className="inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-red-500 px-1.5 text-[11px] font-bold leading-none text-white" title={t("hhAlertBannerTitle").replace("{count}", String(householdAlerts))}>{householdAlerts > 99 ? "99+" : householdAlerts}</span>
                      )}
                      {group.key === "eventsGroup" && feedbackUnread > 0 && !openGroups[group.key] && (
                        <span className="inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-red-500 px-1.5 text-[11px] font-bold leading-none text-white" aria-label={`${feedbackUnread} unread`}>{feedbackUnread > 99 ? "99+" : feedbackUnread}</span>
                      )}
                      {openGroups[group.key] ? <ChevronUp size={16} className="text-white/35" /> : <ChevronDown size={16} className="text-white/35" />}
                    </button>

                    {openGroups[group.key] && (
                      <div className="pl-6 space-y-1 mt-1">
                        {group.items.map((item) => (
                          <button
                            key={item.key}
                            onClick={() => handleNavClick(item.key, item.path)}
                            className={`flex items-center w-full rounded-xl px-4 py-3 gap-3 text-[13.5px] transition-all duration-200 group ${active === item.key ? activeNav : inactiveNav}`}
                          >
                            <item.icon className="h-5 w-5 shrink-0" />
                            <span className="truncate flex-1 min-w-0 text-left">{t(item.key)}</span>
                            {item.key === "notify" && feedbackUnread > 0 && (
                              <span className="ml-auto inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-red-500 px-1.5 text-[11px] font-bold leading-none text-white" aria-label={`${feedbackUnread} unread`}>{feedbackUnread > 99 ? "99+" : feedbackUnread}</span>
                            )}
                            {item.key === "households" && householdAlerts > 0 && (
                              <span className="ml-auto inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-red-500 px-1.5 text-[11px] font-bold leading-none text-white" title={t("hhAlertBannerTitle").replace("{count}", String(householdAlerts))}>{householdAlerts > 99 ? "99+" : householdAlerts}</span>
                            )}
                          </button>
                        ))}
                      </div>
                    )}
                  </div>
                ))}

                {/* SETTINGS WITH SUBMENU */}
                <div className="space-y-1">
                  <button
                    onClick={() => toggleGroup("settings")}
                    className={`flex items-center w-full rounded-xl px-4 py-3 gap-3 text-[13.5px] transition-all duration-200 group ${inactiveNav}`}
                  >
                    <Settings className="h-5 w-5 shrink-0" />
                    <span className="truncate flex-1 min-w-0 text-left">{t("settings")}</span>
                    {securityUnread > 0 && !openGroups["settings"] && (
                      <span className="inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-red-500 px-1.5 text-[11px] font-bold leading-none text-white" aria-label={`${securityUnread} unread`}>{securityUnread > 99 ? "99+" : securityUnread}</span>
                    )}
                    {openGroups["settings"] ? <ChevronUp size={16} className="text-white/35" /> : <ChevronDown size={16} className="text-white/35" />}
                  </button>

                  {/* SUB NAVIGATION */}
                  {openGroups["settings"] && (
                    <div className="pl-6 space-y-1 mt-1">
                      {SETTINGS_SECTIONS.filter((sec) => settingsNav.some((i) => i.section === sec.id)).map((sec, idx) => (
                        <div key={sec.id} className={idx === 0 ? "" : "mt-3"}>
                          <p className="px-4 pb-1.5 pt-1 text-[11px] font-bold uppercase tracking-[0.14em] text-white/35">{t(sec.labelKey)}</p>
                          <div className="space-y-1">
                          {settingsNav.filter((i) => i.section === sec.id).map((item) => (
                            <button
                              key={item.key}
                              onClick={() => handleNavClick(item.key, item.path)}
                              className={`flex items-center w-full rounded-xl px-4 py-3 gap-3 text-[13.5px] transition-all duration-200 group ${active === item.key ? activeNav : inactiveNav}`}
                            >
                              <item.icon className="h-5 w-5 shrink-0" />
                              <span className="truncate flex-1 min-w-0 text-left">{t(item.key)}</span>
                              {item.key === "myaccount" && securityUnread > 0 && (
                                <span className="ml-auto inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-red-500 px-1.5 text-[11px] font-bold leading-none text-white" aria-label={`${securityUnread} unread`}>{securityUnread > 99 ? "99+" : securityUnread}</span>
                              )}
                            </button>
                          ))}
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </>
          )}
          
          <div className="mt-6 border-t border-white/10 pt-5">
                <p className="mb-3 px-3 text-[11px] font-bold uppercase tracking-[0.12em] text-white/35">
                  {t("memberArea")}
                </p>
                <div className="space-y-1.5">
                  {MEMBER_NAV.map((item) => (
                    <button
                      key={item.key}
                      onClick={() => handleNavClick(item.key, item.path)}
                      className={`flex items-center w-full rounded-xl px-4 py-3 gap-3 text-[13.5px] transition-all duration-200 group ${
                        active === item.key ? activeNav : inactiveNav
                      }`}
                    >
                      <item.icon className="h-5 w-5 shrink-0" />
                      <span className="truncate flex-1 min-w-0 text-left">{t(item.labelKey)}</span>
                    </button>
                  ))}
                </div>
              </div>
              
        </div>
      </aside>

      {/* Templated confirm modal, same pattern used for every delete action
          in the app -- logout is destructive to the current session so it
          gets the same "are you sure" treatment instead of firing instantly. */}
      {showLogoutConfirm && (
        <div className="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-[90] px-4">
          <div className="w-full max-w-md rounded-[30px] border border-white/10 bg-[#0A0E1A] p-6 text-center shadow-2xl">
            <div className="mb-4 flex justify-center text-[#4FBEB0]"><LogOut size={40} /></div>
            <h3 className="font-display text-xl font-bold text-white mb-3">{t("confirmLogoutTitle")}</h3>
            <p className="text-[15px] text-white/55 mb-5">{t("confirmLogoutMessage")}</p>
            <div className="flex justify-center gap-4">
              <button onClick={() => setShowLogoutConfirm(false)} disabled={loggingOut} className="px-5 py-2.5 rounded-full border border-white/15 text-white/70 hover:bg-white/5 transition disabled:opacity-60">{t("cancel")}</button>
              <button onClick={doLogout} disabled={loggingOut} className="px-5 py-2.5 rounded-full bg-gradient-to-r from-gold-400 to-[#4FBEB0] text-[#08130F] font-bold hover:opacity-90 transition disabled:opacity-60">{t("yesLogoutButton")}</button>
            </div>
          </div>
        </div>
      )}
    </>
  );
}
</file>

<file path="resources/js/pages/staff/views/HouseholdsView.tsx">
import SaveButton from "../../../components/ui/SaveButton";
import FormDrawer, { FormSection } from "../../../components/ui/FormDrawer";
import React, { useEffect, useMemo, useRef, useState } from "react";
import { Home, Users, Plus, Pencil, Trash2, Star, UserPlus, X, AlertCircle, AlertTriangle, ChevronDown, Search, Check } from "lucide-react";
import ConfirmDialog from "../../../components/ui/ConfirmDialog";
import StatusModal from "../../../components/ui/StatusModal";
import Skeleton from "../../../components/ui/Skeleton";
import { highlightMatches } from "../../../lib/highlight";
import { useLanguage } from "../../../i18n/LanguageContext";
import PagerSkeleton from "../../../components/ui/PagerSkeleton";
import FilterBar from "../../../components/ui/FilterBar";
import Portal from "../../../components/ui/Portal";

/**
 * Real Household module -- staff pick an existing household (or create one)
 * instead of retyping a free-text household_code, so families stay grouped
 * correctly for household-head SMS notifications (see SmsService).
 */

interface Member {
  id: number;
  user_code: string;
  first_name: string;
  last_name: string;
  middle_name?: string | null;
  contact_number: string;
  is_household_head: boolean;
  role?: "Resident" | "Staff";
}

interface HouseholdAlert {
  id: number;
  code: string;
  address: string | null;
  members_count: number;
}

interface Household {
  id: number;
  code: string;
  address: string | null;
  contact_number: string | null;
  members_count: number;
  members: Member[];
  created_at?: string;
}

const csrfToken = () =>
  decodeURIComponent(
    document.cookie.split("; ").find((r) => r.startsWith("XSRF-TOKEN="))?.split("=")[1] ?? ""
  );

async function api(url: string, options: RequestInit = {}) {
  const res = await fetch(url, {
    credentials: "include",
    ...options,
    headers: {
      Accept: "application/json",
      "Content-Type": "application/json",
      "X-XSRF-TOKEN": csrfToken(),
      ...(options.headers || {}),
    },
  });
  const isJson = res.headers.get("content-type")?.includes("application/json");
  const body = isJson ? await res.json().catch(() => null) : null;
  if (!res.ok) {
    const message = body?.message || `HTTP ${res.status}`;
    throw new Error(message);
  }
  return body;
}

function fullName(m: Member) {
  return [m.first_name, m.middle_name, m.last_name].filter(Boolean).join(" ");
}

// A resident picker backed by the server: the typed search is matched by the database
// (HouseholdController::unassigned, paged=1) and only the first matches come back.
function useUnassignedSearch(search: string, enabled: boolean, exclude: number | null = null, reloadKey: unknown = 0) {
  const [rows, setRows] = useState<Member[]>([]);
  const [total, setTotal] = useState(0);
  const seq = useRef(0);
  useEffect(() => {
    if (!enabled) return;
    const timer = setTimeout(async () => {
      const id = ++seq.current;
      try {
        const qs = new URLSearchParams({ paged: "1", per_page: "30" });
        if (search.trim()) qs.set("search", search.trim());
        if (exclude) qs.set("exclude", String(exclude));
        const res = await api(`/households/unassigned?${qs.toString()}`);
        if (id !== seq.current) return;
        setRows(Array.isArray(res?.data) ? res.data : []);
        setTotal(res?.total ?? 0);
      } catch {
        if (id === seq.current) { setRows([]); setTotal(0); }
      }
    }, 120);
    return () => clearTimeout(timer);
  }, [search, enabled, exclude, reloadKey]);
  return { rows, total };
}

export default function HouseholdsView() {
  const { t } = useLanguage();

  const [households, setHouseholds] = useState<Household[]>([]);
  const [loadTick, setLoadTick] = useState(0); // bumps after every reload so the pickers refetch
  const [addHeadPicked, setAddHeadPicked] = useState<Member | null>(null);
  const [loading, setLoading] = useState(true);
  const [search, setSearch] = useState("");
  // Server-side size filter + sort (the list is paginated by the API).
  const [sizeFilter, setSizeFilter] = useState("all");
  const [sortKey, setSortKey] = useState("newest");
  const [matchTotal, setMatchTotal] = useState(0);
  const [page, setPage] = useState(1);
  const [lastPage, setLastPage] = useState(1);

  const [expandedId, setExpandedId] = useState<number | null>(null);
  const [memberSearch, setMemberSearch] = useState("");
  const [pickerFor, setPickerFor] = useState<number | null>(null);

  const [editRecord, setEditRecord] = useState<Household | null>(null);
  const [editForm, setEditForm] = useState({ address: "", contact_number: "" });
  // Closing the Edit Household modal (backdrop or Cancel) with unsaved
  // changes asks first instead of silently discarding them.
  const [showEditCancelConfirm, setShowEditCancelConfirm] = useState(false);

  const [deleteRecord, setDeleteRecord] = useState<Household | null>(null);
  const [saving, setSaving] = useState(false);

  const [successMessage, setSuccessMessage] = useState<string | null>(null);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);
  const [confirmAdd, setConfirmAdd] = useState(false);
  // Add Household modal: a head is required, extra members are optional.
  const [addOpen, setAddOpen] = useState(false);
  const [addHeadId, setAddHeadId] = useState<number | null>(null);
  const [addMemberIds, setAddMemberIds] = useState<number[]>([]);
  const [addHeadSearch, setAddHeadSearch] = useState("");
  const [addMemberSearch, setAddMemberSearch] = useState("");
  const [showAddCancelConfirm, setShowAddCancelConfirm] = useState(false);
  // Households with no head of household -- live warning for staff.
  const [alerts, setAlerts] = useState<HouseholdAlert[]>([]);
  const [confirmEdit, setConfirmEdit] = useState(false);
  // Pending household-member action waiting on an "Are you sure?" answer.
  const [memberAction, setMemberAction] = useState<
    | { kind: "add" | "remove" | "head"; household: Household; member: Member }
    | null
  >(null);

  const load = async (searchValue = search, pageValue = page) => {
    setLoading(true);
    try {
      const qs = new URLSearchParams({ page: String(pageValue) });
      if (searchValue) qs.set("search", searchValue);
      if (sizeFilter !== "all") qs.set("size", sizeFilter);
      if (sortKey !== "newest") qs.set("sort", sortKey);
      const [list, warn] = await Promise.all([
        api(`/households?${qs.toString()}`),
        api(`/households/alerts`).catch(() => []),
      ]);
      setAlerts(Array.isArray(warn) ? warn : []);
      setHouseholds(Array.isArray(list?.data) ? list.data : []);
      setLastPage(list?.last_page ?? 1);
      setMatchTotal(typeof list?.total === "number" ? list.total : (Array.isArray(list?.data) ? list.data.length : 0));
      setLoadTick((n) => n + 1);
    } catch (e: any) {
      console.error("households load:", e);
      setErrorMessage(e?.message || t("loadHouseholdsFailed"));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    load(search, 1);
    setPage(1);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [search, sizeFilter, sortKey]);

  useEffect(() => {
    load(search, page);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [page]);

  // Keep the sidebar's red badge in sync the moment a head is added/removed.
  useEffect(() => {
    window.dispatchEvent(new CustomEvent("household-alerts", { detail: alerts.length }));
  }, [alerts]);

  const filteredUnassigned = useUnassignedSearch(memberSearch, pickerFor !== null, null, loadTick).rows;

  const resetAdd = () => {
    setAddOpen(false);
    setAddHeadId(null);
    setAddMemberIds([]);
    setAddHeadSearch("");
    setAddMemberSearch("");
    setShowAddCancelConfirm(false);
    setConfirmAdd(false);
  };

  const openAdd = () => {
    resetAdd();
    setAddOpen(true);
  };

  const isAddDirty = addHeadId !== null || addMemberIds.length > 0;

  const handleCloseAdd = () => {
    if (isAddDirty) setShowAddCancelConfirm(true);
    else resetAdd();
  };

  const addHead = addHeadId !== null ? addHeadPicked : null;

  const headPick = useUnassignedSearch(addHeadSearch, addOpen, null, loadTick);
  const headChoices = headPick.rows;
  const memberPick = useUnassignedSearch(addMemberSearch, addOpen && addHeadId !== null, addHeadId, loadTick);
  const memberChoices = memberPick.rows;

  const pickHead = (id: number) => {
    setAddHeadPicked(headChoices.find((m) => m.id === id) ?? null);
    setAddHeadId(id);
    // The head is always a member already -- never also list them twice.
    setAddMemberIds((prev) => prev.filter((x) => x !== id));
  };

  const toggleAddMember = (id: number) =>
    setAddMemberIds((prev) => (prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]));

  const performAdd = async () => {
    if (addHeadId === null) return;
    setConfirmAdd(false);
    setSaving(true);
    try {
      // Address/contact number come from the head's resident record
      // (Household::backfillFromHead on the backend).
      await api("/households", {
        method: "POST",
        body: JSON.stringify({ head_user_id: addHeadId, member_ids: [addHeadId, ...addMemberIds] }),
      });
      resetAdd();
      await load();
      setSuccessMessage(t("householdAddedSuccess"));
    } catch (e: any) {
      setConfirmAdd(false);
      setErrorMessage(e?.message || t("saveHouseholdFailed"));
    } finally {
      setSaving(false);
    }
  };

  const openEdit = (h: Household) => {
    setEditRecord(h);
    setEditForm({ address: h.address ?? "", contact_number: h.contact_number ?? "" });
  };

  // Nothing to submit if the form still matches the household being edited.
  const isEditFormUnchanged = !!editRecord &&
    editForm.address === (editRecord.address ?? "") &&
    editForm.contact_number === (editRecord.contact_number ?? "");

  const handleCloseEdit = () => {
    if (!isEditFormUnchanged) setShowEditCancelConfirm(true);
    else setEditRecord(null);
  };

  const submitEdit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!editRecord) return;
    setConfirmEdit(true);
  };

  const performEdit = async () => {
    if (!editRecord) return;
    setConfirmEdit(false);
    setSaving(true);
    try {
      await api(`/households/${editRecord.id}`, {
        method: "PUT",
        body: JSON.stringify(editForm),
      });
      setEditRecord(null);
      await load();
      setSuccessMessage(t("householdUpdatedSuccess"));
    } catch (e: any) {
      setErrorMessage(e?.message || t("saveHouseholdFailed"));
      // Revert the fields to the household as it actually is, rather
      // than leaving the rejected edit sitting in the form.
      if (editRecord) {
        setEditForm({ address: editRecord.address ?? "", contact_number: editRecord.contact_number ?? "" });
      }
    } finally {
      setSaving(false);
    }
  };

  const confirmDelete = async () => {
    if (!deleteRecord) return;
    setSaving(true);
    try {
      await api(`/households/${deleteRecord.id}`, { method: "DELETE" });
      setDeleteRecord(null);
      await load();
      setSuccessMessage(t("householdDeletedSuccess"));
    } catch (e: any) {
      setErrorMessage(e?.message || t("deleteHouseholdFailed"));
    } finally {
      setSaving(false);
    }
  };

  const addMember = async (householdId: number, userId: number) => {
    try {
      await api(`/households/${householdId}/members`, {
        method: "POST",
        body: JSON.stringify({ user_id: userId }),
      });
      setPickerFor(null);
      setMemberSearch("");
      await load(search, page);
      setSuccessMessage(t("hhMemberAddedSuccess"));
    } catch (e: any) {
      setErrorMessage(e?.message || t("addMemberFailed"));
    }
  };

  const removeMember = async (householdId: number, userId: number, wasHead: boolean) => {
    try {
      await api(`/households/${householdId}/members/${userId}`, { method: "DELETE" });
      await load(search, page);
      // The head badge on the card already flags a headless household
      // passively, but staff should also know it happened right when
      // they took the action that caused it, not just on next glance.
      setSuccessMessage(wasHead ? t("removedHeadNowUnassigned") : t("hhMemberRemovedSuccess"));
    } catch (e: any) {
      setErrorMessage(e?.message || t("removeMemberFailed"));
    }
  };

  const setHead = async (householdId: number, userId: number) => {
    try {
      await api(`/households/${householdId}/head`, {
        method: "PUT",
        body: JSON.stringify({ user_id: userId }),
      });
      await load(search, page);
      setSuccessMessage(t("hhHeadUpdatedSuccess"));
    } catch (e: any) {
      setErrorMessage(e?.message || t("setHeadFailed"));
    }
  };

  const runMemberAction = async () => {
    if (!memberAction) return;
    const { kind, household, member } = memberAction;
    setMemberAction(null);
    if (kind === "add") await addMember(household.id, member.id);
    else if (kind === "remove") await removeMember(household.id, member.id, member.is_household_head);
    else await setHead(household.id, member.id);
  };

  const memberActionCopy = (() => {
    if (!memberAction) return null;
    const { kind, household, member } = memberAction;
    const name = fullName(member);
    const currentHead = household.members.find((x) => x.is_household_head && x.id !== member.id);
    const fill = (key: string) =>
      t(key)
        .replace("{name}", name)
        .replace("{head}", currentHead ? fullName(currentHead) : "")
        .replace("{code}", household.code);
    if (kind === "add") {
      return { icon: <UserPlus size={32} />, tone: "brand" as const, title: fill("hhConfirmAddMemberTitle"), body: fill("hhConfirmAddMemberBody"), confirm: t("hhYesAddMember") };
    }
    if (kind === "remove") {
      return {
        icon: <X size={32} />,
        tone: "danger" as const,
        title: fill("hhConfirmRemoveMemberTitle"),
        body: fill(member.is_household_head ? "hhConfirmRemoveHeadBody" : "hhConfirmRemoveMemberBody"),
        confirm: t("hhYesRemoveMember"),
      };
    }
    return {
      icon: <Star size={32} />,
      tone: "brand" as const,
      title: fill(currentHead ? "hhConfirmReplaceHeadTitle" : "hhConfirmSetHeadTitle"),
      body: fill(currentHead ? "hhConfirmReplaceHeadBody" : "hhConfirmSetHeadBody"),
      confirm: t(currentHead ? "hhYesReplaceHead" : "hhYesSetHead"),
    };
  })();

  return (
    <div className="space-y-6">
      {/* Full-bleed dark navy wrapper -- matches the Dashboard/Residents
          background and palette. Modals further down stay in the original
          light theme, same scoping used on the Residents page. */}
      <div className="-m-3 sm:-m-6 min-h-[calc(100dvh-73px)] dash-canvas p-4 sm:p-8">
      <div className="space-y-6">
      <div className="dash-card flex flex-col justify-between gap-4 rounded-[32px] p-5 sm:flex-row sm:items-center sm:p-6">
        <div>
          <h1
            className="font-display text-3xl font-extrabold tracking-tight sm:text-4xl page-title-gradient"
          >
            {t("householdsTitle")}
          </h1>
          <p className="mt-1.5 text-sm text-white/50 max-w-xl">{t("householdsSubtitle")}</p>
        </div>
        <button
          type="button"
          onClick={openAdd}
          disabled={loading}
          className="btn-live-navy group inline-flex max-sm:w-full max-sm:justify-between items-center gap-3 rounded-full border border-[#1E3A5F] bg-[#1E3A5F] pl-6 pr-2 py-2 text-base font-semibold text-white shadow-sm transition-all duration-500 ease-out hover:border-[#274A77] hover:bg-[#274A77] hover:shadow-md shrink-0 disabled:pointer-events-none disabled:opacity-50"
        >
          {t("addHouseholdLabel")}
          <span className="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/15 transition-colors duration-500 ease-out group-hover:bg-white/25">
            <Plus className="h-5 w-5 text-white" />
          </span>
        </button>
      </div>

      <div className="dash-card rounded-[32px] p-4 sm:p-6">
        <FilterBar
          search={{ value: search, onChange: setSearch, placeholder: t("searchHouseholdsPlaceholder") }}
          filters={[{
            key: "size", label: t("hhSizeLabel"), value: sizeFilter, onChange: setSizeFilter,
            options: [
              { value: "all", label: t("hhSizeAll") },
              { value: "small", label: t("hhSizeSmall") },
              { value: "medium", label: t("hhSizeMedium") },
              { value: "large", label: t("hhSizeLarge") },
            ],
          }]}
          sort={{
            value: sortKey, onChange: setSortKey,
            options: [
              { value: "newest", label: t("sortNewest") },
              { value: "oldest", label: t("sortOldest") },
              { value: "code", label: t("hhSortCode") },
              { value: "members", label: t("sortMostMembers") },
              { value: "members_asc", label: t("hhSortFewest") },
            ],
          }}
          count={loading ? undefined : { shown: households.length, total: matchTotal }}
        />
      </div>



      {!loading && alerts.length > 0 && (
        <div className="rounded-2xl border border-amber-400/30 bg-amber-400/10 p-4 sm:p-5 flex gap-3">
          <AlertTriangle className="h-5 w-5 shrink-0 text-amber-400 mt-0.5" />
          <div className="min-w-0 flex-1">
            <p className="text-sm font-bold text-amber-300">{t("hhAlertBannerTitle").replace("{count}", String(alerts.length))}</p>
            <p className="mt-0.5 text-sm text-white/55">{t("hhAlertBannerBody")}</p>
            <div className="mt-3 flex flex-wrap gap-2">
              {alerts.map((a) => (
                <button
                  key={a.id}
                  type="button"
                  onClick={() => { setSearch(a.code); setExpandedId(a.id); }}
                  title={t("hhAlertAssign")}
                  className="inline-flex items-center gap-1.5 rounded-full border border-amber-400/30 bg-black/20 px-3 py-2 text-xs sm:py-1 font-semibold text-amber-200 hover:bg-amber-400/20 transition"
                >
                  <Home className="h-3.5 w-3.5" /> {a.code}
                </button>
              ))}
            </div>
          </div>
        </div>
      )}

      {loading ? (
        <div className="space-y-3">
          {Array.from({ length: 4 }).map((_, i) => (
            <div key={i} className="dash-card rounded-[28px] p-5 flex items-center gap-4">
              <Skeleton className="h-11 w-11 shrink-0 rounded-full" />
              <div className="flex-1 space-y-2">
                <Skeleton className="h-4 w-40" />
                <Skeleton className="h-3 w-24" />
              </div>
            </div>
          ))}
        </div>
      ) : households.length === 0 ? (
        <div className="dash-card rounded-[32px] p-10 text-center text-sm text-white/50">
          {t("noHouseholdsFound")}
        </div>
      ) : (
        <div className="space-y-3">
          {households.map((h) => {
            const expanded = expandedId === h.id;
            const head = h.members?.find((m) => m.is_household_head);
            return (
              <div key={h.id} className="dash-card overflow-hidden rounded-[28px] transition-colors hover:border-[#4FBEB0]/50">
                <div
                  role="button"
                  tabIndex={0}
                  onClick={() => setExpandedId(expanded ? null : h.id)}
                  onKeyDown={(e) => {
                    if (e.key === "Enter" || e.key === " ") {
                      e.preventDefault();
                      setExpandedId(expanded ? null : h.id);
                    }
                  }}
                  className="px-5 py-[18px] flex flex-wrap items-center gap-4 cursor-pointer"
                >
                  <div className="flex h-11 w-11 items-center justify-center rounded-full bg-[#4FBEB0]/10 shrink-0">
                    <Home className="h-5 w-5 text-[#4FBEB0]" />
                  </div>
                  <div className="min-w-[140px]">
                    <p className="text-base font-bold leading-snug text-white">{highlightMatches(h.code, search)}</p>
