import { reportsProTranslations } from "./locales/reportsPro";
import { lostFoundTranslations } from "./locales/lostFound";
import { photoViewerTranslations } from "./locales/photoViewer";
import { recoveryPrintTranslations } from "./locales/recoveryPrint";
import { activityExportTranslations } from "./locales/activityExport";

export type LanguageCode = "en" | "tl" | "ceb";

export const LANGUAGES: { code: LanguageCode; label: string }[] = [
  { code: "en", label: "English" },
  { code: "tl", label: "Filipino" },
  { code: "ceb", label: "Bisaya" },
];

export type Dict = Record<string, Record<LanguageCode, string>>;

export const translations: Dict = {
  dashboard: { en: "Overview", tl: "Pangkalahatang-ideya", ceb: "Kinatibuk-ang Pagtan-aw" },
  qr: { en: "My QR Code", tl: "Aking QR Code", ceb: "Akong QR Code" },
  attendance: { en: "Attendance", tl: "Pagdalo", ceb: "Pagtambong" },
