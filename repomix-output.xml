<file path="resources/js/pages/staff/views/reports/EventBreakdownTable.tsx">
import { useMemo, useState } from "react";
import { ArrowDown, ArrowUp, ArrowUpDown } from "lucide-react";
import SimplePager from "../../../../components/ui/SimplePager";
import usePager from "../../../../hooks/usePager";
import { CHART_COLORS } from "../../../../components/ui/Charts";
import { useEntered } from "../../../../hooks/useAnimatedValue";

type SortKey = "name" | "date" | "rate" | "spent";

const PAGE_SIZE = 10;

/** Every event on one tidy, sortable table: when, who showed up, and what it cost. Printing shows all rows. */
export default function EventBreakdownTable({
  events,
  t,
  onOpen,
  statusPill,
  peso,
}: {
  events: any[];
  t: (k: string) => string;
  onOpen: (id: number | string) => void;
  statusPill: (status: string) => string;
  peso: (n: any) => string;
}) {
  const [sort, setSort] = useState<{ key: SortKey; dir: "asc" | "desc" } | null>(null);
  const entered = useEntered();

  const sorted = useMemo(() => {
    if (!sort) return events;
    const val = (e: any) =>
      sort.key === "name" ? String(e.name ?? "").toLowerCase()
      : sort.key === "date" ? String(e.date ?? "")
      : sort.key === "rate" ? Number(e.percentage) || 0
      : Number(e.total_expenses) || 0;
    const out = [...events].sort((a, b) => (val(a) < val(b) ? -1 : val(a) > val(b) ? 1 : 0));
    return sort.dir === "desc" ? out.reverse() : out;
  }, [events, sort]);

  const pager = usePager(sorted, PAGE_SIZE, 350, `${sort?.key}|${sort?.dir}|${events.length}`);
  const visible = new Set(pager.shown.map((e) => e.id));

  const toggle = (key: SortKey) =>
    setSort((s) => (!s || s.key !== key ? { key, dir: key === "name" || key === "date" ? "asc" : "desc" } : s.dir === (key === "name" || key === "date" ? "asc" : "desc") ? { key, dir: s.dir === "asc" ? "desc" : "asc" } : null));

  const th = "px-4 py-3.5 print:px-2 print:py-2 print:text-[10px] text-left text-xs font-semibold uppercase tracking-wide text-white/45 print:text-gray-500";
  const head = (key: SortKey, label: string, className = "") => {
    const on = sort?.key === key;
    const Icon = !on ? ArrowUpDown : sort!.dir === "asc" ? ArrowUp : ArrowDown;
    return (
      <th className={`${th} ${className}`} aria-sort={on ? (sort!.dir === "asc" ? "ascending" : "descending") : "none"}>
        <button type="button" onClick={() => toggle(key)} className={`inline-flex items-center gap-1.5 uppercase tracking-wide transition hover:text-white print:pointer-events-none print:text-gray-500 ${on ? "text-white" : ""}`}>
          {label}
          <Icon className={`h-3 w-3 print:hidden ${on ? "opacity-100" : "opacity-40"}`} />
        </button>
      </th>
    );
  };

  return (
    <div>
      <div className="overflow-x-auto rounded-2xl border border-white/10 print:overflow-hidden print:border-[#ddd5ca]">
        <table className="w-full min-w-[820px] border-collapse text-base print:min-w-0 print:table-fixed print:text-xs">
          <thead className="bg-white/[0.04] print:bg-gray-50">
            <tr>
              {head("name", t("rpColEvent"), "print:w-[29%]")}
              {head("date", t("rpColDate"), "print:w-[19%]")}
              <th className={`${th} print:w-[14%]`}>{t("rpColStatus")}</th>
              {head("rate", t("rpColAttendance"), "w-[26%] print:w-[23%]")}
              {head("spent", t("rpColBudget"), "text-right print:w-[15%]")}
            </tr>
          </thead>
          <tbody>
            {sorted.map((ev, i) => {
              const pct = Math.max(0, Math.min(100, Number(ev.percentage) || 0));
              const color = pct >= 75 ? CHART_COLORS[0] : pct >= 40 ? CHART_COLORS[1] : CHART_COLORS[3];
              const hasBudget = ev.approved_budget !== null && ev.approved_budget !== undefined;
              return (
                <tr
                  key={ev.id}
                  className={`border-t border-white/10 align-middle transition hover:bg-white/[0.04] print:break-inside-avoid print:border-gray-200 print:hover:bg-transparent ${visible.has(ev.id) ? "" : "hidden print:table-row"}`}
                >
                  <td className="max-w-[280px] px-4 py-4 print:max-w-none print:overflow-hidden print:px-2 print:py-2">
                    <button type="button" onClick={() => onOpen(ev.id)} title={t("rpOpenEvent")} className="block max-w-full truncate text-left text-base font-bold text-white transition hover:text-[#7DD8CB] hover:underline print:overflow-visible print:whitespace-normal print:break-words print:text-[12px] print:leading-snug print:text-[#005f63] print:no-underline">
                      {ev.name}
                    </button>
                    {ev.location && <span className="mt-0.5 block truncate text-[13px] text-white/40 print:overflow-visible print:whitespace-normal print:break-words print:text-[10px] print:leading-snug print:text-gray-500">{ev.location}</span>}
                  </td>
                  <td className="whitespace-nowrap px-4 py-4 text-white/80 print:px-2 print:py-2 print:text-[10.5px] print:text-gray-700">
                    {ev.date}
                    {ev.start_time && <span className="mt-0.5 block text-[13px] text-white/40 print:text-[9px] print:text-gray-500">{ev.start_time}{ev.end_time ? ` – ${ev.end_time}` : ""}</span>}
                  </td>
                  <td className="whitespace-nowrap px-4 py-4 print:px-2 print:py-2">
                    {ev.status && <span className={`inline-block rounded-full px-3 py-1 text-xs font-semibold print:px-2 print:py-0.5 print:text-[10px] ${statusPill(ev.status)}`}>{t(`rptStatus${ev.status}`)}</span>}
                  </td>
                  <td className="px-4 py-4 print:px-1 print:py-2">
                    <div className="flex items-center gap-3.5 print:gap-1.5">
                      <div className="h-2.5 w-28 shrink-0 print:h-2 print:w-8 overflow-hidden rounded-full bg-white/10 print:bg-gray-200">
                        <div
                          className="h-full rounded-full transition-[width] duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] print:transition-none"
                          style={{ width: entered ? `${pct}%` : "0%", background: color, transitionDelay: `${Math.min(i, 10) * 40}ms` }}
                        />
                      </div>
                      <span className="w-14 shrink-0 text-base print:w-10 print:text-[10.5px] font-bold tabular-nums text-white print:text-gray-800">{ev.percentage}%</span>
                      <span className="whitespace-nowrap text-sm print:text-[9px] tabular-nums text-white/45 print:text-gray-500">{ev.attended} / {ev.eligible}</span>
                    </div>
                  </td>
                  <td className="whitespace-nowrap px-4 py-4 text-right tabular-nums print:px-2 print:py-2 print:text-[10.5px]">
                    {hasBudget ? (
                      <>
                        <span className="block font-bold text-white print:text-gray-800">{peso(ev.total_expenses)}</span>
                        <span className="mt-0.5 block text-[13px] text-white/40 print:text-[9px] print:text-gray-500">{t("rpOfBudget")} {peso(ev.approved_budget)}</span>
                      </>
                    ) : (
                      <span className="text-white/30 print:text-gray-400">—</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <SimplePager className="mt-4 print:hidden" page={pager.page} totalPages={pager.totalPages} onChange={pager.go} loading={pager.switching} />
    </div>
  );
}
</file>

<file path="resources/js/pages/staff/views/reports/KpiDelta.tsx">
import { Minus, TrendingDown, TrendingUp } from "lucide-react";

type Mode = "percent" | "points" | "count";

/**
 * "▲ 12.5% vs previous period" -- the small change badge under a KPI number.
 * `good` says which direction is healthy ("up" for attendance, "down" for
 * events that went over budget, "neutral" when neither is better, e.g. money
 * spent), which only decides the tint; the arrow always shows the real direction.
 * Hidden on paper: a printout shows the report's own figures only.
 */
export default function KpiDelta({
  cur,
  prev,
  mode = "percent",
  good = "up",
  decimals = 1,
  tip,
  t,
}: {
  cur: number | null | undefined;
  prev: number | null | undefined;
  mode?: Mode;
  good?: "up" | "down" | "neutral";
  decimals?: number;
  tip?: string;
  t: (key: string) => string;
}) {
  if (cur === null || cur === undefined || prev === null || prev === undefined) return null;

  const diff = cur - prev;
  const round = (n: number, d = decimals) => Number(n.toFixed(d));
  let text: string;
  let direction: "up" | "down" | "flat";

  if (Math.abs(diff) < 1e-9) {
    direction = "flat";
    text = t("rpDeltaSame");
  } else if (mode === "percent" && prev === 0) {
    direction = "up";
    text = t("rpDeltaNew");
  } else {
    direction = diff > 0 ? "up" : "down";
    const sign = diff > 0 ? "+" : "−";
    if (mode === "percent") text = `${sign}${Math.abs(round((diff / Math.abs(prev)) * 100))}%`;
    else if (mode === "points") text = `${sign}${Math.abs(round(diff))} ${t("rpPtsSuffix")}`;
    else text = `${sign}${Math.abs(round(diff, Number.isInteger(diff) ? 0 : decimals))}`;
  }

  const healthy = direction === "flat" || good === "neutral" ? null : (direction === "up") === (good === "up");
  const tone = healthy === null ? "text-white/70" : healthy ? "text-emerald-600" : "text-red-500";
  const Icon = direction === "up" ? TrendingUp : direction === "down" ? TrendingDown : Minus;

  return (
    <span
      title={tip}
      className={`mt-2 inline-flex items-center gap-1 rounded-full bg-white/10 px-2 py-0.5 text-[11px] font-bold print:hidden ${tone}`}
    >
      <Icon className="h-3 w-3" strokeWidth={3} />
      {text}
    </span>
  );
}
</file>

<file path="resources/js/pages/staff/views/reports/LiveStatus.tsx">
import { useEffect, useState } from "react";
import { RefreshCw } from "lucide-react";
import { useLanguage } from "../../../../i18n/LanguageContext";

/**
 * "● Live · Updated 12s ago  ⟳" -- shows the report is watching the data,
 * and lets staff refresh by hand. Owns its one-second clock so the big
 * report page doesn't re-render every second just to count seconds.
 */
export default function LiveStatus({
  lastSync,
  refreshing,
  failed,
  onRefresh,
}: {
  lastSync: number | null;
  refreshing: boolean;
  failed: boolean;
  onRefresh: () => void;
}) {
  const { t } = useLanguage();
  const [now, setNow] = useState(() => Date.now());
  useEffect(() => {
    const id = window.setInterval(() => setNow(Date.now()), 1000);
    return () => window.clearInterval(id);
  }, []);

  const sec = lastSync ? Math.max(0, Math.floor((now - lastSync) / 1000)) : null;
  const label =
    sec === null ? "" : sec < 5 ? t("updatedJustNowLabel") : sec < 60 ? t("updatedSecondsAgoLabel").replace("{n}", String(sec)) : t("updatedMinutesAgoLabel").replace("{n}", String(Math.floor(sec / 60)));

  return (
    <div className="inline-flex items-center gap-2 dash-tile rounded-full py-1.5 pl-3.5 pr-1.5" role="status" aria-live="polite">
      <span className="relative flex h-2.5 w-2.5">
        {!failed && <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60" />}
        <span className={`relative inline-flex h-2.5 w-2.5 rounded-full ${failed ? "bg-amber-400" : "bg-emerald-400"}`} />
      </span>
      <span className="text-[13px] font-semibold text-white/80">{t("rpLive")}</span>
      {label && <span className="hidden text-[13px] text-white/45 sm:inline">· {label}</span>}
      <button
        type="button"
        onClick={onRefresh}
        title={t("rpRefresh")}
        aria-label={t("rpRefresh")}
        className="flex h-8 w-8 items-center justify-center rounded-full text-white/60 transition hover:bg-white/10 hover:text-white active:scale-95"
      >
        <RefreshCw className={`h-4 w-4 ${refreshing ? "animate-spin" : ""}`} />
      </button>
    </div>
  );
}
</file>

<file path="tests/Feature/Ch4AuthSecurityTest.php">
<?php

namespace Tests\Feature;

use App\Models\StaffRecoveryCode;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\RateLimiter;
use Tests\Support;
use Tests\TestCase;

/** Chapter IV – Authentication and Account Security / Staff Account Management (TC-01 … TC-14). */
class Ch4AuthSecurityTest extends TestCase
{
    use RefreshDatabase, Support;

    protected function setUp(): void
    {
        parent::setUp();
        Cache::flush();
        RateLimiter::clear('x');
    }

    public function test_tc01_resident_logs_in_with_valid_credentials(): void
    {
        $u = $this->makeUser('Resident');
        $this->postJson('/login', ['username' => $u->user_code, 'password' => 'Passw0rd!Strong#1'])->assertOk();
        $this->assertAuthenticatedAs($u);
    }

    public function test_tc02_wrong_password_is_rate_limited_after_five_tries(): void
    {
        $u = $this->makeUser('Resident');
        for ($i = 0; $i < 5; $i++) {
            $this->postJson('/login', ['username' => $u->user_code, 'password' => 'wrong'])->assertStatus(401);
        }
        // the correct password is now refused too, because the account is rate limited
        $this->postJson('/login', ['username' => $u->user_code, 'password' => 'Passw0rd!Strong#1'])->assertStatus(429);
    }

    public function test_tc03_staff_with_2fa_must_give_a_valid_authenticator_code(): void
    {
        $s = $this->staff();
        $secret = $this->enableTwoFactor($s);
        $this->postJson('/login', ['username' => $s->user_code, 'password' => 'Passw0rd!Strong#1'])
            ->assertStatus(401)->assertJson(['two_factor_required' => true]);
        $this->postJson('/login', ['username' => $s->user_code, 'password' => 'Passw0rd!Strong#1', 'otp' => '000000'])
            ->assertStatus(401);
        $this->postJson('/login', ['username' => $s->user_code, 'password' => 'Passw0rd!Strong#1', 'otp' => $this->otp($secret)])
            ->assertOk();
    }

    public function test_tc04_logout_ends_the_session(): void
    {
        $u = $this->makeUser('Resident');
        $this->actingAs($u)->postJson('/logout')->assertOk();
        $this->assertGuest();
        $this->getJson('/me')->assertStatus(401);
    }

    public function test_tc05_weak_new_password_is_rejected(): void
    {
        $u = $this->makeUser('Resident');
        $this->actingAs($u)->patchJson("/users/{$u->id}/change-password", [
            'current_password' => 'Passw0rd!Strong#1', 'new_password' => 'abc123', 'new_password_confirmation' => 'abc123',
        ])->assertStatus(422)->assertJsonValidationErrors('new_password');
    }

    public function test_tc06_strong_password_change_replaces_the_old_password(): void
    {
        $u = $this->makeUser('Resident');
        $this->actingAs($u)->patchJson("/users/{$u->id}/change-password", [
            'current_password' => 'Passw0rd!Strong#1', 'new_password' => 'N3w!Passw0rd#Long9', 'new_password_confirmation' => 'N3w!Passw0rd#Long9',
        ])->assertOk();
        $this->assertTrue(\Hash::check('N3w!Passw0rd#Long9', $u->fresh()->password));
        $this->assertFalse(\Hash::check('Passw0rd!Strong#1', $u->fresh()->password));
    }

    public function test_tc08_head_staff_regenerates_recovery_codes_with_password_and_code(): void
    {
        $h = $this->headStaff();
        $secret = $this->enableTwoFactor($h);
        StaffRecoveryCode::create(['user_id' => $h->id, 'code_hash' => bcrypt('OLDCODE123')]);
        $res = $this->actingAs($h)->postJson('/staff-accounts/recovery-codes', [
            'password' => 'Passw0rd!Strong#1', 'otp' => $this->otp($secret),
        ])->assertOk();
        $this->assertCount(8, $res->json('codes'));
        $this->assertSame(8, StaffRecoveryCode::where('user_id', $h->id)->count()); // old code replaced
    }

    public function test_tc09_recovery_codes_refused_with_wrong_authenticator_code(): void
    {
        $h = $this->headStaff();
        $this->enableTwoFactor($h);
        $this->actingAs($h)->postJson('/staff-accounts/recovery-codes', [
            'password' => 'Passw0rd!Strong#1', 'otp' => '000000',
        ])->assertStatus(422);
        $this->assertSame(0, StaffRecoveryCode::where('user_id', $h->id)->count());
    }

    public function test_tc09b_recovery_codes_refused_without_two_step_set_up(): void
    {
        $h = $this->headStaff();
        $this->actingAs($h)->postJson('/staff-accounts/recovery-codes', ['password' => 'Passw0rd!Strong#1'])->assertStatus(422);
    }

    public function test_tc13_non_head_staff_cannot_manage_staff_accounts(): void
    {
        $s = $this->staff();
        $this->actingAs($s)->postJson('/staff-accounts/recovery-codes', ['password' => 'Passw0rd!Strong#1'])->assertStatus(403);
        $this->actingAs($s)->postJson('/staff-accounts/promote', [])->assertStatus(403);
    }

    public function test_tc12_reset_password_needs_password_and_authenticator_code(): void
    {
        $h = $this->headStaff();
        $secret = $this->enableTwoFactor($h);
        $target = $this->staff();
        $this->actingAs($h)->postJson("/staff-accounts/{$target->id}/reset-password", ['password' => 'Passw0rd!Strong#1', 'otp' => '000000'])
            ->assertStatus(422);
        $res = $this->actingAs($h)->postJson("/staff-accounts/{$target->id}/reset-password", ['password' => 'Passw0rd!Strong#1', 'otp' => $this->otp($secret)])
            ->assertOk()->assertJsonStructure(['activation_slip' => ['user_code', 'name', 'code', 'expires_at', 'issued_by']]);
        $this->assertArrayNotHasKey('temporary_password', $res->json());
        // the old password no longer works and only a hash of the code is kept
        $fresh = $target->fresh();
        $this->assertNull($fresh->password);
        $this->assertTrue((bool) $fresh->pending_activation);
        $this->assertNotSame($res->json('activation_slip.code'), $fresh->activation_code_hash);
    }

    public function test_suspend_remove_access_and_make_head_staff_need_password_and_authenticator_code(): void
    {
        $h = $this->headStaff();
        $secret = $this->enableTwoFactor($h);
        $target = $this->staff();
        $pw = 'Passw0rd!Strong#1';

        // password alone is not enough
        $this->actingAs($h)->postJson("/staff-accounts/{$target->id}/suspend", ['password' => $pw])->assertStatus(422);
        $this->actingAs($h)->postJson("/staff-accounts/{$target->id}/suspend", ['password' => $pw, 'otp' => '000000'])->assertStatus(422);
        $this->assertNull($target->fresh()->suspended_at);
        $this->actingAs($h)->postJson('/staff-accounts/transfer', ['to_user_id' => $target->id, 'password' => $pw])->assertStatus(422);
        $this->actingAs($h)->postJson("/staff-accounts/{$target->id}/demote", ['password' => $pw])->assertStatus(422);
        $this->assertSame('Staff', $target->fresh()->role);

        $this->actingAs($h)->postJson("/staff-accounts/{$target->id}/suspend", ['password' => $pw, 'otp' => $this->otp($secret)])->assertOk();
        $this->assertNotNull($target->fresh()->suspended_at);
    }
}
</file>

