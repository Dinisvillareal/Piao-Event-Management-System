import KpiCard from "../../../components/ui/KpiCard";
import useFilterSwitching from "../../../hooks/useFilterSwitching";
import { matchesSearch } from "../../../lib/search";
import { highlightMatches } from "../../../lib/highlight";
import React, { useState, useEffect, useMemo, useRef } from 'react';
import { RefreshCw, Filter, Search, Trash2, Layers, Clock, AlertTriangle, ChevronLeft, ChevronRight, Calendar, Users, Award, Bell, Heart, Briefcase, Package, Wallet, Home, MapPin } from 'lucide-react';
import FilterBar from '../../../components/ui/FilterBar';
import StatusModal from '../../../components/ui/StatusModal';
import { useLanguage } from "../../../i18n/LanguageContext";
import StatCardSkeleton, { usePageOpenSkeleton } from "../../../components/ui/StatCardSkeleton";
import PagerSkeleton from "../../../components/ui/PagerSkeleton";
import Portal from "../../../components/ui/Portal";

interface TrashedItem {
  id: string | number;
  type: 'event' | 'resident' | 'membership' | 'notification' | 'age_bracket' | 'civil_status' | 'current_status' | 'inventory_item' | 'expense' | 'household';
  name: string;
  deletedAt: string;
  deletedAtRaw: string;
  deletedBy: string;
  originalData?: any;
}

const TYPE_LABEL_KEYS: Record<TrashedItem["type"], string> = {
  event: "events",
  resident: "residents",
  membership: "memberships",
  notification: "notify",
  age_bracket: "ageBracketsTitle",
  civil_status: "civilStatusesTitle",
  current_status: "currentStatusesTitle",
  inventory_item: "inventory",
  expense: "expenseTypeLabel",
  household: "households",
};

// Same three-family palette used across the redesigned pages -- teal for
// people/community records, gold for events & communications, and a
// neutral white-on-navy tone for operational/financial records -- same
// semantic mapping as the light styles they replace, recolored for the
// dark navy/gold/teal system used everywhere else.
const TYPE_BADGE_STYLES: Record<TrashedItem["type"], string> = {
  resident: "bg-[#4FBEB0]/15 text-[#7DD8CB] border border-[#4FBEB0]/30",
  household: "bg-[#4FBEB0]/15 text-[#7DD8CB] border border-[#4FBEB0]/30",
  membership: "bg-[#4FBEB0]/15 text-[#7DD8CB] border border-[#4FBEB0]/30",
  age_bracket: "bg-[#4FBEB0]/15 text-[#7DD8CB] border border-[#4FBEB0]/30",
  civil_status: "bg-[#4FBEB0]/15 text-[#7DD8CB] border border-[#4FBEB0]/30",
  current_status: "bg-[#4FBEB0]/15 text-[#7DD8CB] border border-[#4FBEB0]/30",
  event: "bg-gold-400/15 text-gold-300 border border-gold-400/30",
  notification: "bg-gold-400/15 text-gold-300 border border-gold-400/30",
  inventory_item: "bg-white/10 text-white/60 border border-white/15",
  expense: "bg-white/10 text-white/60 border border-white/15",
};

// Phone view (like the Samsung Recycle bin): first the kinds of records in the trash, then the items of the one you tap.
const TYPE_ICONS: Record<TrashedItem["type"], any> = {
  event: Calendar, resident: Users, membership: Award, notification: Bell, age_bracket: Layers,
  civil_status: Heart, current_status: Briefcase, inventory_item: Package, expense: Wallet, household: Home,
};

export default function ArchiveView() {
  const { t } = useLanguage();
  // One page of archived records, already filtered/sorted by the server, and the archive's own figures.
  const [allTrashedItems, setAllTrashedItems] = useState<TrashedItem[]>([]);
  const [archiveMeta, setArchiveMeta] = useState({ total: 0, last_page: 1 });
  const [archiveStats, setArchiveStats] = useState({ total: 0, distinct_types: 0, newest_at: null as string | null, oldest_days: 0 });
  const [loading, setLoading] = useState(true);
  // Page-open skeleton for the KPI strip (first load only -- never returns on polls).
  const statsLoading = usePageOpenSkeleton(loading);
  const [restoringId, setRestoringId] = useState<string | number | null>(null);
  const [typeFilter, setTypeFilter] = useState<string>('all');
  const [searchQuery, setSearchQuery] = useState<string>('');
  const [currentPage, setCurrentPage] = useState(1);
  // Brief skeleton flash on every page switch, same as Activity Logs --
  // this list paginates client-side so there's nothing to actually wait
  // on, but the flash keeps page switches feeling consistent app-wide.
  const [pageSwitchingRaw, setPageSwitching] = useState(false);
  const [archiveSort, setArchiveSort] = useState('recent');
  const [isPhone, setIsPhone] = useState(() => typeof window !== 'undefined' && window.matchMedia('(max-width: 639px)').matches);
  useEffect(() => {
    const mq = window.matchMedia('(max-width: 639px)');
    const on = () => setIsPhone(mq.matches);
    mq.addEventListener('change', on);
    return () => mq.removeEventListener('change', on);
  }, []);
  // How many trashed records of each kind (phone category list).
  const [typeCounts, setTypeCounts] = useState<Record<string, number> | null>(null);
  const filterSwitching = useFilterSwitching([typeFilter, searchQuery, archiveSort]);
  const pageSwitching = pageSwitchingRaw || filterSwitching;
  const pageSwitchTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
  // Anchor at the very top of the page -- scrolled into view on every
  // pagination click, same as Activity Logs, so switching pages always
  // lands back at the top instead of staying wherever the list had been
  // scrolled to.
  const topRef = useRef<HTMLDivElement>(null);
  const goToPage = (updater: number | ((p: number) => number)) => {
    setCurrentPage(updater as any);
    setPageSwitching(true);
    if (pageSwitchTimer.current) clearTimeout(pageSwitchTimer.current);
    pageSwitchTimer.current = setTimeout(() => setPageSwitching(false), 0);
    topRef.current?.scrollIntoView({ behavior: "smooth", block: "start" });
  };
  useEffect(() => () => { if (pageSwitchTimer.current) clearTimeout(pageSwitchTimer.current); }, []);
  const itemsPerPage = 20;

  // State for modals
  const [restoreItem, setRestoreItem] = useState<TrashedItem | null>(null);
  const [showSuccessModal, setShowSuccessModal] = useState(false);
  const [showErrorModal, setShowErrorModal] = useState(false);
  const [errorMessage, setErrorMessage] = useState('');

  // Real-time refresh -- other staff can delete or restore records any
  // time, so this polls quietly in the background rather than relying on
  // a manual refresh. `background` skips the loading spinner so the table
  // doesn't flash/reset scroll position every 20s, and polling pauses
  // while any restore modal is open so the list doesn't shift under it.
  const [lastUpdated, setLastUpdated] = useState<Date | null>(null);
  const [nowTick, setNowTick] = useState(() => Date.now());

  const formatTimeOnly = (dateTimeStr?: string) => {
    if (!dateTimeStr) return '';
    const match = dateTimeStr.match(/^(.*?)(\d{1,2}:\d{2}(:\d{2})?)(.*)$/);
    if (!match) return dateTimeStr;
    const [, beforeTime, timePart, , afterTime] = match;
    const [h, m, s = '00'] = timePart.split(':');
    let hours = parseInt(h, 10);
    const ampm = hours >= 12 ? 'PM' : 'AM';
    hours = hours % 12 || 12;
    const newTime = `${hours}:${m}:${s} ${ampm}`;
    return `${beforeTime}${newTime}${afterTime}`;
  };

  const fetchArchivedItems = async (background = false) => {
    if (!background) setLoading(true);
    try {
      const qs = new URLSearchParams({ paged: '1', sort: archiveSort, page: String(currentPage), per_page: String(itemsPerPage) });
      if (typeFilter !== 'all') qs.set('type', typeFilter);
      if (searchQuery.trim()) qs.set('search', searchQuery.trim());
      const response = await fetch(`/api/archived?${qs}`, {
        credentials: 'include',
        headers: {
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      });

      if (response.ok) {
        const body = await response.json();
        // A page past the end (e.g. after the last record of a page was restored): go back.
        if (body.meta.last_page < currentPage) {
          setCurrentPage(Math.max(1, body.meta.last_page));
          return;
        }
        setArchiveMeta({ total: body.meta.total, last_page: body.meta.last_page });
        setArchiveStats(body.stats);
        const normalized = (body.data as any[]).map((item: any) => {
          const raw = item.deleted_at || item.deletedAt || '';
          return {
            id: item.id,
            type: item.type === 'user' ? 'resident' : item.type,
            name: item.name || item.title || t("opsUnnamed"),
            deletedAt: formatTimeOnly(raw),
            deletedAtRaw: raw,
            deletedBy: item.deleted_by || item.deletedBy,
            originalData: item.original_data || item
          };
        });
        setAllTrashedItems(normalized);
        setLastUpdated(new Date());
      }
    } catch (error) {
      console.error('Error fetching archived items:', error);
    } finally {
      if (!background) setLoading(false);
    }
  };

  const handleRestoreConfirm = async () => {
    if (!restoreItem) return;

    setRestoringId(restoreItem.id);
    try {
      const token = document.cookie
        .split('; ')
        .find(row => row.startsWith('XSRF-TOKEN='))
        ?.split('=')[1];
      const decodedToken = token ? decodeURIComponent(token) : '';

      const restoreType = restoreItem.type === 'notification' ? 'event' : restoreItem.type;

      const response = await fetch('/api/archive/restore', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
          'X-XSRF-TOKEN': decodedToken
        },
        body: JSON.stringify({
          type: restoreType,
          id: restoreItem.id
        })
      });

      if (response.ok) {
        fetchArchivedItems();
        // Show success modal instead of alert
        setShowSuccessModal(true);
      } else {
        const result = await response.json();
        setErrorMessage(result.message || t("restoreItemFailedDefault"));
        setShowErrorModal(true);
      }
    } catch (error) {
      console.error('Error restoring:', error);
      setErrorMessage(t("restoreErrorOccurred"));
      setShowErrorModal(true);
    } finally {
      setRestoringId(null);
      setRestoreItem(null); // Close confirmation modal
    }
  };

  const showCategories = isPhone && typeFilter === 'all' && !searchQuery.trim();
  useEffect(() => {
    if (!showCategories) return;
    let cancelled = false;
    const kinds = Object.keys(TYPE_LABEL_KEYS);
    Promise.all(kinds.map(async (k) => {
      try {
        const r = await fetch(`/api/archived?${new URLSearchParams({ paged: '1', type: k, page: '1', per_page: '1' })}`, {
          credentials: 'include', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        });
        if (!r.ok) return [k, 0] as const;
        const b = await r.json();
        return [k, Number(b?.meta?.total ?? 0)] as const;
      } catch { return [k, 0] as const; }
    })).then((pairs) => { if (!cancelled) setTypeCounts(Object.fromEntries(pairs)); });
    return () => { cancelled = true; };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [showCategories, lastUpdated]);

  const totalPages = Math.max(1, archiveMeta.last_page);
  const paginatedItems = allTrashedItems;

  // The background poll must refresh with the filters of the moment, not those of an older render.
  const fetchRef = useRef(fetchArchivedItems);
  fetchRef.current = fetchArchivedItems;

  // Any filter change starts again from page 1; every change (or page) asks the server.
  useEffect(() => { setCurrentPage(1); }, [typeFilter, searchQuery, archiveSort]);
  useEffect(() => {
    const timer = setTimeout(() => fetchArchivedItems(), 120);
    return () => clearTimeout(timer);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [typeFilter, searchQuery, archiveSort, currentPage]);

  // Quiet background poll -- paused while a restore/success/error modal is
  // open so the list doesn't reshuffle under the staff member's cursor.
  useEffect(() => {
    const poll = setInterval(() => {
      if (!restoreItem && !showSuccessModal && !showErrorModal) fetchRef.current(true);
    }, 20000);
    return () => clearInterval(poll);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [restoreItem, showSuccessModal, showErrorModal]);

  useEffect(() => {
    const tick = setInterval(() => setNowTick(Date.now()), 1000);
    return () => clearInterval(tick);
  }, []);

  const secondsSinceUpdate = lastUpdated ? Math.max(0, Math.floor((nowTick - lastUpdated.getTime()) / 1000)) : null;
  const lastUpdatedLabel =
    secondsSinceUpdate === null
      ? ""
      : secondsSinceUpdate < 5
      ? t("updatedJustNowLabel")
      : secondsSinceUpdate < 60
      ? t("updatedSecondsAgoLabel").replace("{n}", String(secondsSinceUpdate))
      : t("updatedMinutesAgoLabel").replace("{n}", String(Math.floor(secondsSinceUpdate / 60)));

  // Portfolio-wide KPIs across every trashed record (from the server), independent of
  // the current search/type filter.
  const stats = {
    totalItems: archiveStats.total,
    distinctTypes: archiveStats.distinct_types,
    newestAt: archiveStats.newest_at ? new Date(archiveStats.newest_at).getTime() : null,
    oldestDays: archiveStats.oldest_days,
  };

  const relativeTimeLabel = (timestamp: number | null) => {
    if (!timestamp) return "--";
    const diffSec = Math.max(0, Math.floor((nowTick - timestamp) / 1000));
    if (diffSec < 60) return t("justNowLabel");
    const diffMin = Math.floor(diffSec / 60);
    if (diffMin < 60) return t("minutesAgoShortLabel").replace("{n}", String(diffMin));
    const diffHr = Math.floor(diffMin / 60);
    if (diffHr < 24) return t("hoursAgoShortLabel").replace("{n}", String(diffHr));
    const diffDay = Math.floor(diffHr / 24);
    return t("daysAgoShortLabel").replace("{n}", String(diffDay));
  };

  const typeOptions = [
    { value: 'all', label: t('allTypes') },
    { value: 'age_bracket', label: t('ageBracketsTitle') },
    { value: 'civil_status', label: t('civilStatusesTitle') },
    { value: 'current_status', label: t('currentStatusesTitle') },
    { value: 'event', label: t('events') },
    { value: 'expense', label: t('expenseTypeLabel') },
    { value: 'household', label: t('households') },
    { value: 'inventory_item', label: t('inventory') },
    { value: 'membership', label: t('memberships') },
    { value: 'notification', label: t('notify') },
    { value: 'resident', label: t('residents') },
  ];

  const statCards = [
    {
      key: "total",
      label: t("itemsInTrashStatLabel"),
      desc: t("itemsInTrashStatDesc"),
      value: stats.totalItems,
      icon: Trash2,
      gradient: "from-sage-400 to-sage-700",
      isText: false,
    },
    {
      key: "types",
      label: t("distinctRecordTypesStatLabel"),
      desc: t("distinctRecordTypesStatDesc"),
      value: stats.distinctTypes,
      icon: Layers,
      gradient: "from-sage-400 to-sage-700",
      isText: false,
    },
    {
      key: "recent",
      label: t("mostRecentDeletionStatLabel"),
      desc: t("mostRecentDeletionStatDesc"),
      value: relativeTimeLabel(stats.newestAt),
      icon: Clock,
      gradient: "from-sage-400 to-sage-700",
      isText: true,
    },
    {
      key: "oldest",
      label: t("oldestInTrashStatLabel"),
      desc: t("oldestInTrashStatDesc"),
      value: stats.oldestDays,
      icon: AlertTriangle,
      gradient: "from-sage-400 to-sage-700",
      isText: false,
    },
  ];

  const SkeletonRow = () => (
    <tr className="border-b border-white/[0.06] last:border-0">
      <td className="p-3"><div className="h-5 bg-white/10 rounded-full w-20 animate-pulse" /></td>
      <td className="p-3"><div className="h-3.5 bg-white/10 rounded w-32 animate-pulse" /></td>
      <td className="p-3"><div className="h-3.5 bg-white/10 rounded w-40 animate-pulse" /></td>
      <td className="p-3"><div className="h-3.5 bg-white/10 rounded w-24 animate-pulse" /></td>
      <td className="p-3"><div className="h-6 w-6 bg-white/10 rounded-full animate-pulse" /></td>
    </tr>
  );

  return (
    <>
    {/* Full-bleed dark navy page -- same technique and palette as the
        Dashboard/Residents/Households/Memberships/Events/Budget/Returns/
        Activity Logs pages, so Archive reads as part of the same system
        instead of the old light "paper" page. The confirm/success/error
        modals further below stay on their original light theme, same
        scoping used everywhere else -- there's no core edit form on this
        page to darken along with it. */}
    <div ref={topRef} className="-m-3 sm:-m-6 min-h-[calc(100dvh-73px)] dash-canvas p-4 sm:p-8">
    <div className="space-y-6">
      <div className="dash-card flex flex-wrap items-center justify-between gap-3 rounded-[32px] p-5 sm:p-6">
        <div>
          <h1 className="font-display text-3xl font-extrabold tracking-tight sm:text-4xl page-title-gradient page-title-fit">{t("archive")}</h1>
          <p className="mt-1.5 text-sm text-white/55 max-w-xl">{t("archiveSubtitle")}</p>
        </div>
        <div className="dash-tile dash-mint flex items-center gap-2 rounded-full px-3.5 py-2 shrink-0 max-sm:hidden">
          <span className="relative flex h-2 w-2">
            <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#4FBEB0] opacity-75" />
            <span className="relative inline-flex h-2 w-2 rounded-full bg-[#4FBEB0]" />
          </span>
          <span className="text-xs font-bold uppercase tracking-wide text-[#7DD8CB]">{t("liveLabel")}</span>
          {lastUpdatedLabel && <span className="text-xs text-white/40">&bull; {lastUpdatedLabel}</span>}
        </div>
      </div>

      <div className="report-stagger grid grid-cols-2 lg:grid-cols-4 gap-3 max-sm:hidden sm:gap-4">
        {statCards.map((card, idx) =>
          statsLoading ? (
            <StatCardSkeleton key={card.key} />
          ) : (
            <KpiCard key={card.key} value={card.value} label={card.label} description={card.desc} icon={card.icon} gradient={card.gradient} delay={idx * 70} />
          )
        )}
      </div>

      <div className="dash-card rounded-[32px] p-4 sm:p-5">
        <FilterBar
          search={{ value: searchQuery, onChange: setSearchQuery, placeholder: t("searchArchivePlaceholder") }}
          filters={[{ key: "type", label: t("typeColumn"), value: typeFilter, onChange: setTypeFilter, options: typeOptions, searchable: true }]}
          sort={{
            value: archiveSort, onChange: setArchiveSort,
            options: [
              { value: 'recent', label: t("sortRecentlyDeleted") },
              { value: 'oldest', label: t("sortOldest") },
              { value: 'name-az', label: t("sortNameAZ") },
            ],
          }}
          count={loading ? undefined : { shown: archiveMeta.total, total: archiveStats.total }}
        />
      </div>

      {showCategories ? (
        <div className="dash-card overflow-hidden rounded-[28px]">
          {typeCounts === null ? (
            Array.from({ length: 4 }).map((_, i) => (
              <div key={i} className="flex items-center gap-4 border-b border-white/10 px-5 py-4 last:border-0">
                <div className="h-11 w-11 shrink-0 animate-pulse rounded-full bg-white/10" />
                <div className="flex-1 space-y-2"><div className="h-4 w-1/2 animate-pulse rounded bg-white/10" /><div className="h-3 w-1/4 animate-pulse rounded bg-white/10" /></div>
              </div>
            ))
          ) : Object.keys(TYPE_LABEL_KEYS).filter((k) => (typeCounts[k] ?? 0) > 0).length === 0 ? (
            <div className="p-10 text-center text-white/45">{t("noDeletedItems")}</div>
          ) : (
            (Object.keys(TYPE_LABEL_KEYS) as TrashedItem["type"][]).filter((k) => (typeCounts[k] ?? 0) > 0).map((k) => {
              const Icon = TYPE_ICONS[k];
              const n = typeCounts[k] ?? 0;
              return (
                <button
                  key={k}
                  type="button"
                  onClick={() => setTypeFilter(k)}
                  className="flex w-full items-center gap-4 border-b border-white/10 px-5 py-4 text-left transition last:border-0 active:bg-white/[0.05]"
                >
                  <span className="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#2E8E82]/15 text-[#2E8E82]">
                    <Icon className="h-5 w-5" />
                  </span>
                  <span className="min-w-0 flex-1">
                    <span className="block truncate text-[17px] font-semibold text-white">{t(TYPE_LABEL_KEYS[k])}</span>
                    <span className="block text-sm text-white/55">{n === 1 ? t("archiveOneItem") : t("archiveNItems").replace("{n}", String(n))}</span>
                  </span>
                  <ChevronRight className="h-5 w-5 shrink-0 text-white/35" />
                </button>
              );
            })
          )}
        </div>
      ) : (
      <>
      {isPhone && typeFilter !== 'all' && (
        <button
          type="button"
          onClick={() => setTypeFilter('all')}
          className="flex items-center gap-2 text-left"
          aria-label={t("archiveBackToTypes")}
        >
          <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/[0.06] text-white"><ChevronLeft className="h-5 w-5" /></span>
          <span className="font-display text-xl font-extrabold text-white">{t(TYPE_LABEL_KEYS[typeFilter as TrashedItem["type"]] ?? "allTypes")}</span>
          <span className="rounded-full bg-gradient-to-r from-[#0B0F14] to-[#18212B] px-2.5 py-0.5 text-xs font-bold !text-white">{archiveMeta.total}</span>
        </button>
      )}
      <p className="text-xs text-white/45">{t("showingPerPage").replace("{n}", String(itemsPerPage))}</p>

      {allTrashedItems.length === 0 && !loading ? (
        <div className="dash-card rounded-[32px] p-12 text-center text-white/45">
          <svg className="w-16 h-16 mx-auto mb-4 text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
          </svg>
          <p>{t("noDeletedItems")}</p>
        </div>
      ) : (
        <>
        {isPhone && (
          <div className="space-y-4">
            {loading || pageSwitching ? (
              Array.from({ length: 3 }).map((_, i) => <div key={i} className="dash-card h-40 animate-pulse rounded-[28px]" />)
            ) : paginatedItems.map((item, index) => {
              const d = item.originalData?.details;
              const start = d?.event_start ? new Date(d.event_start) : null;
              const end = d?.event_end ? new Date(d.event_end) : null;
              const hm = (x: Date) => x.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
              const Icon = TYPE_ICONS[item.type] ?? Layers;
              const footer = (
                <div className="mt-4 flex items-center justify-between gap-3 border-t border-white/10 pt-3">
                  <div className="min-w-0">
                    <p className="text-[11px] font-bold uppercase tracking-wide text-white/45">{t("deletedAtColumn")}</p>
                    <p className="text-sm font-semibold text-white">{item.deletedAt}</p>
                    <p className="truncate text-xs text-white/45">{t("deletedByColumn")}: {item.deletedBy}</p>
                  </div>
                  <button
                    onClick={() => setRestoreItem(item)}
                    disabled={restoringId === item.id}
                    title={t("restoreTitle")}
                    aria-label={t("restoreTitle")}
                    className="btn-live-navy inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-[#1E3A5F] bg-[#1E3A5F] !text-white shadow-sm transition hover:bg-[#274A77] disabled:opacity-60"
                  >
                    {restoringId === item.id ? <div className="h-4 w-4 animate-spin rounded-full border-b-2 border-[#4FBEB0]" /> : <RefreshCw size={18} />}
                  </button>
                </div>
              );
              if (item.type === 'event') {
                return (
                  <div key={`${item.type}-${item.id}-${index}`} className="dash-card relative overflow-hidden rounded-[28px] p-5 pl-7">
                    <span className="absolute inset-y-0 left-0 w-2 bg-[#4FBEB0]" />
                    {start && (
                      <div className="flex h-20 w-20 flex-col items-center justify-center rounded-3xl bg-white/[0.06]">
                        <span className="text-[11px] font-bold uppercase tracking-wide text-[#2E8E82]">{start.toLocaleDateString(undefined, { month: 'short' })}</span>
                        <span className="font-display text-3xl font-extrabold leading-none text-white">{start.getDate()}</span>
                      </div>
                    )}
                    <p className={`${start ? 'mt-4' : ''} font-display text-xl font-extrabold text-white`}>{highlightMatches(item.name, searchQuery)}</p>
                    {d?.location && (
                      <p className="mt-2 flex items-center gap-2 text-[15px] text-white/65"><MapPin className="h-4 w-4 shrink-0 text-[#2E8E82]" />{d.location}</p>
                    )}
                    {start && (
                      <p className="mt-1.5 flex items-center gap-2 text-[15px] text-white/65"><Clock className="h-4 w-4 shrink-0 text-[#2E8E82]" />{start.toLocaleDateString(undefined, { year: 'numeric', month: '2-digit', day: '2-digit' })} · {hm(start)}{end ? ` – ${hm(end)}` : ''}</p>
                    )}
                    {d && (
                      <p className="mt-3 flex items-center gap-2 text-sm text-white/55"><Users className="h-4 w-4 shrink-0 text-[#2E8E82]" />{d.coverage && d.coverage.length > 0 ? d.coverage.join(', ') : t("allResidentsCoverageLabel")}</p>
                    )}
                    {footer}
                  </div>
                );
              }
              return (
                <div key={`${item.type}-${item.id}-${index}`} className="dash-card rounded-[28px] p-5">
                  <div className="flex items-center gap-3">
                    <span className="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#2E8E82]/15 text-[#2E8E82]"><Icon className="h-5 w-5" /></span>
                    <div className="min-w-0">
                      <p className="break-words text-[17px] font-bold text-white">{highlightMatches(item.name, searchQuery)}</p>
                      <p className="text-xs font-semibold text-white/50">{t(TYPE_LABEL_KEYS[item.type])}</p>
                    </div>
                  </div>
                  {footer}
                </div>
              );
            })}
          </div>
        )}
        <div className="dash-card overflow-hidden rounded-[32px] max-sm:hidden">
          <div className="overflow-x-auto">
            <table className="rtable w-full text-sm">
              <thead>
                <tr className="border-b border-white/10 bg-[#4FBEB0]/[0.06]">
                  <th className="py-3 px-4 text-left text-[11px] font-bold uppercase tracking-wide text-white">{t("typeColumn")}</th>
                  <th className="py-3 px-4 text-left text-[11px] font-bold uppercase tracking-wide text-white">{t("nameTitleColumn")}</th>
                  <th className="py-3 px-4 text-left text-[11px] font-bold uppercase tracking-wide text-white">{t("deletedAtColumn")}</th>
                  <th className="py-3 px-4 text-left text-[11px] font-bold uppercase tracking-wide text-white">{t("deletedByColumn")}</th>
                  <th className="py-3 px-4 text-left text-[11px] font-bold uppercase tracking-wide text-white">{t("actionsColumn")}</th>
                </tr>
              </thead>
              <tbody>
                {loading || pageSwitching ? (
                  Array(8).fill(0).map((_, i) => <SkeletonRow key={i} />)
                ) : (
                  paginatedItems.map((item, index) => (
                    <tr key={`${item.type}-${item.id}-${index}`} className="border-b border-white/[0.06] last:border-0 hover:bg-[#4FBEB0]/[0.07] transition-colors">
                      <td className="py-3.5 px-4">
                        <span className={`inline-flex items-center rounded-full px-2.5 py-1 text-xs font-bold ${TYPE_BADGE_STYLES[item.type] ?? "bg-white/10 text-white/60 border border-white/15"}`}>
                          {highlightMatches(t(TYPE_LABEL_KEYS[item.type]), searchQuery)}
                        </span>
                      </td>
                      <td className="py-3.5 px-4 font-semibold text-white">{highlightMatches(item.name, searchQuery)}</td>
                      <td className="py-3.5 px-4 text-white/60 whitespace-nowrap">{item.deletedAt}</td>
                      <td className="py-3.5 px-4 text-white/45">{highlightMatches(item.deletedBy, searchQuery)}</td>
                      <td className="py-3.5 px-4">
                        <button
                          onClick={() => setRestoreItem(item)}
                          disabled={restoringId === item.id}
                          className="btn-live-navy inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#1E3A5F] bg-[#1E3A5F] text-white shadow-sm transition hover:bg-[#274A77] active:scale-95 disabled:opacity-50"
                          title={t("restoreTitle")}
                        >
                          {restoringId === item.id ? (
                            <div className="animate-spin rounded-full h-3.5 w-3.5 border-b-2 border-[#4FBEB0]"></div>
                          ) : (
                            <RefreshCw size={16} />
                          )}
                        </button>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
        </>
      )}

      {totalPages > 1 && ((pageSwitching || loading) ? <PagerSkeleton withLabel /> : (
        <div className="flex flex-col sm:flex-row gap-3 justify-between items-center">
          <p className="text-sm text-white/45 text-center sm:text-left">
            {t("pageOfLabel")} {currentPage} {t("ofPagesLabel")} {totalPages}
          </p>
          <div className="flex items-center gap-2">
            <button
              onClick={() => goToPage(p => Math.max(1, p - 1))}
              disabled={currentPage === 1}
              className="dash-tile h-8 w-8 rounded-full text-white/70 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed transition-all active:scale-95"
            >←</button>
            <span className="h-8 w-8 rounded-full bg-gradient-to-r from-[#0B0F14] to-[#18212B] text-white shadow-sm flex items-center justify-center text-sm font-bold">
              {currentPage}
            </span>
            <button
              onClick={() => goToPage(p => Math.min(totalPages, p + 1))}
              disabled={currentPage === totalPages}
              className="dash-tile h-8 w-8 rounded-full text-white/70 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed transition-all active:scale-95"
            >→</button>
          </div>
        </div>
      ))}
      </>
      )}
      </div>
      </div>

      {/* Restore Confirm Modal -- sage throughout (button, this confirm
          step, and the success modal below) since restoring is the
          positive/undo action here, not the app's usual save/delete. */}
      {restoreItem && (
        <Portal><div className="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-[90] px-4">
          <div className="bg-[#0A0E1A] border border-white/10 rounded-[30px] w-full max-w-md p-6 shadow-2xl text-center max-h-[85vh] overflow-y-auto">
            <div className="flex justify-center text-sage-400 mb-3"><RefreshCw size={40} /></div>
            <h3 className="font-display text-xl font-bold text-white mb-3">{t("restoreItemModalTitle")}</h3>
            <p className="text-white/50 mb-5">
              {t("restoreConfirmPrefix")} <strong className="text-white">"{restoreItem.name}"</strong>{t("restoreConfirmSuffix")}
            </p>
            <div className="flex justify-center gap-4">
              <button
                onClick={() => setRestoreItem(null)}
                className="px-5 py-2.5 rounded-full border border-white/15 text-white hover:bg-white/10 transition"
              >
                {t("cancelLabel")}
              </button>
              <button
                onClick={handleRestoreConfirm}
                className="px-5 py-2.5 rounded-full bg-sage-700 text-white hover:bg-sage-800 transition"
              >
                {t("yesRestore")}
              </button>
            </div>
          </div>
        </div></Portal>
      )}

      <StatusModal open={showSuccessModal} type="success" title={t("successTitle")} message={t("itemRestoredSuccess")} okLabel={t("okLabel")} onClose={() => setShowSuccessModal(false)} />
      <StatusModal open={showErrorModal} type="error" title={t("restoreFailedTitle")} message={errorMessage} okLabel={t("okLabel")} onClose={() => setShowErrorModal(false)} />
    </>
  );
}
