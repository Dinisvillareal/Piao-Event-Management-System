<file path="app/Console/Commands/AttendanceReconcile.php">
<?php

namespace App\Console\Commands;

use App\Support\AttendanceLedger;
use Illuminate\Console\Command;
use Illuminate\Support\Facades\DB;

/**
 * Checks every attendance row against the attendance scan ledger (see App\Support\AttendanceLedger).
 *
 *   php artisan attendance:reconcile           reports rows whose times or status do not match the ledger (reads only)
 *   php artisan attendance:reconcile --adopt   writes the scans of rows that pre-date the ledger down as explicit
 *                                              entries (user SYSTEM)
 */
class AttendanceReconcile extends Command
{
    protected $signature = 'attendance:reconcile {--adopt : Record the scans of rows that pre-date the ledger} {--force : Do not ask before adopting}';

    protected $description = 'Check that every attendance row matches the scan ledger';

    public function handle(): int
    {
        $problems = AttendanceLedger::check();

        if (!$problems) {
            $this->info('Every attendance row matches the scan ledger.');

            return self::SUCCESS;
        }

        $events = DB::table('events')->whereIn('id', array_unique(array_column($problems, 'event_id')))->pluck('name', 'id');
        $users = DB::table('users')->whereIn('id', array_unique(array_column($problems, 'user_id')))->get(['id', 'user_code', 'first_name', 'last_name'])->keyBy('id');

        $this->error(count($problems) . ' attendance row(s) do not match the ledger:');
        $this->table(['Event', 'Person', 'Problem'], array_map(function ($p) use ($events, $users) {
            $u = $users[$p['user_id']] ?? null;

            return [
                '#' . $p['event_id'] . ' ' . ($events[$p['event_id']] ?? '?'),
                $u ? "{$u->user_code} {$u->first_name} {$u->last_name}" : '#' . $p['user_id'],
                $p['problem'],
            ];
        }, $problems));

        $adoptable = count(array_filter($problems, fn ($p) => $p['adopt']));

        if (!$this->option('adopt')) {
            if ($adoptable) {
                $this->line("{$adoptable} of these are scans with no ledger entry. Run with --adopt to write them down, if they pre-date the ledger.");
            }

            return self::FAILURE;
        }

        if (!$adoptable) {
            $this->line('Nothing here can be adopted: every difference is a real mismatch to investigate.');

            return self::FAILURE;
        }

        if (!$this->option('force') && !$this->confirm("Record {$adoptable} scan(s) as ledger entries (user SYSTEM)? Only do this for scans you know were made before the ledger existed.")) {
            return self::FAILURE;
        }

        $written = AttendanceLedger::adopt();
        $this->info("{$written} opening entr" . ($written === 1 ? 'y' : 'ies') . ' written.');
        $left = count(AttendanceLedger::check());
        $left ? $this->error("{$left} difference(s) still need investigating.") : $this->info('Every attendance row now matches the scan ledger.');

        return $left ? self::FAILURE : self::SUCCESS;
    }
}
</file>

<file path="app/Console/Commands/CheckUploads.php">
<?php

namespace App\Console\Commands;

use App\Support\Uploads;
use Illuminate\Console\Command;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;
use Illuminate\Support\Facades\Storage;

/**
 * Audits every attachment the database points to. The database rule only reads the
 * end of a path (it cannot open a file), so a row written by hand with "jjj.png" is
 * accepted even though no such picture exists. This command finds those rows, and
 * any file that is missing, empty, or not what its name says. It changes nothing.
 *
 *   php artisan uploads:check              lists up to 100 problems
 *   php artisan uploads:check --limit=0    lists all of them
 *
 * Exit code 0 when every attachment is fine, 1 when something needs attention.
 */
class CheckUploads extends Command
{
    protected $signature = 'uploads:check {--limit=100 : Most problems to list (0 = all); the totals always count every one}';

    protected $description = 'Report attachments whose file is missing or is not the JPG/PNG/PDF the database says it is (changes nothing)';

    private const REAL_TYPES = ['image/jpeg' => 'jpg', 'image/png' => 'png', 'application/pdf' => 'pdf'];

    public function handle(): int
    {
        $disk = Storage::disk('public');
        $checked = 0;
        $problems = [];

        foreach (Uploads::columns() as [$table, $column, $allowed, $isList]) {
            if (!Schema::hasColumn($table, $column)) {
                continue;
            }

            DB::table($table)->whereNotNull($column)->select(['id', $column])->orderBy('id')
                ->each(function ($row) use ($disk, $table, $column, $allowed, $isList, &$checked, &$problems) {
                    $paths = $isList ? (array) json_decode((string) $row->{$column}, true) : [$row->{$column}];

                    foreach ($paths as $path) {
                        $checked++;
                        $issue = is_string($path) ? $this->inspect($disk, $path, $allowed) : 'not a file path';
                        if ($issue !== null) {
                            $problems[] = [$table, $row->id, $column, is_string($path) ? $path : json_encode($path), $issue];
                        }
                    }
                });
        }

        if ($problems === []) {
            $this->info("All {$checked} attachments are fine.");

            return self::SUCCESS;
        }

        $limit = max(0, (int) $this->option('limit'));
        $shown = $limit > 0 ? array_slice($problems, 0, $limit) : $problems;
        $this->table(['Table', 'Row', 'Column', 'File', 'Problem'], $shown);

        if (count($shown) < count($problems)) {
            $this->line('... and ' . (count($problems) - count($shown)) . ' more (use --limit=0 to list them all).');
        }
        $this->warn(count($problems) . " of {$checked} attachments need attention. Nothing was changed.");

        return self::FAILURE;
    }

    /**
     * The type of the file read from its first bytes. (The storage layer's own mimeType() falls
     * back to the file name when the content is unclear, which would let a text file called
     * .png pass.)
     */
    private function contentType($disk, string $path): string
    {
        $stream = $disk->readStream($path);
        $head = is_resource($stream) ? (string) fread($stream, 4096) : '';
        if (is_resource($stream)) {
            fclose($stream);
        }

        return (string) (new \finfo(FILEINFO_MIME_TYPE))->buffer($head);
    }

    /** What is wrong with the file at $path, or null when it is a real, allowed file. */
    private function inspect($disk, string $path, array $allowed): ?string
    {
        $ext = Uploads::normalize(pathinfo($path, PATHINFO_EXTENSION));
        $allowedNames = strtoupper(implode('/', array_unique(array_map([Uploads::class, 'normalize'], $allowed))));

        if (!in_array($ext, array_map([Uploads::class, 'normalize'], $allowed), true)) {
            return $ext === ''
                ? "has no file extension (only {$allowedNames} allowed here)"
                : ".{$ext} is not allowed here (only {$allowedNames}); saved before the lock?";
        }

        try {
            if (!$disk->exists($path)) {
                return 'the file is missing from storage';
            }
            if ($disk->size($path) === 0) {
                return 'the file is empty';
            }
            $mime = $this->contentType($disk, $path);
        } catch (\Throwable $e) {
            return 'the file could not be read: ' . $e->getMessage();
        }

        $real = self::REAL_TYPES[$mime] ?? null;
        if ($real === null || !in_array($real, array_map([Uploads::class, 'normalize'], $allowed), true)) {
            return "the content is {$mime}, not {$allowedNames}";
        }
        if ($real !== $ext) {
            return "named .{$ext} but the content is a " . strtoupper($real);
        }

        return null;
    }
}
</file>

<file path="app/Console/Commands/StaffResetPassword.php">
<?php

namespace App\Console\Commands;

use App\Models\ActivityLog;
use App\Models\User;
use App\Services\SecurityService;
use Illuminate\Console\Command;
use Illuminate\Support\Facades\Hash;

/**
 * Server-side last resort for a locked-out account (for example the Head
 * Staff when the recovery codes are lost). Prints a one-time password that
 * must be changed at the first sign-in.
 */
class StaffResetPassword extends Command
{
    protected $signature = 'staff:reset-password {user_code : e.g. PR-0001}';

    protected $description = 'Issue a one-time temporary password for a Staff account';

    public function handle(SecurityService $security): int
    {
        $user = User::where('user_code', $this->argument('user_code'))->where('role', 'Staff')->first();

        if (!$user) {
            $this->error('No Staff account with that user code.');
            return self::FAILURE;
        }

        $temporary = $security->temporaryPassword();
        $user->password = Hash::make($temporary);
        $user->has_account = 1;
        $user->must_change_password = true;
        $user->password_changed_at = null;
        $user->failed_login_attempts = 0;
        $user->locked_until = null;
        $user->two_factor_secret = null;
        $user->two_factor_confirmed_at = null;
        $user->save();
        $security->revokeSessions($user);

        ActivityLog::create([
            'user_code' => $user->user_code,
            'action' => 'Reset Staff Password',
            'module' => 'Staff Accounts',
            'description' => "Password of {$user->user_code} was reset from the server",
        ]);
        $security->alertAllStaff('password_reset', 'Staff password reset',
            "The password of {$user->user_code} was reset from the server.", $user->id);

        $this->info("Temporary password for {$user->user_code}: {$temporary}");
        $this->line('It must be changed at the first sign-in. Share it only with that person.');
        return self::SUCCESS;
    }
}
</file>

<file path="app/Console/Commands/StaffSetHead.php">
<?php

namespace App\Console\Commands;

use App\Models\ActivityLog;
use App\Models\User;
use App\Services\SecurityService;
use Illuminate\Console\Command;
use Illuminate\Support\Facades\DB;

/**
 * Server-side last resort: name the Head Staff when nobody in the app can
 * (first setup, or the previous Head Staff is gone and cannot confirm a
 * transfer). Not reachable from the internet.
 */
class StaffSetHead extends Command
{
    protected $signature = 'staff:set-head {user_code : e.g. PR-0001}';

    protected $description = 'Make a Staff account the Head Staff (replaces the current one)';

    public function handle(SecurityService $security): int
    {
        $user = User::where('user_code', $this->argument('user_code'))->first();

        if (!$user || $user->role !== 'Staff' || $user->suspended_at) {
            $this->error('That account is not an active Staff account.');
            return self::FAILURE;
        }

        DB::transaction(function () use ($user) {
            User::where('is_head_staff', true)->where('id', '!=', $user->id)->update(['is_head_staff' => false]);
            $user->is_head_staff = true;
            $user->save();
        });

        ActivityLog::create([
            'user_code' => $user->user_code,
            'action' => 'Head Staff Set',
            'module' => 'Staff Accounts',
            'description' => "{$user->user_code} was made Head Staff from the server",
        ]);
        $security->alertAllStaff('head_changed', 'New Head Staff', "{$user->user_code} was made the Head Staff.");

        $this->info("{$user->user_code} is now the Head Staff.");
        return self::SUCCESS;
    }
}
</file>

<file path="app/Console/Commands/StockReconcile.php">
<?php

namespace App\Console\Commands;

use App\Support\StockLedger;
use Illuminate\Console\Command;

/**
 * Checks every inventory item's stock against its ledger (see App\Support\StockLedger).
 *
 *   php artisan stock:reconcile           reports items whose stock does not match their ledger (reads only)
 *   php artisan stock:reconcile --adopt   writes each difference down as an explicit ledger entry (user SYSTEM),
 *                                         for items that existed before the ledger
 */
class StockReconcile extends Command
{
    protected $signature = 'stock:reconcile {--adopt : Record each difference as an opening-balance ledger entry} {--force : Do not ask before adopting}';

    protected $description = 'Check that every inventory item\'s stock matches its ledger';

    public function handle(): int
    {
        $problems = StockLedger::check();

        if (!$problems) {
            $this->info('Every item\'s stock matches its ledger.');

            return self::SUCCESS;
        }

        $this->error(count($problems) . ' item(s) do not match their ledger:');
        $this->table(
            ['#', 'Item', 'In stock', 'On loan', 'Lost', 'Units owned', 'Ledger says', 'Lost per ledger'],
            array_map(fn ($p) => [$p['id'], $p['name'], $p['stock'], $p['on_loan'], $p['lost'], $p['owned'], $p['expected_owned'], $p['expected_lost']], $problems)
        );

        if (!$this->option('adopt')) {
            $this->line('Run with --adopt to write each difference down as an opening-balance entry, if these items pre-date the ledger.');

            return self::FAILURE;
        }

        if (!$this->option('force') && !$this->confirm('Record these differences as ledger entries (user SYSTEM)? Only do this for items you know pre-date the ledger.')) {
            return self::FAILURE;
        }

        $written = StockLedger::adopt();
        $this->info("{$written} opening-balance entr" . ($written === 1 ? 'y' : 'ies') . ' written.');

        return self::SUCCESS;
    }
}
</file>

