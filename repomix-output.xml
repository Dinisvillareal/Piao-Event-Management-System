                  if (showCancelConfirm === "edit") closeEditForm();
                }}
                className="px-5 py-2.5 rounded-full bg-sage-700 text-white hover:bg-sage-800 transition"
              >
                {t("discardCloseButton")}
              </button>
            </div>
          </div>
        </div></Portal>
      )}
    </div>
  );
}
